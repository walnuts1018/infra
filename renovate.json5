{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>walnuts1018/renovate-config',
  ],
  kubernetes: {
    managerFilePatterns: [
      '/k8s/.+\\.jsonnet$/',
      '/k8s/.+\\.libsonnet$/',
      '/k8s/.+\\.yaml$/',
      '/k8s/.+\\.yml$/',
    ],
  },
  argocd: {
    managerFilePatterns: [
      '/k8s/_argocd/.+\\.yaml$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^k8s\\/mcl\\.toml$/',
      ],
      matchStrings: [
        'source = "https://raw\\.githubusercontent\\.com/(?<depName>[^/]+/[^/]+)/(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)/[^"\\n]+"',
      ],
      datasourceTemplate: 'github-tags',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^k8s\\/mcl\\.toml$/',
      ],
      matchStrings: [
        '#\\s*renovate: datasource=(?<datasource>docker) depName=(?<depName>[^\\s]+)\\s+source = "(?<source>oci://[^"\\n]+)"\\s+version = "(?<currentValue>[^"\\n]+)"',
      ],
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^k8s\\/mcl\\.toml$/',
      ],
      matchStrings: [
        '#\\s*renovate: datasource=(?<datasource>github-releases) depName=(?<depName>elastic/cloud-on-k8s)\\s+source = "https://download\\.elastic\\.co/downloads/eck/(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)/crds\\.yaml"',
      ],
      autoReplaceStringTemplate: '# renovate: datasource=github-releases depName={{{depName}}}\nsource = "https://download.elastic.co/downloads/eck/{{{replace "^v" "" newValue}}}/crds.yaml"',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^k8s\\/(?:apps|_argocd)\\/.+\\.mcl$/',
      ],
      matchStrings: [
        '(?:image|modelImage|reference):\\s+"(?<packageName>(?:[^/"@]+/)?[^:"@]+(?:/[^:"@]+)*)(?::(?<currentValue>[^"@]+))?(?:@sha256:(?<currentDigest>[a-f0-9]+))?"',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^k8s\\/(?:apps|_argocd)\\/.+\\.mcl$/',
      ],
      matchStrings: [
        '#\\s*renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: registryUrl=(?<registryUrl>[^\\s]+))?\\s+export let [A-Za-z][A-Za-z0-9_]* = "[^"@\\n]+:(?<currentValue>[^"@]+)(?:@sha256:[a-f0-9]+)?"',
      ],
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^k8s\\/(?:apps|_argocd)\\/.+\\.mcl$/',
      ],
      matchStrings: [
        '#\\s*renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: packageName=(?<packageName>[^\\s]+))?(?: registryUrl=(?<registryUrl>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?\\s+export let [A-Za-z][A-Za-z0-9]*Version = "(?<currentValue>[^"]+)"',
      ],
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^k8s/.*/helm.jsonnet$/',
        '/^k8s/.*/helm.libsonnet$/',
        '/^k8s/.*/helm.yaml$/',
        '/^k8s/.*/helm.yml$/',
      ],
      matchStringsStrategy: 'combination',
      matchStrings: [
        'chart:\\s+["\']?(?<depName>[a-z0-9-]+)["\']',
        'repoURL:\\s+["\']?(?<registryUrl>\\S+)["\']',
        'targetRevision:\\s+["\']?(?<currentValue>\\S+)["\']',
      ],
      datasourceTemplate: 'helm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^k8s/.*/helm.jsonnet$/',
        '/^k8s/.*/helm.libsonnet$/',
        '/^k8s/.*/helm.yaml$/',
        '/^k8s/.*/helm.yml$/',
      ],
      matchStringsStrategy: 'combination',
      matchStrings: [
        'ociChartURL:\\s+["\']?(?<packageName>\\S+)["\']?',
        'targetRevision:\\s+["\']?(?<currentValue>\\S+)["\']?',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^k8s/.*/.+\\.jsonnet$/',
        '/^k8s/.*/.+\\.libsonnet$/',
        '/^k8s/.*/.+\\.yaml$/',
        '/^k8s/.*/.+\\.yml$/',
      ],
      matchStrings: [
        '(?:registry:\\s+["\']?(?<registry>[^\\s\'"]+)["\']?\\r?\\n\\s*)?repository:\\s+["\']?(?<packageName>[^\\s\'"]+)["\']?\\r?\\n\\s*tag:\\s+["\']?(?<currentValue>[^\\s\'"]+)["\']?(?:\\r?\\n\\s*digest:\\s+["\']?(?<currentDigest>[^\\s\'"]+)["\']?)?',
      ],
      datasourceTemplate: 'docker',
      packageNameTemplate: '{{#if registry}}{{{registry}}}/{{/if}}{{{packageName}}}',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^k8s/apps/.*/kustomization.yaml$/',
        '/^k8s/apps/.+\\.mcl$/',
      ],
      matchStringsStrategy: 'any',
      matchStrings: [
        'https:\\/\\/github\\.com\\/(?<depName>.*?)\\/releases\\/download\\/(?<currentValue>[^\\/\\s+]+)\\/[^\\/\\s+]+',
        'https:\\/\\/github\\.com\\/(?<depName>([^\\/]+\\/[^\\/]+)?)\\/.*\\\\\\?ref=(?<currentValue>[^&\\s]+)\\s*',
        'https:\\/\\/raw\\.githubusercontent\\.com\\/(?<depName>.*?)\\/refs\\/tags\\/(?<currentValue>[^\\/]+)\\/.*\\s*',
        'https:\\/\\/raw\\.githubusercontent\\.com\\/(?<depName>[^/]+\\/[^/]+?)\\/(?<currentValue>[^\\/]+?)\\/.*\\s*',
      ],
      datasourceTemplate: 'github-tags',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^k8s\\/mcl\\.toml$/',
      ],
      matchStrings: [
        '#\\s*renovate: datasource=(?<datasource>github-releases) depName=(?<depName>[^\\s]+)\\s+source = "https:\\/\\/github\\.com\\/(?<urlDepName>[^/]+\\/[^/]+)\\/releases\\/download\\/(?<versionPrefix>v?)(?<currentValue>[^/]+)\\/(?<assetName>[^"]+)"',
      ],
      autoReplaceStringTemplate: '# renovate: datasource=github-releases depName={{{depName}}}\nsource = "https://github.com/{{{urlDepName}}}/releases/download/{{{versionPrefix}}}{{{replace "^v" "" newValue}}}/{{{assetName}}}"',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^k8s\\/mcl\\.toml$/',
      ],
      matchStrings: [
        '#\\s*renovate: versioned-asset datasource=(?<datasource>github-releases) depName=(?<depName>[^\\s]+)\\s+source = "(?<urlPrefix>https:\\/\\/github\\.com\\/(?<urlDepName>[^/]+\\/[^/]+)\\/releases\\/download\\/)(?<versionPrefix>v?)(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\/(?<assetPrefix>[^/]*?)(?<assetVersion>[0-9]+\\.[0-9]+\\.[0-9]+)(?<assetSuffix>[^"]+)"',
      ],
      autoReplaceStringTemplate: '# renovate: versioned-asset datasource={{{datasource}}} depName={{{depName}}}\nsource = "{{{urlPrefix}}}{{{versionPrefix}}}{{{replace "^v" "" newValue}}}/{{{assetPrefix}}}{{{replace "^v" "" newValue}}}{{{assetSuffix}}}"',
      versioningTemplate: 'semver',
    },
  ],
  packageRules: [
    {
      groupName: 'eck-operator',
      matchPackageNames: [
        'eck-operator',
        'elastic/cloud-on-k8s',
      ],
    },
    {
      groupName: 'trust-manager',
      matchPackageNames: [
        'trust-manager',
        'cert-manager/trust-manager',
      ],
    },
    {
      groupName: 'netbird',
      matchPackageNames: [
        '/netbird/',
      ],
    },
    {
      matchDatasources: [
        'helm',
      ],
      platformAutomerge: false,
      minimumReleaseAge: '1 days',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/renovatebot/renovate',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
      ],
      automerge: true,
      platformAutomerge: false,
      minimumReleaseAge: '1 days',
    },
    {
      matchPackageNames: [
        'ghcr.io/walnuts1018/2024-ac-hacking',
        'ghcr.io/walnuts1018/2024-ac-hacking-front',
        'ghcr.io/walnuts1018/walnuts.dev',
        'ghcr.io/walnuts1018/http-dump',
        'ghcr.io/walnuts1018/mucaron-backend',
        'ghcr.io/walnuts1018/mucaron-frontend',
      ],
      versioning: 'regex:^[a-f0-9]+-(?<patch>[0-9]+)$',
    },
    {
      matchPackageNames: [
        'ghcr.io/kmc-jp/oekaki-dengon-game-back',
        'ghcr.io/kmc-jp/oekaki-dengon-game-front',
        'ghcr.io/walnuts1018/openchokin-back',
        'ghcr.io/walnuts1018/openchokin-front',
      ],
      versioning: 'regex:^v0\\.0\\.0-[a-f0-9]+-(?<patch>[0-9]+)$',
    },
    {
      matchPackageNames: [
        'photoprism/photoprism',
      ],
      versioning: 'regex:^(?<major>[0-9]{2})(?<minor>[0-9]{2})(?<patch>[0-9]{2})$',
    },
    {
      matchPackageNames: [
        'ghcr.io/servercontainers/samba',
      ],
      versioning: 'regex:^a(?<major>[0-9]+)\\.(?<minor>[0-9]+)\\.(?<patch>[0-9]+)-s(?<build>[0-9]+)\\.(?<revision>[0-9]+)\\.([0-9]+)-r([0-9]+)$',
    },
    {
      matchPackageNames: [
        'ghcr.io/cloudnative-pg/postgresql',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
    {
      matchPackageNames: [
        'scylladb/scylla',
      ],
      automerge: false,
      // Major, Minor versionはスキップ禁止なので、手動でPRを作るようにする
      dependencyDashboardApproval: true,
    },
    {
      matchPackageNames: [
        'chrislusf/seaweedfs',
      ],
      versioning: 'regex:^(?<major>[0-9]+)\\.(?<minor>[0-9]+)(_(?<compatibility>.+))?$',
    },
    {
      groupName: 'picca',
      matchPackageNames: [
        '/^ghcr\\.io\\/walnuts1018\\/picca\\//',
      ],
    },
  ],
}
