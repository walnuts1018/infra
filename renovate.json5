{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>walnuts1018/renovate-config',
  ],
  kubernetes: {
    managerFilePatterns: [
      '/k8s/.+\\.jsonnet$/',
      '/k8s/.+\\.libsonnet$/',
      '/k8s/.+\\.yaml$/',
      '/k8s/.+\\.yml$/',
    ],
  },
  argocd: {
    managerFilePatterns: [
      '/k8s/_argocd/.+\\.yaml$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/build-images\\.yaml$/',
      ],
      matchStrings: [
        'version:\\s+(?<currentValue>v\\d+\\.\\d+\\.\\d+)',
      ],
      depNameTemplate: 'docker/buildx',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^k8s/.*/helm.jsonnet$/',
        '/^k8s/.*/helm.libsonnet$/',
        '/^k8s/.*/helm.yaml$/',
        '/^k8s/.*/helm.yml$/',
      ],
      matchStringsStrategy: 'combination',
      matchStrings: [
        'chart:\\s+["\']?(?<depName>[a-z0-9-]+)["\']',
        'repoURL:\\s+["\']?(?<registryUrl>\\S+)["\']',
        'targetRevision:\\s+["\']?(?<currentValue>\\S+)["\']',
      ],
      datasourceTemplate: 'helm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^k8s/.*/helm.jsonnet$/',
        '/^k8s/.*/helm.libsonnet$/',
        '/^k8s/.*/helm.yaml$/',
        '/^k8s/.*/helm.yml$/',
        '/^k8s/apps/actions-runners/runners\\.libsonnet$/',
      ],
      matchStringsStrategy: 'combination',
      matchStrings: [
        'ociChartURL:\\s+["\']?(?<packageName>[^\\s,"\']+)["\']?',
        'targetRevision:\\s+["\']?(?<currentValue>[^\\s,"\']+)["\']?',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^k8s/.*/.+\\.jsonnet$/',
        '/^k8s/.*/.+\\.libsonnet$/',
        '/^k8s/.*/.+\\.yaml$/',
        '/^k8s/.*/.+\\.yml$/',
      ],
      matchStrings: [
        '(?:registry:\\s+["\']?(?<registry>[^\\s\'"]+)["\']?\\r?\\n\\s*)?repository:\\s+["\']?(?<packageName>[^\\s\'"]+)["\']?\\r?\\n\\s*tag:\\s+["\']?(?<currentValue>[^\\s\'"]+)["\']?(?:\\r?\\n\\s*digest:\\s+["\']?(?<currentDigest>[^\\s\'"]+)["\']?)?',
      ],
      datasourceTemplate: 'docker',
      packageNameTemplate: '{{#if registry}}{{{registry}}}/{{/if}}{{{packageName}}}',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^k8s/apps/.*/kustomization.yaml$/',
      ],
      matchStringsStrategy: 'any',
      matchStrings: [
        'https:\\/\\/github\\.com\\/(?<depName>.*?)\\/releases\\/download\\/(?<currentValue>[^\\/]+)\\/.*\\s*',
        'https:\\/\\/github\\.com\\/(?<depName>([^\\/]+\\/[^\\/]+)?)\\/.*\\\\\\?ref=(?<currentValue>[^&\\s]+)\\s*',
        'https:\\/\\/raw\\.githubusercontent\\.com\\/(?<depName>.*?)\\/refs\\/tags\\/(?<currentValue>[^\\/]+)\\/.*\\s*',
        'https:\\/\\/raw\\.githubusercontent\\.com\\/(?<depName>[^/]+\\/[^/]+?)\\/(?<currentValue>[^\\/]+?)\\/.*\\s*',
      ],
      datasourceTemplate: 'github-tags',
    },
  ],
  packageRules: [
    {
      matchPackageNames: [
        'lscr.io/linuxserver/webtop',
      ],
      enabled: false,
    },
    {
      groupName: 'netbird',
      matchPackageNames: [
        '/netbird/',
      ],
    },
    {
      matchDatasources: [
        'helm',
      ],
      platformAutomerge: false,
      minimumReleaseAge: '1 days',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/manifest-configuration-language/website',
        'ghcr.io/manifest-configuration-language/website-api',
      ],
      matchCurrentValue: 'main',
      automerge: true,
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/renovatebot/renovate',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
      ],
      automerge: true,
      platformAutomerge: false,
      minimumReleaseAge: '1 days',
    },
    {
      matchPackageNames: [
        'ghcr.io/cloudnative-pg/postgresql',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
    {
      matchPackageNames: [
        'scylladb/scylla',
      ],
      automerge: false,
      // Major, Minor versionはスキップ禁止なので、手動でPRを作るようにする
      dependencyDashboardApproval: true,
    },
    {
      groupName: 'picca',
      matchPackageNames: [
        '/^ghcr\\.io\\/walnuts1018\\/picca\\//',
      ],
    },
  ],
}
