import "std:crypto" as crypto
import "../lib/tart-control-plane.mcl" as capi
import text "./_patches/control-plane.yaml" as patchesText

let clusterName = "biscuit"
let patches = patchesText
let hostSelectorLabels =
  "infrastructure.cluster.x-k8s.io/host-name": "eclair"
let identity =
  patches: patches
  schematicID: "376567988ad370138ad8b2698212367b8edcb69b5fd68c80be1f2ec7d603b4ba"
  talosVersion: "v1.14.0"
  hostSelectorLabels: hostSelectorLabels
let identityHash = crypto.sha256(identity, 10)
let resourceName = clusterName + "-control-plane-" + identityHash
let patchesSecretName = clusterName + "-control-plane-patches-" + identityHash

let config = identity with:
  name: resourceName
  patchesName: patchesSecretName
  clusterName: clusterName
  namespace: clusterName
  kubernetesVersion: "v1.36.4"
  talosVersion: "v1.14.0"
  replicas: 1
  endpointHost: "192.168.0.15"
  endpointPort: 6443
  podCIDR: "10.244.0.0/16"
  serviceCIDR: "10.96.0.0/12"

export let resources =
  - capi.bootstrapConfigTemplate(config)
  - capi.clusterResource(config)
  - capi.tartControlPlane(config)
  - capi.tartMachineTemplate(config, hostSelectorLabels)
  - capi.patchSecret(config)
  - capi.tartCluster(config)
