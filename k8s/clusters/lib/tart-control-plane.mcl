export type MachineIdentity =
  patches: String
  schematicID: String
  talosVersion: String
  hostSelectorLabels: Map<String, String>

export type MachineTemplateIdentity =
  schematicID: String
  talosVersion: String
  hostSelectorLabels: Map<String, String>

export type ControlPlaneConfig =
  bootstrapConfigName: String
  machineTemplateName: String
  patchesName: String
  clusterName: String
  namespace: String
  kubernetesVersion: String
  talosVersion: String
  replicas: Int
  endpointHost: String
  endpointPort: Int
  schematicID: String
  patches: String
  hostSelectorLabels: Map<String, String>
  podCIDR: String
  serviceCIDR: String

export type WorkerConfig =
  name: String
  patchesName: String
  clusterName: String
  deploymentName: String
  namespace: String
  kubernetesVersion: String
  replicas: Int
  hostSelectorLabels: Map<String, String>
  schematicID: String
  talosVersion: String
  patches: String

export fn bootstrapConfigTemplate(config: ControlPlaneConfig) -> Map<String, Any> = node:
  apiVersion: "bootstrap.cluster.x-k8s.io/v1alpha1"
  kind: "TartBootstrapConfigTemplate"
  metadata:
    annotations:
      "argocd.argoproj.io/sync-options": "Prune=false"
    name: config.bootstrapConfigName
    namespace: config.namespace
  spec:
    template:
      spec:
        configPatchesSecretRef:
          name: config.patchesName

export fn clusterResource(config: ControlPlaneConfig) -> Map<String, Any> = node:
  apiVersion: "cluster.x-k8s.io/v1beta2"
  kind: "Cluster"
  metadata:
    annotations:
      "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=confirm"
    labels:
      "argocd-agent.walnuts.dev/enabled": "true"
      "cluster.x-k8s.io/cluster-name": config.clusterName
    name: config.clusterName
    namespace: config.namespace
  spec:
    clusterNetwork:
      pods:
        cidrBlocks:
          - config.podCIDR
      services:
        cidrBlocks:
          - config.serviceCIDR
    controlPlaneEndpoint:
      host: config.endpointHost
      port: config.endpointPort
    controlPlaneRef:
      apiGroup: "controlplane.cluster.x-k8s.io"
      kind: "TartControlPlane"
      name: config.clusterName
    infrastructureRef:
      apiGroup: "infrastructure.cluster.x-k8s.io"
      kind: "TartCluster"
      name: config.clusterName

export fn tartControlPlane(config: ControlPlaneConfig) -> Map<String, Any> = node:
  apiVersion: "controlplane.cluster.x-k8s.io/v1alpha1"
  kind: "TartControlPlane"
  metadata:
    name: config.clusterName
    namespace: config.namespace
  spec:
    bootstrapConfigTemplateRef:
      apiGroup: "bootstrap.cluster.x-k8s.io"
      kind: "TartBootstrapConfigTemplate"
      name: config.bootstrapConfigName
    machineTemplate:
      spec:
        infrastructureRef:
          apiGroup: "infrastructure.cluster.x-k8s.io"
          kind: "TartMachineTemplate"
          name: config.machineTemplateName
    replicas: config.replicas
    version: config.kubernetesVersion

export fn tartMachineTemplate(config: ControlPlaneConfig) -> Map<String, Any> = node:
  apiVersion: "infrastructure.cluster.x-k8s.io/v1alpha1"
  kind: "TartMachineTemplate"
  metadata:
    annotations:
      "argocd.argoproj.io/sync-options": "Prune=false"
    name: config.machineTemplateName
    namespace: config.namespace
  spec:
    template:
      spec:
        hostSelector:
          selector:
            matchLabels: config.hostSelectorLabels
        image:
          schematicID: config.schematicID
          version: config.talosVersion

export fn patchSecret(config: ControlPlaneConfig) -> Map<String, Any> = node:
  apiVersion: "v1"
  immutable: true
  kind: "Secret"
  metadata:
    annotations:
      "argocd.argoproj.io/sync-options": "Prune=false"
    name: config.patchesName
    namespace: config.namespace
  stringData:
    patches: config.patches
  type: "Opaque"

export fn tartCluster(config: ControlPlaneConfig) -> Map<String, Any> = node:
  apiVersion: "infrastructure.cluster.x-k8s.io/v1alpha1"
  kind: "TartCluster"
  metadata:
    labels:
      "cluster.x-k8s.io/cluster-name": config.clusterName
    name: config.clusterName
    namespace: config.namespace
  spec: {}


export fn worker(config: WorkerConfig) -> List<Map<String, Any>> =
  - apiVersion: "bootstrap.cluster.x-k8s.io/v1alpha1"
    kind: "TartBootstrapConfigTemplate"
    metadata:
      annotations:
        "argocd.argoproj.io/sync-options": "Prune=false"
      name: config.name
      namespace: config.namespace
    spec:
      template:
        spec:
          configPatchesSecretRef:
            name: config.patchesName
  - apiVersion: "cluster.x-k8s.io/v1beta2"
    kind: "MachineDeployment"
    metadata:
      labels:
        "cluster.x-k8s.io/cluster-name": config.clusterName
        "cluster.x-k8s.io/deployment-name": config.deploymentName
      name: config.deploymentName
      namespace: config.namespace
    spec:
      clusterName: config.clusterName
      replicas: config.replicas
      selector:
        matchLabels:
          "cluster.x-k8s.io/cluster-name": config.clusterName
          "cluster.x-k8s.io/deployment-name": config.deploymentName
      template:
        metadata:
          labels:
            "cluster.x-k8s.io/cluster-name": config.clusterName
            "cluster.x-k8s.io/deployment-name": config.deploymentName
        spec:
          bootstrap:
            configRef:
              apiGroup: "bootstrap.cluster.x-k8s.io"
              kind: "TartBootstrapConfigTemplate"
              name: config.name
          clusterName: config.clusterName
          infrastructureRef:
            apiGroup: "infrastructure.cluster.x-k8s.io"
            kind: "TartMachineTemplate"
            name: config.name
          version: config.kubernetesVersion
  - apiVersion: "infrastructure.cluster.x-k8s.io/v1alpha1"
    kind: "TartMachineTemplate"
    metadata:
      annotations:
        "argocd.argoproj.io/sync-options": "Prune=false"
      name: config.name
      namespace: config.namespace
    spec:
      template:
        spec:
          hostSelector:
            selector:
              matchLabels: config.hostSelectorLabels
          image:
            schematicID: config.schematicID
            version: config.talosVersion
  - apiVersion: "v1"
    immutable: true
    kind: "Secret"
    metadata:
      annotations:
        "argocd.argoproj.io/sync-options": "Prune=false"
      name: config.patchesName
      namespace: config.namespace
    stringData:
      patches: config.patches
    type: "Opaque"
