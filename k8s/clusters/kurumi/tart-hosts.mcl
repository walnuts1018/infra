import "std:list" as list
import "../lib/tart-host.mcl" as tart
import "../lib/tart-host-types.mcl" as types

let redfishSecretName = "rusk-redfish-credential"
type Host =
  name: String
  macAddress: String
  talosAPIAddress: String
  labels: Map<String, String>
  power: types.Power

let hosts =
  - name: "cake"
    macAddress: "a8:a1:59:ac:dd:2b"
    talosAPIAddress: "192.168.0.25"
    labels:
      "infrastructure.cluster.x-k8s.io/host-name": "cake"
      "kurumi.walnuts.dev/pool": "control-plane"
    power:
      backend: "WakeOnLAN"
      wakeOnLAN:
        broadcastAddress: "192.168.0.255:9"
  - name: "hotate"
    macAddress: "7c:83:34:be:e6:9b"
    talosAPIAddress: "192.168.0.26"
    labels:
      "infrastructure.cluster.x-k8s.io/host-name": "hotate"
      "kurumi.walnuts.dev/pool": "control-plane"
    power:
      backend: "WakeOnLAN"
      wakeOnLAN:
        broadcastAddress: "192.168.0.255:9"
  - name: "lemon"
    macAddress: "4c:85:8a:eb:89:73"
    talosAPIAddress: "192.168.0.19"
    labels:
      "infrastructure.cluster.x-k8s.io/host-name": "lemon"
      "kurumi.walnuts.dev/pool": "control-plane"
    power:
      backend: "WakeOnLAN"
      wakeOnLAN:
        broadcastAddress: "192.168.0.255:9"
  - name: "rusk"
    macAddress: "28:80:23:b6:fa:e8"
    talosAPIAddress: "192.168.0.101"
    labels:
      "infrastructure.cluster.x-k8s.io/host-name": "rusk"
      "kurumi.walnuts.dev/pool": "worker"
    power:
      backend: "Redfish"
      redfish:
        address: "https://192.168.4.101"
        credentialSecretRef:
          name: redfishSecretName
        caSecretRef:
          name: redfishSecretName
        insecureSkipVerify: false

fn renderHost(host: Host) -> Map<String, Any> = tart.tartHost(host.name, host.macAddress, host.talosAPIAddress, host.labels, host.power)

let hostResources = list.map(hosts, renderHost)

let redfishSecret = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: redfishSecretName
    namespace: "tart-infrastructure-system"
  spec:
    refreshInterval: "1m"
    secretStoreRef:
      kind: "ClusterSecretStore"
      name: "onepassword"
    target:
      name: redfishSecretName
      template:
        engineVersion: "v2"
        type: "Opaque"
    data:
      - secretKey: "username"
        remoteRef:
          key: "rusk iLO"
          property: "username"
      - secretKey: "password"
        remoteRef:
          key: "rusk iLO"
          property: "password"
      - secretKey: "ca.crt"
        remoteRef:
          key: "rusk iLO CA"
          property: "file/ca.crt"

export let resources =
  items: hostResources
  redfishSecret: redfishSecret
