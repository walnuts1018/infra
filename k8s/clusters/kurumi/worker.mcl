import "std:crypto" as crypto
import "../lib/tart-control-plane.mcl" as capi
import "../../cluster.mcl" as clusterConfig
import text "./_patches/worker.yaml" as patchesText

fn workerName(cluster: clusterConfig.ClusterAPIConfig) -> String = cluster.name + "-worker"

fn hostSelectorLabels() -> Map<String, String> =
  "kurumi.walnuts.dev/pool": "worker"

fn identity(cluster: clusterConfig.ClusterAPIConfig) -> capi.MachineIdentity =
  patches: patchesText
  schematicID: "613e1592b2da41ae5e265e8789429f22e121aab91cb4deb6bc3c0b6262961245"
  talosVersion: cluster.talosVersion
  hostSelectorLabels: hostSelectorLabels()

fn resourceName(cluster: clusterConfig.ClusterAPIConfig) -> String =
  cluster.name + "-worker-" + crypto.sha256(identity(cluster), 10)

fn patchesSecretName(cluster: clusterConfig.ClusterAPIConfig) -> String =
  cluster.name + "-worker-patches-" + crypto.sha256(identity(cluster), 10)

fn config(cluster: clusterConfig.ClusterAPIConfig) -> capi.WorkerConfig = identity(cluster) with:
  name: resourceName(cluster)
  patchesName: patchesSecretName(cluster)
  clusterName: cluster.name
  deploymentName: workerName(cluster)
  namespace: cluster.namespace
  kubernetesVersion: cluster.kubernetesVersion
  replicas: cluster.workerMachineCount

export fn resources(cluster: clusterConfig.ClusterAPIConfig) -> List<Map<String, Any>> =
  if cluster.workerMachineCount == 0:
    []
  else:
    capi.worker(config(cluster))
