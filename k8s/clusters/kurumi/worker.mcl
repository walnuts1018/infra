import "std:crypto" as crypto
import "../lib/tart-control-plane.mcl" as capi
import text "./_patches/worker.yaml" as patchesText

let clusterName = "kurumi"
let workerName = "kurumi-worker"
let labels =
  "cluster.x-k8s.io/cluster-name": clusterName
  "cluster.x-k8s.io/deployment-name": workerName
let hostSelectorLabels =
  "kurumi.walnuts.dev/pool": "worker"
let patches = patchesText
let identity =
  patches: patches
  schematicID: "613e1592b2da41ae5e265e8789429f22e121aab91cb4deb6bc3c0b6262961245"
  talosVersion: "v1.14.0"
  hostSelectorLabels: hostSelectorLabels
let identityHash = crypto.sha256(identity, 10)
let resourceName = clusterName + "-worker-" + identityHash
let patchesSecretName = clusterName + "-worker-patches-" + identityHash

let config: capi.WorkerConfig =
  name: resourceName
  patchesName: patchesSecretName
  clusterName: clusterName
  deploymentName: workerName
  namespace: clusterName
  kubernetesVersion: "v1.36.4"
  replicas: 1
  labels: labels
  hostSelectorLabels: hostSelectorLabels
  schematicID: "613e1592b2da41ae5e265e8789429f22e121aab91cb4deb6bc3c0b6262961245"
  talosVersion: "v1.14.0"
  patches: patches

export let resources = capi.worker(config)
