import "std:crypto" as crypto
import "../lib/tart-control-plane.mcl" as capi
import "../../cluster.mcl" as clusterConfig
import text "./_patches/control-plane.yaml" as patchesText

fn hostSelectorLabels() -> Map<String, String> =
  "kurumi.walnuts.dev/pool": "control-plane"

fn machineTemplateIdentity(cluster: clusterConfig.ClusterAPIConfig) -> capi.MachineTemplateIdentity =
  schematicID: "613e1592b2da41ae5e265e8789429f22e121aab91cb4deb6bc3c0b6262961245"
  talosVersion: cluster.talosVersion
  hostSelectorLabels: hostSelectorLabels()

fn identity(cluster: clusterConfig.ClusterAPIConfig) -> capi.MachineIdentity = machineTemplateIdentity(cluster) with:
  patches: patchesText

fn machineTemplateName(cluster: clusterConfig.ClusterAPIConfig) -> String =
  cluster.name + "-control-plane-" + crypto.sha256(machineTemplateIdentity(cluster), 10)

fn patchesSecretName(cluster: clusterConfig.ClusterAPIConfig) -> String =
  cluster.name + "-control-plane-patches-" + crypto.sha256(patchesText, 10)

fn bootstrapConfigName(cluster: clusterConfig.ClusterAPIConfig) -> String =
  cluster.name + "-control-plane-bootstrap-" + crypto.sha256(patchesSecretName(cluster), 10)

fn config(cluster: clusterConfig.ClusterAPIConfig) -> capi.ControlPlaneConfig = identity(cluster) with:
  bootstrapConfigName: bootstrapConfigName(cluster)
  machineTemplateName: machineTemplateName(cluster)
  patchesName: patchesSecretName(cluster)
  clusterName: cluster.name
  namespace: cluster.namespace
  kubernetesVersion: cluster.kubernetesVersion
  replicas: cluster.controlPlaneMachineCount
  endpointHost: "192.168.4.11"
  endpointPort: 6443
  podCIDR: "10.244.0.0/16"
  serviceCIDR: "10.96.0.0/12"

export fn resources(cluster: clusterConfig.ClusterAPIConfig) -> List<Map<String, Any>>:
  let settings = config(cluster)
  [
    capi.bootstrapConfigTemplate(settings),
    capi.clusterResource(settings),
    capi.tartControlPlane(settings),
    capi.tartMachineTemplate(settings),
    capi.patchSecret(settings),
    capi.tartCluster(settings),
  ]
