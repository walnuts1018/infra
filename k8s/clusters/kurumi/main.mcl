import "./tart-hosts.mcl" as tartHosts
import "./control-plane.mcl" as controlPlane
import "./worker.mcl" as worker
import "./argocd-agent-bootstrap.mcl" as argocdAgentBootstrap
import "../../namespaces/kurumi/resources.mcl" as namespaces
import "../../cluster.mcl" as clusterConfig
param cluster: clusterConfig.ClusterAPIConfig

rule validClusterAPIConfig(cluster: clusterConfig.ClusterAPIConfig):
  require cluster.controlPlaneMachineCount >= 1 message "Cluster API requires at least one control plane machine"
  require cluster.workerMachineCount >= 0 message "Cluster API worker machine count must not be negative"

emit each tartHosts.resources.items
emit tartHosts.resources.redfishSecret
emit each namespaces.resources
emit each controlPlane.resources(cluster)
emit each worker.resources(cluster)
emit each argocdAgentBootstrap.resources

validate cluster using validClusterAPIConfig
