export let oidc = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: "argocd-oidc"
    namespace: "argocd"
    labels:
      "app.kubernetes.io/part-of": "argocd"
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: "argocd-oidc"
    data:
      - secretKey: "client-secret"
        remoteRef:
          key: "argocd-oidc"
          property: "client-secret"
      - secretKey: "cli-client-id"
        remoteRef:
          key: "terraform-external-secrets"
          property: "argocd-cli-client-id"

export let notifications = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: "argocd-notifications-secret"
    namespace: "argocd"
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: "argocd-notifications-secret"
      template:
        engineVersion: "v2"
        type: "Opaque"
    data:
      - secretKey: "slack-token"
        remoteRef:
          key: "argocd"
          property: "slack-token"
      - secretKey: "cloudflare-api-token"
        remoteRef:
          key: "cloudflare"
          property: "argocd-webhook"
