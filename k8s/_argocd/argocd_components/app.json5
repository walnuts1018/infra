// このApplicationはArgo CD自体をブートストラップするため、apps-berry ApplicationSetの
// 走査対象(k8s/apps/*/app.json5)には含まれず、k8s/_argocd/applications/berry/argocd.yaml
// にハンドライトされている。値を変更する場合はargocd.yamlも合わせて更新すること。
{
  name: "argocd",
  namespace: "argocd",
  additionalSources: {
    helm: {
      repoURL: "https://argoproj.github.io/argo-helm",
      chart: "argo-cd",
      targetRevision: "10.8.2",
      valueFiles: [
        "values.yaml",
      ],
    },
  },
}
