import text "../_templates/apps-biscuit.gotmpl" as appsTemplatePatch
import "../common.mcl" as common

let agentLabel =
  "argocd-agent": "true"
let standardSyncOptions =
  - "ServerSideApply=true"
  - "FailOnSharedResource=true"
let appSetSyncOptions =
  - "ServerSideApply=true"
  - "FailOnSharedResource=true"
  - "CreateNamespace=true"
let destination =
  name: "biscuit"
  namespace: "argocd"
let appDestination =
  name: "biscuit"
let enabledElement =
  "biscuitEnabled": "{{ hasKey (default dict .clusters) \"biscuit\" }}"
let selector =
  "biscuitEnabled": "true"
let appsGenerator = common.applicationGenerator(enabledElement, selector)
let spokeSource = common.mclSource("k8s/_argocd/spoke")
let cmpSource = common.mclSource("k8s/_argocd/cmp")
let spokeSources =
  - cmpSource
  - spokeSource
let emptySources: List<Map<String, Any>> = []
let apps = node:
  apiVersion: common.apiVersion
  kind: "ApplicationSet"
  metadata: common.metadataNoLabels("apps-biscuit")
  spec:
    goTemplate: true
    goTemplateOptions:
      - "missingkey=error"
    generators:
      - appsGenerator
    template:
      metadata: common.appTemplateMetadataWithLabels("biscuit", agentLabel)
      spec:
        project: "biscuit"
        destination:
          name: "biscuit"
          namespace: "{{.namespace}}"
        sources: emptySources
        syncPolicy: common.syncPolicy(appSetSyncOptions)
    templatePatch: appsTemplatePatch
let agent = common.application(
  "argocd-agent-biscuit",
  "biscuit",
  destination,
  common.mclSource("k8s/_argocd/agent/agent"),
  agentLabel,
  standardSyncOptions,
)
let namespaces = common.application(
  "namespaces-biscuit",
  "biscuit",
  appDestination,
  common.mclSource("k8s/namespaces/biscuit"),
  agentLabel,
  standardSyncOptions,
)
let spoke = common.multiSourceApplication(
  "argocd-spoke-biscuit",
  "biscuit",
  destination,
  spokeSources,
  agentLabel,
  standardSyncOptions,
)

export let resources: List<Map<String, Any>> =
  - agent
  - apps
  - namespaces
  - spoke
