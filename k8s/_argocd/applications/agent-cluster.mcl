import text "./_templates/apps.gotmpl" as appsTemplatePatch
import "./common.mcl" as common

export type AgentClusterConfig =
  name: String
  project: String
  destinationName: String
  namespaceSourcePath: String

let agentLabel =
  "argocd-agent": "true"
let standardSyncOptions =
  - "ServerSideApply=true"
  - "FailOnSharedResource=true"
let appSetSyncOptions =
  - "ServerSideApply=true"
  - "FailOnSharedResource=true"
  - "CreateNamespace=true"
let emptySources: List<Map<String, Any>> = []

fn destination(config: AgentClusterConfig) -> Map<String, Any> = node:
  name: config.destinationName
  namespace: common.argocdNamespace

fn appDestination(config: AgentClusterConfig) -> Map<String, Any> = node:
  name: config.destinationName

fn applicationSet(config: AgentClusterConfig) -> Map<String, Any> = node:
  apiVersion: common.apiVersion
  kind: "ApplicationSet"
  metadata: common.metadataNoLabels("apps-" + config.name)
  spec:
    goTemplate: true
    goTemplateOptions:
      - "missingkey=error"
    generators:
      - common.applicationGenerator(config.name)
    template:
      metadata: common.appTemplateMetadataWithLabels(config.name, agentLabel)
      spec:
        project: config.project
        destination:
          name: config.destinationName
          namespace: "{{.namespace}}"
        sources: emptySources
        syncPolicy: common.syncPolicy(appSetSyncOptions)
    templatePatch: appsTemplatePatch

fn agentApplication(config: AgentClusterConfig) -> Map<String, Any> =
  common.application(
    name = "argocd-agent-" + config.name,
    project = config.project,
    destination = destination(config),
    source = common.mclSource("k8s/_argocd/agent/agent", config.name),
    labels = agentLabel,
    syncOptions = standardSyncOptions,
  )

fn namespacesApplication(config: AgentClusterConfig) -> Map<String, Any> =
  common.application(
    name = "namespaces-" + config.name,
    project = config.project,
    destination = appDestination(config),
    source = common.mclSource(config.namespaceSourcePath, config.name),
    labels = agentLabel,
    syncOptions = standardSyncOptions,
  )

fn spokeSources(config: AgentClusterConfig) -> List<Map<String, Any>> =
  - common.mclSource("k8s/_argocd/cmp", config.name)
  - common.mclSource("k8s/_argocd/spoke", config.name)

fn spokeApplication(config: AgentClusterConfig) -> Map<String, Any> =
  common.multiSourceApplication(
    name = "argocd-spoke-" + config.name,
    project = config.project,
    destination = destination(config),
    sources = spokeSources(config),
    labels = agentLabel,
    syncOptions = standardSyncOptions,
  )

export fn resources(config: AgentClusterConfig) -> List<Map<String, Any>> =
  - agentApplication(config)
  - applicationSet(config)
  - namespacesApplication(config)
  - spokeApplication(config)
