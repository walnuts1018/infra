spec:
  {{- with (dig "clusters" "kurumi" "namespace" "" .) }}
  destination:
    namespace: '{{ . }}'
  {{- end }}
  sources:
  - repoURL: 'https://github.com/walnuts1018/infra'
    targetRevision: clusterapi
    path: '{{.path.path}}'
    {{- if ne (dig "manifestGenerator" "" .) "jsonnet" }}
    plugin:
      name: mcl
      {{- $cluster := dig "clusters" "kurumi" (dict) . }}
      {{- $features := dig "features" nil $cluster }}
      {{- $settings := dig "settings" nil $cluster }}
      {{- if or $features $settings }}
      env:
      {{- with $features }}
      - name: MCL_FEATURES
        value: {{ toJson . | quote }}
      {{- end }}
      {{- with $settings }}
      - name: MCL_SETTINGS
        value: {{ toJson . | quote }}
      {{- end }}
      {{- end }}
    {{- else }}
    directory:
      recurse: true
      exclude: '{config/*,_*/*,values*.yaml}'
      jsonnet:
        tlas:
        {{- range $tla := dig "clusters" "kurumi" "jsonnet" "tlas" (list) . }}
        - {{ $tla | toJson }}
        {{- end }}
        extVars:
        {{- range $extVar := dig "clusters" "kurumi" "jsonnet" "extVars" (list) . }}
        - {{ $extVar | toJson }}
        {{- end }}
    ref: infra
    {{- end }}
  {{- if eq (dig "manifestGenerator" "" .) "jsonnet" }}
  {{- with (dig "additionalSources" "helm" (dict) .) }}
  - repoURL: '{{ .repoURL }}'
    chart: '{{ .chart }}'
    targetRevision: '{{ .targetRevision }}'
    helm:
      releaseName: '{{ $.name }}'
      valueFiles:
      {{- range (dig "valueFiles" (list) .) }}
      - {{ printf "$infra/%s/%s" $.path.path . }}
      {{- end }}
      {{- with (dig "clusters" "kurumi" "additionalSources" "helm" "additionalValueFiles" (list) $) }}
      {{- range . }}
      - {{ printf "$infra/%s/%s" $.path.path . }}
      {{- end }}
      {{- end }}
  {{- end }}
  {{- range (dig "additionalSources" "kustomize" (list) .) }}
  - repoURL: '{{ .repoURL }}'
    path: '{{ .path }}'
    targetRevision: '{{ .targetRevision }}'
    {{- with (dig "patches" (list) .) }}
    kustomize:
      patches: {{ . | toJson }}
    {{- end }}
  {{- end }}
  {{- end }}
{{- with (dig "annotations" (dict) .) }}
metadata:
  annotations:
    {{- range $key, $value := . }}
    {{ $key }}: {{ $value | quote }}
    {{- end }}
{{- end }}
