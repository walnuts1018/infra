import "std:helm" as helm
import "./chart.mcl" as appChart

type HelmOptions =
  releaseName: String
  namespace: String
  version: String
  kubeVersion: String
  apiVersions: List<String>
  values: Map<String, Any>

let apiVersions: List<String> = []
let baseOptions =
  releaseName: "valkey-operator"
  version: appChart.chartVersion
  kubeVersion: appChart.kubeVersion
  apiVersions: apiVersions

fn options(namespace: String, values: Map<String, Any>) -> HelmOptions = baseOptions with:
  namespace: namespace
  values: values

export fn render(namespace: String, values: Map<String, Any>) -> Any = helm.render(appChart.chartArchive, options(namespace, values))
