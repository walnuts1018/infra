import text "./_configs/snmp.yml" as snmpConfig

let commonValues: Map<String, Any> =
  tolerations:
    - key: "node.walnuts.dev/low-performance"
      operator: "Exists"
  serviceMonitor:
    enabled: true
    params:
      - name: "ix2215"
        target: "192.168.0.1"
        module:
          - "nec_ix"
  config: snmpConfig

export let profiles =
  ix2215: commonValues
