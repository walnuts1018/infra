import "std:list" as lists
import "./external-secrets.mcl" as externalSecrets
import text "../../../apps/akvorado/_configs/akvorado.yaml" as akvoradoConfigText
import text "../../../apps/akvorado/_configs/inlet.yaml" as inletConfigText
import text "../../../apps/akvorado/_configs/outlet.yaml" as outletConfigText
import text "../../../apps/akvorado/_configs/console.yaml" as consoleConfigText

let namespace = "akvorado"
let appName = "akvorado"
let syncOptions = "SkipDryRunOnMissingResource=true"
let appLabels =
  app: appName
  "app.kubernetes.io/name": appName
let emptyMounts: List<Map<String, Any>> = []
let emptyVolumes: List<Map<String, Any>> = []

fn componentLabels(component: String) -> Map<String, String> = node:
  app: appName
  "app.kubernetes.io/name": appName
  "app.kubernetes.io/component": component

fn deployment(name: String, component: String, podSpec: Map<String, Any>) -> Map<String, Any> = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    name: name
    namespace: namespace
    labels: appLabels
  spec:
    replicas: 1
    selector:
      matchLabels:
        "app.kubernetes.io/name": appName
        "app.kubernetes.io/component": component
    template:
      metadata:
        labels: componentLabels(component)
      spec: podSpec

fn service(name: String, component: String, ports: List<Map<String, Any>>) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    name: name
    namespace: namespace
    labels: componentLabels(component)
  spec:
    selector:
      "app.kubernetes.io/name": appName
      "app.kubernetes.io/component": component
    ports: ports

type MonitoredComponent =
  name: String
  component: String

fn serviceMonitor(target: MonitoredComponent) -> Map<String, Any> = node:
  apiVersion: "monitoring.coreos.com/v1"
  kind: "ServiceMonitor"
  metadata:
    name: target.name
    namespace: namespace
    labels: componentLabels(target.component)
  spec:
    namespaceSelector:
      matchNames:
        - namespace
    selector:
      matchLabels:
        "app.kubernetes.io/name": appName
        "app.kubernetes.io/component": target.component
    endpoints:
      - port: "http"
        path: "/api/v0/metrics"

fn appContainer(name: String, args: List<String>, ports: List<Map<String, Any>>, mounts: List<Map<String, Any>>, resources: Map<String, Any>) -> Map<String, Any> = node:
  name: name
  image: "quay.io/akvorado/akvorado:2.4.1"
  args: args
  ports: ports
  volumeMounts: mounts
  resources: resources
  livenessProbe:
    httpGet:
      path: "/api/v0/healthcheck"
      port: 8080
    initialDelaySeconds: 30
    periodSeconds: 30
  readinessProbe:
    httpGet:
      path: "/api/v0/healthcheck"
      port: 8080
    initialDelaySeconds: 10
    periodSeconds: 10

let consoleContainerPorts =
  - name: "http"
    containerPort: 8080
    protocol: "TCP"
let inletContainerPorts =
  - name: "http"
    containerPort: 8080
    protocol: "TCP"
  - name: "netflow"
    containerPort: 2055
    protocol: "UDP"
  - name: "sflow"
    containerPort: 6343
    hostPort: 6343
    protocol: "UDP"
let httpContainerPorts =
  - name: "http"
    containerPort: 8080
    protocol: "TCP"
let consoleResources =
  requests:
    cpu: "2m"
    memory: "15Mi"
  limits:
    cpu: "500m"
    memory: "512Mi"
let inletResources =
  requests:
    cpu: "2m"
    memory: "14Mi"
  limits:
    cpu: "2"
    memory: "1Gi"
let outletResources =
  requests:
    cpu: "10m"
    memory: "32Mi"
  limits:
    memory: "256Mi"
let orchestratorResources =
  requests:
    cpu: "2m"
    memory: "11Mi"
  limits:
    cpu: "500m"
    memory: "256Mi"
let consoleArgs =
  - "console"
  - "http://akvorado-orchestrator:8080"
let inletArgs =
  - "inlet"
  - "http://akvorado-orchestrator:8080"
let outletArgs =
  - "outlet"
  - "--debug"
  - "http://akvorado-orchestrator:8080"
let orchestratorArgs =
  - "orchestrator"
  - "/etc/akvorado/akvorado.yaml"
let consoleContainer = appContainer(
  "console",
  consoleArgs,
  consoleContainerPorts,
  emptyMounts,
  consoleResources,
  )
let consolePodSpec =
  containers:
    - consoleContainer
  volumes: emptyVolumes
let inletContainer = appContainer(
  "inlet",
  inletArgs,
  inletContainerPorts,
  emptyMounts,
  inletResources,
  )
let inletPodSpec =
  containers:
    - inletContainer
  volumes: emptyVolumes
  nodeSelector:
    "kubernetes.io/hostname": "cake"
let outletContainer = appContainer(
  "outlet",
  outletArgs,
  httpContainerPorts,
  emptyMounts,
  outletResources,
  )
let outletPodSpec =
  containers:
    - outletContainer
  volumes: emptyVolumes
let orchestratorMounts =
  - name: "config"
    mountPath: "/etc/akvorado/akvorado.yaml"
    subPath: "akvorado.yaml"
    readOnly: true
  - name: "config"
    mountPath: "/etc/akvorado/inlet.yaml"
    subPath: "inlet.yaml"
    readOnly: true
  - name: "config"
    mountPath: "/etc/akvorado/outlet.yaml"
    subPath: "outlet.yaml"
    readOnly: true
  - name: "config"
    mountPath: "/etc/akvorado/console.yaml"
    subPath: "console.yaml"
    readOnly: true
  - name: "snmp-config"
    mountPath: "/etc/akvorado/snmp.yaml"
    subPath: "snmp.yaml"
    readOnly: true
let orchestratorVolumes =
  - name: "config"
    configMap:
      name: "akvorado-config-8a4b55"
  - name: "snmp-config"
    secret:
      secretName: externalSecrets.snmpName
let orchestratorContainer = appContainer(
  "orchestrator",
  orchestratorArgs,
  httpContainerPorts,
  orchestratorMounts,
  orchestratorResources,
  )
let orchestratorPodSpec =
  containers:
    - orchestratorContainer
  volumes: orchestratorVolumes

let configMapData =
  "akvorado.yaml": akvoradoConfigText
  "inlet.yaml": inletConfigText
  "outlet.yaml": outletConfigText
  "console.yaml": consoleConfigText

let configMap = node:
  apiVersion: "v1"
  kind: "ConfigMap"
  immutable: true
  metadata:
    name: "akvorado-config-8a4b55"
    namespace: namespace
    labels:
      app: "akvorado-config"
      "app.kubernetes.io/name": "akvorado-config"
  data: configMapData

let avoidSlowNodeAffinity =
  nodeAffinity:
    requiredDuringSchedulingIgnoredDuringExecution:
      nodeSelectorTerms:
        -
          matchExpressions:
            - key: "storage.walnuts.dev/slow"
              operator: "DoesNotExist"

let keeperCluster = node:
  apiVersion: "clickhouse.com/v1alpha1"
  kind: "KeeperCluster"
  metadata:
    name: "akvorado-keeper"
    namespace: namespace
    annotations:
      "argocd.argoproj.io/sync-options": syncOptions
    labels:
      app: "akvorado-keeper"
      "app.kubernetes.io/name": "akvorado-keeper"
  spec:
    replicas: 1
    containerTemplate:
      resources:
        requests:
          cpu: "15m"
          memory: "116Mi"
    dataVolumeClaimSpec:
      accessModes:
        - "ReadWriteOnce"
      resources:
        requests:
          storage: "5Gi"
    podTemplate:
      affinity: avoidSlowNodeAffinity

let clickHouseCluster = node:
  apiVersion: "clickhouse.com/v1alpha1"
  kind: "ClickHouseCluster"
  metadata:
    name: "akvorado-clickhouse"
    namespace: namespace
    annotations:
      "argocd.argoproj.io/sync-options": syncOptions
    labels:
      app: "akvorado-clickhouse"
      "app.kubernetes.io/name": "akvorado-clickhouse"
  spec:
    keeperClusterRef:
      name: "akvorado-keeper"
    replicas: 1
    dataVolumeClaimSpec:
      accessModes:
        - "ReadWriteOnce"
      resources:
        requests:
          storage: "32Gi"
    podTemplate:
      affinity: avoidSlowNodeAffinity
    containerTemplate:
      resources:
        requests:
          cpu: "90m"
          memory: "650Mi"
        limits:
          memory: "4Gi"

let kafka = node:
  apiVersion: "kafka.strimzi.io/v1"
  kind: "Kafka"
  metadata:
    name: "akvorado-kafka"
    namespace: namespace
    annotations:
      "argocd.argoproj.io/sync-options": syncOptions
      "strimzi.io/node-pools": "enabled"
    labels:
      app: "akvorado-kafka"
      "app.kubernetes.io/name": "akvorado-kafka"
  spec:
    kafka:
      version: "4.3.0"
      listeners:
        - name: "plain"
          port: 9092
          type: "internal"
          tls: false
      config:
        "offsets.topic.replication.factor": 1
        "transaction.state.log.replication.factor": 1
        "transaction.state.log.min.isr": 1
        "default.replication.factor": 1
        "min.insync.replicas": 1
    entityOperator:
      topicOperator:
        resources:
          requests:
            cpu: "4m"
            memory: "200Mi"
          limits:
            cpu: "500m"
            memory: "1Gi"
      userOperator:
        resources:
          requests:
            cpu: "5m"
            memory: "200Mi"
          limits:
            cpu: "500m"
            memory: "1Gi"

let kafkaNodePool = node:
  apiVersion: "kafka.strimzi.io/v1"
  kind: "KafkaNodePool"
  metadata:
    name: "akvorado-kafka-pool"
    namespace: namespace
    labels:
      app: "akvorado-kafka-pool"
      "app.kubernetes.io/name": "akvorado-kafka-pool"
      "strimzi.io/cluster": "akvorado-kafka"
    annotations:
      "argocd.argoproj.io/sync-options": syncOptions
  spec:
    replicas: 1
    roles:
      - "broker"
      - "controller"
    storage:
      type: "persistent-claim"
      size: "10Gi"
      deleteClaim: false
    resources:
      requests:
        cpu: "17m"
        memory: "1.5Gi"
      limits:
        memory: "2Gi"
    template:
      pod:
        affinity: avoidSlowNodeAffinity

let kafkaTopic = node:
  apiVersion: "kafka.strimzi.io/v1"
  kind: "KafkaTopic"
  metadata:
    name: "flows-v5"
    namespace: namespace
    annotations:
      "argocd.argoproj.io/sync-options": syncOptions
    labels:
      app: "akvorado-kafka-topic"
      "app.kubernetes.io/name": "akvorado-kafka-topic"
      "strimzi.io/cluster": "akvorado-kafka"
  spec:
    partitions: 2
    replicas: 1
    config:
      "retention.ms": 604800000
      "segment.bytes": 1073741824

let valkeyCluster = node:
  apiVersion: "valkey.io/v1alpha1"
  kind: "ValkeyCluster"
  metadata:
    name: "akvorado-valkey"
    namespace: namespace
    annotations:
      "argocd.argoproj.io/sync-options": syncOptions
    labels:
      app: "akvorado-valkey"
      "app.kubernetes.io/name": "akvorado-valkey"
  spec:
    shards: 1
    replicas: 1
    resources:
      requests:
        cpu: "6m"
        memory: "13Mi"
      limits:
        cpu: "500m"
        memory: "256Mi"

let httpRoute = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "HTTPRoute"
  metadata:
    name: "akvorado"
    namespace: namespace
    annotations:
      "argocd.argoproj.io/sync-options": syncOptions
  spec:
    parentRefs:
      - name: "envoy-gateway"
        namespace: "envoy-gateway-system"
    hostnames:
      - "akvorado.walnuts.dev"
    rules:
      -
        backendRefs:
          -
            kind: "Service"
            name: "akvorado-console"
            port: 8080
            weight: 1

let securityPolicy = node:
  apiVersion: "gateway.envoyproxy.io/v1alpha1"
  kind: "SecurityPolicy"
  metadata:
    name: "akvorado"
    namespace: namespace
  spec:
    targetRefs:
      - group: "gateway.networking.k8s.io"
        kind: "HTTPRoute"
        name: "akvorado"
    oidc:
      provider:
        issuer: "https://auth.walnuts.dev"
      clientIDRef:
        name: externalSecrets.credentialName
      clientSecret:
        name: externalSecrets.credentialName
      scopes:
        - "openid"
        - "email"
        - "profile"
        - "offline_access"
        - "urn:zitadel:iam:org:projects:roles"
      forwardAccessToken: true
      logoutPath: "/oauth2/logout"
    jwt:
      providers:
        - name: "zitadel"
          issuer: "https://auth.walnuts.dev"
          remoteJWKS:
            uri: "https://auth.walnuts.dev/oauth/v2/keys"
    authorization:
      defaultAction: "Deny"
      rules:
        - action: "Allow"
          principal:
            jwt:
              provider: "zitadel"
              claims:
                - name: "my:zitadel:grants"
                  valueType: "StringArray"
                  values:
                    - "385243484086337737:akvorado-admin"

let componentNames =
  - name: "akvorado-console"
    component: "console"
  - name: "akvorado-inlet"
    component: "inlet"
  - name: "akvorado-outlet"
    component: "outlet"
  - name: "akvorado-orchestrator"
    component: "orchestrator"
let httpServicePorts =
  - name: "http"
    port: 8080
    targetPort: 8080
    protocol: "TCP"
let inletServicePorts =
  - name: "http"
    port: 8080
    targetPort: 8080
    protocol: "TCP"
  - name: "netflow"
    port: 2055
    targetPort: 2055
    protocol: "UDP"
  - name: "sflow"
    port: 6343
    targetPort: 6343
    protocol: "UDP"
let consoleDeployment = deployment("akvorado-console", "console", consolePodSpec)
let inletDeployment = deployment("akvorado-inlet", "inlet", inletPodSpec)
let outletDeployment = deployment("akvorado-outlet", "outlet", outletPodSpec)
let orchestratorDeployment = deployment("akvorado-orchestrator", "orchestrator", orchestratorPodSpec)
let consoleService = service("akvorado-console", "console", httpServicePorts)
let inletService = service("akvorado-inlet", "inlet", inletServicePorts)
let outletService = service("akvorado-outlet", "outlet", httpServicePorts)
let orchestratorService = service("akvorado-orchestrator", "orchestrator", httpServicePorts)
let componentServiceMonitors = lists.map(componentNames, serviceMonitor)

emit configMap
emit externalSecrets.credentials
emit externalSecrets.snmp
emit keeperCluster
emit clickHouseCluster
emit kafka
emit kafkaNodePool
emit kafkaTopic
emit valkeyCluster
emit httpRoute
emit securityPolicy
emit consoleDeployment
emit inletDeployment
emit outletDeployment
emit orchestratorDeployment
emit consoleService
emit inletService
emit outletService
emit orchestratorService
emit each componentServiceMonitors
