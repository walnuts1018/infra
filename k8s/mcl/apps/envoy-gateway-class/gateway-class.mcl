import "./settings.mcl" as appChart

export let resource = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "GatewayClass"
  metadata:
    name: "envoy-gateway"
  spec:
    controllerName: "gateway.envoyproxy.io/gatewayclass-controller"
    parametersRef:
      group: "gateway.envoyproxy.io"
      kind: "EnvoyProxy"
      name: "custom-config"
      namespace: appChart.namespace
