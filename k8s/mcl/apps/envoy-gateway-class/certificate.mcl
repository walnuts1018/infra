import "./settings.mcl" as appChart

export let resource = node:
  apiVersion: "cert-manager.io/v1"
  kind: "Certificate"
  metadata:
    name: "envoy-gateway"
    namespace: appChart.namespace
  spec:
    dnsNames:
      - "*.local.walnuts.dev"
      - "*.seaweedfs.local.walnuts.dev"
      - "*.seaweedfs.walnuts.dev"
      - "*.walnuts.dev"
      - "walnuts.dev"
      - "*.waln.uk"
    issuerRef:
      group: "cert-manager.io"
      kind: "ClusterIssuer"
      name: "letsencrypt-prod"
    secretName: "envoy-gateway-cert"
