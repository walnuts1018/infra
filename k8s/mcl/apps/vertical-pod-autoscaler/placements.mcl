export type NamedDestination =
  kind: "name"
  name: String
  namespace: String

export type ServerDestination =
  kind: "server"
  server: String
  namespace: String

export type Destination = NamedDestination | ServerDestination

export type Placement =
  target: String
  cluster: String
  entrypoint: String
  destination: Destination
  profile: String

export let placements: Map<String, Placement> =
  kurumi:
    target: "kurumi"
    cluster: "kurumi"
    entrypoint: "k8s/mcl/apps/vertical-pod-autoscaler/main.mcl"
    destination:
      kind: "name"
      name: "kurumi"
      namespace: "kube-system"
    profile: "standard"
