import "./chart.mcl" as appChart

export type NamedDestination =
  kind: "name"
  name: String
  namespace: String

export type ServerDestination =
  kind: "server"
  server: String
  namespace: String

export type Destination = NamedDestination | ServerDestination

export type Deployment =
  target: String
  cluster: String
  entrypoint: String
  destination: Destination
  profile: String

export let deployments: Map<String, Deployment> =
  kurumi:
    target: "kurumi"
    cluster: "kurumi"
    entrypoint: "k8s/mcl/apps/external-secrets/main.mcl"
    destination:
      kind: "name"
      name: "kurumi"
      namespace: appChart.namespace
    profile: "standard"
  biscuit:
    target: "biscuit"
    cluster: "biscuit"
    entrypoint: "k8s/mcl/apps/external-secrets/main.mcl"
    destination:
      kind: "name"
      name: "biscuit"
      namespace: appChart.namespace
    profile: "standard"
  berry:
    target: "berry"
    cluster: "berry"
    entrypoint: "k8s/mcl/apps/external-secrets/main.mcl"
    destination:
      kind: "server"
      server: "https://kubernetes.default.svc"
      namespace: appChart.namespace
    profile: "standard"
