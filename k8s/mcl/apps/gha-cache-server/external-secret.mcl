export let resource = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: "gha-cache-server"
    namespace: "arc-systems"
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: "gha-cache-server"
      template:
        engineVersion: "v2"
        type: "Opaque"
    data:
      - secretKey: "db_password"
        remoteRef:
          key: "postgres_passwords"
          property: "gha_cache_server"
