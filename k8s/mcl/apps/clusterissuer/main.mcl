export type AcmeIssuerConfig =
  name: String
  server: String

let externalSecretName = "cloudflare-api-token-fb60a7"
let localCertificateName = "local-ca-cert"
let localCertificateSecretName = "local-ca-secret"

let externalSecret = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: externalSecretName
  spec:
    data:
      -
        remoteRef:
          key: "cert-manager"
          property: "cloudflare_api_token"
        secretKey: "api-token"
    refreshInterval: "1m"
    secretStoreRef:
      kind: "ClusterSecretStore"
      name: "onepassword"
    target:
      name: externalSecretName
      template:
        engineVersion: "v2"
        type: "Opaque"

fn acmeIssuer(config: AcmeIssuerConfig) -> Map<String, Any> = node:
  apiVersion: "cert-manager.io/v1"
  kind: "ClusterIssuer"
  metadata:
    name: config.name
  spec:
    acme:
      server: config.server
      email: "r.juglans.1018@gmail.com"
      privateKeySecretRef:
        name: config.name
      solvers:
        -
          dns01:
            cloudflare:
              apiTokenSecretRef:
                name: externalSecretName
                key: "api-token"

let productionConfig: AcmeIssuerConfig =
  name: "letsencrypt-prod"
  server: "https://acme-v02.api.letsencrypt.org/directory"
let productionIssuer = acmeIssuer(productionConfig)

let stagingConfig: AcmeIssuerConfig =
  name: "letsencrypt-stg"
  server: "https://acme-staging-v02.api.letsencrypt.org/directory"
let stagingIssuer = acmeIssuer(stagingConfig)

let localBundle = node:
  apiVersion: "trust.cert-manager.io/v1alpha1"
  kind: "Bundle"
  metadata:
    name: "local-ca-bundle"
    namespace: "cert-manager"
  spec:
    sources:
      -
        useDefaultCAs: true
      -
        secret:
          name: localCertificateSecretName
          key: "tls.crt"
    target:
      configMap:
        key: "trust-bundle.pem"

let localCertificate = node:
  apiVersion: "cert-manager.io/v1"
  kind: "Certificate"
  metadata:
    name: localCertificateName
    namespace: "cert-manager"
  spec:
    isCA: true
    commonName: "operator"
    secretName: localCertificateSecretName
    duration: "70128h"
    privateKey:
      algorithm: "ECDSA"
      size: 256
    issuerRef:
      name: "selfsigned"
      kind: "ClusterIssuer"
      group: "cert-manager.io"

let localIssuer = node:
  apiVersion: "cert-manager.io/v1"
  kind: "ClusterIssuer"
  metadata:
    name: "local"
  spec:
    ca:
      secretName: localCertificateSecretName

let selfSignedIssuer = node:
  apiVersion: "cert-manager.io/v1"
  kind: "ClusterIssuer"
  metadata:
    name: "selfsigned"
  spec:
    selfSigned: {}

emit externalSecret
emit productionIssuer
emit stagingIssuer
emit localBundle
emit localCertificate
emit localIssuer
emit selfSignedIssuer
