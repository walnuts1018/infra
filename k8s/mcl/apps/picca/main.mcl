let resource37 = node:
  apiVersion: "valkey.io/v1alpha1"
  kind: "ValkeyCluster"
  metadata:
    annotations:
      "argocd.argoproj.io/sync-options": "SkipDryRunOnMissingResource=true"
    labels:
      app: "picca-valkey"
      "app.kubernetes.io/name": "picca-valkey"
    name: "picca-valkey"
    namespace: appProfile.namespace
  spec:
    replicas: 2
    resources:
      limits:
        cpu: "1"
        memory: "1Gi"
      requests:
        cpu: "5m"
        memory: "5Mi"
    scheduling:
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              -
                matchExpressions:
                  -
                    key: "storage.walnuts.dev/slow"
                    operator: "DoesNotExist"
    shards: 1
    users:
      -
        enabled: true
        name: "default"
        passwordSecret:
          keys:
            - "valkey_password"
          name: "picca-valkey-ee0a97"
        permissions: "+@all ~* &*"

let resource38 = node:
  apiVersion: "external-secrets.io/v1"
