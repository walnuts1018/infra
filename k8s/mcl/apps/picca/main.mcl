import "std:context" as context
import "./profiles.mcl" as appProfiles
import text "./_configs/plans.yaml" as plansConfig
import text "./_configs/scylla-ca.crt" as scyllaCaCertificate

let appProfile = appProfiles.profiles[context.parameter("profile")]
let emptyMap: Map<String, Any> = {}

let resource0 = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    labels:
      app: "picca-caption-service"
      "app.kubernetes.io/name": "picca-caption-service"
    name: "picca-caption-service"
    namespace: appProfile.namespace
  spec:
    replicas: 1
    selector:
      matchLabels:
        app: "picca-caption-service"
        "app.kubernetes.io/name": "picca-caption-service"
    template:
      metadata:
        labels:
          app: "picca-caption-service"
          "app.kubernetes.io/name": "picca-caption-service"
      spec:
        containers:
          -
            command:
              - "python"
              - "scripts/run_caption_service.py"
            env:
              -
                name: "PORT"
                value: "8004"
              -
                name: "MODEL_DEVICE"
                value: "cpu"
              -
                name: "FLORENCE2_MODEL_NAME"
                value: "/models/Florence-2-base-ft"
              -
                name: "TRANSLATE_MODEL_NAME"
                value: "/models/CAT-Translate-0.8b"
            image: "ghcr.io/walnuts1018/picca/ai-services:v0.0.49"
            imagePullPolicy: "IfNotPresent"
            livenessProbe:
              failureThreshold: 3
              httpGet:
                path: "/healthz"
                port: "http"
              periodSeconds: 10
            name: "caption-service"
            ports:
              -
                containerPort: 8004
                name: "http"
            readinessProbe:
              failureThreshold: 3
              httpGet:
                path: "/healthz"
                port: "http"
              periodSeconds: 10
            resources:
              limits:
                cpu: "4"
                memory: "6Gi"
              requests:
                cpu: "1"
                memory: "2Gi"
            securityContext:
              allowPrivilegeEscalation: false
              capabilities:
                add:
                  - "NET_BIND_SERVICE"
                drop:
                  - "all"
              readOnlyRootFilesystem: false
              seccompProfile:
                type: "RuntimeDefault"
            volumeMounts:
              -
                mountPath: "/tmp"
                name: "tmp"
              -
                mountPath: "/models"
                name: "models"
                readOnly: true
        imagePullSecrets:
          -
            name: "ghcr-login-secret"
        securityContext:
          runAsGroup: 65532
          runAsNonRoot: true
          runAsUser: 65532
        serviceAccountName: "picca"
        volumes:
          -
            emptyDir: emptyMap
            name: "tmp"
          -
            image:
              pullPolicy: "IfNotPresent"
              reference: "ghcr.io/walnuts1018/picca/ai-models-caption:v0.0.1"
            name: "models"

let resource1 = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    labels:
      app: "picca-caption-service"
      "app.kubernetes.io/name": "picca-caption-service"
    name: "picca-caption-service"
    namespace: appProfile.namespace
  spec:
    ports:
      -
        name: "http"
        port: 8004
        targetPort: "http"
    selector:
      app: "picca-caption-service"
      "app.kubernetes.io/name": "picca-caption-service"
    type: "ClusterIP"

