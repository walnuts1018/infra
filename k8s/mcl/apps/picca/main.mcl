let resource50 = node:
  apiVersion: "keda.sh/v1alpha1"
  kind: "ScaledObject"
  metadata:
    name: "picca-stack-timeline-worker"
    namespace: appProfile.namespace
  spec:
    maxReplicaCount: 4
    minReplicaCount: 0
    pollingInterval: 5
    scaleTargetRef:
      name: "picca-stack-timeline-worker"
    triggers:
      -
        authenticationRef:
          name: "picca-rabbitmq-worker-auth"
        metadata:
          mode: "QueueLength"
          protocol: "http"
          queueName: "picca.stack-timeline"
          value: "4"
        metricType: "AverageValue"
        type: "rabbitmq"

