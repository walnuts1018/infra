import "./chart.mcl" as appChart

export type NamedDestination =
  kind: "name"
  name: String
  namespace: String

export type ServerDestination =
  kind: "server"
  server: String
  namespace: String

export type Destination = NamedDestination | ServerDestination

export type Placement =
  target: String
  cluster: String
  entrypoint: String
  destination: Destination
  profile: String

export let placements: Map<String, Placement> =
  kurumi:
    target: "kurumi"
    cluster: "kurumi"
    entrypoint: "k8s/mcl/apps/topolvm/main.mcl"
    destination:
      kind: "name"
      name: "kurumi"
      namespace: appChart.namespace
    profile: "monitoringHdd"
  biscuit:
    target: "biscuit"
    cluster: "biscuit"
    entrypoint: "k8s/mcl/apps/topolvm/main.mcl"
    destination:
      kind: "name"
      name: "biscuit"
      namespace: appChart.namespace
    profile: "ssdAndHdd"
