import "./placements.mcl" as app

let kurumi = app.placements.kurumi
let biscuit = app.placements.biscuit
let berry = app.placements.berry

let targets =
  - target: kurumi.target
    cluster: kurumi.cluster
    entrypoint: kurumi.entrypoint
    destination: kurumi.destination
    profile: kurumi.profile
  - target: biscuit.target
    cluster: biscuit.cluster
    entrypoint: biscuit.entrypoint
    destination: biscuit.destination
    profile: biscuit.profile
  - target: berry.target
    cluster: berry.cluster
    entrypoint: berry.entrypoint
    destination: berry.destination
    profile: berry.profile

emit each targets
