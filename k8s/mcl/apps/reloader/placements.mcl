export type NamedDestination =
  kind: "name"
  name: String
  namespace: String

export type ServerDestination =
  kind: "server"
  server: String
  namespace: String

export type Destination = NamedDestination | ServerDestination

export type Placement =
  target: String
  cluster: String
  entrypoint: String
  destination: Destination
  profile: String

export let placements: Map<String, Placement> =
  kurumi:
    target: "kurumi"
    cluster: "kurumi"
    entrypoint: "k8s/mcl/apps/reloader/main.mcl"
    destination:
      kind: "name"
      name: "kurumi"
      namespace: "reloader"
    profile: "standard"
  biscuit:
    target: "biscuit"
    cluster: "biscuit"
    entrypoint: "k8s/mcl/apps/reloader/main.mcl"
    destination:
      kind: "name"
      name: "biscuit"
      namespace: "reloader"
    profile: "standard"
  berry:
    target: "berry"
    cluster: "berry"
    entrypoint: "k8s/mcl/apps/reloader/main.mcl"
    destination:
      kind: "server"
      server: "https://kubernetes.default.svc"
      namespace: "reloader"
    profile: "argocdApplicationReload"
