export type Deployment =
  target: String
  cluster: String
  entrypoint: String
  destination: Map<String, String>
  values: Map<String, Any>

export let deployments: Map<String, Deployment> =
  kurumi:
    target: "kurumi"
    cluster: "kurumi"
    entrypoint: "k8s/mcl/apps/reloader/entrypoints/kurumi/main.mcl"
    destination:
      name: "kurumi"
      namespace: "reloader"
    values: {}
  biscuit:
    target: "biscuit"
    cluster: "biscuit"
    entrypoint: "k8s/mcl/apps/reloader/entrypoints/biscuit/main.mcl"
    destination:
      name: "biscuit"
      namespace: "reloader"
    values: {}
  berry:
    target: "berry"
    cluster: "berry"
    entrypoint: "k8s/mcl/apps/reloader/entrypoints/berry/main.mcl"
    destination:
      server: "https://kubernetes.default.svc"
      namespace: "reloader"
    values:
      reloader:
        autoReloadAll: true
        namespaceSelector: "kubernetes.io/metadata.name=argocd"
        reloadStrategy: "annotations"
