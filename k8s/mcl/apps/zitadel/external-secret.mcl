import "./chart.mcl" as appChart
import text "./_configs/config.yaml" as configYAML

export let name = "zitadel"

let labels =
  app: name
  "app.kubernetes.io/name": name

export let configMap = node:
  apiVersion: "v1"
  kind: "ConfigMap"
  metadata:
    name: name + "-config"
    namespace: appChart.namespace
    labels: labels
  data:
    "config.yaml": configYAML

export let resource = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: name
    namespace: appChart.namespace
    labels: labels
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: name
      template:
        engineVersion: "v2"
        type: "Opaque"
        templateFrom:
          - target: "Data"
            configMap:
              name: configMap.metadata.name
              items:
                -
                  key: "config.yaml"
                  templateAs: "Values"
        data:
          masterkey: "{{ .masterkey }}"
          postgres: "{{ .postgresdbpassword }}"
    data:
      -
        secretKey: "masterkey"
        remoteRef:
          key: "zitadel"
          property: "masterkey"
      -
        secretKey: "postgresdbpassword"
        remoteRef:
          key: "postgres_passwords"
          property: "postgres"
      -
        secretKey: "zitadeldbpassword"
        remoteRef:
          key: "postgres_passwords"
          property: "zitadel"

export let pdb = node:
  apiVersion: "policy/v1"
  kind: "PodDisruptionBudget"
  metadata:
    name: name
    namespace: appChart.namespace
    labels: labels
  spec:
    minAvailable: 1
    selector:
      matchLabels: labels

export let scaledObject = node:
  apiVersion: "keda.sh/v1alpha1"
  kind: "ScaledObject"
  metadata:
    name: name
    namespace: appChart.namespace
    labels: labels
  spec:
    minReplicaCount: 2
    maxReplicaCount: 4
    scaleTargetRef:
      apiVersion: "apps/v1"
      kind: "Deployment"
      name: "zitadel"
    triggers:
      -
        type: "prometheus"
        metadata:
          serverAddress: "http://victoria-metrics-victoria-metrics-cluster-vmselect.victoria-metrics.svc.cluster.local:8481/select/0/prometheus"
          metricName: "http_server_request_count_total_zitadel"
          query: "sum(rate(http_server_request_count_total{namespace=\"zitadel\", service_name=\"zitadel\"}[2m]))"
          threshold: "10"

export let vpa = node:
  apiVersion: "autoscaling.k8s.io/v1"
  kind: "VerticalPodAutoscaler"
  metadata:
    name: name
    namespace: appChart.namespace
    labels: labels
  spec:
    targetRef:
      apiVersion: "apps/v1"
      kind: "Deployment"
      name: "zitadel"
    updatePolicy:
      updateMode: "Auto"
    resourcePolicy:
      containerPolicies:
        -
          containerName: "zitadel"
          controlledResources:
            - "memory"
          minAllowed:
            cpu: "100m"
            memory: "128Mi"
          maxAllowed:
            cpu: "500m"
            memory: "1Gi"
