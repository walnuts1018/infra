import "./chart.mcl" as appChart

export type NamedDestination =
  kind: "name"
  name: String
  namespace: String

export type Placement =
  target: String
  cluster: String
  entrypoint: String
  destination: NamedDestination
  profile: String

export let placements: Map<String, Placement> =
  kurumi:
    target: "kurumi"
    cluster: "kurumi"
    entrypoint: "k8s/mcl/apps/nvidia-gpu-operator/main.mcl"
    destination:
      kind: "name"
      name: "kurumi"
      namespace: appChart.namespace
    profile: "standard"
