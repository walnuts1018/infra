import "std:crypto" as crypto
import "./config.mcl" as app

let data =
  - secretKey: "client-id"
    remoteRef:
      key: "terraform-external-secrets"
      property: "hubble-client-id"
  - secretKey: "client-secret"
    remoteRef:
      key: "terraform-external-secrets"
      property: "hubble-client-secret"

export let name = app.name + "-secret-" + crypto.sha256(data, 6)

export let resource = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: name
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: name
      template:
        engineVersion: "v2"
        type: "Opaque"
    data: data
