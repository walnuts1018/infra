import "./chart.mcl" as appChart

export type Destination =
  kind: "name"
  name: String
  namespace: String

export type Placement =
  target: String
  cluster: String
  entrypoint: String
  destination: Destination
  profile: String

export let placements: Map<String, Placement> =
  kurumi:
    target: "kurumi"
    cluster: "kurumi"
    entrypoint: "k8s/mcl/apps/cilium/main.mcl"
    destination:
      kind: "name"
      name: "kurumi"
      namespace: appChart.namespace
    profile: "originCertificateIngress"
  biscuit:
    target: "biscuit"
    cluster: "biscuit"
    entrypoint: "k8s/mcl/apps/cilium/main.mcl"
    destination:
      kind: "name"
      name: "biscuit"
      namespace: appChart.namespace
    profile: "gatewayAPI"
