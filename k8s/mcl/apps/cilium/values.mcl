let commonValues =
  kubeProxyReplacement: true
  l7Proxy: true
  k8sServicePort: 6443
  cni:
    resources:
      limits:
        cpu: "1"
  bgpControlPlane:
    enabled: true
  k8sClientRateLimit:
    qps: 10
    burst: 20
  resources:
    requests:
      cpu: "100m"
      memory: "512Mi"
    limits:
      memory: "2Gi"
  envoy:
    log:
      accessLogBufferSize: 16384
    resources:
      requests:
        cpu: "10m"
        memory: "51Mi"
  operator:
    replicas: 1
    resources:
      requests:
        cpu: "10m"
        memory: "60Mi"
      limits:
        memory: "512Mi"

let originIngressValues =
  k8sServiceHost: "192.168.4.11"
  cluster:
    id: 1
    name: "kurumi"
  l2announcements:
    enabled: true
  ingressController:
    enabled: true
    loadbalancerMode: "shared"
    default: true
    enforceHttps: true
    service:
      loadBalancerIP: "192.168.12.129"
    defaultSecretName: "cloudflare-origin-cert"
    defaultSecretNamespace: "cilium-system"
    secretsNamespace:
      create: false
      name: "cilium-secrets"
      sync: true
  nodePort:
    enabled: true
  hubble:
    tls:
      enabled: true
      auto:
        method: "cronJob"
    relay:
      enabled: true
      prometheus:
        enabled: true
        serviceMonitor:
          enabled: true
      resources:
        requests:
          cpu: "5m"
          memory: "48Mi"
        limits:
          memory: "512Mi"
    ui:
      enabled: true
      backend:
        resources:
          requests:
            cpu: "5m"
            memory: "60Mi"
          limits:
            memory: "256Mi"
      frontend:
        resources:
          requests:
            cpu: "1m"
            memory: "10Mi"
          limits:
            memory: "256Mi"
    metrics:
      enableOpenMetrics: true
      enabled:
        - "dns"
        - "drop"
        - "tcp"
        - "flow:labelsContext=source_namespace,source_workload_kind,source_workload,destination_namespace,destination_workload_kind,destination_workload,traffic_direction"
        - "flows-to-world"
        - "port-distribution"
        - "icmp"
        - "httpV2:exemplars=true;"
      serviceMonitor:
        enabled: true
      dashboards:
        enabled: true
  envoy:
    prometheus:
      enabled: true
      serviceMonitor:
        enabled: true
  operator:
    prometheus:
      enabled: true
      serviceMonitor:
        enabled: true
  prometheus:
    enabled: true
    serviceMonitor:
      enabled: true
      trustCRDsExist: true
  envoyConfig:
    enabled: true
    secretsNamespace:
      create: false
      name: "cilium-secrets"
  tls:
    secretsNamespace:
      create: false
      name: "cilium-secrets"

let gatewayAPIValues =
  k8sServiceHost: "192.168.0.15"
  cluster:
    id: 2
    name: "biscuit"
  hubble:
    tls:
      enabled: false
  envoy:
    prometheus:
      enabled: false
    resources:
      requests:
        memory: "64Mi"
  operator:
    prometheus:
      enabled: false
  gatewayAPI:
    enabled: true
    secretsNamespace:
      create: true
      name: "cilium-secrets"
      sync: true
    gatewayClass:
      create: false

export let profiles =
  originCertificateIngress:
    helmValues: commonValues with:
      k8sServiceHost: originIngressValues.k8sServiceHost
      cluster: originIngressValues.cluster
      l2announcements: originIngressValues.l2announcements
      ingressController: originIngressValues.ingressController
      nodePort: originIngressValues.nodePort
      hubble: originIngressValues.hubble
      envoy: originIngressValues.envoy
      operator: originIngressValues.operator
      prometheus: originIngressValues.prometheus
      envoyConfig: originIngressValues.envoyConfig
      tls: originIngressValues.tls
    cloudflareOriginCert: true
  gatewayAPI:
    helmValues: commonValues with:
      k8sServiceHost: gatewayAPIValues.k8sServiceHost
      cluster: gatewayAPIValues.cluster
      hubble: gatewayAPIValues.hubble
      envoy: gatewayAPIValues.envoy
      operator: gatewayAPIValues.operator
      gatewayAPI: gatewayAPIValues.gatewayAPI
    cloudflareOriginCert: false
