import "./app.mcl" as app
import "std:hash" as hash

let data =
  -
    secretKey: "admin_token"
    remoteRef:
      key: app.name
      property: "admin_token"
  -
    secretKey: "jwt_sign_secret"
    remoteRef:
      key: app.name
      property: "jwt_sign_secret"
  -
    secretKey: "minio_secret_key"
    remoteRef:
      key: app.name
      property: "minio_secret_key"
let secretName = app.name + "-" + hash.fnv1a64(data)

export let resource = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: secretName
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: secretName
      template:
        engineVersion: "v2"
        type: "Opaque"
    data: data

export let name = secretName
