import text "./_configs/robots.txt" as robotsText

let backDeployment = manifest.load("./_configs/back__deployment.yaml")[0]
let backHpa = manifest.load("./_configs/back__hpa.yaml")[0]
let backNetworkPolicy = manifest.load("./_configs/back__networkpolicy.yaml")[0]
let backService = manifest.load("./_configs/back__service.yaml")[0]
let backVpa = manifest.load("./_configs/back__vpa.yaml")[0]
let externalSecret = manifest.load("./_configs/external-secret.yaml")[0]
let frontDeployment = manifest.load("./_configs/front__deployment.yaml")[0]
let frontHpa = manifest.load("./_configs/front__hpa.yaml")[0]
let frontNetworkPolicy = manifest.load("./_configs/front__networkpolicy.yaml")[0]
let frontService = manifest.load("./_configs/front__service.yaml")[0]
let frontVpa = manifest.load("./_configs/front__vpa.yaml")[0]
let oauth2ProxyExternalSecret = manifest.load("./_configs/oauth2-proxy__external-secret.yaml")[0]
let oauth2ProxyHttpRoutePublic = manifest.load("./_configs/oauth2-proxy__httproute-public.yaml")[0]
