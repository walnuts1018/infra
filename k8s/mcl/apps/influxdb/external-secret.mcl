export let resource = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: "influxdb"
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: "influxdb"
      template:
        engineVersion: "v2"
        type: "Opaque"
    data:
      - secretKey: "admin-password"
        remoteRef:
          key: "influxdb"
          property: "admin-password"
      - secretKey: "admin-token"
        remoteRef:
          key: "influxdb"
          property: "admin-token"
