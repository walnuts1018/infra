let appName = "kubernetes-control-plane-metrics"
let monitoringNamespace = "monitoring"
let systemNamespace = "kube-system"
let bearerTokenFile = "/var/run/secrets/kubernetes.io/serviceaccount/token"
let caFile = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
fn service(name: String, labels: Map<String, String>, selector: Map<String, String>, portName: String, port: Int) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    name: name
    namespace: systemNamespace
    labels: labels
  spec:
    clusterIP: "None"
    selector: selector
    ports:
      -
        name: portName
        port: port
        targetPort: port

fn serviceMonitor(name: String, selector: Map<String, String>, jobLabel: String, namespace: String, endpoints: List<Map<String, Any>>) -> Map<String, Any> = node:
  apiVersion: "monitoring.coreos.com/v1"
  kind: "ServiceMonitor"
  metadata:
    name: name
    namespace: monitoringNamespace
    labels:
      app: appName
      "app.kubernetes.io/name": appName
  spec:
    jobLabel: jobLabel
    namespaceSelector:
      matchNames:
        - namespace
    selector:
      matchLabels: selector
    endpoints: endpoints

let controlPlaneProxySelector =
  app: "kubernetes-control-plane-metrics-proxy"
let corednsSelector =
  "k8s-app": "kube-dns"
let kubeProxySelector =
  "k8s-app": "kube-proxy"
let corednsMetricsSelector =
  app: "coredns-metrics"
let etcdMetricsSelector =
  app: "kube-etcd-metrics-proxy"
let kubeProxyMetricsSelector =
  app: "kube-proxy-metrics"
let controllerManagerMetricsSelector =
  app: "kube-controller-manager-metrics-proxy"
let schedulerMetricsSelector =
  app: "kube-scheduler-metrics-proxy"
let apiserverSelector =
  component: "apiserver"
  provider: "kubernetes"
let kubeletMetricsSelector =
  "app.kubernetes.io/name": "kubelet-metrics-proxy"
  "k8s-app": "kubelet"

let controllerManagerServiceLabels =
  app: "kube-controller-manager-metrics-proxy"
  "app.kubernetes.io/name": appName
  jobLabel: "kube-controller-manager"
let corednsServiceLabels =
  app: "coredns-metrics"
  "app.kubernetes.io/name": appName
  jobLabel: "kubernetes-coredns"
let etcdServiceLabels =
  app: "kube-etcd-metrics-proxy"
  "app.kubernetes.io/name": appName
  jobLabel: "kube-etcd"
let proxyServiceLabels =
  app: "kube-proxy-metrics"
  "app.kubernetes.io/name": appName
  jobLabel: "kube-proxy"
let schedulerServiceLabels =
  app: "kube-scheduler-metrics-proxy"
  "app.kubernetes.io/name": appName
  jobLabel: "kube-scheduler"

let controllerManagerService = service(
  "kube-controller-manager-metrics-proxy",
  controllerManagerServiceLabels,
  controlPlaneProxySelector,
  "http-metrics",
  11057,
)
let corednsService = service(
  "coredns-metrics",
  corednsServiceLabels,
  corednsSelector,
  "http-metrics",
  9153,
)
let etcdService = service(
  "kube-etcd-metrics-proxy",
  etcdServiceLabels,
  controlPlaneProxySelector,
  "http-metrics",
  12381,
)
let proxyService = service(
  "kube-proxy-metrics",
  proxyServiceLabels,
  kubeProxySelector,
  "http-metrics",
  10249,
)
let schedulerService = service(
  "kube-scheduler-metrics-proxy",
  schedulerServiceLabels,
  controlPlaneProxySelector,
  "http-metrics",
  11059,
)

let kubeletService = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    name: "kubelet-metrics-proxy"
    namespace: systemNamespace
    labels:
      app: appName
      "app.kubernetes.io/name": "kubelet-metrics-proxy"
      "k8s-app": "kubelet"
  spec:
    clusterIP: "None"
    ipFamilies:
      - "IPv4"
    ipFamilyPolicy: "SingleStack"
    selector:
      app: "kubelet-metrics-proxy"
    ports:
      -
        name: "https-metrics"
        port: 11050
        targetPort: 11050

let bearerEndpoint =
  bearerTokenFile: bearerTokenFile
  port: "http-metrics"
let simpleEndpoints =
  - bearerEndpoint
let tlsSkipVerifyEndpoint =
  bearerTokenFile: bearerTokenFile
  port: "http-metrics"
  scheme: "https"
  tlsConfig:
    caFile: caFile
    insecureSkipVerify: true
let tlsSkipVerifyEndpoints =
  - tlsSkipVerifyEndpoint

let corednsServiceMonitor = serviceMonitor(
  "kubernetes-coredns",
  corednsMetricsSelector,
  "jobLabel",
  systemNamespace,
  simpleEndpoints,
)
let etcdServiceMonitor = serviceMonitor(
  "kube-etcd",
  etcdMetricsSelector,
  "jobLabel",
  systemNamespace,
  simpleEndpoints,
)
let proxyServiceMonitor = serviceMonitor(
  "kube-proxy",
  kubeProxyMetricsSelector,
  "jobLabel",
  systemNamespace,
  simpleEndpoints,
)
let controllerManagerServiceMonitor = serviceMonitor(
  "kube-controller-manager",
  controllerManagerMetricsSelector,
  "jobLabel",
  systemNamespace,
  tlsSkipVerifyEndpoints,
)
let schedulerServiceMonitor = serviceMonitor(
  "kube-scheduler",
  schedulerMetricsSelector,
  "jobLabel",
  systemNamespace,
  tlsSkipVerifyEndpoints,
)

let apiServerEndpoints =
  -
    bearerTokenFile: bearerTokenFile
    metricRelabelings:
      -
        action: "drop"
        regex: "(etcd_request|apiserver_request_slo|apiserver_request_sli|apiserver_request)_duration_seconds_bucket;(0\\.15|0\\.2|0\\.3|0\\.35|0\\.4|0\\.45|0\\.6|0\\.7|0\\.8|0\\.9|1\\.25|1\\.5|1\\.75|2|3|3\\.5|4|4\\.5|6|7|8|9|15|20|40|45|50)(\\.0)?"
        sourceLabels:
          - "__name__"
          - "le"
    port: "https"
    scheme: "https"
    tlsConfig:
      caFile: caFile
      insecureSkipVerify: false
      serverName: "kubernetes"

let apiServerServiceMonitor = serviceMonitor(
  "kube-apiserver",
  apiserverSelector,
  "component",
  "default",
  apiServerEndpoints,
)

let kubeletEndpoints =
  -
    bearerTokenFile: bearerTokenFile
    honorLabels: true
    honorTimestamps: true
    metricRelabelings:
      -
        action: "drop"
        regex: "(csi_operations|storage_operation_duration)_seconds_bucket;(0.25|2.5|15|25|120|600)(\\.0)?"
        sourceLabels:
          - "__name__"
          - "le"
    port: "https-metrics"
    relabelings:
      -
        action: "replace"
        sourceLabels:
          - "__meta_kubernetes_endpointslice_endpoint_node_name"
        targetLabel: "node"
      -
        action: "replace"
        sourceLabels:
          - "__metrics_path__"
        targetLabel: "metrics_path"
    scheme: "https"
    tlsConfig:
      caFile: caFile
      insecureSkipVerify: true
  -
    bearerTokenFile: bearerTokenFile
    honorLabels: true
    honorTimestamps: true
    interval: "30s"
    metricRelabelings:
      -
        action: "drop"
        regex: "container_cpu_(cfs_throttled_seconds_total|load_average_10s|system_seconds_total|user_seconds_total)"
        sourceLabels:
          - "__name__"
      -
        action: "drop"
        regex: "container_fs_(io_current|io_time_seconds_total|io_time_weighted_seconds_total|reads_merged_total|sector_reads_total|sector_writes_total|writes_merged_total)"
        sourceLabels:
          - "__name__"
      -
        action: "drop"
        regex: "container_memory_(mapped_file|swap)"
        sourceLabels:
          - "__name__"
      -
        action: "drop"
        regex: "container_(file_descriptors|tasks_state|threads_max)"
        sourceLabels:
          - "__name__"
      -
        action: "drop"
        regex: "container_memory_failures_total;hierarchy"
        sourceLabels:
          - "__name__"
          - "scope"
      -
        action: "drop"
        regex: "container_network_.*;(cali|cilium|cni|lxc|nodelocaldns|tunl).*"
        sourceLabels:
          - "__name__"
          - "interface"
      -
        action: "drop"
        regex: "container_spec.*"
        sourceLabels:
          - "__name__"
      -
        action: "drop"
        regex: ".+;"
        sourceLabels:
          - "id"
          - "pod"
    path: "/metrics/cadvisor"
    port: "https-metrics"
    relabelings:
      -
        action: "replace"
        sourceLabels:
          - "__meta_kubernetes_endpointslice_endpoint_node_name"
        targetLabel: "node"
      -
        action: "replace"
        sourceLabels:
          - "__metrics_path__"
        targetLabel: "metrics_path"
    scheme: "https"
    tlsConfig:
      caFile: caFile
      insecureSkipVerify: true
    trackTimestampsStaleness: true
  -
    bearerTokenFile: bearerTokenFile
    honorLabels: true
    honorTimestamps: true
    path: "/metrics/probes"
    port: "https-metrics"
    relabelings:
      -
        action: "replace"
        sourceLabels:
          - "__meta_kubernetes_endpointslice_endpoint_node_name"
        targetLabel: "node"
      -
        action: "replace"
        sourceLabels:
          - "__metrics_path__"
        targetLabel: "metrics_path"
    scheme: "https"
    tlsConfig:
      caFile: caFile
      insecureSkipVerify: true

let kubeletServiceMonitor = serviceMonitor(
  "kubelet",
  kubeletMetricsSelector,
  "k8s-app",
  systemNamespace,
  kubeletEndpoints,
)

fn socatContainer(name: String, portName: String, listenPort: String, targetPort: String, port: Int, memoryLimit: String) -> Map<String, Any> = node:
  name: name
  image: "docker.io/alpine/socat:1.8.1.3"
  args:
    - "-d"
    - "-d"
    - "TCP-LISTEN:" + listenPort + ",fork,reuseaddr,bind=0.0.0.0"
    - "TCP:" + targetPort
  ports:
    -
      name: portName
      containerPort: port
      hostPort: port
  resources:
    requests:
      cpu: "3m"
      memory: "8Mi"
    limits:
      cpu: "50m"
      memory: memoryLimit

let kubeletProxyDaemonSet = node:
  apiVersion: "apps/v1"
  kind: "DaemonSet"
  metadata:
    name: "kubelet-metrics-proxy"
    namespace: systemNamespace
    labels:
      app: "kubelet-metrics-proxy"
      "app.kubernetes.io/name": appName
  spec:
    selector:
      matchLabels:
        app: "kubelet-metrics-proxy"
    template:
      metadata:
        labels:
          app: "kubelet-metrics-proxy"
          "app.kubernetes.io/name": appName
      spec:
        hostNetwork: true
        dnsPolicy: "ClusterFirstWithHostNet"
        tolerations:
          -
            operator: "Exists"
        containers:
          - socatContainer("kubelet", "https-metrics", "11050", "127.0.0.1:10250", 11050, "64Mi")

let controlPlaneProxyDaemonSet = node:
  apiVersion: "apps/v1"
  kind: "DaemonSet"
  metadata:
    name: "kubernetes-control-plane-metrics-proxy"
    namespace: systemNamespace
    labels:
      app: "kubernetes-control-plane-metrics-proxy"
      "app.kubernetes.io/name": appName
  spec:
    selector:
      matchLabels:
        app: "kubernetes-control-plane-metrics-proxy"
    template:
      metadata:
        labels:
          app: "kubernetes-control-plane-metrics-proxy"
          "app.kubernetes.io/name": appName
      spec:
        hostNetwork: true
        dnsPolicy: "ClusterFirstWithHostNet"
        nodeSelector:
          "node-role.kubernetes.io/control-plane": ""
        tolerations:
          -
            key: "node-role.kubernetes.io/control-plane"
            operator: "Exists"
            effect: "NoSchedule"
        containers:
          - socatContainer("controller-manager", "controller", "11057", "127.0.0.1:10257", 11057, "32Mi")
          - socatContainer("scheduler", "scheduler", "11059", "127.0.0.1:10259", 11059, "32Mi")
          - socatContainer("etcd", "etcd", "12381", "127.0.0.1:2381", 12381, "32Mi")

emit controllerManagerService
emit corednsService
emit etcdService
emit kubeletService
emit proxyService
emit schedulerService
emit kubeletProxyDaemonSet
emit controlPlaneProxyDaemonSet
emit controllerManagerServiceMonitor
emit corednsServiceMonitor
emit etcdServiceMonitor
emit proxyServiceMonitor
emit schedulerServiceMonitor
emit apiServerServiceMonitor
emit kubeletServiceMonitor
