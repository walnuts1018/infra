import "./app.mcl" as app
import "./profiles.mcl" as appProfiles

export type Destination =
  kind: "name"
  name: String
  namespace: String

export type Placement =
  target: String
  cluster: String
  entrypoint: String
  destination: Destination
  profile: String

export let placements: Map<String, Placement> =
  kurumi:
    target: "kurumi"
    cluster: "kurumi"
    entrypoint: "k8s/mcl/apps/opentelemetry-collectors/main.mcl"
    destination:
      kind: "name"
      name: "kurumi"
      namespace: app.namespace
    profile: appProfiles.placementProfile
