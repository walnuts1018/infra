import "./app.mcl" as appConfig

export let data =
  - secretKey: "github-token"
    remoteRef:
      key: "github_token"
      property: "github-readme-stats"

export let name = appConfig.app.name + "-" + crypto.sha256(data, 6)

export let externalSecret = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: name
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: name
      template:
        engineVersion: "v2"
        type: "Opaque"
    data: data
