export type Destination =
  kind: "name"
  name: String
  namespace: String

export type Placement =
  target: String
  cluster: String
  entrypoint: String
  destination: Destination
  profile: String

export let placements: Map<String, Placement> =
  kurumi:
    target: "kurumi"
    cluster: "kurumi"
    entrypoint: "k8s/mcl/apps/netbird/main.mcl"
    destination:
      kind: "name"
      name: "kurumi"
      namespace: appSettings.namespace
    profile: "standard"
