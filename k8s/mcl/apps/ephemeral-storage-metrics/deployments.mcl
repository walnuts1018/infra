export type NamedDestination =
  kind: "name"
  name: String
  namespace: String

export type ServerDestination =
  kind: "server"
  server: String
  namespace: String

export type Destination = NamedDestination | ServerDestination

export type Deployment =
  target: String
  cluster: String
  entrypoint: String
  destination: Destination
  values: Map<String, Any>

export let deployments: Map<String, Deployment> =
  kurumi:
    target: "kurumi"
    cluster: "kurumi"
    entrypoint: "k8s/mcl/apps/ephemeral-storage-metrics/main.mcl"
    destination:
      kind: "name"
      name: "kurumi"
      namespace: "monitoring"
    values:
      serviceMonitor:
        enable: true
      metrics:
        ephemeral_storage_container_limit_percentage: true
        ephemeral_storage_container_volume_usage: true
        ephemeral_storage_container_volume_limit_percentage: true
        ephemeral_storage_pod_usage: true
        ephemeral_storage_inodes: true
        ephemeral_storage_node_available: true
        ephemeral_storage_node_capacity: true
        ephemeral_storage_node_percentage: true
        adjusted_polling_rate: false
      prometheus:
        enable: true
