import "./datasources.mcl" as datasources
import "./external-secret.mcl" as externalSecret
import text "./_configs/role-attribute-path.txt" as roleAttributePath

export let values: Map<String, Any> =
  replicas: 1
  autoscaling:
    enabled: true
    minReplicas: 1
    maxReplicas: 5
    targetCPU: "95"
    targetMemory: ""
  resources:
    requests:
      cpu: "100m"
      memory: "560Mi"
    limits:
      cpu: "500m"
      memory: "2Gi"
  downloadDashboards:
    resources:
      requests:
        cpu: "1m"
        memory: "295Mi"
      limits:
        cpu: "1"
        memory: "1Gi"
  ingress:
    enabled: false
    hosts:
      - "grafana.walnuts.dev"
    ingressClassName: "cilium"
  rbac:
    pspEnabled: false
  testFramework:
    enabled: false
  persistence:
    enabled: false
  service:
    type: "ClusterIP"
  admin:
    existingSecret: externalSecret.name
    userKey: "admin-username"
    passwordKey: "admin-password"
  extraSecretMounts:
    - name: "auth-generic-oauth-secret"
      secretName: externalSecret.name
      mountPath: "/etc/secrets"
      readOnly: true
  "grafana.ini":
    server:
      domain: "grafana.walnuts.dev"
      root_url: "https://grafana.walnuts.dev/"
    security:
      secret_key: "$__file{/etc/secrets/secret_key}"
    auth:
      disable_login_form: true
      oauth_auto_login: true
    "auth.basic":
      enabled: false
    "auth.generic_oauth":
      enabled: true
      client_id: "237480184528306541@walnuts.dev"
      client_secret: "$__file{/etc/secrets/client_secret}"
      scopes: "openid email profile offline_access urn:zitadel:iam:org:projects:roles"
      email_attribute_path: "email"
      login_attribute_path: "preferred_username"
      name_attribute_path: "preferred_username"
      auth_url: "https://auth.walnuts.dev/oauth/v2/authorize"
      token_url: "https://auth.walnuts.dev/oauth/v2/token"
      api_url: "https://auth.walnuts.dev/oidc/v1/userinfo"
      role_attribute_strict: true
      role_attribute_path: roleAttributePath
      allow_assign_grafana_admin: true
      use_pkce: true
    feature_toggles:
      provisioning: true
      kubernetesDashboards: true
    smtp:
      enabled: true
      from_address: "grafana@walnuts.dev"
      host: "mx.walnuts.dev:465"
      user: "grafana@walnuts.dev"
      password: "$__file{/etc/secrets/smtp_password}"
    database:
      type: "postgres"
      host: "postgresql-default-rw.databases.svc.cluster.local"
      name: "grafana"
      user: "grafana"
      password: "$__file{/etc/secrets/postgres_password}"
  sidecar:
    dashboards:
      enabled: false
      initDashboards: false
    plugins:
      enabled: true
    datasources:
      enabled: true
    resources:
      requests:
        cpu: "1m"
        memory: "92Mi"
      limits:
        memory: "512Mi"
  plugins:
    - "knightss27-weathermap-panel"
    - "grafana-github-datasource"
    - "volkovlabs-echarts-panel"
    - "ovhcloud-akvorado-datasource"
  datasources:
    "datasources.yaml": datasources.values
  route:
    main:
      enabled: true
      annotations:
        "external-dns-cloudflare.alpha.kubernetes.io/cloudflare-proxied": "true"
      hostnames:
        - "grafana.walnuts.dev"
      parentRefs:
        - name: "envoy-gateway"
          namespace: "envoy-gateway-system"
