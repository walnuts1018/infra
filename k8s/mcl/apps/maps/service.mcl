import "./app.mcl" as app

let labels = app.labels("versatiles-server")

export let resource = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    name: "maps-versatiles-server"
    namespace: app.namespace
    labels: labels
  spec:
    selector: labels
    ports:
      - name: "http"
        port: 80
        targetPort: 8080
    type: "ClusterIP"
