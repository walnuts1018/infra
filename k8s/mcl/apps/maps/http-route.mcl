import "./app.mcl" as app
import "./service.mcl" as service

export let resource = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "HTTPRoute"
  metadata:
    name: app.name
    namespace: app.namespace
    annotations:
      "external-dns-cloudflare.alpha.kubernetes.io/cloudflare-proxied": "true"
  spec:
    parentRefs:
      - name: "envoy-gateway"
        namespace: "envoy-gateway-system"
        sectionName: "https"
    hostnames:
      - "maps.walnuts.dev"
    rules:
      -
        backendRefs:
          - kind: "Service"
            name: service.resource.metadata.name
            port: 80
            weight: 1
