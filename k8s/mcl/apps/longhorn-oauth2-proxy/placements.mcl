import "./settings.mcl" as settings

export type NamedDestination =
  kind: "name"
  name: String
  namespace: String

export type Destination = NamedDestination

export type Placement =
  target: String
  cluster: String
  entrypoint: String
  destination: Destination
  profile: String

export let placements: Map<String, Placement> =
  kurumi:
    target: "kurumi"
    cluster: "kurumi"
    entrypoint: "k8s/mcl/apps/longhorn-oauth2-proxy/main.mcl"
    destination:
      kind: "name"
      name: "kurumi"
      namespace: settings.namespace
    profile: "standard"
