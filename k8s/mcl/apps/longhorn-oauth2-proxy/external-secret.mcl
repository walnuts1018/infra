import "std:crypto" as crypto
import "./settings.mcl" as settings
import "./external-secret-data.mcl" as secretData

export let name = settings.name + "-secret-" + crypto.sha256(secretData.data, 6)

export let resource = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: name
  spec:
    refreshInterval: "1m"
    secretStoreRef:
      kind: "ClusterSecretStore"
      name: "onepassword"
    target:
      name: name
      template:
        engineVersion: "v2"
        type: "Opaque"
    data: secretData.data
