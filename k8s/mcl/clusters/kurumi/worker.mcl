import "../lib/tart-control-plane.mcl" as capi

let clusterName = "kurumi"
let workerName = "kurumi-worker"
let resourceName = "kurumi-worker-768a0bf9b4"
let patchesSecretName = "kurumi-worker-patches-768a0bf9b4"
let labels =
  "cluster.x-k8s.io/cluster-name": clusterName
  "cluster.x-k8s.io/deployment-name": workerName
let hostSelectorLabels =
  "kurumi.walnuts.dev/pool": "worker"
let patchesText = """
# OSインストール先: sda(HP Smart Array論理ドライブ、100G)。ssh + udevadmで実機確認済み(2026-09-11)。
# EPHEMERALのmaxSizeは制限しない(システムディスク全体を使い、/var/lib/longhornもその中に収まる。
# 現行のrusk構成と同じ形)。
apiVersion: v1alpha1
kind: UnattendedInstallConfig
provisioning:
  diskSelector:
    match: '!disk.readonly && disk.wwid == "naa.600508b1001c1351"'
  wipe: false
---
# 既存のTopoLVM VG「hdd」(物理的にはsdc+sddのHP Smart Array論理ドライブ、465.7GB x2)。
# sda(OS)とは別の専用ディスクであり、現行構成のまま(thick provisioning)再現する。
apiVersion: v1alpha1
kind: LVMVolumeGroupConfig
name: hdd
provisioning:
  volumeSelector:
    match: >-
      !disk.readonly && (
        disk.wwid == "naa.600508b1001ca894" ||
        disk.wwid == "naa.600508b1001c4ca3"
      )
---
apiVersion: v1alpha1
kind: SwapVolumeConfig
name: swap
provisioning:
  diskSelector:
    match: '!disk.readonly && disk.wwid == "naa.600508b1001c1351"'
  minSize: 4GiB
  maxSize: 4GiB
---
apiVersion: v1alpha1
kind: KubeletConfig
config:
  memorySwap:
    swapBehavior: LimitedSwap
"""
let patches = patchesText + "\n"

export let resources = capi.worker(
  resourceName,
  patchesSecretName,
  clusterName,
  workerName,
  clusterName,
  "v1.36.4",
  1,
  labels,
  hostSelectorLabels,
  "613e1592b2da41ae5e265e8789429f22e121aab91cb4deb6bc3c0b6262961245",
  "v1.14.0",
  patches,
)
