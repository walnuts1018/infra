import "std:hash" as hashes
import "./external-secret-data.mcl" as secretData

export let name = "grafana-" + hashes.fnv1a64(secretData.data)

export let resource =
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: name
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: name
      template:
        engineVersion: "v2"
        type: "Opaque"
    data: secretData.data
