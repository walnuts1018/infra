export fn resource(namespace: String) -> Map<String, Any> =
  apiVersion: "autoscaling.k8s.io/v1"
  kind: "VerticalPodAutoscaler"
  metadata:
    name: "grafana"
    namespace: namespace
    labels:
      app: "grafana"
      "app.kubernetes.io/name": "grafana"
  spec:
    targetRef:
      apiVersion: "apps/v1"
      kind: "Deployment"
      name: "grafana"
    updatePolicy:
      updateMode: "Auto"
    resourcePolicy:
      containerPolicies:
        - containerName: "grafana"
          controlledResources:
            - "memory"
          minAllowed:
            memory: "256Mi"
          maxAllowed:
            memory: "1Gi"
