import "std:hash" as hashes
import "./app.mcl" as app

let data =
  - secretKey: "discovery_key"
    remoteRef:
      key: "terraform-external-secrets"
      property: "iwashi-discovery-key"
let templateData =
  DISCOVERY_KEY: "{{ .discovery_key }}"
let hashInput =
  data: data
  templateData: templateData

export let name = app.name + "-discovery-" + hashes.fnv1a64(hashInput)

export let resource = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: name
    namespace: app.namespace
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: name
      template:
        engineVersion: "v2"
        type: "Opaque"
        data: templateData
    data: data
