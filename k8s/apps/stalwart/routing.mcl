let appName = "stalwart"
let routeNames =
  smtp: "stalwart-smtp"
  smtps: "stalwart-smtps"
  submission: "stalwart-submission"
  imaps: "stalwart-imaps"

fn tcpRoute(namespace: String, listener: String, port: Int, routeName: String) -> Map<String, Any> = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "TCPRoute"
  metadata:
    name: routeName
    namespace: namespace
  spec:
    parentRefs:
      - name: "envoy-gateway"
        namespace: "envoy-gateway-system"
        sectionName: listener
    rules:
      -
        backendRefs:
          - name: appName
            port: port
fn generatedTcpRoutes(namespace: String) -> List<Map<String, Any>> =
  - tcpRoute(namespace, "smtp", 25, routeNames.smtp)
  - tcpRoute(namespace, "smtps", 465, routeNames.smtps)
  - tcpRoute(namespace, "submission", 587, routeNames.submission)
  - tcpRoute(namespace, "imaps", 993, routeNames.imaps)

fn backendTrafficPolicy(namespace: String) -> Map<String, Any> = node:
  apiVersion: "gateway.envoyproxy.io/v1alpha1"
  kind: "BackendTrafficPolicy"
  metadata:
    name: "stalwart-proxy-protocol"
    namespace: namespace
  spec:
    targetRefs:
      - group: "gateway.networking.k8s.io"
        kind: "TCPRoute"
        name: routeNames.smtp
      - group: "gateway.networking.k8s.io"
        kind: "TCPRoute"
        name: routeNames.smtps
    proxyProtocol:
      version: "V2"

fn httpRoute(namespace: String) -> Map<String, Any> = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "HTTPRoute"
  metadata:
    name: appName
    namespace: namespace
  spec:
    parentRefs:
      - name: "envoy-gateway"
        namespace: "envoy-gateway-system"
    hostnames:
      - "stalwart.local.walnuts.dev"
      - "autoconfig.walnuts.dev"
      - "autodiscover.walnuts.dev"
    rules:
      -
        backendRefs:
          - kind: "Service"
            name: appName
            port: 8080
            weight: 1
        matches:
          - path:
              type: "PathPrefix"
              value: "/"


export fn resources(namespace: String) -> List<Map<String, Any>> =
  - backendTrafficPolicy(namespace)
  - httpRoute(namespace)
export fn tcpRoutes(namespace: String) -> List<Map<String, Any>> = generatedTcpRoutes(namespace)
