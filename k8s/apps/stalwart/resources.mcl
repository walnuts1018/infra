import text "./_configs/config.json" as configJSON
import "./config.mcl" as appConfig

let appName = "stalwart"
let labels =
  app: appName
  "app.kubernetes.io/name": appName

fn externalSecret(namespace: String, settings: appConfig.Settings) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: appName
    namespace: namespace
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: appName
      template:
        engineVersion: "v2"
        type: "Opaque"
        data:
          postgres_password: "{{ .postgres_password }}"
    data:
      - secretKey: "postgres_password"
        remoteRef:
          key: "postgres_passwords"
          property: appName

fn certificate(namespace: String, settings: appConfig.Settings) -> Map<String, Any> = node:
  apiVersion: "cert-manager.io/v1"
  kind: "Certificate"
  metadata:
    name: "stalwart-mx"
    namespace: namespace
  spec:
    secretName: "stalwart-mx-tls"
    dnsNames:
      - "mx.walnuts.dev"
    issuerRef:
      group: "cert-manager.io"
      kind: "ClusterIssuer"
      name: "letsencrypt-prod"

fn configMap(namespace: String, settings: appConfig.Settings) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "ConfigMap"
  metadata:
    name: "stalwart-config"
    namespace: namespace
    labels: labels
  data:
    "config.json": configJSON

fn serviceAccount(namespace: String, settings: appConfig.Settings) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "ServiceAccount"
  metadata:
    name: appName
    namespace: namespace

fn s3CredentialsSecret(namespace: String, settings: appConfig.Settings) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Secret"
  metadata:
    name: settings.s3CredentialName
    namespace: namespace

fn s3ReferenceGrant(namespace: String, settings: appConfig.Settings) -> Map<String, Any> = node:
  apiVersion: "seaweed.seaweedfs.com/v1"
  kind: "ResourceReferenceGrant"
  metadata:
    name: "seaweedfs-s3-credentials"
    namespace: namespace
  spec:
    from:
      - group: "seaweed.seaweedfs.com"
        kind: "S3Credentials"
        namespace: "seaweedfs"
    to:
      - group: ""
        kind: "Secret"

let databaseStorage =
  nodeAffinity:
    requiredDuringSchedulingIgnoredDuringExecution:
      nodeSelectorTerms:
        -
          matchExpressions:
            - key: "storage.walnuts.dev/slow"
              operator: "DoesNotExist"

fn elasticsearch(namespace: String, settings: appConfig.Settings) -> Map<String, Any> = node:
  apiVersion: "elasticsearch.k8s.elastic.co/v1"
  kind: "Elasticsearch"
  metadata:
    name: appName
    namespace: namespace
    annotations:
      "argocd.argoproj.io/sync-options": "SkipDryRunOnMissingResource=true"
  spec:
    version: "9.4.2"
    volumeClaimDeletePolicy: "DeleteOnScaledownOnly"
    nodeSets:
      - name: "default"
        count: 1
        config:
          "node.store.allow_mmap": false
        podTemplate:
          spec:
            affinity: databaseStorage
            containers:
              - name: "elasticsearch"
                resources:
                  requests:
                    cpu: "250m"
                    memory: "1Gi"
                  limits:
                    cpu: "1"
                    memory: "2Gi"
        volumeClaimTemplates:
          - metadata:
              name: "elasticsearch-data"
            spec:
              accessModes:
                - "ReadWriteOnce"
              storageClassName: "longhorn"
              resources:
                requests:
                  storage: "4Gi"

fn valkeyCluster(namespace: String, settings: appConfig.Settings) -> Map<String, Any> = node:
  apiVersion: "valkey.io/v1alpha1"
  kind: "ValkeyCluster"
  metadata:
    name: "stalwart-valkey"
    namespace: namespace
    annotations:
      "argocd.argoproj.io/sync-options": "SkipDryRunOnMissingResource=true"
    labels:
      app: "stalwart-valkey"
      "app.kubernetes.io/name": "stalwart-valkey"
  spec:
    shards: 1
    replicas: 2
    resources:
      requests:
        cpu: "5m"
        memory: "5Mi"
      limits:
        cpu: "1"
        memory: "1Gi"


fn deployment(namespace: String, settings: appConfig.Settings) -> Map<String, Any> = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    name: appName
    namespace: namespace
    labels: labels
    annotations:
      "reloader.stakater.com/auto": "true"
  spec:
    replicas: 1
    selector:
      matchLabels: labels
    strategy:
      type: "RollingUpdate"
      rollingUpdate:
        maxUnavailable: 0
        maxSurge: 1
    template:
      metadata:
        labels: labels
      spec:
        serviceAccountName: appName
        topologySpreadConstraints:
          - maxSkew: 1
            topologyKey: "kubernetes.io/hostname"
            whenUnsatisfiable: "ScheduleAnyway"
            labelSelector:
              matchLabels: labels
        containers:
          - name: "stalwart"
            image: "docker.io/stalwartlabs/stalwart:v0.16.22"
            imagePullPolicy: "IfNotPresent"
            args:
              - "--config"
              - "/opt/stalwart/etc/config.json"
            env:
              - name: "STALWART_DB_PASSWORD"
                valueFrom:
                  secretKeyRef:
                    name: appName
                    key: "postgres_password"
              - name: "STALWART_S3_ACCESS_KEY"
                valueFrom:
                  secretKeyRef:
                    name: settings.s3CredentialName
                    key: settings.s3AccessKeyField
              - name: "STALWART_S3_SECRET_KEY"
                valueFrom:
                  secretKeyRef:
                    name: settings.s3CredentialName
                    key: settings.s3SecretKeyField
            ports:
              - name: "http"
                containerPort: 8080
              - name: "https"
                containerPort: 443
              - name: "smtp"
                containerPort: 25
              - name: "smtps"
                containerPort: 465
              - name: "submission"
                containerPort: 587
              - name: "imaps"
                containerPort: 993
            volumeMounts:
              - name: "stalwart-config"
                mountPath: "/opt/stalwart/etc/config.json"
                subPath: "config.json"
                readOnly: true
              - name: "tmp"
                mountPath: "/tmp"
              - name: "tls"
                mountPath: "/var/run/stalwart/tls"
                readOnly: true
            livenessProbe:
              httpGet:
                path: "/healthz/live"
                port: 8080
              initialDelaySeconds: 30
              periodSeconds: 10
            startupProbe:
              httpGet:
                path: "/healthz/live"
                port: 8080
              periodSeconds: 10
              failureThreshold: 20
            readinessProbe:
              httpGet:
                path: "/healthz/ready"
                port: 8080
              initialDelaySeconds: 5
              periodSeconds: 10
            resources:
              requests:
                cpu: "5m"
                memory: "60Mi"
              limits:
                cpu: "500m"
                memory: "256Mi"
        volumes:
          - name: "stalwart-config"
            configMap:
              name: "stalwart-config"
              items:
                - key: "config.json"
                  path: "config.json"
          - name: "tmp"
            emptyDir: {}
          - name: "tls"
            secret:
              secretName: "stalwart-mx-tls"

fn service(namespace: String, settings: appConfig.Settings) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    name: appName
    namespace: namespace
    labels: labels
  spec:
    selector: labels
    ports:
      - name: "http"
        protocol: "TCP"
        port: 8080
        targetPort: "http"
      - name: "https"
        protocol: "TCP"
        port: 443
        targetPort: "https"
      - name: "smtp"
        protocol: "TCP"
        port: 25
        targetPort: "smtp"
      - name: "smtps"
        protocol: "TCP"
        port: 465
        targetPort: "smtps"
      - name: "submission"
        protocol: "TCP"
        port: 587
        targetPort: "submission"
      - name: "imaps"
        protocol: "TCP"
        port: 993
        targetPort: "imaps"
    type: settings.loadBalancerService

fn verticalAutoscaler(namespace: String, settings: appConfig.Settings) -> Map<String, Any> = node:
  apiVersion: "autoscaling.k8s.io/v1"
  kind: "VerticalPodAutoscaler"
  metadata:
    name: appName
    namespace: namespace
    labels: labels
  spec:
    targetRef:
      apiVersion: "apps/v1"
      kind: "Deployment"
      name: appName
    updatePolicy:
      updateMode: "Auto"
    resourcePolicy:
      containerPolicies:
        - containerName: "stalwart"
          controlledResources:
            - "memory"
          minAllowed:
            cpu: "10m"
            memory: "10Mi"
          maxAllowed:
            cpu: "500m"
            memory: "256Mi"

export fn allResources(namespace: String, settings: appConfig.Settings) -> List<Map<String, Any>> =
  - externalSecret(namespace, settings)
  - certificate(namespace, settings)
  - configMap(namespace, settings)
  - serviceAccount(namespace, settings)
  - s3CredentialsSecret(namespace, settings)
  - s3ReferenceGrant(namespace, settings)
  - elasticsearch(namespace, settings)
  - valkeyCluster(namespace, settings)
  - deployment(namespace, settings)
  - service(namespace, settings)
  - verticalAutoscaler(namespace, settings)
