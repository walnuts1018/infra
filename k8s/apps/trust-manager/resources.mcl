import "std:list" as lists
import "./_resources/certificates.mcl" as certificates
import "./_resources/crd.mcl" as customResourceDefinitions
import "./_resources/rbac.mcl" as accessControl
import "./_resources/runtime.mcl" as runtimeResources
import "./_resources/service-monitor.mcl" as serviceMonitor

export let baseResources = lists.concat(
  lists.concat(customResourceDefinitions.resources, accessControl.resources),
  lists.concat(runtimeResources.resources, certificates.resources),
)

export let monitoringResources = serviceMonitor.resources
