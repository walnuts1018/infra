let serviceTrustManagerMetricsSpecPorts =
  - port: 9402
    targetPort: 9402
    protocol: "TCP"
    name: "metrics"

let serviceTrustManagerSpecPorts =
  - port: 443
    targetPort: 6443
    protocol: "TCP"
    name: "webhook"

let deploymentTrustManagerSpecInitContainersVolumeMounts =
  - mountPath: "/packages"
    name: "packages"
    readOnly: false

let deploymentTrustManagerTemplateSpecInitContainers =
  - name: "cert-manager-package-debian"
    image: "quay.io/jetstack/trust-pkg-debian-trixie:20250419.1"
    imagePullPolicy: "IfNotPresent"
    args:
      - "/copyandmaybepause"
      - "/debian-package"
      - "/packages"
    volumeMounts: deploymentTrustManagerSpecInitContainersVolumeMounts
    securityContext: node:
      allowPrivilegeEscalation: false
      capabilities: node:
        drop:
          - "ALL"
      readOnlyRootFilesystem: true
      runAsNonRoot: true
      seccompProfile: node:
        type: "RuntimeDefault"

let deploymentTrustManagerSpecContainersPorts =
  - containerPort: 6443
    name: "webhook"
  - containerPort: 9402
    name: "metrics"

let deploymentTrustManagerSpecContainersVolumeMounts =
  - mountPath: "/tls"
    name: "tls"
    readOnly: true
  - mountPath: "/packages"
    name: "packages"
    readOnly: true

let deploymentTrustManagerTemplateSpecContainers =
  - name: "trust-manager"
    image: "quay.io/jetstack/trust-manager:v0.24.0"
    imagePullPolicy: "IfNotPresent"
    ports: deploymentTrustManagerSpecContainersPorts
    readinessProbe: node:
      httpGet: node:
        port: 6060
        path: "/readyz"
      initialDelaySeconds: 3
      periodSeconds: 7
    args:
      - "--log-format=text"
      - "--log-level=1"
      - "--metrics-port=9402"
      - "--readiness-probe-port=6060"
      - "--readiness-probe-path=/readyz"
      - "--leader-elect=true"
      - "--leader-election-lease-duration=15s"
      - "--leader-election-renew-deadline=10s"
      - "--trust-namespace=cert-manager"
      - "--webhook-host=0.0.0.0"
      - "--webhook-port=6443"
      - "--webhook-certificate-dir=/tls"
      - "--default-package-location=/packages/cert-manager-package-debian.json"
    volumeMounts: deploymentTrustManagerSpecContainersVolumeMounts
    resources: node:
      limits: node:
        cpu: "100m"
        memory: "128Mi"
      requests: node:
        cpu: "5m"
        memory: "32Mi"
    securityContext: node:
      allowPrivilegeEscalation: false
      capabilities: node:
        drop:
          - "ALL"
      readOnlyRootFilesystem: true
      runAsNonRoot: true
      seccompProfile: node:
        type: "RuntimeDefault"

let deploymentTrustManagerTemplateSpecVolumes =
  - name: "packages"
    emptyDir: node:
      sizeLimit: "50M"
  - name: "tls"
    secret: node:
      defaultMode: 420
      secretName: "trust-manager-tls"

let validatingWebhookConfigurationTrustManagerWebhooksRules =
  - apiGroups:
      - "trust.cert-manager.io"
    apiVersions:
      - "v1alpha1"
    operations:
      - "CREATE"
      - "UPDATE"
    resources:
      - "bundles"

let validatingWebhookConfigurationTrustManagerWebhooks =
  - name: "trust.cert-manager.io"
    rules: validatingWebhookConfigurationTrustManagerWebhooksRules
    admissionReviewVersions:
      - "v1"
    timeoutSeconds: 5
    failurePolicy: "Fail"
    sideEffects: "None"
    clientConfig: node:
      service: node:
        name: "trust-manager"
        namespace: "cert-manager"
        path: "/validate-trust-cert-manager-io-v1alpha1-bundle"

let serviceTrustManagerMetrics = node:
  apiVersion: "v1"
  kind: "Service"
  metadata: node:
    name: "trust-manager-metrics"
    namespace: "cert-manager"
    labels: node:
      app: "trust-manager"
      "app.kubernetes.io/component": "metrics"
      "app.kubernetes.io/name": "trust-manager"
      "helm.sh/chart": "trust-manager-v0.24.0"
      "app.kubernetes.io/instance": "trust-manager"
      "app.kubernetes.io/version": "v0.24.0"
      "app.kubernetes.io/managed-by": "Helm"
  spec: node:
    type: "ClusterIP"
    ports: serviceTrustManagerMetricsSpecPorts
    selector: node:
      app: "trust-manager"

let serviceTrustManager = node:
  apiVersion: "v1"
  kind: "Service"
  metadata: node:
    name: "trust-manager"
    namespace: "cert-manager"
    labels: node:
      app: "trust-manager"
      "app.kubernetes.io/name": "trust-manager"
      "helm.sh/chart": "trust-manager-v0.24.0"
      "app.kubernetes.io/instance": "trust-manager"
      "app.kubernetes.io/version": "v0.24.0"
      "app.kubernetes.io/managed-by": "Helm"
  spec: node:
    type: "ClusterIP"
    ports: serviceTrustManagerSpecPorts
    selector: node:
      app: "trust-manager"

let deploymentTrustManager = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata: node:
    name: "trust-manager"
    namespace: "cert-manager"
    labels: node:
      "app.kubernetes.io/name": "trust-manager"
      "helm.sh/chart": "trust-manager-v0.24.0"
      "app.kubernetes.io/instance": "trust-manager"
      "app.kubernetes.io/version": "v0.24.0"
      "app.kubernetes.io/managed-by": "Helm"
  spec: node:
    replicas: 1
    revisionHistoryLimit: 10
    selector: node:
      matchLabels: node:
        app: "trust-manager"
    template: node:
      metadata: node:
        labels: node:
          app: "trust-manager"
          "app.kubernetes.io/name": "trust-manager"
          "helm.sh/chart": "trust-manager-v0.24.0"
          "app.kubernetes.io/instance": "trust-manager"
          "app.kubernetes.io/version": "v0.24.0"
          "app.kubernetes.io/managed-by": "Helm"
      spec: node:
        serviceAccountName: "trust-manager"
        automountServiceAccountToken: true
        initContainers: deploymentTrustManagerTemplateSpecInitContainers
        containers: deploymentTrustManagerTemplateSpecContainers
        nodeSelector: node:
          "kubernetes.io/os": "linux"
        volumes: deploymentTrustManagerTemplateSpecVolumes

let validatingWebhookConfigurationTrustManager = node:
  apiVersion: "admissionregistration.k8s.io/v1"
  kind: "ValidatingWebhookConfiguration"
  metadata: node:
    name: "trust-manager"
    labels: node:
      app: "trust-manager"
      "app.kubernetes.io/name": "trust-manager"
      "helm.sh/chart": "trust-manager-v0.24.0"
      "app.kubernetes.io/instance": "trust-manager"
      "app.kubernetes.io/version": "v0.24.0"
      "app.kubernetes.io/managed-by": "Helm"
    annotations: node:
      "cert-manager.io/inject-ca-from": "cert-manager/trust-manager"
  webhooks: validatingWebhookConfigurationTrustManagerWebhooks

export let resources =
  - serviceTrustManagerMetrics
  - serviceTrustManager
  - deploymentTrustManager
  - validatingWebhookConfigurationTrustManager
