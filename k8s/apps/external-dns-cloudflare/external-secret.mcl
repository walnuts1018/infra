let data =
  - secretKey: "cloudflare_api_token"
    remoteRef:
      key: "external-dns"
      property: "cloudflare_api_token"

export let name = "external-dns-cloudflare"

export let resource = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: name
    namespace: "external-dns-cloudflare"
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: name
      template:
        engineVersion: "v2"
        type: "Opaque"
    data: data
