export fn resource(namespace: String) -> Map<String, Any> = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "HTTPRoute"
  metadata:
    name: "seaweedfs-biscuit-s3"
    namespace: namespace
  spec:
    hostnames:
      - "seaweedfs-biscuit.local.walnuts.dev"
    parentRefs:
      -
        name: "cilium-gateway"
        namespace: "cilium-system"
    rules:
      -
        backendRefs:
          -
            kind: "Service"
            name: "seaweedfs-biscuit"
            port: 8333
        timeouts:
          request: "1h"
