export fn service(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    labels:
      app: "seaweedfs-biscuit"
      "app.kubernetes.io/component": "mini"
      "app.kubernetes.io/name": "seaweedfs-biscuit"
    name: "seaweedfs-biscuit"
    namespace: namespace
  spec:
    clusterIP: "None"
    ports:
      -
        name: "s3"
        port: 8333
        protocol: "TCP"
        targetPort: "s3"
    selector:
      app: "seaweedfs-biscuit"
      "app.kubernetes.io/component": "mini"
      "app.kubernetes.io/name": "seaweedfs-biscuit"
    type: "ClusterIP"

export fn metaPVC(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "PersistentVolumeClaim"
  metadata:
    labels:
      app: "seaweedfs-biscuit"
      "app.kubernetes.io/component": "mini"
      "app.kubernetes.io/name": "seaweedfs-biscuit"
    name: "seaweedfs-meta"
    namespace: namespace
  spec:
    accessModes:
      - "ReadWriteOnce"
    resources:
      requests:
        storage: "20Gi"
    storageClassName: "topolvm-ssd"
    volumeMode: "Filesystem"

export fn volumePVC(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "PersistentVolumeClaim"
  metadata:
    labels:
      app: "seaweedfs-biscuit"
      "app.kubernetes.io/component": "mini"
      "app.kubernetes.io/name": "seaweedfs-biscuit"
    name: "seaweedfs-volume"
    namespace: namespace
  spec:
    accessModes:
      - "ReadWriteOnce"
    resources:
      requests:
        storage: "800Gi"
    storageClassName: "topolvm-hdd"
    volumeMode: "Filesystem"
