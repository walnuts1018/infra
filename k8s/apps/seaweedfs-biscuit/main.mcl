import "./compute.mcl" as compute
import "./config.mcl" as config
import "./routes.mcl" as routes
import "./external-secrets.mcl" as externalSecrets
import "./storage.mcl" as storage
import "../../cluster.mcl" as clusterConfig
param cluster: clusterConfig.Cluster
param namespace: String

emit compute.resource(namespace)
emit config.resource(namespace)
emit routes.resource(namespace)
emit externalSecrets.resource(namespace)
emit storage.service(namespace)
emit storage.metaPVC(namespace)
emit storage.volumePVC(namespace)
