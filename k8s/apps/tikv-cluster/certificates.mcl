let issuer =
  name: "local"
  kind: "ClusterIssuer"
  group: "cert-manager.io"

let tlsUsages =
  - "server auth"
  - "client auth"

let clientUsages =
  - "client auth"

fn serviceNames(name: String, namespace: String) -> List<String> =
  - name
  - name + "." + namespace
  - name + "." + namespace + ".svc"
  - name + "." + namespace + ".svc.cluster.local"

fn pdNames(namespace: String) -> List<String> =
  - "tikv-cluster-pd"
  - "tikv-cluster-pd." + namespace
  - "tikv-cluster-pd." + namespace + ".svc"
  - "tikv-cluster-pd." + namespace + ".svc.cluster.local"
  - "tikv-cluster-pd-peer"
  - "tikv-cluster-pd-peer." + namespace
  - "tikv-cluster-pd-peer." + namespace + ".svc"
  - "tikv-cluster-pd-peer." + namespace + ".svc.cluster.local"
  - "*.tikv-cluster-pd-peer"
  - "*.tikv-cluster-pd-peer." + namespace
  - "*.tikv-cluster-pd-peer." + namespace + ".svc"
  - "*.tikv-cluster-pd-peer." + namespace + ".svc.cluster.local"

fn tikvNames(namespace: String) -> List<String> =
  - "tikv-cluster-tikv"
  - "tikv-cluster-tikv." + namespace
  - "tikv-cluster-tikv." + namespace + ".svc"
  - "tikv-cluster-tikv." + namespace + ".svc.cluster.local"
  - "tikv-cluster-tikv-peer"
  - "tikv-cluster-tikv-peer." + namespace
  - "tikv-cluster-tikv-peer." + namespace + ".svc"
  - "tikv-cluster-tikv-peer." + namespace + ".svc.cluster.local"
  - "*.tikv-cluster-tikv-peer"
  - "*.tikv-cluster-tikv-peer." + namespace
  - "*.tikv-cluster-tikv-peer." + namespace + ".svc"
  - "*.tikv-cluster-tikv-peer." + namespace + ".svc.cluster.local"

fn pdCertificate(namespace: String) -> Map<String, Any> =
  apiVersion: "cert-manager.io/v1"
  kind: "Certificate"
  metadata:
    name: "tikv-cluster-pd-cluster-secret"
    namespace: namespace
  spec:
    secretName: "tikv-cluster-pd-cluster-secret"
    duration: "8760h"
    renewBefore: "360h"
    commonName: "TiDB"
    usages: tlsUsages
    dnsNames: pdNames(namespace)
    issuerRef: issuer

fn tikvCertificate(namespace: String) -> Map<String, Any> =
  apiVersion: "cert-manager.io/v1"
  kind: "Certificate"
  metadata:
    name: "tikv-cluster-tikv-cluster-secret"
    namespace: namespace
  spec:
    secretName: "tikv-cluster-tikv-cluster-secret"
    duration: "8760h"
    renewBefore: "360h"
    commonName: "TiDB"
    usages: tlsUsages
    dnsNames: tikvNames(namespace)
    issuerRef: issuer

fn clientCertificate(namespace: String) -> Map<String, Any> =
  apiVersion: "cert-manager.io/v1"
  kind: "Certificate"
  metadata:
    name: "tikv-cluster-cluster-client-secret"
    namespace: namespace
  spec:
    secretName: "tikv-cluster-cluster-client-secret"
    duration: "8760h"
    renewBefore: "360h"
    commonName: "TiDB"
    usages: clientUsages
    issuerRef: issuer

export fn resources(namespace: String) -> List<Map<String, Any>> =
  - pdCertificate(namespace)
  - tikvCertificate(namespace)
  - clientCertificate(namespace)
