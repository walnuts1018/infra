import "./values.mcl" as appValues
import "../../cluster.mcl" as clusterConfig
param cluster: clusterConfig.Cluster

let binding =
  apiVersion: "rbac.authorization.k8s.io/v1"
  kind: "ClusterRoleBinding"
  metadata:
    name: "zitadel-kubernetes-cluster-admins"
  roleRef:
    apiGroup: "rbac.authorization.k8s.io"
    kind: "ClusterRole"
    name: "cluster-admin"
  subjects:
    - apiGroup: "rbac.authorization.k8s.io"
      kind: "Group"
      name: "zitadel:" + appValues.oidcIssuerAudience + ":cluster-admin"

emit binding
