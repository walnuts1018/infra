import "./app.mcl" as app
import "./labels.mcl" as labels

let appLabels = labels.forApp(app.name)

export fn resource(namespace: String) -> Map<String, Any> =
  apiVersion: "policy/v1"
  kind: "PodDisruptionBudget"
  metadata:
    name: app.name
    namespace: namespace
    labels: appLabels
  spec:
    minAvailable: 1
    selector:
      matchLabels: appLabels
