import "./app.mcl" as app
import "./labels.mcl" as labels

let appLabels = labels.forApp(app.name)
let valkeyName = app.name + "-valkey"
let valkeyLabels = labels.forApp(valkeyName)

export fn application(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    name: app.name
    namespace: namespace
    labels: appLabels
  spec:
    selector: appLabels
    ports:
      - protocol: "TCP"
        port: 8080
        targetPort: 3000
    type: "ClusterIP"

export fn valkey(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    name: valkeyName
    namespace: namespace
    labels: valkeyLabels
  spec:
    selector: valkeyLabels
    ports:
      - name: "valkey"
        port: 6379
        targetPort: "valkey"

export fn valkeyHeadless(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    name: valkeyName + "-headless"
    namespace: namespace
    labels: valkeyLabels
  spec:
    clusterIP: "None"
    selector: valkeyLabels
    ports:
      - name: "valkey"
        port: 6379
        targetPort: "valkey"
