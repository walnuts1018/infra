import text "./_configs/default.yml" as defaultConfig
import "./app.mcl" as app
import "./labels.mcl" as labels

export let resource = node:
  apiVersion: "v1"
  kind: "ConfigMap"
  metadata:
    name: app.name
    namespace: app.namespace
    labels: labels.forApp(app.name)
  data:
    "default.yml": defaultConfig
