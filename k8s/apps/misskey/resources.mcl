import "./config.mcl" as config
import "./backup.mcl" as backup
import "./deployment.mcl" as deployment
import "./external-secrets.mcl" as externalSecrets
import "./pdb.mcl" as pdb
import "./postgres.mcl" as postgres
import "./routing.mcl" as routing
import "./services.mcl" as services
import "./valkey.mcl" as valkey
import "./vpa.mcl" as vpa

export fn resources(namespace: String) -> List<Map<String, Any>> =
  - config.resource(namespace)
  - deployment.resource(namespace)
  - externalSecrets.appSecret(namespace)
  - externalSecrets.postgresPassword(namespace)
  - pdb.resource(namespace)
  - vpa.resource(namespace)
  - postgres.cluster(namespace)
  - backup.objectStore(namespace)
  - backup.scheduledBackup(namespace)
  - routing.webRoute(namespace)
  - routing.userContentRoute(namespace)
  - routing.seaweedReferenceGrant(namespace)
  - services.application(namespace)
  - services.valkey(namespace)
  - services.valkeyHeadless(namespace)
  - valkey.statefulSet(namespace)
