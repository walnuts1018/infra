import "./app.mcl" as app

let envoyGatewayName = "envoy-gateway"
let envoyGatewayNamespace = "envoy-gateway-system"
let seaweedNamespace = "seaweedfs"
let seaweedFilerName = "seaweedfs-default-filer"
let seaweedS3DomainName = "seaweedfs.local.walnuts.dev"
let gatewayParentReference =
  name: envoyGatewayName
  namespace: envoyGatewayNamespace
let gatewayParentReferences =
  - gatewayParentReference

let webPath =
  type: "PathPrefix"
  value: "/"
let webPathMatch =
  path: webPath
let webMatches =
  - webPathMatch
let webBackendReference =
  kind: "Service"
  name: app.name
  port: 8080
  weight: 1
let webBackendReferences =
  - webBackendReference
let webRule =
  matches: webMatches
  backendRefs: webBackendReferences
let webRules =
  - webRule
let webHostnames =
  - "misskey.walnuts.dev"
let webRouteSpec =
  parentRefs: gatewayParentReferences
  hostnames: webHostnames
  rules: webRules

export fn webRoute(namespace: String) -> Map<String, Any> =
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "HTTPRoute"
  metadata:
    name: app.name
    namespace: namespace
    annotations:
      "external-dns-cloudflare.alpha.kubernetes.io/cloudflare-proxied": "true"
  spec: webRouteSpec

let userContentPath =
  type: "PathPrefix"
  value: "/files"
let userContentPathMatch =
  path: userContentPath
let userContentMatches =
  - userContentPathMatch
let replacementPath =
  type: "ReplacePrefixMatch"
  replacePrefixMatch: "/misskey/files"
let urlRewrite =
  hostname: seaweedS3DomainName
  path: replacementPath
let urlRewriteFilter =
  type: "URLRewrite"
  urlRewrite: urlRewrite
let forwardedPrefix =
  - name: "X-Forwarded-Prefix"
    value: "/files"
let requestHeaderModifier =
  add: forwardedPrefix
let requestHeaderFilter =
  type: "RequestHeaderModifier"
  requestHeaderModifier: requestHeaderModifier
let userContentFilters =
  - urlRewriteFilter
  - requestHeaderFilter
let userContentBackendReference =
  kind: "Service"
  name: seaweedFilerName
  namespace: seaweedNamespace
  port: 8333
  weight: 1
let userContentBackendReferences =
  - userContentBackendReference
let userContentRule =
  matches: userContentMatches
  filters: userContentFilters
  backendRefs: userContentBackendReferences
let userContentRules =
  - userContentRule
let userContentHostnames =
  - "misskeyusercontent.walnuts.dev"
let userContentRouteSpec =
  parentRefs: gatewayParentReferences
  hostnames: userContentHostnames
  rules: userContentRules

export fn userContentRoute(namespace: String) -> Map<String, Any> =
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "HTTPRoute"
  metadata:
    name: app.name + "-usercontent"
    namespace: namespace
    annotations:
      "external-dns-cloudflare.alpha.kubernetes.io/cloudflare-proxied": "true"
  spec: userContentRouteSpec

export fn seaweedReferenceGrant(namespace: String) -> Map<String, Any> =
  apiVersion: "gateway.networking.k8s.io/v1beta1"
  kind: "ReferenceGrant"
  metadata:
    name: app.name
    namespace: seaweedNamespace
  spec:
    from:
      - group: "gateway.networking.k8s.io"
        kind: "HTTPRoute"
        namespace: namespace
    to:
      - group: ""
        kind: "Service"
