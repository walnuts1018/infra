import "./app.mcl" as app

let objectStoreEnvironment =
  - name: "AWS_WEB_IDENTITY_TOKEN_FILE"
    value: "/projected/sts.seaweedfs.com/serviceaccount/token"
  - name: "AWS_ENDPOINT_URL_STS"
    value: "https://seaweedfs.local.walnuts.dev"
  - name: "AWS_REGION"
    value: "us-east-1"
  - name: "AWS_ROLE_ARN"
    value: "arn:aws:iam::role/cloudnative-pg-backup"
let objectStoreConfiguration =
  destinationPath: "s3://cloudnative-pg-backup/"
  endpointURL: "https://seaweedfs.local.walnuts.dev"
  s3Credentials:
    inheritFromIAMRole: true
  data:
    compression: "bzip2"
  wal:
    compression: "xz"
let objectStoreSpec =
  configuration: objectStoreConfiguration
  retentionPolicy: "3d"
  instanceSidecarConfiguration:
    env: objectStoreEnvironment

export fn objectStore(namespace: String) -> Map<String, Any> =
  apiVersion: "barmancloud.cnpg.io/v1"
  kind: "ObjectStore"
  metadata:
    name: "seaweedfs-store"
    namespace: namespace
  spec: objectStoreSpec

let scheduledBackupSpec =
  cluster:
    name: app.name + "-postgresql"
  schedule: "0 0 18 */3 * *"
  backupOwnerReference: "self"
  method: "plugin"
  pluginConfiguration:
    name: "barman-cloud.cloudnative-pg.io"

export fn scheduledBackup(namespace: String) -> Map<String, Any> =
  apiVersion: "postgresql.cnpg.io/v1"
  kind: "ScheduledBackup"
  metadata:
    name: app.name + "-postgresql-backup"
    namespace: namespace
  spec: scheduledBackupSpec
