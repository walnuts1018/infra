import "std:hash" as hashes
import text "./_configs/default.yml" as defaultConfig
import "./app.mcl" as app

let appSecretData =
  - secretKey: "dbPassword"
    remoteRef:
      key: "misskey"
      property: "dbpassword"
  - secretKey: "redisPassword"
    remoteRef:
      key: "redis"
      property: "password"
let appSecretTemplateData =
  dbPassword: "{{ .dbPassword }}"
  redisPassword: "{{ .redisPassword }}"
let appSecretHashInput =
  data: appSecretData
  templateData: appSecretTemplateData
  defaultConfig: defaultConfig
export let appSecretName = app.name + "-" + hashes.fnv1a64(appSecretHashInput)

export fn appSecret(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: appSecretName
    namespace: namespace
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: appSecretName
      template:
        engineVersion: "v2"
        type: "Opaque"
        data: appSecretTemplateData
        templateFrom:
          - target: "Data"
            configMap:
              name: app.name
              items:
                - key: "default.yml"
                  templateAs: "Values"
    data: appSecretData

let postgresPasswordData =
  - secretKey: "password"
    remoteRef:
      key: "misskey"
      property: "dbpassword"
export let postgresPasswordSecretName = app.name + "-db-password"

export fn postgresPassword(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: postgresPasswordSecretName
    namespace: namespace
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: postgresPasswordSecretName
      template:
        engineVersion: "v2"
        type: "kubernetes.io/basic-auth"
        data:
          username: "misskey"
          password: "{{ .password }}"
    data: postgresPasswordData
