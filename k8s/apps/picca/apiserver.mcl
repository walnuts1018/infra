import "./names.mcl" as names
import "./worker-common.mcl" as workerCommon
import "./environment.mcl" as environment

let emptyMap: Map<String, Any> = {}

fn deploymentPiccaApiserver(namespace: String) -> Map<String, Any> = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    labels:
      app: "picca-apiserver"
      "app.kubernetes.io/name": "picca-apiserver"
    name: "picca-apiserver"
    namespace: namespace
  spec:
    replicas: 1
    selector:
      matchLabels:
        app: "picca-apiserver"
        "app.kubernetes.io/name": "picca-apiserver"
    template:
      metadata:
        labels:
          app: "picca-apiserver"
          "app.kubernetes.io/name": "picca-apiserver"
      spec:
        containers:
          -
            env: environment.apiServerEnvironment()
            envFrom:
              -
                secretRef:
                  name: names.piccaPostgresSecretName
              -
                secretRef:
                  name: names.piccaScyllaSecretName
              -
                secretRef:
                  name: names.piccaValkeySecretName
              -
                secretRef:
                  name: names.piccaRabbitmqSecretName
              -
                secretRef:
                  name: names.piccaOidcSecretName
              -
                secretRef:
                  name: names.piccaGraphqlSecretName
              -
                secretRef:
                  name: names.piccaImgproxySecretName
            image: "ghcr.io/walnuts1018/picca/apiserver:v0.0.49"
            imagePullPolicy: "IfNotPresent"
            livenessProbe:
              failureThreshold: 5
              httpGet:
                path: "/livez"
                port: 8080
              initialDelaySeconds: 10
            name: "apiserver"
            ports:
              -
                containerPort: 8080
            readinessProbe:
              failureThreshold: 5
              httpGet:
                path: "/readyz"
                port: 8080
              initialDelaySeconds: 10
            resources:
              limits:
                cpu: "500m"
                memory: "512Mi"
              requests:
                cpu: "50m"
                memory: "128Mi"
            securityContext: workerCommon.containerSecurityContext
            volumeMounts:
              -
                mountPath: "/tmp"
                name: "tmp"
              -
                mountPath: "/var/run/secrets/sts.seaweedfs.com/serviceaccount"
                name: "seaweedfs-sts-token"
                readOnly: true
              -
                mountPath: "/etc/certs/scylla-db"
                name: "scylla-db-ca-cert"
                readOnly: true
              -
                mountPath: "/etc/certs/scylla-db-client"
                name: "scylla-db-client-cert"
                readOnly: true
              -
                mountPath: "/etc/picca/plans"
                name: "picca-plans"
                readOnly: true
        imagePullSecrets:
          -
            name: "ghcr-login-secret"
        initContainers:
          -
            env: environment.migrationEnvironment("picca-apiserver")
            envFrom:
              -
                secretRef:
                  name: names.piccaPostgresSecretName
              -
                secretRef:
                  name: names.piccaScyllaSecretName
            image: "ghcr.io/walnuts1018/picca/migrations:v0.0.49"
            imagePullPolicy: "IfNotPresent"
            name: "migrations"
            securityContext: workerCommon.containerSecurityContext
            volumeMounts:
              -
                mountPath: "/var/run/secrets/sts.seaweedfs.com/serviceaccount"
                name: "seaweedfs-sts-token"
                readOnly: true
              -
                mountPath: "/etc/certs/scylla-db"
                name: "scylla-db-ca-cert"
                readOnly: true
              -
                mountPath: "/etc/certs/scylla-db-client"
                name: "scylla-db-client-cert"
                readOnly: true
        securityContext:
          runAsGroup: 65532
          runAsNonRoot: true
          runAsUser: 65532
        serviceAccountName: "picca"
        volumes:
          -
            emptyDir: emptyMap
            name: "tmp"
          -
            name: "seaweedfs-sts-token"
            projected:
              sources:
                -
                  serviceAccountToken:
                    audience: "sts.seaweedfs.com"
                    expirationSeconds: 86400
                    path: "token"
          -
            configMap:
              items:
                -
                  key: "ca.crt"
                  path: "ca.crt"
              name: names.piccaScylladbCaConfigMapName
            name: "scylla-db-ca-cert"
          -
            name: "scylla-db-client-cert"
            secret:
              items:
                -
                  key: "tls.crt"
                  path: "tls.crt"
                -
                  key: "tls.key"
                  path: "tls.key"
              secretName: "scylla-cluster-local-client-ca"
          -
            configMap:
              items:
                -
                  key: "plans.yaml"
                  path: "plans.yaml"
              name: names.piccaPlansConfigMapName
            name: "picca-plans"
fn servicePiccaApiserver(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    labels:
      app: "picca-apiserver"
      "app.kubernetes.io/name": "picca-apiserver"
    name: "picca-apiserver"
    namespace: namespace
  spec:
    ports:
      -
        name: "http"
        port: 8080
        targetPort: 8080
    selector:
      app: "picca-apiserver"
      "app.kubernetes.io/name": "picca-apiserver"
    type: "ClusterIP"

export fn render(namespace: String) -> List<Map<String, Any>> =
  - deploymentPiccaApiserver(namespace)
  - servicePiccaApiserver(namespace)
