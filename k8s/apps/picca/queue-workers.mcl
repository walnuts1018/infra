
import "./names.mcl" as names
import "./worker-common.mcl" as workerCommon

let emptyMap: Map<String, Any> = {}

fn deploymentPiccaOutboxWorker(namespace: String) -> Map<String, Any> = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    labels:
      app: "picca-outbox-worker"
      "app.kubernetes.io/name": "picca-outbox-worker"
    name: "picca-outbox-worker"
    namespace: namespace
  spec:
    replicas: 1
    selector:
      matchLabels:
        app: "picca-outbox-worker"
        "app.kubernetes.io/name": "picca-outbox-worker"
    template:
      metadata:
        labels:
          app: "picca-outbox-worker"
          "app.kubernetes.io/name": "picca-outbox-worker"
      spec:
        containers:
          -
            env: workerCommon.environmentWithScylla("picca-outbox-worker")
            envFrom: workerCommon.envFromWithScylla
            image: "ghcr.io/walnuts1018/picca/outbox-worker:v0.0.49"
            imagePullPolicy: "IfNotPresent"
            livenessProbe: workerCommon.livenessProbe
            name: "outbox-worker"
            ports:
              -
                containerPort: 8080
                name: "health"
            resources:
              limits:
                cpu: "1"
                memory: "512Mi"
              requests:
                cpu: "100m"
                memory: "256Mi"
            securityContext: workerCommon.containerSecurityContext
            startupProbe: workerCommon.startupProbe
            volumeMounts:
              -
                mountPath: "/tmp"
                name: "tmp"
              -
                mountPath: "/var/run/secrets/sts.seaweedfs.com/serviceaccount"
                name: "seaweedfs-sts-token"
                readOnly: true
              -
                mountPath: "/etc/certs/scylla-db"
                name: "scylla-db-ca-cert"
                readOnly: true
              -
                mountPath: "/etc/certs/scylla-db-client"
                name: "scylla-db-client-cert"
                readOnly: true
              -
                mountPath: "/etc/picca/plans"
                name: "picca-plans"
                readOnly: true
        imagePullSecrets: workerCommon.imagePullSecrets
        securityContext: workerCommon.podSecurityContext
        serviceAccountName: workerCommon.serviceAccountName
        volumes:
          -
            emptyDir: emptyMap
            name: "tmp"
          -
            name: "seaweedfs-sts-token"
            projected:
              sources:
                -
                  serviceAccountToken:
                    audience: "sts.seaweedfs.com"
                    expirationSeconds: 86400
                    path: "token"
          -
            configMap:
              items:
                -
                  key: "ca.crt"
                  path: "ca.crt"
              name: names.piccaScylladbCaConfigMapName
            name: "scylla-db-ca-cert"
          -
            name: "scylla-db-client-cert"
            secret:
              items:
                -
                  key: "tls.crt"
                  path: "tls.crt"
                -
                  key: "tls.key"
                  path: "tls.key"
              secretName: "scylla-cluster-local-client-ca"
          -
            configMap:
              items:
                -
                  key: "plans.yaml"
                  path: "plans.yaml"
              name: names.piccaPlansConfigMapName
            name: "picca-plans"

