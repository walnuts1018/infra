fn triggerAuthenticationPiccaRabbitmqWorkerAuth(namespace: String) -> Map<String, Any> = node:
  apiVersion: "keda.sh/v1alpha1"
  kind: "TriggerAuthentication"
  metadata:
    name: "picca-rabbitmq-worker-auth"
    namespace: namespace
  spec:
    secretTargetRef:
      -
        key: "KEDA_RABBITMQ_HOST"
        name: names.piccaRabbitmqSecretName
        parameter: "host"

export fn outbox(namespace: String) -> List<Map<String, Any>> =
  - deploymentPiccaOutboxWorker(namespace)

export fn processingReconciler(namespace: String) -> List<Map<String, Any>> =
  - deploymentPiccaProcessingReconciler(namespace)

export fn storageReconciler(namespace: String) -> List<Map<String, Any>> =
  - deploymentPiccaStorageReconciler(namespace)

export fn triggerAuthentication(namespace: String) -> List<Map<String, Any>> =
  - triggerAuthenticationPiccaRabbitmqWorkerAuth(namespace)
