import "./names.mcl" as names
import "./secret-data.mcl" as secretData

export fn graphqlSigningExternalSecret(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: names.piccaGraphqlSecretName
    namespace: namespace
  spec:
    data: secretData.piccaGraphqlData
    refreshInterval: "1m"
    secretStoreRef:
      kind: "ClusterSecretStore"
      name: "onepassword"
    target:
      name: names.piccaGraphqlSecretName
      template:
        data: secretData.piccaGraphqlTemplateData
        engineVersion: "v2"
        type: "Opaque"

