import "./configmaps.mcl" as configmaps
import "./names.mcl" as names
import "./rabbitmq.mcl" as rabbitmq
import "./routes.mcl" as routes
import "./service-account.mcl" as serviceAccount
import "./external-secrets.mcl" as externalSecrets
import "./scylla.mcl" as scylla
import "./valkey-cluster.mcl" as valkeyCluster
import "./valkey.mcl" as valkey

export let piccaGraphqlSecretName = names.piccaGraphqlSecretName

export let piccaImgproxySecretName = names.piccaImgproxySecretName

export let piccaOidcSecretName = names.piccaOidcSecretName

export let piccaPostgresSecretName = names.piccaPostgresSecretName

export let piccaRabbitmqSecretName = names.piccaRabbitmqSecretName

export let piccaScyllaSecretName = names.piccaScyllaSecretName

export let piccaValkeySecretName = names.piccaValkeySecretName

export let piccaPlansConfigMapName = names.piccaPlansConfigMapName

export let piccaScylladbCaConfigMapName = names.piccaScylladbCaConfigMapName


export fn render(namespace: String) -> List<Map<String, Any>> =
  - configmaps.plansConfigMap(namespace)
  - configmaps.scyllaCAConfigMap(namespace)
  - externalSecrets.graphqlSigningExternalSecret(namespace)
  - routes.httpRoutePiccaImgproxy(namespace)
  - routes.httpRoutePicca(namespace)
  - routes.httpRoutePiccaHttp(namespace)
  - externalSecrets.imgproxyExternalSecret(namespace)
  - routes.networkPolicyPicca(namespace)
  - externalSecrets.oidcExternalSecret(namespace)
  - externalSecrets.postgresExternalSecret(namespace)
  - externalSecrets.externalSecretPiccaRabbitmqUserCredentials(namespace)
  - rabbitmq.permissionPicca(namespace)
  - rabbitmq.rabbitmqExternalSecret(namespace)
  - rabbitmq.userPicca(namespace)
  - rabbitmq.vhostPicca(namespace)
  - serviceAccount.serviceAccountPicca(namespace)
  - scylla.externalSecretScyllaClusterLocalClientCa(namespace)
  - scylla.rolePiccaReadScyllaClientCert()
  - scylla.roleBindingPiccaReadScyllaClientCert()
  - scylla.serviceAccountPiccaScyllaSecretReader(namespace)
  - scylla.secretStoreScyllaClientCert(namespace)
  - scylla.scyllaExternalSecret(namespace)
  - valkeyCluster.valkeyClusterPiccaValkey(namespace)
  - valkey.valkeyExternalSecret(namespace)
