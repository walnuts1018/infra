        type: "Opaque"

fn externalSecretPiccaRabbitmqUserCredentials(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: "picca-rabbitmq-user-credentials"
    namespace: namespace
  spec:
    data:
      -
        remoteRef:
          key: "terraform-external-secrets"
          property: "picca-rabbitmq-password"
        secretKey: "password"
    refreshInterval: "1m"
    secretStoreRef:
      kind: "ClusterSecretStore"
      name: "onepassword"
    target:
      name: "picca-rabbitmq-user-credentials"
      template:
        data:
          password: "{{ .password }}"
          username: "picca"
        engineVersion: "v2"
        type: "Opaque"

fn permissionPicca(namespace: String) -> Map<String, Any> = node:
  apiVersion: "rabbitmq.com/v1beta1"
  kind: "Permission"
  metadata:
    name: "picca"
    namespace: namespace
  spec:
    permissions:
      configure: ".*"
      read: ".*"
      write: ".*"
    rabbitmqClusterReference:
      name: "default"
      namespace: "rabbitmq"
    userReference:
      name: "picca"
    vhost: "picca"

fn externalSecretPiccaRabbitmq94D271(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: "picca-rabbitmq-94d271"
    namespace: namespace
  spec:
    data:
      -
        remoteRef:
          key: "terraform-external-secrets"
          property: "picca-rabbitmq-password"
        secretKey: "rabbitmq_password"
    refreshInterval: "1m"
    secretStoreRef:
      kind: "ClusterSecretStore"
      name: "onepassword"
    target:
      name: "picca-rabbitmq-94d271"
      template:
        data:
          KEDA_RABBITMQ_HOST: "http://picca:{{ .rabbitmq_password }}@default.rabbitmq.svc.cluster.local:15672/picca"
          RABBITMQ_URL: "amqp://picca:{{ .rabbitmq_password }}@default.rabbitmq.svc.cluster.local:5672/picca"
        engineVersion: "v2"
        type: "Opaque"

fn userPicca(namespace: String) -> Map<String, Any> = node:
  apiVersion: "rabbitmq.com/v1beta1"
  kind: "User"
  metadata:
    name: "picca"
    namespace: namespace
  spec:
    importCredentialsSecret:
      name: "picca-rabbitmq-user-credentials"
    rabbitmqClusterReference:
      name: "default"
      namespace: "rabbitmq"
    tags:
      - "monitoring"

fn vhostPicca(namespace: String) -> Map<String, Any> = node:
  apiVersion: "rabbitmq.com/v1beta1"
  kind: "Vhost"
  metadata:
    name: "picca"
    namespace: namespace
  spec:
    name: "picca"
    rabbitmqClusterReference:
      name: "default"
      namespace: "rabbitmq"

fn serviceAccountPicca(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "ServiceAccount"
  metadata:
    name: "picca"
    namespace: namespace

fn externalSecretScyllaClusterLocalClientCa(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: "scylla-cluster-local-client-ca"
    namespace: namespace
  spec:
    dataFrom:
      -
        extract:
          key: "scylla-cluster-local-client-ca"
    refreshInterval: "1h"
    secretStoreRef:
      kind: "SecretStore"
      name: "scylla-client-cert"
    target:
      name: "scylla-cluster-local-client-ca"

let rolePiccaReadScyllaClientCert = node:
  apiVersion: "rbac.authorization.k8s.io/v1"
  kind: "Role"
  metadata:
    name: "picca-read-scylla-client-cert"
    namespace: "databases"
  rules:
    -
      apiGroups:
        - ""
      resourceNames:
        - "scylla-cluster-local-client-ca"
      resources:
        - "secrets"
      verbs:
        - "get"

let roleBindingPiccaReadScyllaClientCert = node:
  apiVersion: "rbac.authorization.k8s.io/v1"
  kind: "RoleBinding"
  metadata:
    name: "picca-read-scylla-client-cert"
    namespace: "databases"
  roleRef:
    apiGroup: "rbac.authorization.k8s.io"
    kind: "Role"
    name: "picca-read-scylla-client-cert"
  subjects:
    -
      kind: "ServiceAccount"
      name: "picca-scylla-secret-reader"
      namespace: "picca"

fn serviceAccountPiccaScyllaSecretReader(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "ServiceAccount"
  metadata:
    name: "picca-scylla-secret-reader"
    namespace: namespace

fn secretStoreScyllaClientCert(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "SecretStore"
  metadata:
    name: "scylla-client-cert"
    namespace: namespace
  spec:
    provider:
      kubernetes:
        auth:
          serviceAccount:
            name: "picca-scylla-secret-reader"
            namespace: "picca"
        remoteNamespace: "databases"
        server:
          caProvider:
            key: "ca.crt"
            name: "kube-root-ca.crt"
            type: "ConfigMap"
          url: "https://kubernetes.default.svc"

fn externalSecretPiccaScyllaA8F7Af(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: "picca-scylla-a8f7af"
    namespace: namespace
  spec:
    data:
      -
        remoteRef:
          key: "scylladb"
          property: "picca"
        secretKey: "scylla_password"
    refreshInterval: "1m"
    secretStoreRef:
      kind: "ClusterSecretStore"
      name: "onepassword"
    target:
      name: "picca-scylla-a8f7af"
      template:
        data:
          SCYLLA_PASSWORD: "{{ .scylla_password }}"
