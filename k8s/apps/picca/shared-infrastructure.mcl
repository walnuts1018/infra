import text "./_configs/plans.yaml" as plansConfig
import text "./_configs/scylla-ca.crt" as scyllaCaCertificate

let emptyMap: Map<String, Any> = {}

fn configMapPiccaPlans23D579(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  data:
    "plans.yaml": plansConfig
  immutable: true
  kind: "ConfigMap"
  metadata:
    labels:
      app: "picca"
      "app.kubernetes.io/name": "picca"
    name: "picca-plans-23d579"
    namespace: namespace

fn configMapPiccaScylladbCaCertC0F830(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  data:
    "ca.crt": scyllaCaCertificate
  immutable: true
  kind: "ConfigMap"
  metadata:
    labels:
      app: "picca"
      "app.kubernetes.io/name": "picca"
    name: "picca-scylladb-ca-cert-c0f830"
    namespace: namespace

fn externalSecretPiccaGraphqlSigningSecretB86Cef(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: "picca-graphql-signing-secret-b86cef"
