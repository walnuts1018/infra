fn externalSecretPiccaPostgres99751A(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: "picca-postgres-99751a"
    namespace: namespace
  spec:
    data:
      -
        remoteRef:
          key: "postgres_passwords"
          property: "picca"
        secretKey: "postgres_password"
