export let piccaGraphqlData: List<Map<String, Any>> =
  -
    remoteRef:
      key: "terraform-external-secrets"
      property: "picca-graphql-query-signing-secret"
    secretKey: "graphql_query_signing_secret"

export let piccaGraphqlTemplateData: Map<String, String> =
  GRAPHQL_QUERY_SIGNING_SECRET: "{{ .graphql_query_signing_secret }}"
  PICCA_GRAPHQL_QUERY_SIGNING_SECRET: "{{ .graphql_query_signing_secret }}"

export let piccaGraphqlHashInput =
  data: piccaGraphqlData
  templateData: piccaGraphqlTemplateData

export let piccaImgproxyData: List<Map<String, Any>> =
  -
    remoteRef:
      key: "terraform-external-secrets"
      property: "picca-imgproxy-key"
    secretKey: "imgproxy_key"
  -
    remoteRef:
      key: "terraform-external-secrets"
      property: "picca-imgproxy-salt"
    secretKey: "imgproxy_salt"

export let piccaImgproxyTemplateData: Map<String, String> =
  IMGPROXY_ALLOW_ORIGIN: "https://picca.walnuts.dev"
  IMGPROXY_FAIL_ON_DEPRECATION: "true"
  IMGPROXY_KEY: "{{ .imgproxy_key }}"
  IMGPROXY_PROMETHEUS_BIND: ":8081"
  IMGPROXY_S3_ALLOWED_BUCKETS: "picca"
  IMGPROXY_S3_ENDPOINT: "http://seaweedfs-default-filer.seaweedfs.svc.cluster.local:8333"
  IMGPROXY_S3_ENDPOINT_USE_PATH_STYLE: "true"
  IMGPROXY_S3_REGION: "us-east-1"
  IMGPROXY_SALT: "{{ .imgproxy_salt }}"
  IMGPROXY_TTL: "900"
  IMGPROXY_USE_S3: "true"

export let piccaImgproxyHashInput =
  data: piccaImgproxyData
  templateData: piccaImgproxyTemplateData

export let piccaOidcData: List<Map<String, Any>> =
  -
    remoteRef:
      key: "terraform-external-secrets"
      property: "picca-client-id"
    secretKey: "oidc_client_id"
  -
    remoteRef:
      key: "terraform-external-secrets"
      property: "picca-client-secret"
    secretKey: "oidc_client_secret"

export let piccaOidcTemplateData: Map<String, String> =
  OIDC_CLIENT_ID: "{{ .oidc_client_id }}"
  OIDC_CLIENT_SECRET: "{{ .oidc_client_secret }}"

export let piccaOidcHashInput =
  data: piccaOidcData
  templateData: piccaOidcTemplateData

export let piccaPostgresData: List<Map<String, Any>> =
  -
    remoteRef:
      key: "postgres_passwords"
      property: "picca"
    secretKey: "postgres_password"

export let piccaPostgresTemplateData: Map<String, String> =
  DATABASE_URL: "postgres://picca:{{ .postgres_password | urlquery | replace \"+\" \"%20\" }}@postgresql-default-rw.databases.svc.cluster.local:5432/picca?pool_max_conns=2"

export let piccaPostgresHashInput =
  data: piccaPostgresData
  templateData: piccaPostgresTemplateData

export let piccaRabbitmqData: List<Map<String, Any>> =
  -
    remoteRef:
      key: "terraform-external-secrets"
      property: "picca-rabbitmq-password"
    secretKey: "rabbitmq_password"

export let piccaRabbitmqTemplateData: Map<String, String> =
  KEDA_RABBITMQ_HOST: "http://picca:{{ .rabbitmq_password | urlquery | replace \"+\" \"%20\" }}@default.rabbitmq.svc.cluster.local:15672/picca"
  RABBITMQ_URL: "amqp://picca:{{ .rabbitmq_password | urlquery | replace \"+\" \"%20\" }}@default.rabbitmq.svc.cluster.local:5672/picca"

export let piccaRabbitmqHashInput =
  data: piccaRabbitmqData
  templateData: piccaRabbitmqTemplateData

export let piccaScyllaData: List<Map<String, Any>> =
  -
    remoteRef:
      key: "scylladb"
      property: "picca"
    secretKey: "scylla_password"

export let piccaScyllaTemplateData: Map<String, String> =
