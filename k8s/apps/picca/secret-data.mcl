export let piccaValkeyData: List<Map<String, Any>> =
  -
    remoteRef:
      key: "terraform-external-secrets"
      property: "picca-redis-password"
    secretKey: "valkey_password"

export let piccaValkeyTemplateData: Map<String, String> =
  VALKEY_URL: "redis://:{{ .valkey_password | urlquery | replace \"+\" \"%20\" }}@valkey-picca-valkey.picca.svc.cluster.local:6379/0"
  valkey_password: "{{ .valkey_password }}"

export let piccaValkeyHashInput =
  data: piccaValkeyData
