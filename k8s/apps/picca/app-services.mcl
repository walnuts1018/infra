
import "./names.mcl" as names

let emptyMap: Map<String, Any> = {}

fn deploymentPiccaApiserver(namespace: String) -> Map<String, Any> = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    labels:
      app: "picca-apiserver"
      "app.kubernetes.io/name": "picca-apiserver"
    name: "picca-apiserver"
    namespace: namespace
  spec:
    replicas: 1
    selector:
      matchLabels:
        app: "picca-apiserver"
        "app.kubernetes.io/name": "picca-apiserver"
    template:
      metadata:
        labels:
          app: "picca-apiserver"
          "app.kubernetes.io/name": "picca-apiserver"
      spec:
        containers:
          -
            env:
              -
                name: "ENVIRONMENT"
                value: "production"
              -
                name: "OTEL_EXPORTER_OTLP_ENDPOINT"
                value: "http://default-collector.opentelemetry-collector.svc.cluster.local:4318"
              -
                name: "LOG_LEVEL"
                value: "debug"
              -
                name: "AWS_ENDPOINT_URL_S3"
                value: "http://seaweedfs-default-filer.seaweedfs.svc.cluster.local:8333"
              -
                name: "AWS_REGION"
                value: "us-east-1"
              -
                name: "S3_REGION"
                value: "us-east-1"
              -
                name: "S3_BUCKET"
                value: "picca"
              -
                name: "S3_USE_PATH_STYLE"
                value: "true"
              -
                name: "S3_EXTERNAL_ENDPOINT"
                value: "https://picca.seaweedfs.walnuts.dev"
              -
                name: "IMGPROXY_PUBLIC_URL"
                value: "https://imgproxy-picca.walnuts.dev"
              -
                name: "IMGPROXY_BUCKET"
                value: "picca"
              -
                name: "IMGPROXY_TTL"
                value: "900"
              -
                name: "SCYLLA_HOSTS"
                value: "scylla-cluster-client.databases.svc.cluster.local:9142"
              -
                name: "SCYLLA_DATACENTER"
                value: "iwakura"
              -
                name: "SCYLLA_USER"
                value: "picca"
              -
                name: "OIDC_ISSUER"
                value: "https://auth.walnuts.dev"
              -
                name: "OIDC_AUTH_URL"
                value: "https://auth.walnuts.dev/oauth/v2/authorize"
              -
                name: "OIDC_REDIRECT_URL"
                value: "https://picca.walnuts.dev/auth/callback"
              -
                name: "PUBLIC_API_URL"
                value: "https://picca.walnuts.dev"
              -
                name: "ALLOWED_ORIGIN"
                value: "https://picca.walnuts.dev"
              -
                name: "GRAPHQL_QUERY_SIGNING_REQUIRED"
                value: "true"
              -
                name: "QDRANT_HOST"
                value: "qdrant.qdrant.svc.cluster.local"
              -
                name: "QDRANT_PORT"
                value: "6334"
              -
                name: "QDRANT_COLLECTION"
                value: "picca_media"
              -
                name: "DENSE_SERVICE_URL"
                value: "http://picca-dense-service.picca.svc.cluster.local:8001"
              -
                name: "SPARSE_SERVICE_URL"
                value: "http://picca-sparse-service.picca.svc.cluster.local:8002"
              -
                name: "OCR_SERVICE_URL"
                value: "http://picca-ocr-service.picca.svc.cluster.local:8003"
              -
                name: "CAPTION_SERVICE_URL"
                value: "http://picca-caption-service.picca.svc.cluster.local:8004"
              -
                name: "AWS_WEB_IDENTITY_TOKEN_FILE"
                value: "/var/run/secrets/sts.seaweedfs.com/serviceaccount/token"
              -
                name: "AWS_ENDPOINT_URL_STS"
                value: "http://seaweedfs-default-filer.seaweedfs.svc.cluster.local:8333"
              -
                name: "AWS_ROLE_ARN"
                value: "arn:aws:iam::role/picca"
              -
                name: "SCYLLA_CA_CERT_PATH"
                value: "/etc/certs/scylla-db/ca.crt"
              -
                name: "SCYLLA_CLIENT_CERT_PATH"
                value: "/etc/certs/scylla-db-client/tls.crt"
              -
                name: "SCYLLA_CLIENT_KEY_PATH"
                value: "/etc/certs/scylla-db-client/tls.key"
              -
                name: "PLAN_CONFIG_FILE"
                value: "/etc/picca/plans/plans.yaml"
              -
                name: "OTEL_SERVICE_NAME"
                value: "picca-apiserver"
            envFrom:
              -
                secretRef:
                  name: names.piccaPostgresSecretName
              -
                secretRef:
                  name: names.piccaScyllaSecretName
              -
                secretRef:
                  name: names.piccaValkeySecretName
              -
                secretRef:
                  name: names.piccaRabbitmqSecretName
              -
                secretRef:
                  name: names.piccaOidcSecretName
              -
                secretRef:
                  name: names.piccaGraphqlSecretName
              -
                secretRef:
                  name: names.piccaImgproxySecretName
            image: "ghcr.io/walnuts1018/picca/apiserver:v0.0.49"
            imagePullPolicy: "IfNotPresent"
            livenessProbe:
              failureThreshold: 5
              httpGet:
                path: "/livez"
                port: 8080
              initialDelaySeconds: 10
            name: "apiserver"
            ports:
              -
                containerPort: 8080
            readinessProbe:
              failureThreshold: 5
              httpGet:
                path: "/readyz"
                port: 8080
              initialDelaySeconds: 10
            resources:
              limits:
                cpu: "500m"
                memory: "512Mi"
              requests:
                cpu: "50m"
                memory: "128Mi"
            securityContext:
              capabilities:
                add:
                  - "NET_BIND_SERVICE"
                drop:
                  - "all"
              readOnlyRootFilesystem: true
              seccompProfile:
                type: "RuntimeDefault"
            volumeMounts:
              -
                mountPath: "/tmp"
                name: "tmp"
              -
                mountPath: "/var/run/secrets/sts.seaweedfs.com/serviceaccount"
                name: "seaweedfs-sts-token"
                readOnly: true
              -
                mountPath: "/etc/certs/scylla-db"
                name: "scylla-db-ca-cert"
                readOnly: true
              -
                mountPath: "/etc/certs/scylla-db-client"
                name: "scylla-db-client-cert"
                readOnly: true
              -
                mountPath: "/etc/picca/plans"
                name: "picca-plans"
                readOnly: true
        imagePullSecrets:
          -
            name: "ghcr-login-secret"
        initContainers:
          -
            env:
              -
                name: "ENVIRONMENT"
                value: "production"
              -
                name: "OTEL_EXPORTER_OTLP_ENDPOINT"
                value: "http://default-collector.opentelemetry-collector.svc.cluster.local:4318"
              -
                name: "LOG_LEVEL"
                value: "debug"
              -
                name: "AWS_ENDPOINT_URL_S3"
                value: "http://seaweedfs-default-filer.seaweedfs.svc.cluster.local:8333"
              -
                name: "AWS_REGION"
                value: "us-east-1"
              -
                name: "S3_REGION"
                value: "us-east-1"
              -
                name: "S3_BUCKET"
                value: "picca"
              -
                name: "S3_USE_PATH_STYLE"
                value: "true"
              -
                name: "S3_EXTERNAL_ENDPOINT"
                value: "https://picca.seaweedfs.walnuts.dev"
              -
                name: "IMGPROXY_PUBLIC_URL"
                value: "https://imgproxy-picca.walnuts.dev"
              -
                name: "IMGPROXY_BUCKET"
                value: "picca"
              -
                name: "IMGPROXY_TTL"
                value: "900"
              -
                name: "SCYLLA_HOSTS"
                value: "scylla-cluster-client.databases.svc.cluster.local:9142"
              -
                name: "SCYLLA_DATACENTER"
                value: "iwakura"
              -
                name: "SCYLLA_USER"
                value: "picca"
              -
                name: "OIDC_ISSUER"
                value: "https://auth.walnuts.dev"
              -
                name: "OIDC_AUTH_URL"
                value: "https://auth.walnuts.dev/oauth/v2/authorize"
              -
                name: "OIDC_REDIRECT_URL"
                value: "https://picca.walnuts.dev/auth/callback"
              -
                name: "PUBLIC_API_URL"
                value: "https://picca.walnuts.dev"
              -
                name: "ALLOWED_ORIGIN"
                value: "https://picca.walnuts.dev"
              -
                name: "GRAPHQL_QUERY_SIGNING_REQUIRED"
                value: "true"
              -
                name: "QDRANT_HOST"
                value: "qdrant.qdrant.svc.cluster.local"
              -
                name: "QDRANT_PORT"
                value: "6334"
              -
                name: "QDRANT_COLLECTION"
                value: "picca_media"
              -
                name: "DENSE_SERVICE_URL"
                value: "http://picca-dense-service.picca.svc.cluster.local:8001"
              -
                name: "SPARSE_SERVICE_URL"
                value: "http://picca-sparse-service.picca.svc.cluster.local:8002"
              -
                name: "OCR_SERVICE_URL"
                value: "http://picca-ocr-service.picca.svc.cluster.local:8003"
              -
                name: "CAPTION_SERVICE_URL"
                value: "http://picca-caption-service.picca.svc.cluster.local:8004"
              -
                name: "AWS_WEB_IDENTITY_TOKEN_FILE"
                value: "/var/run/secrets/sts.seaweedfs.com/serviceaccount/token"
              -
                name: "AWS_ENDPOINT_URL_STS"
                value: "http://seaweedfs-default-filer.seaweedfs.svc.cluster.local:8333"
              -
                name: "AWS_ROLE_ARN"
                value: "arn:aws:iam::role/picca"
              -
                name: "SCYLLA_CA_CERT_PATH"
                value: "/etc/certs/scylla-db/ca.crt"
              -
                name: "SCYLLA_CLIENT_CERT_PATH"
                value: "/etc/certs/scylla-db-client/tls.crt"
              -
                name: "SCYLLA_CLIENT_KEY_PATH"
                value: "/etc/certs/scylla-db-client/tls.key"
              -
                name: "OTEL_SERVICE_NAME"
                value: "picca-apiserver"
            envFrom:
              -
                secretRef:
                  name: names.piccaPostgresSecretName
              -
                secretRef:
                  name: names.piccaScyllaSecretName
            image: "ghcr.io/walnuts1018/picca/migrations:v0.0.49"
            imagePullPolicy: "IfNotPresent"
            name: "migrations"
            securityContext:
              capabilities:
                add:
                  - "NET_BIND_SERVICE"
                drop:
                  - "all"
              readOnlyRootFilesystem: true
              seccompProfile:
                type: "RuntimeDefault"
            volumeMounts:
              -
                mountPath: "/var/run/secrets/sts.seaweedfs.com/serviceaccount"
                name: "seaweedfs-sts-token"
                readOnly: true
              -
                mountPath: "/etc/certs/scylla-db"
                name: "scylla-db-ca-cert"
                readOnly: true
              -
                mountPath: "/etc/certs/scylla-db-client"
                name: "scylla-db-client-cert"
                readOnly: true
        securityContext:
          runAsGroup: 65532
          runAsNonRoot: true
          runAsUser: 65532
        serviceAccountName: "picca"
        volumes:
          -
            emptyDir: emptyMap
            name: "tmp"
          -
            name: "seaweedfs-sts-token"
            projected:
              sources:
                -
                  serviceAccountToken:
                    audience: "sts.seaweedfs.com"
                    expirationSeconds: 86400
                    path: "token"
          -
            configMap:
              items:
                -
                  key: "ca.crt"
                  path: "ca.crt"
              name: names.piccaScylladbCaConfigMapName
            name: "scylla-db-ca-cert"
          -
            name: "scylla-db-client-cert"
            secret:
              items:
                -
                  key: "tls.crt"
                  path: "tls.crt"
                -
                  key: "tls.key"
                  path: "tls.key"
              secretName: "scylla-cluster-local-client-ca"
          -
            configMap:
              items:
                -
                  key: "plans.yaml"
                  path: "plans.yaml"
              name: names.piccaPlansConfigMapName
            name: "picca-plans"

fn servicePiccaApiserver(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    labels:
      app: "picca-apiserver"
      "app.kubernetes.io/name": "picca-apiserver"
    name: "picca-apiserver"
    namespace: namespace
  spec:
    ports:
      -
        name: "http"
        port: 8080
        targetPort: 8080
    selector:
      app: "picca-apiserver"
      "app.kubernetes.io/name": "picca-apiserver"
    type: "ClusterIP"

fn deploymentPiccaFrontend(namespace: String) -> Map<String, Any> = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    labels:
      app: "picca-frontend"
      "app.kubernetes.io/name": "picca-frontend"
    name: "picca-frontend"
    namespace: namespace
  spec:
    replicas: 1
    selector:
      matchLabels:
        app: "picca-frontend"
        "app.kubernetes.io/name": "picca-frontend"
    template:
      metadata:
        labels:
          app: "picca-frontend"
          "app.kubernetes.io/name": "picca-frontend"
      spec:
        containers:
          -
            env:
              -
                name: "PICCA_API_URL"
                value: "http://picca-apiserver.picca.svc.cluster.local:8080"
              -
                name: "PICCA_GRAPHQL_ENDPOINT"
                value: "https://picca.walnuts.dev/query"
              -
                name: "PICCA_S3_EXTERNAL_ENDPOINT"
                value: "https://picca.seaweedfs.walnuts.dev"
              -
                name: "PICCA_IMGPROXY_PUBLIC_URL"
                value: "https://imgproxy-picca.walnuts.dev"
              -
                name: "PICCA_MAPS_URL"
                value: "https://maps.walnuts.dev"
              -
                name: "OTEL_EXPORTER_OTLP_ENDPOINT"
                value: "http://default-collector.opentelemetry-collector.svc.cluster.local:4318"
              -
                name: "OTEL_SERVICE_NAME"
                value: "picca-frontend"
              -
                name: "PICCA_GRAPHQL_QUERY_SIGNING_SECRET"
                valueFrom:
                  secretKeyRef:
                    key: "PICCA_GRAPHQL_QUERY_SIGNING_SECRET"
                    name: names.piccaGraphqlSecretName
            image: "ghcr.io/walnuts1018/picca/frontend:v0.0.49"
            imagePullPolicy: "IfNotPresent"
            livenessProbe:
              failureThreshold: 5
              httpGet:
                path: "/api/health"
                port: 3000
              initialDelaySeconds: 15
            name: "frontend"
            ports:
              -
                containerPort: 3000
            readinessProbe:
              failureThreshold: 5
              httpGet:
                path: "/api/health"
                port: 3000
              initialDelaySeconds: 15
            resources:
              limits:
                cpu: "500m"
                memory: "512Mi"
              requests:
                cpu: "50m"
                memory: "128Mi"
            securityContext:
              capabilities:
                add:
                  - "NET_BIND_SERVICE"
                drop:
                  - "all"
              readOnlyRootFilesystem: true
              seccompProfile:
                type: "RuntimeDefault"
            volumeMounts:
              -
                mountPath: "/tmp"
                name: "tmp"
              -
                mountPath: "/.cache"
                name: "cache"
        imagePullSecrets:
          -
            name: "ghcr-login-secret"
        securityContext:
          fsGroup: 65534
          runAsGroup: 65534
          runAsUser: 10001
        volumes:
          -
            emptyDir: emptyMap
            name: "tmp"
          -
            emptyDir: emptyMap
            name: "cache"

fn servicePiccaFrontend(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    labels:
      app: "picca-frontend"
      "app.kubernetes.io/name": "picca-frontend"
    name: "picca-frontend"
    namespace: namespace
  spec:
    ports:
      -
        name: "http"
        port: 3000
        targetPort: 3000
    selector:
      app: "picca-frontend"
      "app.kubernetes.io/name": "picca-frontend"
    type: "ClusterIP"

fn deploymentPiccaImgproxy(namespace: String) -> Map<String, Any> = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    labels:
      app: "picca-imgproxy"
      "app.kubernetes.io/name": "picca-imgproxy"
    name: "picca-imgproxy"
    namespace: namespace
  spec:
    replicas: 2
    selector:
      matchLabels:
        app: "picca-imgproxy"
        "app.kubernetes.io/name": "picca-imgproxy"
    template:
      metadata:
        labels:
          app: "picca-imgproxy"
          "app.kubernetes.io/name": "picca-imgproxy"
      spec:
        containers:
          -
            env:
              -
                name: "AWS_WEB_IDENTITY_TOKEN_FILE"
                value: "/var/run/secrets/sts.seaweedfs.com/serviceaccount/token"
              -
                name: "AWS_ENDPOINT_URL_STS"
                value: "http://seaweedfs-default-filer.seaweedfs.svc.cluster.local:8333"
              -
                name: "AWS_ROLE_ARN"
                value: "arn:aws:iam::role/picca"
            envFrom:
              -
                secretRef:
                  name: names.piccaImgproxySecretName
            image: "ghcr.io/imgproxy/imgproxy:v4.0.15"
            imagePullPolicy: "IfNotPresent"
            livenessProbe:
              failureThreshold: 5
              httpGet:
                path: "/health"
                port: 8080
              initialDelaySeconds: 30
              timeoutSeconds: 5
            name: "imgproxy"
            ports:
              -
                containerPort: 8080
                name: "http"
              -
                containerPort: 8081
                name: "metrics"
            readinessProbe:
              failureThreshold: 5
              httpGet:
                path: "/health"
                port: 8080
              initialDelaySeconds: 10
              timeoutSeconds: 5
            resources:
              limits:
                cpu: "1"
                memory: "512Mi"
              requests:
                cpu: "50m"
                memory: "128Mi"
            securityContext:
              capabilities:
                add:
                  - "NET_BIND_SERVICE"
                drop:
                  - "all"
              readOnlyRootFilesystem: true
              seccompProfile:
                type: "RuntimeDefault"
            volumeMounts:
              -
                mountPath: "/var/run/secrets/sts.seaweedfs.com/serviceaccount"
                name: "seaweedfs-sts-token"
                readOnly: true
        serviceAccountName: "picca"
        volumes:
          -
            name: "seaweedfs-sts-token"
            projected:
              sources:
                -
                  serviceAccountToken:
                    audience: "sts.seaweedfs.com"
                    expirationSeconds: 86400
                    path: "token"

fn servicePiccaImgproxy(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    labels:
      app: "picca-imgproxy"
      "app.kubernetes.io/name": "picca-imgproxy"
    name: "picca-imgproxy"
    namespace: namespace
  spec:
    ports:
      -
        name: "http"
        port: 80
        targetPort: 8080
      -
        name: "metrics"
        port: 8081
        targetPort: 8081
    selector:
      app: "picca-imgproxy"
      "app.kubernetes.io/name": "picca-imgproxy"
    type: "ClusterIP"

fn serviceMonitorPiccaImgproxy(namespace: String) -> Map<String, Any> = node:
  apiVersion: "monitoring.coreos.com/v1"
  kind: "ServiceMonitor"
  metadata:
    labels:
      app: "picca-imgproxy"
      "app.kubernetes.io/name": "picca-imgproxy"
    name: "picca-imgproxy"
    namespace: namespace
  spec:
    endpoints:
      -
        path: "/metrics"
        port: "metrics"
    namespaceSelector:
      matchNames:
        - "picca"
    selector:
      matchLabels:
        app: "picca-imgproxy"
        "app.kubernetes.io/name": "picca-imgproxy"

export fn render(namespace: String) -> List<Map<String, Any>> =
  - deploymentPiccaApiserver(namespace)
  - servicePiccaApiserver(namespace)
  - deploymentPiccaFrontend(namespace)
  - servicePiccaFrontend(namespace)
  - deploymentPiccaImgproxy(namespace)
  - servicePiccaImgproxy(namespace)
  - serviceMonitorPiccaImgproxy(namespace)
