  - name: "PLAN_CONFIG_FILE"
    value: "/etc/picca/plans/plans.yaml"

export let scyllaEnvironment: List<Map<String, String>> =
  - name: "SCYLLA_HOSTS"
    value: "scylla-cluster-client.databases.svc.cluster.local:9142"
  - name: "SCYLLA_DATACENTER"
    value: "iwakura"
  - name: "SCYLLA_USER"
    value: "picca"
  - name: "SCYLLA_CA_CERT_PATH"
    value: "/etc/certs/scylla-db/ca.crt"
  - name: "SCYLLA_CLIENT_CERT_PATH"
    value: "/etc/certs/scylla-db-client/tls.crt"
  - name: "SCYLLA_CLIENT_KEY_PATH"
    value: "/etc/certs/scylla-db-client/tls.key"

let scyllaSecretReference: List<Map<String, Any>> =
  - secretRef:
      name: names.piccaScyllaSecretName

fn serviceEnvironment(serviceName: String) -> List<Map<String, String>> =
  - name: "OTEL_SERVICE_NAME"
    value: serviceName

fn withEnvironmentValue(variable: Map<String, String>, value: String) -> Map<String, String> = variable with:
  value: value

fn sharedEnvironmentDense(namespace: String, variable: Map<String, String>) -> Map<String, String> =
  if variable.name == "DENSE_SERVICE_URL":
    withEnvironmentValue(variable, "http://picca-dense-service." + namespace + ".svc.cluster.local:8001")
  else:
    variable

fn sharedEnvironmentSparse(namespace: String, variable: Map<String, String>) -> Map<String, String> =
  if variable.name == "SPARSE_SERVICE_URL":
    withEnvironmentValue(variable, "http://picca-sparse-service." + namespace + ".svc.cluster.local:8002")
  else:
    variable

fn sharedEnvironmentOcr(namespace: String, variable: Map<String, String>) -> Map<String, String> =
  if variable.name == "OCR_SERVICE_URL":
    withEnvironmentValue(variable, "http://picca-ocr-service." + namespace + ".svc.cluster.local:8003")
  else:
    variable

fn sharedEnvironmentCaption(namespace: String, variable: Map<String, String>) -> Map<String, String> =
  if variable.name == "CAPTION_SERVICE_URL":
    withEnvironmentValue(variable, "http://picca-caption-service." + namespace + ".svc.cluster.local:8004")
  else:
    variable

fn sharedEnvironmentVariable(namespace: String, variable: Map<String, String>) -> Map<String, String> =
  sharedEnvironmentCaption(namespace, sharedEnvironmentOcr(namespace, sharedEnvironmentSparse(namespace, sharedEnvironmentDense(namespace, variable))))

fn sharedEnvironmentFor(namespace: String) -> List<Map<String, String>> =
  lists.map(sharedEnvironment, fn(variable) => sharedEnvironmentVariable(namespace, variable))

fn envFromWithNamespace(namespace: String) -> List<Map<String, Any>> =
  - secretRef:
      name: names.piccaPostgresSecretName
  - secretRef:
      name: names.piccaValkeySecretName(namespace)
  - secretRef:
      name: names.piccaRabbitmqSecretName
  - secretRef:
      name: names.piccaOidcSecretName

export fn envFrom(namespace: String) -> List<Map<String, Any>> = envFromWithNamespace(namespace)

export fn envFromWithScylla(namespace: String) -> List<Map<String, Any>> =
  lists.concat(
    envFromWithNamespace(namespace),
    scyllaSecretReference,
  )

export fn environment(namespace: String, serviceName: String) -> List<Map<String, String>> =
  lists.concat(sharedEnvironmentFor(namespace), serviceEnvironment(serviceName))

export fn environmentWithScylla(namespace: String, serviceName: String) -> List<Map<String, String>> =
  lists.concat(
    lists.concat(sharedEnvironmentFor(namespace), scyllaEnvironment),
    serviceEnvironment(serviceName),
  )

export fn migrationEnvironment(namespace: String, serviceName: String) -> List<Map<String, String>> =
  lists.concat(
    lists.concat(
      lists.filter(sharedEnvironmentFor(namespace), fn(variable) => variable.name != "PLAN_CONFIG_FILE"),
      scyllaEnvironment,
    ),
    serviceEnvironment(serviceName),
  )

export fn apiServerEnvironment(namespace: String) -> List<Map<String, String>> =
  environmentWithScylla(namespace, "picca-apiserver")
