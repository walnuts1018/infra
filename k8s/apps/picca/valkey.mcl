import "./names.mcl" as names

let valkeySecretData = names.piccaValkeyData
let valkeySecretTemplateData = names.piccaValkeyTemplateData

export fn valkeyExternalSecret(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: names.piccaValkeySecretName
    namespace: namespace
  spec:
    data: valkeySecretData
    refreshInterval: "1m"
    secretStoreRef:
      kind: "ClusterSecretStore"
      name: "onepassword"
    target:
      name: names.piccaValkeySecretName
      template:
        data: valkeySecretTemplateData
        engineVersion: "v2"
        type: "Opaque"
