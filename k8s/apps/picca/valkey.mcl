import "./names.mcl" as names
import "./secret-data.mcl" as secretData

export fn valkeyExternalSecret(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: names.piccaValkeySecretName(namespace)
    namespace: namespace
  spec:
    data: secretData.piccaValkeyData
    refreshInterval: "1m"
    secretStoreRef:
      kind: "ClusterSecretStore"
      name: "onepassword"
    target:
      name: names.piccaValkeySecretName(namespace)
      template:
        data: secretData.piccaValkeyTemplateData(namespace)
        engineVersion: "v2"
        type: "Opaque"
