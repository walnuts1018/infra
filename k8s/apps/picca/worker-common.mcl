import "std:list" as lists
import "./names.mcl" as names

let emptyMap: Map<String, Any> = {}

let sharedEnvironment: List<Map<String, String>> =
  - name: "ENVIRONMENT"
    value: "production"
  - name: "OTEL_EXPORTER_OTLP_ENDPOINT"
    value: "http://default-collector.opentelemetry-collector.svc.cluster.local:4318"
  - name: "LOG_LEVEL"
    value: "debug"
  - name: "AWS_ENDPOINT_URL_S3"
    value: "http://seaweedfs-default-filer.seaweedfs.svc.cluster.local:8333"
  - name: "AWS_REGION"
    value: "us-east-1"
  - name: "S3_REGION"
    value: "us-east-1"
  - name: "S3_BUCKET"
    value: "picca"
  - name: "S3_USE_PATH_STYLE"
    value: "true"
  - name: "S3_EXTERNAL_ENDPOINT"
    value: "https://picca.seaweedfs.walnuts.dev"
  - name: "IMGPROXY_PUBLIC_URL"
    value: "https://imgproxy-picca.walnuts.dev"
  - name: "IMGPROXY_BUCKET"
    value: "picca"
  - name: "IMGPROXY_TTL"
    value: "900"
  - name: "SCYLLA_HOSTS"
    value: "scylla-cluster-client.databases.svc.cluster.local:9142"
  - name: "SCYLLA_DATACENTER"
    value: "iwakura"
  - name: "SCYLLA_USER"
    value: "picca"
  - name: "OIDC_ISSUER"
    value: "https://auth.walnuts.dev"
  - name: "OIDC_AUTH_URL"
    value: "https://auth.walnuts.dev/oauth/v2/authorize"
  - name: "OIDC_REDIRECT_URL"
    value: "https://picca.walnuts.dev/auth/callback"
  - name: "PUBLIC_API_URL"
    value: "https://picca.walnuts.dev"
  - name: "ALLOWED_ORIGIN"
    value: "https://picca.walnuts.dev"
  - name: "GRAPHQL_QUERY_SIGNING_REQUIRED"
    value: "true"
  - name: "QDRANT_HOST"
    value: "qdrant.qdrant.svc.cluster.local"
  - name: "QDRANT_PORT"
    value: "6334"
  - name: "QDRANT_COLLECTION"
    value: "picca_media"
  - name: "DENSE_SERVICE_URL"
    value: "http://picca-dense-service.picca.svc.cluster.local:8001"
  - name: "SPARSE_SERVICE_URL"
    value: "http://picca-sparse-service.picca.svc.cluster.local:8002"
  - name: "OCR_SERVICE_URL"
    value: "http://picca-ocr-service.picca.svc.cluster.local:8003"
  - name: "CAPTION_SERVICE_URL"
    value: "http://picca-caption-service.picca.svc.cluster.local:8004"
  - name: "AWS_WEB_IDENTITY_TOKEN_FILE"
    value: "/var/run/secrets/sts.seaweedfs.com/serviceaccount/token"
  - name: "AWS_ENDPOINT_URL_STS"
    value: "http://seaweedfs-default-filer.seaweedfs.svc.cluster.local:8333"
  - name: "AWS_ROLE_ARN"
    value: "arn:aws:iam::role/picca"

let scyllaEnvironment: List<Map<String, String>> =
  - name: "SCYLLA_CA_CERT_PATH"
    value: "/etc/certs/scylla-db/ca.crt"
  - name: "SCYLLA_CLIENT_CERT_PATH"
    value: "/etc/certs/scylla-db-client/tls.crt"
  - name: "SCYLLA_CLIENT_KEY_PATH"
    value: "/etc/certs/scylla-db-client/tls.key"
  - name: "PLAN_CONFIG_FILE"
    value: "/etc/picca/plans/plans.yaml"

let postgresSecretReference: List<Map<String, Any>> =
  - secretRef:
      name: names.piccaPostgresSecretName

let otherSecretReferences: List<Map<String, Any>> =
  - secretRef:
      name: names.piccaValkeySecretName
  - secretRef:
      name: names.piccaRabbitmqSecretName
  - secretRef:
      name: names.piccaOidcSecretName
  - secretRef:
      name: names.piccaGraphqlSecretName

let scyllaSecretReference: List<Map<String, Any>> =
  - secretRef:
      name: names.piccaScyllaSecretName

export let envFrom = lists.concat(
  postgresSecretReference,
  otherSecretReferences,
)

let envFromGroups: List<List<Map<String, Any>>> =
  - postgresSecretReference
  - scyllaSecretReference
  - otherSecretReferences

export let envFromWithScylla = lists.flatten(envFromGroups)

fn serviceEnvironment(serviceName: String) -> List<Map<String, String>> =
  - name: "OTEL_SERVICE_NAME"
    value: serviceName

let environmentWithScyllaGroups: List<List<Map<String, String>>> =
  - sharedEnvironment
  - scyllaEnvironment

let environmentWithScyllaBase = lists.flatten(environmentWithScyllaGroups)

export fn environment(serviceName: String) -> List<Map<String, String>> =
  lists.concat(sharedEnvironment, serviceEnvironment(serviceName))

export fn environmentWithScylla(serviceName: String) -> List<Map<String, String>> =
  lists.concat(environmentWithScyllaBase, serviceEnvironment(serviceName))

export let imagePullSecrets =
  - name: "ghcr-login-secret"

export let podSecurityContext =
  runAsGroup: 65532
  runAsNonRoot: true
  runAsUser: 65532

export let containerSecurityContext =
  allowPrivilegeEscalation: false
  capabilities:
    drop:
      - "ALL"
  readOnlyRootFilesystem: true
  seccompProfile:
    type: "RuntimeDefault"

export let tmpVolumeMount =
  mountPath: "/tmp"
  name: "tmp"

export let stsTokenVolumeMount =
  mountPath: "/var/run/secrets/sts.seaweedfs.com/serviceaccount"
  name: "seaweedfs-sts-token"
  readOnly: true

export let scyllaCaVolumeMount =
  mountPath: "/etc/certs/scylla-db"
  name: "scylla-db-ca-cert"
  readOnly: true

export let scyllaClientCertVolumeMount =
  mountPath: "/etc/certs/scylla-db-client"
  name: "scylla-db-client-cert"
  readOnly: true

export let tmpVolume =
  emptyDir: emptyMap
  name: "tmp"

export let stsTokenVolume =
  name: "seaweedfs-sts-token"
  projected:
    sources:
      - serviceAccountToken:
          audience: "sts.seaweedfs.com"
          expirationSeconds: 86400
          path: "token"

export let scyllaCaVolume =
  configMap:
    items:
      - key: "ca.crt"
        path: "ca.crt"
    name: names.piccaScylladbCaConfigMapName
  name: "scylla-db-ca-cert"

export let scyllaClientCertVolume =
  name: "scylla-db-client-cert"
  secret:
    items:
      - key: "tls.crt"
        path: "tls.crt"
      - key: "tls.key"
        path: "tls.key"
    secretName: "scylla-cluster-local-client-ca"

export let livenessProbe =
  failureThreshold: 3
  httpGet:
    path: "/healthz"
    port: 8080
  periodSeconds: 15

export let startupProbe =
  failureThreshold: 18
  httpGet:
    path: "/healthz"
    port: 8080
  periodSeconds: 10

export let serviceAccountName = "picca"
