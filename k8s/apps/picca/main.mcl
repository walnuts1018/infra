import "./profiles.mcl" as appProfiles
import "./ai-services.mcl" as aiServices
import "./app-services.mcl" as appServices
import "./shared-infrastructure.mcl" as sharedInfrastructure
import "./workers.mcl" as workers

let namespace = appProfiles.profiles["default"].namespace

emit each aiServices.render(namespace)
emit each appServices.render(namespace)
emit each sharedInfrastructure.render(namespace)
emit each workers.render(namespace)
