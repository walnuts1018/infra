fn scaledObjectPiccaLibraryNotifyWorker(namespace: String) -> Map<String, Any> = node:
  apiVersion: "keda.sh/v1alpha1"
  kind: "ScaledObject"
  metadata:
    name: "picca-library-notify-worker"
    namespace: namespace
  spec:
    maxReplicaCount: 4
    minReplicaCount: 0
    pollingInterval: 5
    scaleTargetRef:
      name: "picca-library-notify-worker"
    triggers:
      -
        authenticationRef:
          name: "picca-rabbitmq-worker-auth"
        metadata:
          mode: "QueueLength"
          protocol: "http"
          queueName: "picca.library-auto-stack"
          value: "2"
        metricType: "AverageValue"
        type: "rabbitmq"
      -
        authenticationRef:
          name: "picca-rabbitmq-worker-auth"
        metadata:
          mode: "QueueLength"
          protocol: "http"
          queueName: "picca.media-processing-notification"
          value: "4"
        metricType: "AverageValue"
        type: "rabbitmq"

