
import "./shared-infrastructure.mcl" as sharedInfrastructure

let emptyMap: Map<String, Any> = {}

fn deploymentPiccaEmbeddingWorker(namespace: String) -> Map<String, Any> = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    labels:
      app: "picca-embedding-worker"
      "app.kubernetes.io/name": "picca-embedding-worker"
    name: "picca-embedding-worker"
    namespace: namespace
  spec:
    replicas: 0
    selector:
      matchLabels:
        app: "picca-embedding-worker"
        "app.kubernetes.io/name": "picca-embedding-worker"
    template:
      metadata:
        labels:
          app: "picca-embedding-worker"
          "app.kubernetes.io/name": "picca-embedding-worker"
      spec:
        containers:
          -
            env:
              -
                name: "ENVIRONMENT"
                value: "production"
              -
                name: "OTEL_EXPORTER_OTLP_ENDPOINT"
                value: "http://default-collector.opentelemetry-collector.svc.cluster.local:4318"
              -
                name: "LOG_LEVEL"
                value: "debug"
              -
                name: "AWS_ENDPOINT_URL_S3"
                value: "http://seaweedfs-default-filer.seaweedfs.svc.cluster.local:8333"
              -
                name: "AWS_REGION"
                value: "us-east-1"
              -
                name: "S3_REGION"
                value: "us-east-1"
              -
                name: "S3_BUCKET"
                value: "picca"
              -
                name: "S3_USE_PATH_STYLE"
                value: "true"
              -
                name: "S3_EXTERNAL_ENDPOINT"
                value: "https://picca.seaweedfs.walnuts.dev"
              -
                name: "IMGPROXY_PUBLIC_URL"
                value: "https://imgproxy-picca.walnuts.dev"
              -
                name: "IMGPROXY_BUCKET"
                value: "picca"
              -
                name: "IMGPROXY_TTL"
                value: "900"
              -
                name: "SCYLLA_HOSTS"
                value: "scylla-cluster-client.databases.svc.cluster.local:9142"
              -
                name: "SCYLLA_DATACENTER"
                value: "iwakura"
              -
                name: "SCYLLA_USER"
                value: "picca"
              -
                name: "OIDC_ISSUER"
                value: "https://auth.walnuts.dev"
              -
                name: "OIDC_AUTH_URL"
                value: "https://auth.walnuts.dev/oauth/v2/authorize"
              -
                name: "OIDC_REDIRECT_URL"
                value: "https://picca.walnuts.dev/auth/callback"
              -
                name: "PUBLIC_API_URL"
                value: "https://picca.walnuts.dev"
              -
                name: "ALLOWED_ORIGIN"
                value: "https://picca.walnuts.dev"
              -
                name: "GRAPHQL_QUERY_SIGNING_REQUIRED"
                value: "true"
              -
                name: "QDRANT_HOST"
                value: "qdrant.qdrant.svc.cluster.local"
              -
                name: "QDRANT_PORT"
                value: "6334"
              -
                name: "QDRANT_COLLECTION"
                value: "picca_media"
              -
                name: "DENSE_SERVICE_URL"
                value: "http://picca-dense-service.picca.svc.cluster.local:8001"
              -
                name: "SPARSE_SERVICE_URL"
                value: "http://picca-sparse-service.picca.svc.cluster.local:8002"
              -
                name: "OCR_SERVICE_URL"
                value: "http://picca-ocr-service.picca.svc.cluster.local:8003"
              -
                name: "CAPTION_SERVICE_URL"
                value: "http://picca-caption-service.picca.svc.cluster.local:8004"
              -
                name: "AWS_WEB_IDENTITY_TOKEN_FILE"
                value: "/var/run/secrets/sts.seaweedfs.com/serviceaccount/token"
              -
                name: "AWS_ENDPOINT_URL_STS"
                value: "http://seaweedfs-default-filer.seaweedfs.svc.cluster.local:8333"
              -
                name: "AWS_ROLE_ARN"
                value: "arn:aws:iam::role/picca"
              -
                name: "OTEL_SERVICE_NAME"
                value: "picca-embedding-worker"
            envFrom:
              -
                secretRef:
                  name: sharedInfrastructure.piccaPostgresSecretName
              -
                secretRef:
                  name: sharedInfrastructure.piccaValkeySecretName
              -
                secretRef:
                  name: sharedInfrastructure.piccaRabbitmqSecretName
              -
                secretRef:
                  name: sharedInfrastructure.piccaOidcSecretName
              -
                secretRef:
                  name: sharedInfrastructure.piccaGraphqlSecretName
            image: "ghcr.io/walnuts1018/picca/embedding-worker:v0.0.49"
            imagePullPolicy: "IfNotPresent"
            livenessProbe:
              failureThreshold: 3
              httpGet:
                path: "/healthz"
                port: 8080
              periodSeconds: 15
            name: "embedding-worker"
            ports:
              -
                containerPort: 8080
                name: "health"
            resources:
              limits:
                cpu: "1"
                memory: "512Mi"
              requests:
                cpu: "250m"
                memory: "256Mi"
            securityContext:
              capabilities:
                add:
                  - "NET_BIND_SERVICE"
                drop:
                  - "all"
              readOnlyRootFilesystem: true
              seccompProfile:
                type: "RuntimeDefault"
            startupProbe:
              failureThreshold: 18
              httpGet:
                path: "/healthz"
                port: 8080
              periodSeconds: 10
            volumeMounts:
              -
                mountPath: "/tmp"
                name: "tmp"
              -
                mountPath: "/var/run/secrets/sts.seaweedfs.com/serviceaccount"
                name: "seaweedfs-sts-token"
                readOnly: true
        imagePullSecrets:
          -
            name: "ghcr-login-secret"
        securityContext:
          runAsGroup: 65532
          runAsNonRoot: true
          runAsUser: 65532
        serviceAccountName: "picca"
        volumes:
          -
            emptyDir: emptyMap
            name: "tmp"
          -
            name: "seaweedfs-sts-token"
            projected:
              sources:
                -
                  serviceAccountToken:
                    audience: "sts.seaweedfs.com"
                    expirationSeconds: 86400
                    path: "token"

fn scaledObjectPiccaEmbeddingWorker(namespace: String) -> Map<String, Any> = node:
  apiVersion: "keda.sh/v1alpha1"
  kind: "ScaledObject"
  metadata:
    name: "picca-embedding-worker"
    namespace: namespace
  spec:
    maxReplicaCount: 4
    minReplicaCount: 0
    pollingInterval: 5
    scaleTargetRef:
      name: "picca-embedding-worker"
    triggers:
      -
        authenticationRef:
          name: "picca-rabbitmq-worker-auth"
        metadata:
          mode: "QueueLength"
          protocol: "http"
          queueName: "picca.embedding-processing"
          value: "2"
        metricType: "AverageValue"
        type: "rabbitmq"

