
import "./names.mcl" as names
import "./worker-common.mcl" as workerCommon

fn deploymentPiccaEmbeddingWorker(namespace: String) -> Map<String, Any> = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    labels:
      app: "picca-embedding-worker"
      "app.kubernetes.io/name": "picca-embedding-worker"
    name: "picca-embedding-worker"
    namespace: namespace
  spec:
    replicas: 0
    selector:
      matchLabels:
        app: "picca-embedding-worker"
        "app.kubernetes.io/name": "picca-embedding-worker"
    template:
      metadata:
        labels:
          app: "picca-embedding-worker"
          "app.kubernetes.io/name": "picca-embedding-worker"
      spec:
        containers:
          -
            env: workerCommon.environment("picca-embedding-worker")
            envFrom: workerCommon.envFrom
            image: "ghcr.io/walnuts1018/picca/embedding-worker:v0.0.49"
            imagePullPolicy: "IfNotPresent"
            livenessProbe: workerCommon.livenessProbe
            name: "embedding-worker"
            ports:
              -
                containerPort: 8080
                name: "health"
            resources:
              limits:
                cpu: "1"
                memory: "512Mi"
              requests:
                cpu: "250m"
                memory: "256Mi"
            securityContext: workerCommon.containerSecurityContext
            startupProbe: workerCommon.startupProbe
            volumeMounts:
              - workerCommon.tmpVolumeMount
              - workerCommon.stsTokenVolumeMount
        imagePullSecrets: workerCommon.imagePullSecrets
        securityContext: workerCommon.podSecurityContext
        serviceAccountName: workerCommon.serviceAccountName
        volumes:
          - workerCommon.tmpVolume
          - workerCommon.stsTokenVolume

fn scaledObjectPiccaEmbeddingWorker(namespace: String) -> Map<String, Any> = node:
  apiVersion: "keda.sh/v1alpha1"
  kind: "ScaledObject"
  metadata:
    name: "picca-embedding-worker"
    namespace: namespace
  spec:
    maxReplicaCount: 4
    minReplicaCount: 0
    pollingInterval: 5
    scaleTargetRef:
      name: "picca-embedding-worker"
    triggers:
      -
        authenticationRef:
          name: "picca-rabbitmq-worker-auth"
        metadata:
          mode: "QueueLength"
          protocol: "http"
          queueName: "picca.embedding-processing"
          value: "2"
        metricType: "AverageValue"
        type: "rabbitmq"

fn deploymentPiccaLibraryNotifyWorker(namespace: String) -> Map<String, Any> = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    labels:
      app: "picca-library-notify-worker"
      "app.kubernetes.io/name": "picca-library-notify-worker"
    name: "picca-library-notify-worker"
    namespace: namespace
  spec:
    replicas: 0
    selector:
      matchLabels:
        app: "picca-library-notify-worker"
        "app.kubernetes.io/name": "picca-library-notify-worker"
    template:
      metadata:
        labels:
          app: "picca-library-notify-worker"
          "app.kubernetes.io/name": "picca-library-notify-worker"
      spec:
        containers:
          -
            env: workerCommon.environment("picca-library-notify-worker")
            envFrom: workerCommon.envFrom
            image: "ghcr.io/walnuts1018/picca/library-notify-worker:v0.0.49"
            imagePullPolicy: "IfNotPresent"
            livenessProbe: workerCommon.livenessProbe
            name: "library-notify-worker"
            ports:
              -
                containerPort: 8080
                name: "health"
            resources:
              limits:
                cpu: "1"
                memory: "512Mi"
              requests:
                cpu: "100m"
                memory: "256Mi"
            securityContext: workerCommon.containerSecurityContext
            startupProbe: workerCommon.startupProbe
            volumeMounts:
              - workerCommon.tmpVolumeMount
              - workerCommon.stsTokenVolumeMount
              -
                mountPath: "/etc/picca/plans"
                name: "picca-plans"
                readOnly: true
        imagePullSecrets: workerCommon.imagePullSecrets
        securityContext: workerCommon.podSecurityContext
        serviceAccountName: workerCommon.serviceAccountName
        volumes:
          - workerCommon.tmpVolume
          - workerCommon.stsTokenVolume
          -
            configMap:
              items:
                -
                  key: "plans.yaml"
                  path: "plans.yaml"
              name: names.piccaPlansConfigMapName
            name: "picca-plans"

fn scaledObjectPiccaLibraryNotifyWorker(namespace: String) -> Map<String, Any> = node:
  apiVersion: "keda.sh/v1alpha1"
  kind: "ScaledObject"
  metadata:
    name: "picca-library-notify-worker"
    namespace: namespace
  spec:
    maxReplicaCount: 4
    minReplicaCount: 0
    pollingInterval: 5
    scaleTargetRef:
      name: "picca-library-notify-worker"
    triggers:
      -
        authenticationRef:
          name: "picca-rabbitmq-worker-auth"
        metadata:
          mode: "QueueLength"
          protocol: "http"
          queueName: "picca.library-auto-stack"
          value: "2"
        metricType: "AverageValue"
        type: "rabbitmq"
      -
        authenticationRef:
          name: "picca-rabbitmq-worker-auth"
        metadata:
          mode: "QueueLength"
          protocol: "http"
          queueName: "picca.media-processing-notification"
          value: "4"
        metricType: "AverageValue"
        type: "rabbitmq"

fn deploymentPiccaStackTimelineWorker(namespace: String) -> Map<String, Any> = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    labels:
      app: "picca-stack-timeline-worker"
      "app.kubernetes.io/name": "picca-stack-timeline-worker"
    name: "picca-stack-timeline-worker"
    namespace: namespace
  spec:
    replicas: 0
    selector:
      matchLabels:
        app: "picca-stack-timeline-worker"
        "app.kubernetes.io/name": "picca-stack-timeline-worker"
    template:
      metadata:
        labels:
          app: "picca-stack-timeline-worker"
          "app.kubernetes.io/name": "picca-stack-timeline-worker"
      spec:
        containers:
          -
            env: workerCommon.environmentWithScylla("picca-stack-timeline-worker")
            envFrom: workerCommon.envFromWithScylla
            image: "ghcr.io/walnuts1018/picca/stack-timeline-worker:v0.0.49"
            imagePullPolicy: "IfNotPresent"
            livenessProbe: workerCommon.livenessProbe
            name: "stack-timeline-worker"
            ports:
              -
                containerPort: 8080
                name: "health"
            resources:
              limits:
                cpu: "1"
                memory: "512Mi"
              requests:
                cpu: "100m"
                memory: "256Mi"
            securityContext: workerCommon.containerSecurityContext
            startupProbe: workerCommon.startupProbe
            volumeMounts:
              - workerCommon.tmpVolumeMount
              - workerCommon.stsTokenVolumeMount
              - workerCommon.scyllaCaVolumeMount
              - workerCommon.scyllaClientCertVolumeMount
              -
                mountPath: "/etc/picca/plans"
                name: "picca-plans"
                readOnly: true
        imagePullSecrets: workerCommon.imagePullSecrets
        securityContext: workerCommon.podSecurityContext
        serviceAccountName: workerCommon.serviceAccountName
        volumes:
          - workerCommon.tmpVolume
          - workerCommon.stsTokenVolume
          - workerCommon.scyllaCaVolume
          - workerCommon.scyllaClientCertVolume
          -
            configMap:
              items:
                -
                  key: "plans.yaml"
                  path: "plans.yaml"
              name: names.piccaPlansConfigMapName
            name: "picca-plans"

fn scaledObjectPiccaStackTimelineWorker(namespace: String) -> Map<String, Any> = node:
  apiVersion: "keda.sh/v1alpha1"
  kind: "ScaledObject"
  metadata:
    name: "picca-stack-timeline-worker"
    namespace: namespace
  spec:
    maxReplicaCount: 4
    minReplicaCount: 0
    pollingInterval: 5
    scaleTargetRef:
      name: "picca-stack-timeline-worker"
    triggers:
      -
        authenticationRef:
          name: "picca-rabbitmq-worker-auth"
        metadata:
          mode: "QueueLength"
          protocol: "http"
          queueName: "picca.stack-timeline"
          value: "4"
        metricType: "AverageValue"
        type: "rabbitmq"

export fn embedding(namespace: String) -> List<Map<String, Any>> =
  - deploymentPiccaEmbeddingWorker(namespace)
  - scaledObjectPiccaEmbeddingWorker(namespace)

export fn libraryNotify(namespace: String) -> List<Map<String, Any>> =
  - deploymentPiccaLibraryNotifyWorker(namespace)
  - scaledObjectPiccaLibraryNotifyWorker(namespace)

export fn stackTimeline(namespace: String) -> List<Map<String, Any>> =
  - deploymentPiccaStackTimelineWorker(namespace)
  - scaledObjectPiccaStackTimelineWorker(namespace)
