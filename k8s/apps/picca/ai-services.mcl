fn deploymentPiccaSparseService(namespace: String) -> Map<String, Any> = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    labels:
      app: "picca-sparse-service"
      "app.kubernetes.io/name": "picca-sparse-service"
    name: "picca-sparse-service"
    namespace: namespace
  spec:
    replicas: 1
    selector:
      matchLabels:
        app: "picca-sparse-service"
        "app.kubernetes.io/name": "picca-sparse-service"
    template:
      metadata:
        labels:
          app: "picca-sparse-service"
          "app.kubernetes.io/name": "picca-sparse-service"
      spec:
        containers:
          -
            command:
              - "python"
              - "scripts/run_sparse_service.py"
