import "std:list" as lists
import "./worker-common.mcl" as workerCommon

type AIServiceSpec =
  name: String
  port: Int
  command: List<String>
  modelImage: String
  environment: List<Map<String, String>>
  resources: Map<String, Any>
  readOnlyRootFilesystem: Bool

let aiServices: List<AIServiceSpec> =
  - name: "caption-service"
    port: 8004
    command:
      - "python"
      - "scripts/run_caption_service.py"
    modelImage: "ghcr.io/walnuts1018/picca/ai-models-caption:v0.0.1"
    environment:
      - name: "PORT"
        value: "8004"
      - name: "MODEL_DEVICE"
        value: "cpu"
      - name: "FLORENCE2_MODEL_NAME"
        value: "/models/Florence-2-base-ft"
      - name: "TRANSLATE_MODEL_NAME"
        value: "/models/CAT-Translate-0.8b"
    resources:
      limits:
        cpu: "4"
        memory: "6Gi"
      requests:
        cpu: "1"
        memory: "2Gi"
    readOnlyRootFilesystem: false
  - name: "dense-service"
    port: 8001
    command:
      - "python"
      - "scripts/run_dense_service.py"
    modelImage: "ghcr.io/walnuts1018/picca/ai-models-dense:v0.0.1"
    environment:
      - name: "PORT"
        value: "8001"
      - name: "MODEL_DEVICE"
        value: "cpu"
      - name: "DENSE_MODEL_NAME"
        value: "/models/waon-siglip2-base-patch16-256"
    resources:
      limits:
        cpu: "4"
        memory: "6Gi"
      requests:
        cpu: "1"
        memory: "2Gi"
    readOnlyRootFilesystem: false
  - name: "ocr-service"
    port: 8003
    command:
      - "python"
      - "scripts/run_ocr_service.py"
    modelImage: "ghcr.io/walnuts1018/picca/ai-models-ocr:v0.0.1"
    environment:
      - name: "PORT"
        value: "8003"
      - name: "MODEL_DEVICE"
        value: "cpu"
    resources:
      limits:
        cpu: "4"
        memory: "6Gi"
      requests:
        cpu: "1"
        memory: "2Gi"
    readOnlyRootFilesystem: false
  - name: "sparse-service"
    port: 8002
    command:
      - "python"
      - "scripts/run_sparse_service.py"
    modelImage: "ghcr.io/walnuts1018/picca/ai-models-sparse:v0.0.1"
    environment:
      - name: "PORT"
        value: "8002"
      - name: "MODEL_DEVICE"
        value: "cpu"
      - name: "SPARSE_MODEL_NAME"
        value: "/models/light-splade-japanese-28M"
    resources:
      limits:
        cpu: "1"
        memory: "1Gi"
      requests:
        cpu: "250m"
        memory: "512Mi"
    readOnlyRootFilesystem: false

fn labels(name: String) -> Map<String, String> =
  app: "picca-" + name
  "app.kubernetes.io/name": "picca-" + name

fn deployment(namespace: String, config: AIServiceSpec) -> Map<String, Any> = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    labels: labels(config.name)
    name: "picca-" + config.name
    namespace: namespace
  spec:
    replicas: 1
    selector:
      matchLabels: labels(config.name)
    template:
      metadata:
        labels: labels(config.name)
      spec:
        containers:
          -
            command: config.command
            env: config.environment
            image: "ghcr.io/walnuts1018/picca/ai-services:v0.0.49"
            imagePullPolicy: "IfNotPresent"
            livenessProbe:
              failureThreshold: 3
              httpGet:
                path: "/healthz"
                port: "http"
              periodSeconds: 10
            name: config.name
            ports:
              -
                containerPort: config.port
                name: "http"
            readinessProbe:
              failureThreshold: 3
              httpGet:
                path: "/healthz"
                port: "http"
              periodSeconds: 10
            resources: config.resources
            securityContext:
              allowPrivilegeEscalation: false
              capabilities:
                drop:
                  - "ALL"
              readOnlyRootFilesystem: config.readOnlyRootFilesystem
              seccompProfile:
                type: "RuntimeDefault"
            volumeMounts:
              -
                mountPath: "/tmp"
                name: "tmp"
              -
                mountPath: "/models"
                name: "models"
                readOnly: true
        imagePullSecrets: workerCommon.imagePullSecrets
        securityContext: workerCommon.podSecurityContext
        serviceAccountName: workerCommon.serviceAccountName
        volumes:
          - workerCommon.tmpVolume
          -
            image:
              pullPolicy: "IfNotPresent"
              reference: config.modelImage
            name: "models"

fn service(namespace: String, config: AIServiceSpec) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    labels: labels(config.name)
    name: "picca-" + config.name
    namespace: namespace
  spec:
    ports:
      -
        name: "http"
        port: config.port
        targetPort: "http"
    selector: labels(config.name)
    type: "ClusterIP"

fn resources(namespace: String, config: AIServiceSpec) -> List<Map<String, Any>> =
  - deployment(namespace, config)
  - service(namespace, config)

export fn render(namespace: String) -> List<Map<String, Any>> =
  lists.flatten(lists.map(aiServices, fn(config) => resources(namespace, config)))
