      "app.kubernetes.io/name": "picca-sparse-service"
    name: "picca-sparse-service"
    namespace: namespace
  spec:
    ports:
      -
        name: "http"
        port: 8002
        targetPort: "http"
    selector:
      app: "picca-sparse-service"
      "app.kubernetes.io/name": "picca-sparse-service"
    type: "ClusterIP"

export fn render(namespace: String) -> List<Map<String, Any>> =
  - deploymentPiccaCaptionService(namespace)
  - servicePiccaCaptionService(namespace)
  - deploymentPiccaDenseService(namespace)
  - servicePiccaDenseService(namespace)
  - deploymentPiccaOcrService(namespace)
  - servicePiccaOcrService(namespace)
  - deploymentPiccaSparseService(namespace)
  - servicePiccaSparseService(namespace)
