
import "./names.mcl" as names
import "./worker-common.mcl" as workerCommon

fn deploymentPiccaDownloadWorker(namespace: String) -> Map<String, Any> = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    labels:
      app: "picca-download-worker"
      "app.kubernetes.io/name": "picca-download-worker"
    name: "picca-download-worker"
    namespace: namespace
  spec:
    replicas: 0
    selector:
      matchLabels:
        app: "picca-download-worker"
        "app.kubernetes.io/name": "picca-download-worker"
    template:
      metadata:
        labels:
          app: "picca-download-worker"
          "app.kubernetes.io/name": "picca-download-worker"
      spec:
        containers:
          -
            env: workerCommon.environmentWithScylla("picca-download-worker")
            envFrom: workerCommon.envFrom
            image: "ghcr.io/walnuts1018/picca/download-worker:v0.0.49"
            imagePullPolicy: "IfNotPresent"
            livenessProbe: workerCommon.livenessProbe
            name: "download-worker"
            ports:
              -
                containerPort: 8080
                name: "health"
            resources:
              limits:
                cpu: "2"
                memory: "1Gi"
              requests:
                cpu: "300m"
                memory: "512Mi"
            securityContext: workerCommon.containerSecurityContext
            startupProbe: workerCommon.startupProbe
            volumeMounts:
              - workerCommon.tmpVolumeMount
              - workerCommon.stsTokenVolumeMount
              -
                mountPath: "/etc/picca/plans"
                name: "picca-plans"
                readOnly: true
        imagePullSecrets: workerCommon.imagePullSecrets
        securityContext: workerCommon.podSecurityContext
        serviceAccountName: workerCommon.serviceAccountName
        volumes:
          - workerCommon.tmpVolume
          - workerCommon.stsTokenVolume
          -
            configMap:
              items:
                -
                  key: "plans.yaml"
                  path: "plans.yaml"
              name: names.piccaPlansConfigMapName
            name: "picca-plans"

fn scaledObjectPiccaDownloadWorker(namespace: String) -> Map<String, Any> = node:
  apiVersion: "keda.sh/v1alpha1"
  kind: "ScaledObject"
  metadata:
    name: "picca-download-worker"
    namespace: namespace
  spec:
    maxReplicaCount: 4
    minReplicaCount: 0
    pollingInterval: 5
    scaleTargetRef:
      name: "picca-download-worker"
    triggers:
      -
        authenticationRef:
          name: "picca-rabbitmq-worker-auth"
        metadata:
          mode: "QueueLength"
          protocol: "http"
          queueName: "picca.download"
          value: "1"
        metricType: "AverageValue"
        type: "rabbitmq"

