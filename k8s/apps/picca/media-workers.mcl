export fn download(namespace: String) -> List<Map<String, Any>> =
  - deploymentPiccaDownloadWorker(namespace)
  - scaledObjectPiccaDownloadWorker(namespace)

export fn imageProcessing(namespace: String) -> List<Map<String, Any>> =
  - deploymentPiccaImageProcessingWorker(namespace)
  - scaledObjectPiccaImageProcessingWorker(namespace)

export fn videoProcessing(namespace: String) -> List<Map<String, Any>> =
