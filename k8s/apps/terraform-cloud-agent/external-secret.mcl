import "./values.mcl" as app

export fn resource(namespace: String) -> Map<String, Any> =
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: app.name
    namespace: namespace
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: app.name
      template:
        engineVersion: "v2"
        type: "Opaque"
    data:
      - secretKey: "TFC_AGENT_TOKEN"
        remoteRef:
          key: "terraform-external-secrets"
          property: "terraform_cloud_agent_token"
