import "../envoy-gateway-class/gateway.mcl" as gateway
import "./config.mcl" as app

let serviceAccountName = app.name
let certificateSecretName = app.name + "-tls"
let labels =
  "app.kubernetes.io/name": app.name

fn service(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    name: app.name
    namespace: namespace
  spec:
    ports:
      -
        name: "https"
        port: 443
        protocol: "TCP"
        targetPort: "https"
    selector: labels
    type: "ClusterIP"

fn certificate(namespace: String) -> Map<String, Any> = node:
  apiVersion: "cert-manager.io/v1"
  kind: "Certificate"
  metadata:
    name: app.name
    namespace: namespace
  spec:
    dnsNames:
      - app.name
      - app.name + "." + namespace
      - app.name + "." + namespace + ".svc"
      - app.name + "." + namespace + ".svc.cluster.local"
    issuerRef:
      group: "cert-manager.io"
      kind: "ClusterIssuer"
      name: "local"
    secretName: certificateSecretName
    usages:
      - "server auth"

fn deployment(namespace: String) -> Map<String, Any> = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    name: app.name
    namespace: namespace
  spec:
    replicas: 2
    selector:
      matchLabels: labels
    template:
      metadata:
        labels: labels
      spec:
        automountServiceAccountToken: true
        serviceAccountName: serviceAccountName
        containers:
          -
            name: "kube-oidc-proxy"
            image: "ghcr.io/tremolosecurity/kube-oidc-proxy:1.0.13@sha256:400477688105f303005df4eec55fb96cf12692cbda510ca68c401f9926bd702f"
            imagePullPolicy: "IfNotPresent"
            command:
              - "kube-oidc-proxy"
            args:
              - "--secure-port=8443"
              - "--tls-cert-file=/etc/kube-oidc-proxy/tls.crt"
              - "--tls-private-key-file=/etc/kube-oidc-proxy/tls.key"
              - "--tls-min-version=VersionTLS12"
              - "--oidc-client-id=" + app.oidcIssuerAudience
              - "--oidc-issuer-url=https://auth.walnuts.dev"
              - "--oidc-username-claim=email"
              - "--oidc-username-prefix=zitadel:"
              - "--oidc-groups-claim=my:zitadel:grants"
              - "--oidc-groups-prefix=zitadel:"
              - "--oidc-signing-algs=RS256"
              - "--oidc-ca-file=/etc/kube-oidc-proxy-ca/trust-bundle.pem"
              - "--v=9"
            ports:
              -
                name: "https"
                containerPort: 8443
                protocol: "TCP"
              -
                name: "health"
                containerPort: 8080
                protocol: "TCP"
            readinessProbe:
              httpGet:
                path: "/ready"
                port: "health"
              initialDelaySeconds: 5
              periodSeconds: 10
            livenessProbe:
              httpGet:
                path: "/ready"
                port: "health"
              initialDelaySeconds: 15
              periodSeconds: 20
            resources:
              requests:
                cpu: "5m"
                memory: "32Mi"
              limits:
                memory: "256Mi"
            securityContext:
              allowPrivilegeEscalation: false
              capabilities:
                drop:
                  - "ALL"
              readOnlyRootFilesystem: true
              runAsGroup: 65532
              runAsNonRoot: true
              runAsUser: 65532
              seccompProfile:
                type: "RuntimeDefault"
            volumeMounts:
              -
                name: "tls"
                mountPath: "/etc/kube-oidc-proxy"
                readOnly: true
              -
                name: "ca"
                mountPath: "/etc/kube-oidc-proxy-ca"
                readOnly: true
        volumes:
          -
            name: "tls"
            secret:
              secretName: certificateSecretName
          -
            name: "ca"
            configMap:
              name: "local-ca-bundle"
              items:
                -
                  key: "trust-bundle.pem"
                  path: "trust-bundle.pem"
        topologySpreadConstraints:
          -
            maxSkew: 1
            topologyKey: "kubernetes.io/hostname"
            whenUnsatisfiable: "ScheduleAnyway"
            labelSelector:
              matchLabels: labels

fn backendTLSPolicy(namespace: String) -> Map<String, Any> = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "BackendTLSPolicy"
  metadata:
    name: app.name
    namespace: namespace
  spec:
    targetRefs:
      -
        group: ""
        kind: "Service"
        name: app.name
    validation:
      caCertificateRefs:
        -
          group: ""
          kind: "ConfigMap"
          name: "local-ca-bundle"
      hostname: app.name + "." + namespace + ".svc.cluster.local"

fn httpRoute(namespace: String) -> Map<String, Any> = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "HTTPRoute"
  metadata:
    name: app.name
    namespace: namespace
  spec:
    parentRefs:
      -
        name: "envoy-gateway"
        namespace: gateway.namespace
    hostnames:
      - "kurumi-oidc-proxy.local.walnuts.dev"
    rules:
      -
        backendRefs:
          -
            name: app.name
            port: 443
        matches:
          -
            path:
              type: "PathPrefix"
              value: "/"

fn securityPolicy(namespace: String) -> Map<String, Any> = node:
  apiVersion: "gateway.envoyproxy.io/v1alpha1"
  kind: "SecurityPolicy"
  metadata:
    name: app.name
    namespace: namespace
  spec:
    targetRefs:
      -
        group: "gateway.networking.k8s.io"
        kind: "HTTPRoute"
        name: app.name
    authorization:
      defaultAction: "Deny"
      rules:
        -
          action: "Allow"
          principal:
            clientCIDRs:
              - "192.168.0.0/16"

fn networkPolicy(namespace: String) -> Map<String, Any> = node:
  apiVersion: "networking.k8s.io/v1"
  kind: "NetworkPolicy"
  metadata:
    name: app.name
    namespace: namespace
  spec:
    podSelector:
      matchLabels: labels
    policyTypes:
      - "Ingress"
    ingress:
      -
        ports:
          -
            port: 8443
            protocol: "TCP"
      -
        ports:
          -
            port: 8080
            protocol: "TCP"

export fn resources(namespace: String) -> List<Map<String, Any>> =
  - service(namespace)
  - certificate(namespace)
  - deployment(namespace)
  - backendTLSPolicy(namespace)
  - httpRoute(namespace)
  - securityPolicy(namespace)
  - networkPolicy(namespace)
