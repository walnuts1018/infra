import "./settings.mcl" as settings
import "./external-secret.mcl" as externalSecret
import "./config.mcl" as appConfig


export fn resource(namespace: String, appSettings: appConfig.Settings) -> Map<String, Any> = node:
  apiVersion: "gateway.envoyproxy.io/v1alpha1"
  kind: "SecurityPolicy"
  metadata:
    name: settings.name
    namespace: namespace
  spec:
    targetRefs:
      - group: "gateway.networking.k8s.io"
        kind: "HTTPRoute"
        name: settings.name
    oidc:
      provider:
        issuer: "https://auth.walnuts.dev"
      clientIDRef:
        name: externalSecret.name
      clientSecret:
        name: externalSecret.name
      scopes:
        - "openid"
        - "email"
        - "profile"
        - "offline_access"
        - "urn:zitadel:iam:org:projects:roles"
      forwardAccessToken: true
      logoutPath: "/oauth2/logout"
    jwt:
      providers:
        - name: "zitadel"
          issuer: "https://auth.walnuts.dev"
          remoteJWKS:
            uri: "https://auth.walnuts.dev/oauth/v2/keys"
    authorization:
      defaultAction: "Deny"
      rules:
        - action: "Allow"
          principal:
            jwt:
              provider: "zitadel"
              claims:
                - name: "my:zitadel:grants"
                  valueType: "StringArray"
                  values:
                    - appSettings.authorizedGrant
