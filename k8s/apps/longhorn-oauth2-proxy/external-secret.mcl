import "std:hash" as hashes
import "./settings.mcl" as settings
import "./external-secret-data.mcl" as secretData

export let name = settings.name + "-secret-" + hashes.fnv1a64(secretData.data)

export fn resource(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: name
    namespace: namespace
  spec:
    refreshInterval: "1m"
    secretStoreRef:
      kind: "ClusterSecretStore"
      name: "onepassword"
    target:
      name: name
      template:
        engineVersion: "v2"
        type: "Opaque"
    data: secretData.data
