export type ChartReference =
  repoURL: String
  chart: String
  targetRevision: String

# renovate: datasource=helm depName=vertical-pod-autoscaler registryUrl=https://kubernetes.github.io/autoscaler
export let chartVersion = "0.12.0"
export let chart: ChartReference =
  repoURL: "https://kubernetes.github.io/autoscaler"
  chart: "vertical-pod-autoscaler"
  targetRevision: chartVersion
export let chartArchive = "https://github.com/kubernetes/autoscaler/releases/download/vertical-pod-autoscaler-chart-" + chartVersion + "/" + chart.chart + "-" + chartVersion + ".tgz"
export let apiVersions: List<String> =
  - "monitoring.coreos.com/v1"

export let namespace = "kube-system"
