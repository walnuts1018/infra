let name = "vertical-pod-autoscaler"
let labels =
  app: name
  "app.kubernetes.io/name": name

export fn resource(namespace: String) -> Map<String, Any> = node:
  apiVersion: "monitoring.coreos.com/v1"
  kind: "ServiceMonitor"
  metadata:
    name: name
    namespace: namespace
    labels: labels with:
      "app.kubernetes.io/component": "recommender"
  spec:
    namespaceSelector:
      matchNames:
        - namespace
    selector:
      matchLabels:
        "app.kubernetes.io/name": name
        "app.kubernetes.io/component": "recommender"
    endpoints:
      - port: "prometheus"
        path: "/metrics"
