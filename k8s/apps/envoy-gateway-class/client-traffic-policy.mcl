import "./gateway.mcl" as gateway

export fn resource(namespace: String) -> Map<String, Any> = node:
  apiVersion: "gateway.envoyproxy.io/v1alpha1"
  kind: "ClientTrafficPolicy"
  metadata:
    name: "enable-http3"
    namespace: namespace
  spec:
    http3: {}
    headers:
      lateResponseHeaders:
        remove:
          - "Server"
    targetRefs:
      - group: "gateway.networking.k8s.io"
        kind: "Gateway"
        name: gateway.name
