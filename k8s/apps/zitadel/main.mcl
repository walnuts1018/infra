import "std:helm" as helm
import "std:list" as lists
import "./chart.mcl" as appChart
import "./external-secret.mcl" as appResources
import "./values.mcl" as appValues
import "./config.mcl" as appConfig
import "../../cluster.mcl" as clusterConfig
param cluster: clusterConfig.Cluster
param namespace: String
param features: List<appConfig.Feature> = []

let values: Map<String, Any> = appValues.baseValues with:
  metrics:
    serviceMonitor:
      enabled: lists.contains(features, "monitoring")
let options =
  releaseName: "zitadel"
  namespace: namespace
  version: appChart.chartVersion
  kubeVersion: cluster.kubernetesVersion
  apiVersions: []
  values: values
let chartResources = helm.render(appChart.chartArchive, options)

emit each chartResources
emit appResources.configMap(namespace)
emit appResources.resource(namespace)
emit appResources.pdb(namespace)
emit appResources.scaledObject(namespace)
emit appResources.vpa(namespace)
