import "./chart.mcl" as appChart

let appName = "tempo"
let valkeyName = appName + "-valkey"
let avoidSlowNodeAffinity =
  nodeAffinity:
    requiredDuringSchedulingIgnoredDuringExecution:
      nodeSelectorTerms:
        -
          matchExpressions:
            - key: "storage.walnuts.dev/slow"
              operator: "DoesNotExist"

export let valkeyCluster = node:
  apiVersion: "valkey.io/v1alpha1"
  kind: "ValkeyCluster"
  metadata:
    name: valkeyName
    namespace: appChart.namespace
    annotations:
      "argocd.argoproj.io/sync-options": "SkipDryRunOnMissingResource=true"
    labels:
      app: valkeyName
      "app.kubernetes.io/name": valkeyName
  spec:
    shards: 1
    replicas: 0
    scheduling:
      affinity: avoidSlowNodeAffinity
    resources:
      requests:
        cpu: "5m"
        memory: "5Mi"
      limits:
        cpu: "1"
        memory: "1Gi"
