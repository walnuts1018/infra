import "./configmap.mcl" as appConfigMap

let namespace = "coredns"
let labels =
  app: "coredns"
  "app.kubernetes.io/name": "coredns"

export let deployment = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    name: "coredns"
    namespace: namespace
    labels: labels
  spec:
    replicas: 1
    selector:
      matchLabels: labels
    template:
      metadata:
        labels: labels
      spec:
        containers:
          - name: "coredns"
            image: "coredns/coredns:1.14.7"
            resizePolicy:
              - resourceName: "cpu"
                restartPolicy: "NotRequired"
              - resourceName: "memory"
                restartPolicy: "RestartContainer"
            args:
              - "-conf"
              - "/etc/coredns/Corefile"
            ports:
              - name: "dns"
                containerPort: 53
                protocol: "UDP"
              - name: "dns-tcp"
                containerPort: 53
                protocol: "TCP"
              - name: "dns-over-tls"
                containerPort: 853
                protocol: "TCP"
              - name: "dns-over-https"
                containerPort: 443
                protocol: "TCP"
              - name: "liveness-probe"
                containerPort: 8080
                protocol: "TCP"
              - name: "readiness-probe"
                containerPort: 8181
                protocol: "TCP"
            livenessProbe:
              httpGet:
                path: "/health"
                port: "liveness-probe"
            readinessProbe:
              httpGet:
                path: "/ready"
                port: "readiness-probe"
            securityContext:
              readOnlyRootFilesystem: true
              seccompProfile:
                type: "RuntimeDefault"
              capabilities:
                add:
                  - "NET_BIND_SERVICE"
                drop:
                  - "all"
              allowPrivilegeEscalation: false
            resources:
              requests:
                cpu: "5m"
                memory: "128Mi"
              limits:
                cpu: "500m"
                memory: "256Mi"
            volumeMounts:
              - name: "corefile"
                mountPath: "/etc/coredns"
                readOnly: true
        volumes:
          - name: "corefile"
            configMap:
              name: appConfigMap.configMapName
        affinity:
          podAntiAffinity:
            preferredDuringSchedulingIgnoredDuringExecution:
              - weight: 100
                podAffinityTerm:
                  labelSelector:
                    matchExpressions:
                      - key: "app"
                        operator: "In"
                        values:
                          - "coredns"
                  topologyKey: "kubernetes.io/hostname"

export let service = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    name: "coredns"
    namespace: namespace
    labels: labels
  spec:
    selector: labels
    ports:
      - name: "dns"
        protocol: "UDP"
        port: 53
        targetPort: "dns"
      - name: "dns-tcp"
        protocol: "TCP"
        port: 53
        targetPort: "dns"
      - name: "dns-over-tls"
        protocol: "TCP"
        port: 853
        targetPort: "dns-over-tls"
      - name: "dns-over-https"
        protocol: "TCP"
        port: 443
        targetPort: "dns-over-https"
    loadBalancerIP: "192.168.12.135"
    type: "LoadBalancer"

export let scaledObject = node:
  apiVersion: "keda.sh/v1alpha1"
  kind: "ScaledObject"
  metadata:
    name: "coredns"
    namespace: namespace
    labels: labels
  spec:
    minReplicaCount: 2
    maxReplicaCount: 4
    scaleTargetRef:
      apiVersion: "apps/v1"
      kind: "Deployment"
      name: "coredns"
    triggers:
      - type: "prometheus"
        metadata:
          serverAddress: "http://victoria-metrics-victoria-metrics-cluster-vmselect.victoria-metrics.svc.cluster.local:8481/select/0/prometheus"
          metricName: "coredns_dns_requests_total"
          query: "sum(rate(coredns_dns_requests_total[2m]))"
          threshold: "100"

export let podDisruptionBudget = node:
  apiVersion: "policy/v1"
  kind: "PodDisruptionBudget"
  metadata:
    name: "coredns"
    namespace: namespace
    labels: labels
  spec:
    minAvailable: 1
    selector:
      matchLabels: labels

export let verticalPodAutoscaler = node:
  apiVersion: "autoscaling.k8s.io/v1"
  kind: "VerticalPodAutoscaler"
  metadata:
    name: "coredns"
    namespace: namespace
    labels: labels
  spec:
    targetRef:
      apiVersion: "apps/v1"
      kind: "Deployment"
      name: "coredns"
    updatePolicy:
      updateMode: "Auto"
    resourcePolicy:
      containerPolicies:
        - containerName: "coredns"
          controlledResources:
            - "memory"
          minAllowed:
            cpu: "1m"
            memory: "64Mi"
          maxAllowed:
            cpu: "100m"
            memory: "256Mi"

export let dnsEndpoint = node:
  apiVersion: "externaldns.k8s.io/v1alpha1"
  kind: "DNSEndpoint"
  metadata:
    name: "coredns-local-static"
    namespace: namespace
  spec:
    endpoints:
      - dnsName: "seaweedfs-biscuit.local.walnuts.dev"
        recordTTL: 60
        recordType: "A"
        targets:
          - "192.168.16.159"
      - dnsName: "shutdown-manager.local.walnuts.dev"
        recordTTL: 60
        recordType: "A"
        targets:
          - "192.168.16.158"
      - dnsName: "tart.local.walnuts.dev"
        recordTTL: 60
        recordType: "A"
        targets:
          - "192.168.0.14"
