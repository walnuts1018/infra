import "./configmap.mcl" as appConfigMap
import "./coredns.mcl" as appCoreDNS
import "./etcd.mcl" as appEtcd
import "../../cluster.mcl" as clusterConfig
param cluster: clusterConfig.Cluster
param namespace: String

let resources =
  - appConfigMap.configMap(namespace)
  - appCoreDNS.deployment(namespace)
  - appCoreDNS.service(namespace)
  - appCoreDNS.scaledObject(namespace)
  - appCoreDNS.podDisruptionBudget(namespace)
  - appCoreDNS.verticalPodAutoscaler(namespace)
  - appCoreDNS.dnsEndpoint(namespace)
  - appEtcd.headlessService(namespace)
  - appEtcd.service(namespace)
  - appEtcd.statefulSet(namespace)

emit each resources
