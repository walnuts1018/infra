import "./config.mcl" as app

fn claim(namespace: String, name: String, storageClassName: String, size: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "PersistentVolumeClaim"
  metadata:
    name: name
    namespace: namespace
  spec:
    storageClassName: storageClassName
    accessModes:
      - "ReadWriteOnce"

    resources:
      requests:
        storage: size

export fn resources(namespace: String) -> List<Map<String, Any>> =
  - claim(namespace, "books", "longhorn", "40Gi")
  - claim(namespace, "camera-roll", "longhorn", "160Gi")
  -
    apiVersion: "v1"
    kind: "PersistentVolumeClaim"
    metadata:
      name: "mega"
      namespace: namespace
    spec:
      storageClassName: "longhorn-single-encrypted"
      accessModes:
        - "ReadWriteOnce"

      resources:
        requests:
          storage: "176Gi"
  - claim(namespace, "movies", "longhorn-single", "248Gi")
  - claim(namespace, "musics", "longhorn", "32Gi")
  - claim(namespace, "root", "longhorn", "64Gi")
