import "std:hash" as hashes
import "./config.mcl" as app

let accountData =
  - secretKey: "account-samba"
    remoteRef:
      key: "samba"
      property: "password"

export let accountName = "samba-secret-" + hashes.fnv1a64(accountData)

export fn account(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: accountName
    namespace: namespace
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: accountName
      template:
        engineVersion: "v2"
        type: "Opaque"
    data: accountData

let megaData =
  - secretKey: "CRYPTO_KEY_VALUE"
    remoteRef:
      key: "samba"
      property: "longhorn-encryption-key"

export fn mega(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: "mega"
    namespace: namespace
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: "mega"
      template:
        engineVersion: "v2"
        type: "Opaque"
        data:
          CRYPTO_KEY_VALUE: "{{ .CRYPTO_KEY_VALUE }}"
          CRYPTO_KEY_PROVIDER: "secret"
          CRYPTO_KEY_CIPHER: "aes-xts-plain64"
          CRYPTO_KEY_HASH: "sha256"
          CRYPTO_KEY_SIZE: "256"
          CRYPTO_PBKDF: "argon2i"
    data: megaData
