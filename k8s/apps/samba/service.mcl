import "./config.mcl" as app

export fn resource(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    name: app.appName
    namespace: namespace
    labels: app.labels
  spec:
    ports:
      - port: 445
        protocol: "TCP"
        targetPort: 10445

    selector: app.labels
    type: "LoadBalancer"
    loadBalancerIP: "192.168.12.132"
