import "std:list" as lists
import "./claims.mcl" as claims
import "./external-secrets.mcl" as externalSecrets
import "./network-policy.mcl" as networkPolicy
import "./service.mcl" as service
import "./statefulset.mcl" as statefulSet
import "../../cluster.mcl" as clusterConfig
param cluster: clusterConfig.Cluster
param namespace: String

let additionalResources =
  - externalSecrets.account(namespace)
  - externalSecrets.mega(namespace)
  - networkPolicy.resource(namespace)
  - service.resource(namespace)
  - statefulSet.resource(namespace)

let resources = lists.concat(claims.resources(namespace), additionalResources)

emit each resources
