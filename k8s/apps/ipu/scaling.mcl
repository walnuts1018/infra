fn scaledObject(namespace: String) -> Map<String, Any> = node:
  apiVersion: "keda.sh/v1alpha1"
  kind: "ScaledObject"
  metadata:
    name: "ipu"
    namespace: namespace
  spec:
    minReplicaCount: 0
    maxReplicaCount: 3
    cooldownPeriod: 300
    scaleTargetRef:
      name: "ipu"
    triggers:
      - type: "external-push"
        metadata:
          scalerAddress: "keda-add-ons-http-external-scaler.keda:9090"
          interceptorRoute: "ipu"

export fn resource(namespace: String) -> Map<String, Any> = scaledObject(namespace)
