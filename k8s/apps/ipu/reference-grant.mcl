let from =
  - group: "gateway.networking.k8s.io"
    kind: "HTTPRoute"
    namespace: "ipu"
let to =
  - group: ""
    kind: "Service"
    name: "keda-add-ons-http-interceptor-proxy"

export let resource = node:
  apiVersion: "gateway.networking.k8s.io/v1beta1"
  kind: "ReferenceGrant"
  metadata:
    name: "ipu-allow-interceptor"
    namespace: "keda"
  spec:
    from: from
    to: to
