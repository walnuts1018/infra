let hosts =
  - "ipu.walnuts.dev"
let routeRules =
  - hosts: hosts

export fn resource(namespace: String) -> Map<String, Any> = node:
  apiVersion: "http.keda.sh/v1beta1"
  kind: "InterceptorRoute"
  metadata:
    name: "ipu"
    namespace: namespace
  spec:
    target:
      service: "ipu"
      port: 8080
    rules: routeRules
    scalingMetric:
      concurrency:
        targetValue: 10
