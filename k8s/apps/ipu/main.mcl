import "./workload.mcl" as workload
import "./routes.mcl" as routes
import "./interceptor-route.mcl" as interceptorRoute
import "./reference-grant.mcl" as referenceGrant
import "./external-secrets.mcl" as externalSecrets
import "./scaling.mcl" as scaling
import "../../cluster.mcl" as clusterConfig
param cluster: clusterConfig.Cluster
param namespace: String

let resources =
  - workload.serviceAccount(namespace)
  - workload.deployment(namespace)
  - workload.service(namespace)
  - externalSecrets.externalSecret(namespace)
  - routes.httpRoute(namespace)
  - interceptorRoute.resource(namespace)
  - referenceGrant.resource(namespace)
  - scaling.resource(namespace)

emit each resources
