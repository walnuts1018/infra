import "../envoy-gateway-class/gateway.mcl" as gateway

let backendRefs =
  - name: "keda-add-ons-http-interceptor-proxy"
    namespace: "keda"
    port: 8080
let routeRules =
  - backendRefs: backendRefs

export fn httpRoute(namespace: String) -> Map<String, Any> = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "HTTPRoute"
  metadata:
    name: "ipu"
    namespace: namespace
  spec:
    parentRefs:
      - name: gateway.name
        namespace: gateway.namespace
    hostnames:
      - "ipu.walnuts.dev"
    rules: routeRules
