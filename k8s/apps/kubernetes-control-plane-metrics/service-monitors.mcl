let appName = "kubernetes-control-plane-metrics"
let systemNamespace = "kube-system"
let bearerTokenFile = "/var/run/secrets/kubernetes.io/serviceaccount/token"
let caFile = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
export type ServiceMonitorConfig =
  name: String
  selector: Map<String, String>
  jobLabel: String
  namespace: String
  endpoints: List<Map<String, Any>>

fn serviceMonitor(namespace: String, config: ServiceMonitorConfig) -> Map<String, Any> = node:
  apiVersion: "monitoring.coreos.com/v1"
  kind: "ServiceMonitor"
  metadata:
    name: config.name
    namespace: namespace
    labels:
      app: appName
      "app.kubernetes.io/name": appName
  spec:
    jobLabel: config.jobLabel
    namespaceSelector:
      matchNames:
        - config.namespace
    selector:
      matchLabels: config.selector
    endpoints: config.endpoints


let corednsMetricsSelector =
  app: "coredns-metrics"
let etcdMetricsSelector =
  app: "kube-etcd-metrics-proxy"
let kubeProxyMetricsSelector =
  app: "kube-proxy-metrics"
let controllerManagerMetricsSelector =
  app: "kube-controller-manager-metrics-proxy"
let schedulerMetricsSelector =
  app: "kube-scheduler-metrics-proxy"
let apiserverSelector =
  component: "apiserver"
  provider: "kubernetes"
let kubeletMetricsSelector =
  "app.kubernetes.io/name": "kubelet-metrics-proxy"
  "k8s-app": "kubelet"


let bearerEndpoint =
  bearerTokenFile: bearerTokenFile
  port: "http-metrics"
let simpleEndpoints =
  - bearerEndpoint
let tlsSkipVerifyEndpoint =
  bearerTokenFile: bearerTokenFile
  port: "http-metrics"
  scheme: "https"
  tlsConfig:
    caFile: caFile
    insecureSkipVerify: true
let tlsSkipVerifyEndpoints =
  - tlsSkipVerifyEndpoint

let corednsServiceMonitorConfig: ServiceMonitorConfig =
  name: "kubernetes-coredns"
  selector: corednsMetricsSelector
  jobLabel: "jobLabel"
  namespace: systemNamespace
  endpoints: simpleEndpoints
export fn corednsServiceMonitor(namespace: String) -> Map<String, Any> = serviceMonitor(namespace, corednsServiceMonitorConfig)

let etcdServiceMonitorConfig: ServiceMonitorConfig =
  name: "kube-etcd"
  selector: etcdMetricsSelector
  jobLabel: "jobLabel"
  namespace: systemNamespace
  endpoints: simpleEndpoints
export fn etcdServiceMonitor(namespace: String) -> Map<String, Any> = serviceMonitor(namespace, etcdServiceMonitorConfig)

let proxyServiceMonitorConfig: ServiceMonitorConfig =
  name: "kube-proxy"
  selector: kubeProxyMetricsSelector
  jobLabel: "jobLabel"
  namespace: systemNamespace
  endpoints: simpleEndpoints
export fn proxyServiceMonitor(namespace: String) -> Map<String, Any> = serviceMonitor(namespace, proxyServiceMonitorConfig)

let controllerManagerServiceMonitorConfig: ServiceMonitorConfig =
  name: "kube-controller-manager"
  selector: controllerManagerMetricsSelector
  jobLabel: "jobLabel"
  namespace: systemNamespace
  endpoints: tlsSkipVerifyEndpoints
export fn controllerManagerServiceMonitor(namespace: String) -> Map<String, Any> = serviceMonitor(namespace, controllerManagerServiceMonitorConfig)

let schedulerServiceMonitorConfig: ServiceMonitorConfig =
  name: "kube-scheduler"
  selector: schedulerMetricsSelector
  jobLabel: "jobLabel"
  namespace: systemNamespace
  endpoints: tlsSkipVerifyEndpoints
export fn schedulerServiceMonitor(namespace: String) -> Map<String, Any> = serviceMonitor(namespace, schedulerServiceMonitorConfig)

let apiServerEndpoints =
  -
    bearerTokenFile: bearerTokenFile
    metricRelabelings:
      -
        action: "drop"
        regex: "(etcd_request|apiserver_request_slo|apiserver_request_sli|apiserver_request)_duration_seconds_bucket;(0\\.15|0\\.2|0\\.3|0\\.35|0\\.4|0\\.45|0\\.6|0\\.7|0\\.8|0\\.9|1\\.25|1\\.5|1\\.75|2|3|3\\.5|4|4\\.5|6|7|8|9|15|20|40|45|50)(\\.0)?"
        sourceLabels:
          - "__name__"
          - "le"
    port: "https"
    scheme: "https"
    tlsConfig:
      caFile: caFile
      insecureSkipVerify: false
      serverName: "kubernetes"

let apiServerServiceMonitorConfig: ServiceMonitorConfig =
  name: "kube-apiserver"
  selector: apiserverSelector
  jobLabel: "component"
  namespace: "default"
  endpoints: apiServerEndpoints
export fn apiServerServiceMonitor(namespace: String) -> Map<String, Any> = serviceMonitor(namespace, apiServerServiceMonitorConfig)

let kubeletEndpoints =
  -
    bearerTokenFile: bearerTokenFile
    honorLabels: true
    honorTimestamps: true
    metricRelabelings:
      -
        action: "drop"
        regex: "(csi_operations|storage_operation_duration)_seconds_bucket;(0.25|2.5|15|25|120|600)(\\.0)?"
        sourceLabels:
          - "__name__"
          - "le"
    port: "https-metrics"
    relabelings:
      -
        action: "replace"
        sourceLabels:
          - "__meta_kubernetes_endpointslice_endpoint_node_name"
        targetLabel: "node"
      -
        action: "replace"
        sourceLabels:
          - "__metrics_path__"
        targetLabel: "metrics_path"
    scheme: "https"
    tlsConfig:
      caFile: caFile
      insecureSkipVerify: true
  -
    bearerTokenFile: bearerTokenFile
    honorLabels: true
    honorTimestamps: true
    interval: "30s"
    metricRelabelings:
      -
        action: "drop"
        regex: "container_cpu_(cfs_throttled_seconds_total|load_average_10s|system_seconds_total|user_seconds_total)"
        sourceLabels:
          - "__name__"
      -
        action: "drop"
        regex: "container_fs_(io_current|io_time_seconds_total|io_time_weighted_seconds_total|reads_merged_total|sector_reads_total|sector_writes_total|writes_merged_total)"
        sourceLabels:
          - "__name__"
      -
        action: "drop"
        regex: "container_memory_(mapped_file|swap)"
        sourceLabels:
          - "__name__"
      -
        action: "drop"
        regex: "container_(file_descriptors|tasks_state|threads_max)"
        sourceLabels:
          - "__name__"
      -
        action: "drop"
        regex: "container_memory_failures_total;hierarchy"
        sourceLabels:
          - "__name__"
          - "scope"
      -
        action: "drop"
        regex: "container_network_.*;(cali|cilium|cni|lxc|nodelocaldns|tunl).*"
        sourceLabels:
          - "__name__"
          - "interface"
      -
        action: "drop"
        regex: "container_spec.*"
        sourceLabels:
          - "__name__"
      -
        action: "drop"
        regex: ".+;"
        sourceLabels:
          - "id"
          - "pod"
    path: "/metrics/cadvisor"
    port: "https-metrics"
    relabelings:
      -
        action: "replace"
        sourceLabels:
          - "__meta_kubernetes_endpointslice_endpoint_node_name"
        targetLabel: "node"
      -
        action: "replace"
        sourceLabels:
          - "__metrics_path__"
        targetLabel: "metrics_path"
    scheme: "https"
    tlsConfig:
      caFile: caFile
      insecureSkipVerify: true
    trackTimestampsStaleness: true
  -
    bearerTokenFile: bearerTokenFile
    honorLabels: true
    honorTimestamps: true
    path: "/metrics/probes"
    port: "https-metrics"
    relabelings:
      -
        action: "replace"
        sourceLabels:
          - "__meta_kubernetes_endpointslice_endpoint_node_name"
        targetLabel: "node"
      -
        action: "replace"
        sourceLabels:
          - "__metrics_path__"
        targetLabel: "metrics_path"
    scheme: "https"
    tlsConfig:
      caFile: caFile
      insecureSkipVerify: true

let kubeletServiceMonitorConfig: ServiceMonitorConfig =
  name: "kubelet"
  selector: kubeletMetricsSelector
  jobLabel: "k8s-app"
  namespace: systemNamespace
  endpoints: kubeletEndpoints
export fn kubeletServiceMonitor(namespace: String) -> Map<String, Any> = serviceMonitor(namespace, kubeletServiceMonitorConfig)
