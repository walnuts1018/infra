let appName = "kubernetes-control-plane-metrics"
let monitoringNamespace = "monitoring"
let systemNamespace = "kube-system"
let bearerTokenFile = "/var/run/secrets/kubernetes.io/serviceaccount/token"
let caFile = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
fn serviceMonitor(name: String, selector: Map<String, String>, jobLabel: String, namespace: String, endpoints: List<Map<String, Any>>) -> Map<String, Any> = node:
  apiVersion: "monitoring.coreos.com/v1"
  kind: "ServiceMonitor"
  metadata:
    name: name
    namespace: monitoringNamespace
    labels:
      app: appName
      "app.kubernetes.io/name": appName
  spec:
    jobLabel: jobLabel
    namespaceSelector:
      matchNames:
        - namespace
    selector:
      matchLabels: selector
    endpoints: endpoints


let controlPlaneProxySelector =
  app: "kubernetes-control-plane-metrics-proxy"
let corednsSelector =
  "k8s-app": "kube-dns"
let kubeProxySelector =
  "k8s-app": "kube-proxy"
let corednsMetricsSelector =
  app: "coredns-metrics"
let etcdMetricsSelector =
  app: "kube-etcd-metrics-proxy"
let kubeProxyMetricsSelector =
  app: "kube-proxy-metrics"
let controllerManagerMetricsSelector =
  app: "kube-controller-manager-metrics-proxy"
let schedulerMetricsSelector =
  app: "kube-scheduler-metrics-proxy"
let apiserverSelector =
  component: "apiserver"
  provider: "kubernetes"
let kubeletMetricsSelector =
  "app.kubernetes.io/name": "kubelet-metrics-proxy"
  "k8s-app": "kubelet"


let bearerEndpoint =
  bearerTokenFile: bearerTokenFile
  port: "http-metrics"
let simpleEndpoints =
  - bearerEndpoint
let tlsSkipVerifyEndpoint =
  bearerTokenFile: bearerTokenFile
  port: "http-metrics"
  scheme: "https"
  tlsConfig:
    caFile: caFile
    insecureSkipVerify: true
let tlsSkipVerifyEndpoints =
  - tlsSkipVerifyEndpoint

export let corednsServiceMonitor = serviceMonitor(
  "kubernetes-coredns",
  corednsMetricsSelector,
  "jobLabel",
  systemNamespace,
  simpleEndpoints,
)
export let etcdServiceMonitor = serviceMonitor(
  "kube-etcd",
  etcdMetricsSelector,
  "jobLabel",
  systemNamespace,
  simpleEndpoints,
)
export let proxyServiceMonitor = serviceMonitor(
  "kube-proxy",
  kubeProxyMetricsSelector,
  "jobLabel",
  systemNamespace,
  simpleEndpoints,
)
export let controllerManagerServiceMonitor = serviceMonitor(
  "kube-controller-manager",
  controllerManagerMetricsSelector,
  "jobLabel",
  systemNamespace,
  tlsSkipVerifyEndpoints,
)
export let schedulerServiceMonitor = serviceMonitor(
  "kube-scheduler",
  schedulerMetricsSelector,
  "jobLabel",
  systemNamespace,
  tlsSkipVerifyEndpoints,
)

let apiServerEndpoints =
  -
    bearerTokenFile: bearerTokenFile
    metricRelabelings:
      -
        action: "drop"
        regex: "(etcd_request|apiserver_request_slo|apiserver_request_sli|apiserver_request)_duration_seconds_bucket;(0\\.15|0\\.2|0\\.3|0\\.35|0\\.4|0\\.45|0\\.6|0\\.7|0\\.8|0\\.9|1\\.25|1\\.5|1\\.75|2|3|3\\.5|4|4\\.5|6|7|8|9|15|20|40|45|50)(\\.0)?"
        sourceLabels:
          - "__name__"
          - "le"
    port: "https"
    scheme: "https"
    tlsConfig:
      caFile: caFile
      insecureSkipVerify: false
      serverName: "kubernetes"

export let apiServerServiceMonitor = serviceMonitor(
  "kube-apiserver",
  apiserverSelector,
  "component",
  "default",
  apiServerEndpoints,
)

let kubeletEndpoints =
  -
    bearerTokenFile: bearerTokenFile
    honorLabels: true
    honorTimestamps: true
    metricRelabelings:
      -
        action: "drop"
        regex: "(csi_operations|storage_operation_duration)_seconds_bucket;(0.25|2.5|15|25|120|600)(\\.0)?"
        sourceLabels:
          - "__name__"
          - "le"
    port: "https-metrics"
    relabelings:
      -
        action: "replace"
        sourceLabels:
          - "__meta_kubernetes_endpointslice_endpoint_node_name"
        targetLabel: "node"
      -
        action: "replace"
        sourceLabels:
          - "__metrics_path__"
        targetLabel: "metrics_path"
    scheme: "https"
    tlsConfig:
      caFile: caFile
      insecureSkipVerify: true
  -
    bearerTokenFile: bearerTokenFile
    honorLabels: true
    honorTimestamps: true
    interval: "30s"
    metricRelabelings:
      -
        action: "drop"
        regex: "container_cpu_(cfs_throttled_seconds_total|load_average_10s|system_seconds_total|user_seconds_total)"
        sourceLabels:
          - "__name__"
      -
        action: "drop"
        regex: "container_fs_(io_current|io_time_seconds_total|io_time_weighted_seconds_total|reads_merged_total|sector_reads_total|sector_writes_total|writes_merged_total)"
        sourceLabels:
          - "__name__"
      -
        action: "drop"
        regex: "container_memory_(mapped_file|swap)"
        sourceLabels:
          - "__name__"
      -
        action: "drop"
        regex: "container_(file_descriptors|tasks_state|threads_max)"
        sourceLabels:
          - "__name__"
      -
        action: "drop"
        regex: "container_memory_failures_total;hierarchy"
        sourceLabels:
          - "__name__"
          - "scope"
      -
        action: "drop"
        regex: "container_network_.*;(cali|cilium|cni|lxc|nodelocaldns|tunl).*"
        sourceLabels:
          - "__name__"
          - "interface"
      -
        action: "drop"
        regex: "container_spec.*"
        sourceLabels:
          - "__name__"
      -
        action: "drop"
        regex: ".+;"
        sourceLabels:
          - "id"
          - "pod"
    path: "/metrics/cadvisor"
    port: "https-metrics"
    relabelings:
      -
        action: "replace"
        sourceLabels:
          - "__meta_kubernetes_endpointslice_endpoint_node_name"
        targetLabel: "node"
      -
        action: "replace"
        sourceLabels:
          - "__metrics_path__"
        targetLabel: "metrics_path"
    scheme: "https"
    tlsConfig:
      caFile: caFile
      insecureSkipVerify: true
    trackTimestampsStaleness: true
  -
    bearerTokenFile: bearerTokenFile
    honorLabels: true
    honorTimestamps: true
    path: "/metrics/probes"
    port: "https-metrics"
    relabelings:
      -
        action: "replace"
        sourceLabels:
          - "__meta_kubernetes_endpointslice_endpoint_node_name"
        targetLabel: "node"
      -
        action: "replace"
        sourceLabels:
          - "__metrics_path__"
        targetLabel: "metrics_path"
    scheme: "https"
    tlsConfig:
      caFile: caFile
      insecureSkipVerify: true

export let kubeletServiceMonitor = serviceMonitor(
  "kubelet",
  kubeletMetricsSelector,
  "k8s-app",
  systemNamespace,
  kubeletEndpoints,
)
