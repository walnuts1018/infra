import "./profiles.mcl" as appProfiles
import "./oidc.mcl" as oidc
import "./configmaps.mcl" as configmaps
import "./external-secrets.mcl" as externalSecrets
import "./routes.mcl" as routes
import "./rabbitmq.mcl" as rabbitmq
import "./scylla.mcl" as scylla
import "./valkey.mcl" as valkey
import "./identity.mcl" as identity
import "../../cluster.mcl" as clusterConfig
param cluster: clusterConfig.Cluster

let namespace = appProfiles.profiles["default"].namespace

emit each oidc.externalSecret()
emit each configmaps.render(namespace)
emit each externalSecrets.render(namespace)
emit each routes.render(namespace)
emit each rabbitmq.render(namespace)
emit each scylla.render(namespace)
emit each valkey.render(namespace)
emit each identity.render(namespace)
emit each oidc.securityPolicy(namespace)
