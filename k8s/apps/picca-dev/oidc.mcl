import "std:hash" as hash

let externalSecretData =
  -
    remoteRef:
      key: "terraform-external-secrets"
      property: "picca-dev-client-id"
    secretKey: "client-id"
  -
    remoteRef:
      key: "terraform-external-secrets"
      property: "picca-dev-client-secret"
    secretKey: "client-secret"
export let secretName = "picca-dev-oidc-filter-" + hash.fnv1a64(externalSecretData)

let externalSecretPiccaDevOidcFilter = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: secretName
  spec:
    data: externalSecretData
    refreshInterval: "1m"
    secretStoreRef:
      kind: "ClusterSecretStore"
      name: "onepassword"
    target:
      name: secretName
      template:
        engineVersion: "v2"
        type: "Opaque"

fn securityPolicyPiccaDev(namespace: String) -> Map<String, Any> = node:
  apiVersion: "gateway.envoyproxy.io/v1alpha1"
  kind: "SecurityPolicy"
  metadata:
    name: "picca-dev"
    namespace: namespace
  spec:
    oidc:
      clientIDRef:
        name: secretName
      clientSecret:
        name: secretName
      logoutPath: "/oauth2/logout"
      provider:
        issuer: "https://auth.walnuts.dev"
      redirectURL: "https://picca-dev.walnuts.dev/oauth2/callback"
      scopes:
        - "openid"
        - "email"
        - "profile"
    targetRefs:
      -
        group: "gateway.networking.k8s.io"
        kind: "HTTPRoute"
        name: "picca-dev"

export fn externalSecret() -> List<Map<String, Any>> =
  - externalSecretPiccaDevOidcFilter

export fn securityPolicy(namespace: String) -> List<Map<String, Any>> =
  - securityPolicyPiccaDev(namespace)
