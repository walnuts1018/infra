import text "./_configs/plans.yaml" as plansConfig
import text "./_configs/scylla-ca.crt" as scyllaCaCertificate

let emptyMap: Map<String, Any> = {}

fn configMapPiccaDevPlans(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  data:
    "plans.yaml": plansConfig
  immutable: false
  kind: "ConfigMap"
  metadata:
    labels:
      app: "picca-dev"
      "app.kubernetes.io/name": "picca-dev"
    name: "picca-dev-plans"
    namespace: namespace

fn configMapPiccaDevScylladbCaCert(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  data:
    "ca.crt": scyllaCaCertificate
  immutable: false
  kind: "ConfigMap"
  metadata:
    labels:
      app: "picca-dev"
      "app.kubernetes.io/name": "picca-dev"
    name: "picca-dev-scylladb-ca-cert"
    namespace: namespace

fn externalSecretPiccaDevGraphqlSigningSecret(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: "picca-dev-graphql-signing-secret"
    namespace: namespace
  spec:
    data:
      -
        remoteRef:
          key: "terraform-external-secrets"
          property: "picca-dev-graphql-query-signing-secret"
        secretKey: "graphql_query_signing_secret"
    refreshInterval: "1m"
    secretStoreRef:
      kind: "ClusterSecretStore"
      name: "onepassword"
    target:
      name: "picca-dev-graphql-signing-secret"
      template:
        data:
          GRAPHQL_QUERY_SIGNING_SECRET: "{{ .graphql_query_signing_secret }}"
          PICCA_GRAPHQL_QUERY_SIGNING_SECRET: "{{ .graphql_query_signing_secret }}"
        engineVersion: "v2"
        type: "Opaque"

fn httpRoutePiccaDevImgproxy(namespace: String) -> Map<String, Any> = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "HTTPRoute"
  metadata:
    name: "picca-dev-imgproxy"
    namespace: namespace
  spec:
    hostnames:
      - "imgproxy-picca-dev.walnuts.dev"
    parentRefs:
      -
        name: "envoy-gateway"
        namespace: "envoy-gateway-system"
        sectionName: "https"
    rules:
      -
        backendRefs:
          -
            kind: "Service"
            name: "picca-dev-imgproxy"
            port: 80
            weight: 1

fn httpRoutePiccaDev(namespace: String) -> Map<String, Any> = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "HTTPRoute"
  metadata:
    name: "picca-dev"
    namespace: namespace
  spec:
    hostnames:
      - "picca-dev.walnuts.dev"
    parentRefs:
      -
        name: "envoy-gateway"
        namespace: "envoy-gateway-system"
        sectionName: "https"
    rules:
      -
        backendRefs:
          -
            kind: "Service"
            name: "picca-dev-frontend"
            port: 3000
            weight: 1
        filters:
          -
            responseHeaderModifier:
              set:
                -
                  name: "Strict-Transport-Security"
                  value: "max-age=63072000; includeSubDomains"
                -
                  name: "X-Content-Type-Options"
                  value: "nosniff"
                -
                  name: "X-Frame-Options"
                  value: "DENY"
                -
                  name: "Referrer-Policy"
                  value: "no-referrer"
                -
                  name: "Permissions-Policy"
                  value: "camera=(), microphone=(), geolocation=(self), payment=(), usb=(), serial=(), bluetooth=(), accelerometer=(), gyroscope=(), magnetometer=()"
            type: "ResponseHeaderModifier"
        matches:
          -
            path:
              type: "PathPrefix"
              value: "/api/health"
          -
            path:
              type: "PathPrefix"
              value: "/api/telemetry"
      -
        backendRefs:
          -
            kind: "Service"
            name: "picca-dev-apiserver"
            port: 8080
            weight: 1
        filters:
          -
            responseHeaderModifier:
              set:
                -
                  name: "Strict-Transport-Security"
                  value: "max-age=63072000; includeSubDomains"
                -
                  name: "X-Content-Type-Options"
                  value: "nosniff"
                -
                  name: "X-Frame-Options"
                  value: "DENY"
                -
                  name: "Referrer-Policy"
                  value: "no-referrer"
                -
                  name: "Permissions-Policy"
                  value: "camera=(), microphone=(), geolocation=(self), payment=(), usb=(), serial=(), bluetooth=(), accelerometer=(), gyroscope=(), magnetometer=()"
            type: "ResponseHeaderModifier"
        matches:
          -
            path:
              type: "PathPrefix"
              value: "/auth"
          -
            path:
              type: "PathPrefix"
              value: "/query"
          -
            path:
              type: "PathPrefix"
              value: "/api"
        timeouts:
          backendRequest: "0s"
          request: "0s"
      -
        backendRefs:
          -
            kind: "Service"
            name: "picca-dev-frontend"
            port: 3000
            weight: 1
        filters:
          -
            responseHeaderModifier:
              set:
                -
                  name: "Strict-Transport-Security"
                  value: "max-age=63072000; includeSubDomains"
                -
                  name: "X-Content-Type-Options"
                  value: "nosniff"
                -
                  name: "X-Frame-Options"
                  value: "DENY"
                -
                  name: "Referrer-Policy"
                  value: "no-referrer"
                -
                  name: "Permissions-Policy"
                  value: "camera=(), microphone=(), geolocation=(self), payment=(), usb=(), serial=(), bluetooth=(), accelerometer=(), gyroscope=(), magnetometer=()"
            type: "ResponseHeaderModifier"

fn httpRoutePiccaDevHttp(namespace: String) -> Map<String, Any> = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "HTTPRoute"
  metadata:
    name: "picca-dev-http"
    namespace: namespace
  spec:
    hostnames:
      - "picca-dev.walnuts.dev"
    parentRefs:
      -
        name: "envoy-gateway"
        namespace: "envoy-gateway-system"
        sectionName: "http"
    rules:
      -
        filters:
          -
            requestRedirect:
              scheme: "https"
              statusCode: 301
            type: "RequestRedirect"

fn externalSecretPiccaDevImgproxy(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: "picca-dev-imgproxy"
    namespace: namespace
  spec:
    data:
      -
        remoteRef:
          key: "terraform-external-secrets"
          property: "picca-dev-imgproxy-key"
        secretKey: "imgproxy_key"
      -
        remoteRef:
          key: "terraform-external-secrets"
          property: "picca-dev-imgproxy-salt"
        secretKey: "imgproxy_salt"
    refreshInterval: "1m"
    secretStoreRef:
      kind: "ClusterSecretStore"
      name: "onepassword"
    target:
      name: "picca-dev-imgproxy"
      template:
        data:
          IMGPROXY_ALLOW_ORIGIN: "https://picca-dev.walnuts.dev"
          IMGPROXY_FAIL_ON_DEPRECATION: "true"
          IMGPROXY_KEY: "{{ .imgproxy_key }}"
          IMGPROXY_PROMETHEUS_BIND: ":8081"
          IMGPROXY_S3_ALLOWED_BUCKETS: "picca-dev"
          IMGPROXY_S3_ENDPOINT: "http://seaweedfs-default-filer.seaweedfs.svc.cluster.local:8333"
          IMGPROXY_S3_ENDPOINT_USE_PATH_STYLE: "true"
          IMGPROXY_S3_REGION: "us-east-1"
          IMGPROXY_SALT: "{{ .imgproxy_salt }}"
          IMGPROXY_TTL: "900"
          IMGPROXY_USE_S3: "true"
        engineVersion: "v2"
        type: "Opaque"

fn networkPolicyPiccaDev(namespace: String) -> Map<String, Any> = node:
  apiVersion: "networking.k8s.io/v1"
  kind: "NetworkPolicy"
  metadata:
    labels:
      app: "picca-dev"
      "app.kubernetes.io/name": "picca-dev"
    name: "picca-dev"
    namespace: namespace
  spec:
    egress:
      -
        to:
          -
            ipBlock:
              cidr: "0.0.0.0/0"
              except:
                - "192.168.0.0/16"
                - "10.244.0.0/16"
                - "10.96.0.0/12"
          -
            namespaceSelector:
              matchLabels:
                "kubernetes.io/metadata.name": "kube-system"
            podSelector:
              matchLabels:
                "k8s-app": "kube-dns"
          -
            namespaceSelector:
              matchLabels:
                "kubernetes.io/metadata.name": "opentelemetry-collector"
            podSelector:
              matchLabels:
                "app.kubernetes.io/name": "default-collector"
          -
            namespaceSelector:
              matchLabels:
                "kubernetes.io/metadata.name": "databases"
            podSelector:
              matchLabels:
                "cnpg.io/cluster": "postgresql-default"
          -
            namespaceSelector:
              matchLabels:
                "kubernetes.io/metadata.name": "databases"
            podSelector:
              matchLabels:
                "scylla/cluster": "scylla-cluster"
          -
            namespaceSelector:
              matchLabels:
                "kubernetes.io/metadata.name": "rabbitmq"
          -
            namespaceSelector:
              matchLabels:
                "kubernetes.io/metadata.name": "seaweedfs"
          -
            namespaceSelector:
              matchLabels:
                "kubernetes.io/metadata.name": "qdrant"
          -
            namespaceSelector:
              matchLabels:
                "kubernetes.io/metadata.name": "zitadel"
          -
            podSelector: emptyMap
    podSelector: emptyMap
    policyTypes:
      - "Egress"

fn externalSecretPiccaDevOidc(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: "picca-dev-oidc"
    namespace: namespace
  spec:
    data:
      -
        remoteRef:
          key: "terraform-external-secrets"
          property: "picca-dev-client-id"
        secretKey: "oidc_client_id"
      -
        remoteRef:
          key: "terraform-external-secrets"
          property: "picca-dev-client-secret"
        secretKey: "oidc_client_secret"
    refreshInterval: "1m"
    secretStoreRef:
      kind: "ClusterSecretStore"
      name: "onepassword"
    target:
      name: "picca-dev-oidc"
      template:
        data:
          OIDC_CLIENT_ID: "{{ .oidc_client_id }}"
          OIDC_CLIENT_SECRET: "{{ .oidc_client_secret }}"
        engineVersion: "v2"
        type: "Opaque"

fn externalSecretPiccaDevPostgres(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: "picca-dev-postgres"
    namespace: namespace
  spec:
    data:
      -
        remoteRef:
          key: "postgres_passwords"
          property: "picca_dev"
        secretKey: "postgres_password"
    refreshInterval: "1m"
    secretStoreRef:
      kind: "ClusterSecretStore"
      name: "onepassword"
    target:
      name: "picca-dev-postgres"
      template:
        data:
          DATABASE_URL: "postgres://picca_dev:{{ .postgres_password }}@postgresql-default-rw.databases.svc.cluster.local:5432/picca_dev?pool_max_conns=2"
        engineVersion: "v2"
        type: "Opaque"

fn externalSecretPiccaDevRabbitmqUserCredentials(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: "picca-dev-rabbitmq-user-credentials"
    namespace: namespace
  spec:
    data:
      -
        remoteRef:
          key: "terraform-external-secrets"
          property: "picca-dev-rabbitmq-password"
        secretKey: "password"
    refreshInterval: "1m"
    secretStoreRef:
      kind: "ClusterSecretStore"
      name: "onepassword"
    target:
      name: "picca-dev-rabbitmq-user-credentials"
      template:
        data:
          password: "{{ .password }}"
          username: "picca-dev"
        engineVersion: "v2"
        type: "Opaque"

fn permissionPiccaDev(namespace: String) -> Map<String, Any> = node:
  apiVersion: "rabbitmq.com/v1beta1"
  kind: "Permission"
  metadata:
    name: "picca-dev"
    namespace: namespace
  spec:
    permissions:
      configure: ".*"
      read: ".*"
      write: ".*"
    rabbitmqClusterReference:
      name: "default"
      namespace: "rabbitmq"
    userReference:
      name: "picca-dev"
    vhost: "picca-dev"

fn externalSecretPiccaDevRabbitmq(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: "picca-dev-rabbitmq"
    namespace: namespace
  spec:
    data:
      -
        remoteRef:
          key: "terraform-external-secrets"
          property: "picca-dev-rabbitmq-password"
        secretKey: "rabbitmq_password"
    refreshInterval: "1m"
    secretStoreRef:
      kind: "ClusterSecretStore"
      name: "onepassword"
    target:
      name: "picca-dev-rabbitmq"
      template:
        data:
          KEDA_RABBITMQ_HOST: "http://picca-dev:{{ .rabbitmq_password }}@default.rabbitmq.svc.cluster.local:15672/picca-dev"
          RABBITMQ_URL: "amqp://picca-dev:{{ .rabbitmq_password }}@default.rabbitmq.svc.cluster.local:5672/picca-dev"
        engineVersion: "v2"
        type: "Opaque"

fn userPiccaDev(namespace: String) -> Map<String, Any> = node:
  apiVersion: "rabbitmq.com/v1beta1"
  kind: "User"
  metadata:
    name: "picca-dev"
    namespace: namespace
  spec:
    importCredentialsSecret:
      name: "picca-dev-rabbitmq-user-credentials"
    rabbitmqClusterReference:
      name: "default"
      namespace: "rabbitmq"
    tags:
      - "monitoring"

fn vhostPiccaDev(namespace: String) -> Map<String, Any> = node:
  apiVersion: "rabbitmq.com/v1beta1"
  kind: "Vhost"
  metadata:
    name: "picca-dev"
    namespace: namespace
  spec:
    name: "picca-dev"
    rabbitmqClusterReference:
      name: "default"
      namespace: "rabbitmq"

fn serviceAccountPiccaDev(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "ServiceAccount"
  metadata:
    name: "picca-dev"
    namespace: namespace

fn externalSecretScyllaClusterLocalClientCaAt73(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: "scylla-cluster-local-client-ca"
    namespace: namespace
  spec:
    dataFrom:
      -
        extract:
          key: "scylla-cluster-local-client-ca"
    refreshInterval: "1h"
    secretStoreRef:
      kind: "SecretStore"
      name: "scylla-client-cert"
    target:
      name: "scylla-cluster-local-client-ca"

let rolePiccaDevReadScyllaClientCert = node:
  apiVersion: "rbac.authorization.k8s.io/v1"
  kind: "Role"
  metadata:
    name: "picca-dev-read-scylla-client-cert"
    namespace: "databases"
  rules:
    -
      apiGroups:
        - ""
      resourceNames:
        - "scylla-cluster-local-client-ca"
      resources:
        - "secrets"
      verbs:
        - "get"

let roleBindingPiccaDevReadScyllaClientCert = node:
  apiVersion: "rbac.authorization.k8s.io/v1"
  kind: "RoleBinding"
  metadata:
    name: "picca-dev-read-scylla-client-cert"
    namespace: "databases"
  roleRef:
    apiGroup: "rbac.authorization.k8s.io"
    kind: "Role"
    name: "picca-dev-read-scylla-client-cert"
  subjects:
    -
      kind: "ServiceAccount"
      name: "picca-dev-scylla-secret-reader"
      namespace: "picca-dev"

fn serviceAccountPiccaDevScyllaSecretReader(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "ServiceAccount"
  metadata:
    name: "picca-dev-scylla-secret-reader"
    namespace: namespace

fn secretStoreScyllaClientCertAt77(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "SecretStore"
  metadata:
    name: "scylla-client-cert"
    namespace: namespace
  spec:
    provider:
      kubernetes:
        auth:
          serviceAccount:
            name: "picca-dev-scylla-secret-reader"
            namespace: "picca-dev"
        remoteNamespace: "databases"
        server:
          caProvider:
            key: "ca.crt"
            name: "kube-root-ca.crt"
            type: "ConfigMap"
          url: "https://kubernetes.default.svc"

fn externalSecretPiccaDevScylla(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: "picca-dev-scylla"
    namespace: namespace
  spec:
    data:
      -
        remoteRef:
          key: "scylladb"
          property: "picca_dev"
        secretKey: "scylla_password"
    refreshInterval: "1m"
    secretStoreRef:
      kind: "ClusterSecretStore"
      name: "onepassword"
    target:
      name: "picca-dev-scylla"
      template:
        data:
          SCYLLA_PASSWORD: "{{ .scylla_password }}"
        engineVersion: "v2"
        type: "Opaque"

fn valkeyClusterPiccaDevValkey(namespace: String) -> Map<String, Any> = node:
  apiVersion: "valkey.io/v1alpha1"
  kind: "ValkeyCluster"
  metadata:
    annotations:
      "argocd.argoproj.io/sync-options": "SkipDryRunOnMissingResource=true"
    labels:
      app: "picca-dev-valkey"
      "app.kubernetes.io/name": "picca-dev-valkey"
    name: "picca-dev-valkey"
    namespace: namespace
  spec:
    replicas: 2
    resources:
      limits:
        cpu: "1"
        memory: "1Gi"
      requests:
        cpu: "5m"
        memory: "5Mi"
    scheduling:
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              -
                matchExpressions:
                  -
                    key: "storage.walnuts.dev/slow"
                    operator: "DoesNotExist"
    shards: 1
    users:
      -
        enabled: true
        name: "default"
        passwordSecret:
          keys:
            - "valkey_password"
          name: "picca-dev-valkey"
        permissions: "+@all ~* &*"

fn externalSecretPiccaDevValkey(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: "picca-dev-valkey"
    namespace: namespace
  spec:
    data:
      -
        remoteRef:
          key: "terraform-external-secrets"
          property: "picca-dev-redis-password"
        secretKey: "valkey_password"
    refreshInterval: "1m"
    secretStoreRef:
      kind: "ClusterSecretStore"
      name: "onepassword"
    target:
      name: "picca-dev-valkey"
      template:
        data:
          VALKEY_URL: "redis://:{{ .valkey_password }}@valkey-picca-dev-valkey.picca-dev.svc.cluster.local:6379/0"
          valkey_password: "{{ .valkey_password }}"
        engineVersion: "v2"
        type: "Opaque"

export fn render(namespace: String) -> List<Map<String, Any>> =
  - configMapPiccaDevPlans(namespace)
  - configMapPiccaDevScylladbCaCert(namespace)
  - externalSecretPiccaDevGraphqlSigningSecret(namespace)
  - httpRoutePiccaDevImgproxy(namespace)
  - httpRoutePiccaDev(namespace)
  - httpRoutePiccaDevHttp(namespace)
  - externalSecretPiccaDevImgproxy(namespace)
  - networkPolicyPiccaDev(namespace)
  - externalSecretPiccaDevOidc(namespace)
  - externalSecretPiccaDevPostgres(namespace)
  - externalSecretPiccaDevRabbitmqUserCredentials(namespace)
  - permissionPiccaDev(namespace)
  - externalSecretPiccaDevRabbitmq(namespace)
  - userPiccaDev(namespace)
  - vhostPiccaDev(namespace)
  - serviceAccountPiccaDev(namespace)
  - externalSecretScyllaClusterLocalClientCaAt73(namespace)
  - rolePiccaDevReadScyllaClientCert
  - roleBindingPiccaDevReadScyllaClientCert
  - serviceAccountPiccaDevScyllaSecretReader(namespace)
  - secretStoreScyllaClientCertAt77(namespace)
  - externalSecretPiccaDevScylla(namespace)
  - valkeyClusterPiccaDevValkey(namespace)
  - externalSecretPiccaDevValkey(namespace)
