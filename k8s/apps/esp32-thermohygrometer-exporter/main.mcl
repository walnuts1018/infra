import "std:hash" as hashes
import "../../cluster.mcl" as clusterConfig
param cluster: clusterConfig.Cluster
param namespace: String

let appName = "esp32-thermohygrometer-exporter"
let externalSecretData =
  - secretKey: "device_url"
    remoteRef:
      key: "esp32_thermohygrometer_exporter"
      property: "device_url"
  - secretKey: "private_key_json"
    remoteRef:
      key: "esp32_thermohygrometer_exporter"
      property: "private_key_json"
let externalSecretName = appName + "-" + hashes.fnv1a64(externalSecretData)
let labels =
  app: appName
  "app.kubernetes.io/name": appName

let deployment = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    name: appName
    namespace: namespace
    labels: labels
  spec:
    replicas: 1
    selector:
      matchLabels: labels
    template:
      metadata:
        labels: labels
      spec:
        containers:
          - name: appName
            image: "ghcr.io/walnuts1018/esp32-thermohygrometer-exporter:v0.0.29"
            imagePullPolicy: "IfNotPresent"
            resources:
              requests:
                cpu: "1m"
                memory: "30Mi"
              limits:
                cpu: "100m"
                memory: "128Mi"
            securityContext:
              capabilities:
                add:
                  - "NET_BIND_SERVICE"
                drop:
                  - "all"
              readOnlyRootFilesystem: true
              seccompProfile:
                type: "RuntimeDefault"
            livenessProbe:
              httpGet:
                path: "/livez"
                port: 8080
              initialDelaySeconds: 0
              periodSeconds: 10
              timeoutSeconds: 1
              failureThreshold: 3
            readinessProbe:
              httpGet:
                path: "/readyz"
                port: 8080
              initialDelaySeconds: 0
              periodSeconds: 5
              timeoutSeconds: 1
              failureThreshold: 3
            startupProbe:
              httpGet:
                path: "/livez"
                port: 8080
              periodSeconds: 1
              timeoutSeconds: 1
              failureThreshold: 30
            env:
              - name: "FETCH_INTERVAL"
                value: "30s"
              - name: "DEVICE_URL"
                valueFrom:
                  secretKeyRef:
                    name: externalSecretName
                    key: "device_url"
              - name: "OIDC_PRIVATE_KEY_JSON"
                valueFrom:
                  secretKeyRef:
                    name: externalSecretName
                    key: "private_key_json"
              - name: "OIDC_SCOPES"
                value: "openid urn:zitadel:iam:org:project:id:375241036420612774:aud urn:zitadel:iam:org:project:role:thermohygrometer.read"
              - name: "OIDC_ISSUER"
                value: "https://auth.walnuts.dev"
              - name: "OTEL_EXPORTER_OTLP_ENDPOINT"
                value: "http://default-collector.opentelemetry-collector.svc.cluster.local:4317"
              - name: "OTEL_EXPORTER_OTLP_INSECURE"
                value: "true"
              - name: "LOG_LEVEL"
                value: "info"
              - name: "LOG_TYPE"
                value: "json"

let externalSecret = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: externalSecretName
    namespace: namespace
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: externalSecretName
      template:
        engineVersion: "v2"
        type: "Opaque"
    data: externalSecretData

emit deployment
emit externalSecret
