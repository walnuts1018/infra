import "std:helm" as helm
import "./chart.mcl" as appChart
import "./external-secrets.mcl" as externalSecrets
import "./values.mcl" as appValues
import "./service-account.mcl" as serviceAccount
import "../../cluster.mcl" as clusterConfig
param cluster: clusterConfig.Cluster
param namespace: String

let options =
  releaseName: appChart.releaseName
  namespace: namespace
  version: appChart.chartVersion
  kubeVersion: cluster.kubernetesVersion
  apiVersions: appChart.apiVersions
  values: appValues.baseValues
let resources = helm.render(appChart.chartArchive, options)

emit each resources
emit externalSecrets.netboxSecret(namespace)
emit externalSecrets.oidcSecret(namespace)
emit serviceAccount.resource(namespace)
