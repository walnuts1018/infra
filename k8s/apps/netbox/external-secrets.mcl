import text "./_configs/oidc.py" as oidcConfig

let netboxData =
  - secretKey: "superuser_password"
    remoteRef:
      key: "netbox"
      property: "superuser-password"
  - secretKey: "superuser_api_token"
    remoteRef:
      key: "netbox"
      property: "superuser-api-token"
  - secretKey: "secret_key"
    remoteRef:
      key: "netbox"
      property: "secret_key"
  - secretKey: "api_token_peppers1"
    remoteRef:
      key: "netbox"
      property: "api_token_peppers"
  - secretKey: "db_password"
    remoteRef:
      key: "postgres_passwords"
      property: "netbox"
  - secretKey: "smtp_password"
    remoteRef:
      key: "resend"
      property: "api-key"
  - secretKey: "valkey_password"
    remoteRef:
      key: "netbox"
      property: "valkey_password"
let netboxTemplateData =
  username: "netbox-admin"
  email: "netbox-admin@walnuts.dev"
  password: "{{ .superuser_password }}"
  api_token: "{{ .superuser_api_token }}"
  secret_key: "{{ .secret_key }}"
  api_token_peppers: "{\"1\": \"{{ .api_token_peppers1 }}\"}"
  "db-password": "{{ .db_password }}"
  "smtp-password": "{{ .smtp_password }}"
  valkey_password: "{{ .valkey_password }}"
export let netboxSecretName = "netbox"

let oidcData =
  - secretKey: "client_id"
    remoteRef:
      key: "terraform-external-secrets"
      property: "netbox-oidc-client-id"
  - secretKey: "client_secret"
    remoteRef:
      key: "terraform-external-secrets"
      property: "netbox-oidc-client-secret"
export let oidcSecretName = "netbox-oidc-config"

export let netboxSecret = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: netboxSecretName
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: netboxSecretName
      template:
        engineVersion: "v2"
        type: "Opaque"
        data: netboxTemplateData
    data: netboxData

export let oidcSecret = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: oidcSecretName
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: oidcSecretName
      template:
        engineVersion: "v2"
        type: "Opaque"
        data:
          "oidc.py": oidcConfig
    data: oidcData
