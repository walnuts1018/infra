{
  name: "cilium",
  namespace: "cilium-system",
  additionalSources: {
    helm: {
      repoURL: "https://helm.cilium.io/",
      chart: "cilium",
      targetRevision: "1.20.1",
      valueFiles: [
        "values.yaml",
      ],
    },
  },
  clusters: {
    kurumi: {
      jsonnet: {
        tlas: [
          {
            name: "cloudflareOriginCert",
            value: "true",
          },
        ],
      },
    },
    biscuit: {
      jsonnet: {
        tlas: [
          {
            name: "cloudflareOriginCert",
            value: "false",
          },
        ],
      },
      additionalSources: {
        helm: {
          valueFiles: [
            "values.biscuit.yaml",
          ],
        },
      },
    },
  },
}
