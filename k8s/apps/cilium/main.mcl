import "std:helm" as helm
import "std:list" as lists
import "./chart.mcl" as appChart
import "./external-secret.mcl" as externalSecret
import "./values.mcl" as appValues

type Feature = "originCertificateIngress" | "gatewayAPI" | "monitoring" | "hubbleTLS" | "l2Announcements" | "nodePort"
type Settings =
  api_server: String
  cluster_id: Int
  cluster_name: String
  envoy_memory: String

param features: List<Feature> = []
param settings: Settings

let originCertificateIngressEnabled = lists.contains(features, "originCertificateIngress")
let gatewayAPIEnabled = lists.contains(features, "gatewayAPI")
let monitoringEnabled = lists.contains(features, "monitoring")
let hubbleTLSEnabled = lists.contains(features, "hubbleTLS")
let l2AnnouncementsEnabled = lists.contains(features, "l2Announcements")
let nodePortEnabled = lists.contains(features, "nodePort")
let helmValues = appValues.helmValues(
  originCertificateIngressEnabled,
  gatewayAPIEnabled,
  monitoringEnabled,
  hubbleTLSEnabled,
  l2AnnouncementsEnabled,
  nodePortEnabled,
  settings.api_server,
  settings.cluster_id,
  settings.cluster_name,
  settings.envoy_memory,
)
let apiVersions: List<String> = []
let options =
  releaseName: "cilium"
  namespace: appChart.namespace
  version: appChart.chartVersion
  kubeVersion: appChart.kubeVersion
  now: appChart.durationValidationTime
  apiVersions: apiVersions
  values: helmValues
let chartResources = helm.render(appChart.chartArchive, options)
let extraResources =
  if originCertificateIngressEnabled:
    - externalSecret.resource
  else:
    []

emit each lists.concat(chartResources, extraResources)
