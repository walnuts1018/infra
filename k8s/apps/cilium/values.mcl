let commonValues =
  kubeProxyReplacement: true
  l7Proxy: true
  k8sServicePort: 6443
  cni:
    resources:
      limits:
        cpu: "1"
  bgpControlPlane:
    enabled: true
  k8sClientRateLimit:
    qps: 10
    burst: 20
  resources:
    requests:
      cpu: "100m"
      memory: "512Mi"
    limits:
      memory: "2Gi"
  envoy:
    log:
      accessLogBufferSize: 16384
    resources:
      requests:
        cpu: "10m"
        memory: "51Mi"
  operator:
    replicas: 1
    resources:
      requests:
        cpu: "10m"
        memory: "60Mi"
      limits:
        memory: "512Mi"

let hubbleMetricNames: List<String> =
  - "dns"
  - "drop"
  - "tcp"
  - "flow:labelsContext=source_namespace,source_workload_kind,source_workload,destination_namespace,destination_workload_kind,destination_workload,traffic_direction"
  - "flows-to-world"
  - "port-distribution"
  - "icmp"
  - "httpV2:exemplars=true;"

fn hubbleMetrics(enabled: Bool) -> List<String> =
  if enabled:
    hubbleMetricNames
  else:
    []

export fn helmValues(originCertificateIngressEnabled: Bool, gatewayAPIEnabled: Bool, monitoringEnabled: Bool, hubbleTLSEnabled: Bool, l2AnnouncementsEnabled: Bool, nodePortEnabled: Bool, apiServer: String, clusterID: Int, clusterName: String, envoyMemory: String) -> Map<String, Any> = commonValues with:
  k8sServiceHost: apiServer
  cluster:
    id: clusterID
    name: clusterName
  l2announcements:
    enabled: l2AnnouncementsEnabled
  ingressController:
    enabled: originCertificateIngressEnabled
    loadbalancerMode: "shared"
    default: true
    enforceHttps: true
    service:
      loadBalancerIP: "192.168.12.129"
    defaultSecretName: "cloudflare-origin-cert"
    defaultSecretNamespace: "cilium-system"
    secretsNamespace:
      create: false
      name: "cilium-secrets"
      sync: true
  nodePort:
    enabled: nodePortEnabled
  hubble:
    tls:
      enabled: hubbleTLSEnabled
      auto:
        method: "cronJob"
    relay:
      enabled: monitoringEnabled
      prometheus:
        enabled: monitoringEnabled
        serviceMonitor:
          enabled: monitoringEnabled
      resources:
        requests:
          cpu: "5m"
          memory: "48Mi"
        limits:
          memory: "512Mi"
    ui:
      enabled: monitoringEnabled
      backend:
        resources:
          requests:
            cpu: "5m"
            memory: "60Mi"
          limits:
            memory: "256Mi"
      frontend:
        resources:
          requests:
            cpu: "1m"
            memory: "10Mi"
          limits:
            memory: "256Mi"
    metrics:
      enableOpenMetrics: monitoringEnabled
      enabled: hubbleMetrics(monitoringEnabled)
      serviceMonitor:
        enabled: monitoringEnabled
      dashboards:
        enabled: monitoringEnabled
  envoy:
    resources:
      requests:
        memory: envoyMemory
    prometheus:
      enabled: monitoringEnabled
      serviceMonitor:
        enabled: monitoringEnabled
  operator:
    prometheus:
      enabled: monitoringEnabled
      serviceMonitor:
        enabled: monitoringEnabled
  prometheus:
    enabled: monitoringEnabled
    serviceMonitor:
      enabled: monitoringEnabled
      trustCRDsExist: true
  envoyConfig:
    enabled: originCertificateIngressEnabled
    secretsNamespace:
      create: false
      name: "cilium-secrets"
  tls:
    secretsNamespace:
      create: false
      name: "cilium-secrets"
  gatewayAPI:
    enabled: gatewayAPIEnabled
    secretsNamespace:
      create: true
      name: "cilium-secrets"
      sync: true
    gatewayClass:
      create: false
