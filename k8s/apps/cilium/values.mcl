import "std:list" as lists
import "../../cluster.mcl" as clusterConfig
import "./config.mcl" as config

let commonValues =
  kubeProxyReplacement: true
  l7Proxy: true
  k8sServicePort: 6443
  cni:
    resources:
      limits:
        cpu: "1"
  bgpControlPlane:
    enabled: true
  k8sClientRateLimit:
    qps: 10
    burst: 20
  resources:
    requests:
      cpu: "100m"
      memory: "512Mi"
    limits:
      memory: "2Gi"
  envoy:
    log:
      accessLogBufferSize: 16384
    resources:
      requests:
        cpu: "10m"
        memory: "51Mi"
  operator:
    replicas: 1
    resources:
      requests:
        cpu: "10m"
        memory: "60Mi"
      limits:
        memory: "512Mi"

let hubbleMetricNames: List<String> =
  - "dns"
  - "drop"
  - "tcp"
  - "flow:labelsContext=source_namespace,source_workload_kind,source_workload,destination_namespace,destination_workload_kind,destination_workload,traffic_direction"
  - "flows-to-world"
  - "port-distribution"
  - "icmp"
  - "httpV2:exemplars=true;"

fn hubbleMetrics(enabled: Bool) -> List<String> =
  if enabled:
    hubbleMetricNames
  else:
    []

type FeatureFlags =
  l2Announcements: Bool
  originCertificateIngress: Bool
  gatewayAPI: Bool
  hubbleTLS: Bool
  monitoring: Bool
  nodePort: Bool

fn featureFlags(features: List<config.Feature>) -> FeatureFlags =
  l2Announcements: lists.contains(features, "l2Announcements")
  originCertificateIngress: lists.contains(features, "originCertificateIngress")
  gatewayAPI: lists.contains(features, "gatewayAPI")
  hubbleTLS: lists.contains(features, "hubbleTLS")
  monitoring: lists.contains(features, "monitoring")
  nodePort: lists.contains(features, "nodePort")

fn helmValuesWithFlags(clusterContext: clusterConfig.Cluster, namespace: String, settings: config.Settings, flags: FeatureFlags) -> Map<String, Any> = commonValues with:
  k8sServiceHost: settings.apiServer
  cluster:
    id: settings.clusterId
    name: clusterContext.name
  l2announcements:
    enabled: flags.l2Announcements
  ingressController:
    enabled: flags.originCertificateIngress
    loadbalancerMode: "shared"
    default: true
    enforceHttps: true
    service:
      loadBalancerIP: settings.ingressLoadBalancerIP ?? ""
    defaultSecretName: "cloudflare-origin-cert"
    defaultSecretNamespace: namespace
    secretsNamespace:
      create: false
      name: "cilium-secrets"
      sync: true
  nodePort:
    enabled: flags.nodePort
  hubble:
    tls:
      enabled: flags.hubbleTLS
      auto:
        method: "cronJob"
    relay:
      enabled: flags.monitoring
      prometheus:
        enabled: flags.monitoring
        serviceMonitor:
          enabled: flags.monitoring
      resources:
        requests:
          cpu: "5m"
          memory: "48Mi"
        limits:
          memory: "512Mi"
    ui:
      enabled: flags.monitoring
      backend:
        resources:
          requests:
            cpu: "5m"
            memory: "60Mi"
          limits:
            memory: "256Mi"
      frontend:
        resources:
          requests:
            cpu: "1m"
            memory: "10Mi"
          limits:
            memory: "256Mi"
    metrics:
      enableOpenMetrics: flags.monitoring
      enabled: hubbleMetrics(flags.monitoring)
      serviceMonitor:
        enabled: flags.monitoring
      dashboards:
        enabled: flags.monitoring
  envoy:
    resources:
      requests:
        memory: settings.envoyMemory
    prometheus:
      enabled: flags.monitoring
      serviceMonitor:
        enabled: flags.monitoring
  operator:
    prometheus:
      enabled: flags.monitoring
      serviceMonitor:
        enabled: flags.monitoring
  prometheus:
    enabled: flags.monitoring
    serviceMonitor:
      enabled: flags.monitoring
  envoyConfig:
    enabled: flags.originCertificateIngress
    secretsNamespace:
      create: false
      name: "cilium-secrets"
  tls:
    secretsNamespace:
      create: false
      name: "cilium-secrets"
  gatewayAPI:
    enabled: flags.gatewayAPI
    secretsNamespace:
      create: true
      name: "cilium-secrets"
      sync: true
    gatewayClass:
      create: false

export fn helmValues(clusterContext: clusterConfig.Cluster, namespace: String, features: List<config.Feature>, settings: config.Settings) -> Map<String, Any> =
  helmValuesWithFlags(clusterContext, namespace, settings, featureFlags(features))
