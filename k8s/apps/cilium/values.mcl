import "std:list" as lists

export type Feature = "originCertificateIngress" | "gatewayAPI" | "monitoring" | "hubbleTLS" | "l2Announcements" | "nodePort"
export type Settings =
  api_server: String
  cluster_id: Int
  cluster_name: String
  envoy_memory: String

let commonValues =
  kubeProxyReplacement: true
  l7Proxy: true
  k8sServicePort: 6443
  cni:
    resources:
      limits:
        cpu: "1"
  bgpControlPlane:
    enabled: true
  k8sClientRateLimit:
    qps: 10
    burst: 20
  resources:
    requests:
      cpu: "100m"
      memory: "512Mi"
    limits:
      memory: "2Gi"
  envoy:
    log:
      accessLogBufferSize: 16384
    resources:
      requests:
        cpu: "10m"
        memory: "51Mi"
  operator:
    replicas: 1
    resources:
      requests:
        cpu: "10m"
        memory: "60Mi"
      limits:
        memory: "512Mi"

let hubbleMetricNames: List<String> =
  - "dns"
  - "drop"
  - "tcp"
  - "flow:labelsContext=source_namespace,source_workload_kind,source_workload,destination_namespace,destination_workload_kind,destination_workload,traffic_direction"
  - "flows-to-world"
  - "port-distribution"
  - "icmp"
  - "httpV2:exemplars=true;"

fn hubbleMetrics(enabled: Bool) -> List<String> =
  if enabled:
    hubbleMetricNames
  else:
    []

export fn helmValues(features: List<Feature>, settings: Settings) -> Map<String, Any> = commonValues with:
  k8sServiceHost: settings.api_server
  cluster:
    id: settings.cluster_id
    name: settings.cluster_name
  l2announcements:
    enabled: lists.contains(features, "l2Announcements")
  ingressController:
    enabled: lists.contains(features, "originCertificateIngress")
    loadbalancerMode: "shared"
    default: true
    enforceHttps: true
    service:
      loadBalancerIP: "192.168.12.129"
    defaultSecretName: "cloudflare-origin-cert"
    defaultSecretNamespace: "cilium-system"
    secretsNamespace:
      create: false
      name: "cilium-secrets"
      sync: true
  nodePort:
    enabled: lists.contains(features, "nodePort")
  hubble:
    tls:
      enabled: lists.contains(features, "hubbleTLS")
      auto:
        method: "cronJob"
    relay:
      enabled: lists.contains(features, "monitoring")
      prometheus:
        enabled: lists.contains(features, "monitoring")
        serviceMonitor:
          enabled: lists.contains(features, "monitoring")
      resources:
        requests:
          cpu: "5m"
          memory: "48Mi"
        limits:
          memory: "512Mi"
    ui:
      enabled: lists.contains(features, "monitoring")
      backend:
        resources:
          requests:
            cpu: "5m"
            memory: "60Mi"
          limits:
            memory: "256Mi"
      frontend:
        resources:
          requests:
            cpu: "1m"
            memory: "10Mi"
          limits:
            memory: "256Mi"
    metrics:
      enableOpenMetrics: lists.contains(features, "monitoring")
      enabled: hubbleMetrics(lists.contains(features, "monitoring"))
      serviceMonitor:
        enabled: lists.contains(features, "monitoring")
      dashboards:
        enabled: lists.contains(features, "monitoring")
  envoy:
    resources:
      requests:
        memory: settings.envoy_memory
    prometheus:
      enabled: lists.contains(features, "monitoring")
      serviceMonitor:
        enabled: lists.contains(features, "monitoring")
  operator:
    prometheus:
      enabled: lists.contains(features, "monitoring")
      serviceMonitor:
        enabled: lists.contains(features, "monitoring")
  prometheus:
    enabled: lists.contains(features, "monitoring")
    serviceMonitor:
      enabled: lists.contains(features, "monitoring")
      trustCRDsExist: true
  envoyConfig:
    enabled: lists.contains(features, "originCertificateIngress")
    secretsNamespace:
      create: false
      name: "cilium-secrets"
  tls:
    secretsNamespace:
      create: false
      name: "cilium-secrets"
  gatewayAPI:
    enabled: lists.contains(features, "gatewayAPI")
    secretsNamespace:
      create: true
      name: "cilium-secrets"
      sync: true
    gatewayClass:
      create: false
