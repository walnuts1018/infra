export let resource = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: "cloudflare-origin-cert"
    namespace: "cilium-system"
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: "cloudflare-origin-cert"
      template:
        engineVersion: "v2"
        type: "kubernetes.io/tls"
    data:
      - secretKey: "tls.crt"
        remoteRef:
          key: "cloudflare-origin-cert"
          property: "tls.crt"
      - secretKey: "tls.key"
        remoteRef:
          key: "cloudflare-origin-cert"
          property: "tls.key"
