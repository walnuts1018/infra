import "./app.mcl" as app

export fn resources(namespace: String) -> List<Map<String, Any>> =
  - node:
      apiVersion: "networking.k8s.io/v1"
      kind: "NetworkPolicy"
      metadata:
        name: app.name
        namespace: namespace
      spec:
        podSelector:
          matchLabels:
            "app.kubernetes.io/name": "coder-workspace"
        policyTypes:
          - "Ingress"
  - node:
      apiVersion: "v1"
      kind: "ServiceAccount"
      metadata:
        name: "coder-workspace"
        namespace: namespace
      automountServiceAccountToken: false
