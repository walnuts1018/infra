import "./app.mcl" as app

export fn resources(namespace: String) -> List<Map<String, Any>> =
  -
    apiVersion: "networking.k8s.io/v1"
    kind: "NetworkPolicy"
    metadata:
      name: app.name
      namespace: namespace
    spec:
      podSelector:
        matchLabels:
          "app.kubernetes.io/name": "coder-workspace"
      policyTypes:
        - "Ingress"
  -
    apiVersion: "v1"
    kind: "ServiceAccount"
    metadata:
      name: "coder-workspace"
      namespace: namespace
    automountServiceAccountToken: false
