import "./settings.mcl" as appSettings

let name = appSettings.name + "-dashboard"
let labels =
  app: name
  "app.kubernetes.io/name": name

let deployment = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    name: name
    namespace: appSettings.namespace
    labels: labels
  spec:
    replicas: 1
    selector:
      matchLabels: labels
    template:
      metadata:
        labels: labels
      spec:
        containers:
          - name: "dashboard"
            image: "netbirdio/dashboard:v2.92.0"
            env:
              - name: "NETBIRD_MGMT_API_ENDPOINT"
                value: "https://netbird.walnuts.dev"
              - name: "NETBIRD_MGMT_GRPC_API_ENDPOINT"
                value: "https://netbird.walnuts.dev"
              - name: "AUTH_AUDIENCE"
                value: "netbird-dashboard"
              - name: "AUTH_CLIENT_ID"
                value: "netbird-dashboard"
              - name: "AUTH_AUTHORITY"
                value: "https://netbird.walnuts.dev/oauth2"
              - name: "USE_AUTH0"
                value: "false"
              - name: "AUTH_SUPPORTED_SCOPES"
                value: "openid profile email offline_access"
              - name: "AUTH_REDIRECT_URI"
                value: "/auth"
              - name: "AUTH_SILENT_REDIRECT_URI"
                value: "/silent-auth"
            ports:
              - name: "http"
                containerPort: 80
                protocol: "TCP"
            resources:
              requests:
                cpu: "10m"
                memory: "64Mi"
              limits:
                memory: "256Mi"

let service = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    name: name
    namespace: appSettings.namespace
  spec:
    selector: labels
    ports:
      - name: "http"
        port: 80
        targetPort: "http"
        protocol: "TCP"

export let resources =
  - deployment
  - service
