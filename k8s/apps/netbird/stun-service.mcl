import "./settings.mcl" as appSettings
import "./config.mcl" as config

let serverLabels =
  app: appSettings.name + "-server"
  "app.kubernetes.io/name": appSettings.name + "-server"
let ports =
  -
    name: "stun"
    port: 3478
    targetPort: 3478
    protocol: "UDP"
fn serviceSpec(settings: config.Settings) -> Map<String, Any> =
  type: "LoadBalancer"
  loadBalancerIP: settings.stunLoadBalancerIP
  selector: serverLabels
  ports: ports

export fn resource(settings: config.Settings) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    name: appSettings.name + "-stun"
    namespace: appSettings.namespace
  spec: serviceSpec(settings)
