import "std:hash" as hashes

let data =
  - secretKey: "admin-password"
    remoteRef:
      key: "influxdb"
      property: "admin-password"
  - secretKey: "admin-token"
    remoteRef:
      key: "influxdb"
      property: "admin-token"

export let name = "influxdb-" + hashes.fnv1a64(data)

export let resource = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: name
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: name
      template:
        engineVersion: "v2"
        type: "Opaque"
    data: data
