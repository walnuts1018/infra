import "std:helm" as helm
import "./chart.mcl" as appChart
import "./values.mcl" as appValues
import "./external-secret.mcl" as externalSecret
import "./http-route.mcl" as httpRoute
import "../../cluster.mcl" as clusterConfig
let apiVersions: List<String> =
  - "policy/v1"
export fn chartResources(cluster: clusterConfig.Cluster) -> List<Map<String, Any>> = helm.render(appChart.chartArchive, options(cluster))

fn options(cluster: clusterConfig.Cluster) -> Map<String, Any> =
  releaseName: appChart.releaseName
  namespace: appChart.namespace
  version: appChart.chartVersion
  kubeVersion: cluster.kubernetesVersion
  apiVersions: apiVersions
  values: appValues.values
