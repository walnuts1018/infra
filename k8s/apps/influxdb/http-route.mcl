import "../envoy-gateway-class/gateway.mcl" as gateway
import "./chart.mcl" as appChart

export fn resource(namespace: String) -> Map<String, Any> = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "HTTPRoute"
  metadata:
    name: appChart.releaseName
    namespace: namespace
  spec:
    parentRefs:
      -
        name: gateway.name
        namespace: "envoy-gateway-system"
    hostnames:
      - "influxdb.walnuts.dev"
    rules:
      -
        backendRefs:
          -
            kind: "Service"
            name: "influxdb-influxdb2"
            port: 80
            weight: 1
        matches:
          - path:
              type: "PathPrefix"
              value: "/"
