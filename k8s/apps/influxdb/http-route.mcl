import "../envoy-gateway-class/gateway.mcl" as gateway
import "../envoy-gateway-class/settings.mcl" as gatewaySettings
import "./chart.mcl" as appChart

export let resource = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "HTTPRoute"
  metadata:
    name: appChart.releaseName
    namespace: appChart.namespace
  spec:
    parentRefs:
      -
        name: gateway.name
        namespace: gatewaySettings.namespace
    hostnames:
      - "influxdb.walnuts.dev"
    rules:
      -
        backendRefs:
          -
            kind: "Service"
            name: "influxdb-influxdb2"
            port: 80
            weight: 1
        matches:
          - path:
              type: "PathPrefix"
              value: "/"
