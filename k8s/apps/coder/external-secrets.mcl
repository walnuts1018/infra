import "std:hash" as hashes

let databaseData =
  - secretKey: "database_password"
    remoteRef:
      key: "terraform-external-secrets"
      property: "coder-database-password"
let databaseTemplateData =
  url: "postgres://coder:{{ .database_password }}@postgresql-default-rw.databases.svc.cluster.local:5432/coder?sslmode=require"
let databaseHashInput =
  data: databaseData
  templateData: databaseTemplateData
export let databaseName = "coder-db-url-" + hashes.fnv1a64(databaseHashInput)

let githubData =
  - secretKey: "client-id"
    remoteRef:
      key: "coder"
      property: "github-client-id"
  - secretKey: "client-secret"
    remoteRef:
      key: "coder"
      property: "github-client-secret"
export let githubName = "coder-github-" + hashes.fnv1a64(githubData)

let oidcData =
  - secretKey: "client-id"
    remoteRef:
      key: "terraform-external-secrets"
      property: "coder-client-id"
  - secretKey: "client-secret"
    remoteRef:
      key: "terraform-external-secrets"
      property: "coder-client-secret"
export let oidcName = "coder-oidc-" + hashes.fnv1a64(oidcData)

fn externalSecret(name: String, data: List<Map<String, Any>>) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: name
    namespace: "coder"
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: name
      template:
        engineVersion: "v2"
        type: "Opaque"
    data: data

export let database = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: databaseName
    namespace: "coder"
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: databaseName
      template:
        engineVersion: "v2"
        type: "Opaque"
        data: databaseTemplateData
    data: databaseData

export let github = externalSecret(githubName, githubData)
export let oidc = externalSecret(oidcName, oidcData)
