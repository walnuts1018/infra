import "./external-secrets.mcl" as externalSecrets

export let environment =
  - name: "CODER_PG_CONNECTION_URL"
    valueFrom:
      secretKeyRef:
        name: externalSecrets.databaseName
        key: "url"
  - name: "CODER_ACCESS_URL"
    value: "https://coder.walnuts.dev"
  - name: "CODER_OIDC_ISSUER_URL"
    value: "https://auth.walnuts.dev"
  - name: "CODER_OIDC_CLIENT_ID"
    valueFrom:
      secretKeyRef:
        name: externalSecrets.oidcName
        key: "client-id"
  - name: "CODER_OIDC_CLIENT_SECRET"
    valueFrom:
      secretKeyRef:
        name: externalSecrets.oidcName
        key: "client-secret"
  - name: "CODER_DISABLE_PASSWORD_AUTH"
    value: "true"
  - name: "CODER_OAUTH2_GITHUB_DEFAULT_PROVIDER_ENABLE"
    value: "false"
  - name: "CODER_OIDC_SIGN_IN_TEXT"
    value: "Sign in with ZITADEL"
  - name: "CODER_EXTERNAL_AUTH_GITHUB_DEFAULT_PROVIDER_ENABLE"
    value: "false"
  - name: "CODER_EXTERNAL_AUTH_0_ID"
    value: "github"
  - name: "CODER_EXTERNAL_AUTH_0_TYPE"
    value: "github"
  - name: "CODER_EXTERNAL_AUTH_0_CLIENT_ID"
    valueFrom:
      secretKeyRef:
        name: externalSecrets.githubName
        key: "client-id"
  - name: "CODER_EXTERNAL_AUTH_0_CLIENT_SECRET"
    valueFrom:
      secretKeyRef:
        name: externalSecrets.githubName
        key: "client-secret"
  - name: "CODER_EXTERNAL_AUTH_0_APP_INSTALL_URL"
    value: "https://github.com/apps/kurumi-coder-app/installations/new"
