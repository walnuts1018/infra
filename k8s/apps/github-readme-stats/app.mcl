export type App =
  name: String
  image: String
  gatewayName: String
  hostname: String

export let app: App =
  name: "github-readme-stats"
  image: "ghcr.io/walnuts1018/github-readme-stats:v1.0.3"
  gatewayName: "envoy-gateway"
  hostname: "github-readme-stats.walnuts.dev"

export let labels =
  app: app.name
  "app.kubernetes.io/name": app.name
