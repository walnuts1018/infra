import "std:hash" as hashes
import "./app.mcl" as appConfig

export let data =
  - secretKey: "github-token"
    remoteRef:
      key: "github_token"
      property: "github-readme-stats"

export let name = appConfig.app.name + "-" + hashes.fnv1a64(data)

export fn externalSecret(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: name
    namespace: namespace
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: name
      template:
        engineVersion: "v2"
        type: "Opaque"
    data: data
