import "./app.mcl" as appConfig
import "../envoy-gateway-class/gateway.mcl" as gateway

let app = appConfig.app

export fn httpRoute(namespace: String) -> Map<String, Any> = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "HTTPRoute"
  metadata:
    name: app.name
    namespace: namespace
    annotations:
      "external-dns-cloudflare.alpha.kubernetes.io/cloudflare-proxied": "true"
  spec:
    parentRefs:
      -
        name: app.gatewayName
        namespace: gateway.namespace
    hostnames:
      - app.hostname
    rules:
      -
        backendRefs:
          -
            kind: "Service"
            name: app.name
            port: 80
            weight: 1
        matches:
          -
            path:
              type: "PathPrefix"
              value: "/"
