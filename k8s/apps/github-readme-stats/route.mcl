import "./app.mcl" as appConfig

let app = appConfig.app

export let httpRoute = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "HTTPRoute"
  metadata:
    name: app.name
    namespace: app.namespace
    annotations:
      "external-dns-cloudflare.alpha.kubernetes.io/cloudflare-proxied": "true"
  spec:
    parentRefs:
      -
        name: app.gatewayName
        namespace: app.gatewayNamespace
    hostnames:
      - app.hostname
    rules:
      -
        backendRefs:
          -
            kind: "Service"
            name: app.name
            port: 80
            weight: 1
        matches:
          -
            path:
              type: "PathPrefix"
              value: "/"
