export fn resources(namespace: String) -> List<Map<String, Any>> =
  -
    apiVersion: "external-secrets.io/v1"
    kind: "ExternalSecret"
    metadata:
      name: "walnuk-51af8a"
      namespace: namespace
    spec:
      secretStoreRef:
        name: "onepassword"
        kind: "ClusterSecretStore"
      refreshInterval: "1m"
      target:
        name: "walnuk-51af8a"
        template:
          engineVersion: "v2"
          type: "Opaque"
          data:
            scylladb_password: "{{ .scylladb_password }}"
            scylladb_username: "walnuk"
      data:
        - secretKey: "scylladb_password"
          remoteRef:
            key: "scylladb"
            property: "walnuk"
  -
    apiVersion: "external-secrets.io/v1"
    kind: "ExternalSecret"
    metadata:
      name: "scylla-cluster-local-client-ca"
      namespace: namespace
    spec:
      secretStoreRef:
        name: "scylla-client-cert"
        kind: "SecretStore"
      refreshInterval: "1m"
      target:
        name: "scylla-cluster-local-client-ca"
      dataFrom:
        - extract:
            key: "scylla-cluster-local-client-ca"
  -
    apiVersion: "v1"
    kind: "ServiceAccount"
    metadata:
      name: "walnuk-scylla-secret-reader"
      namespace: namespace
  -
    apiVersion: "external-secrets.io/v1"
    kind: "SecretStore"
    metadata:
      name: "scylla-client-cert"
      namespace: namespace
    spec:
      provider:
        kubernetes:
          auth:
            serviceAccount:
              name: "walnuk-scylla-secret-reader"
          remoteNamespace: "databases"
          server:
            caProvider:
              type: "ConfigMap"
              name: "kube-root-ca.crt"
              key: "ca.crt"
            url: "https://kubernetes.default.svc"
  -
    apiVersion: "rbac.authorization.k8s.io/v1"
    kind: "Role"
    metadata:
      name: "walnuk-read-scylla-client-cert"
      namespace: "databases"
    rules:
      - apiGroups:
          - ""
        resources:
          - "secrets"
        resourceNames:
          - "scylla-cluster-local-client-ca"
        verbs:
          - "get"
  -
    apiVersion: "rbac.authorization.k8s.io/v1"
    kind: "RoleBinding"
    metadata:
      name: "walnuk-read-scylla-client-cert"
      namespace: "databases"
    roleRef:
      apiGroup: "rbac.authorization.k8s.io"
      kind: "Role"
      name: "walnuk-read-scylla-client-cert"
    subjects:
      - kind: "ServiceAccount"
        name: "walnuk-scylla-secret-reader"
        namespace: namespace
