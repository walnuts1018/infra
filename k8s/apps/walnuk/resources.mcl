import "std:manifest" as manifest
import "std:list" as lists
import "../envoy-gateway-class/gateway.mcl" as gateway
import "./external-secrets.mcl" as externalSecrets

let workloads = manifest.load("./_configs/workloads.yaml")
fn gatewayParentReference(parentReference: Map<String, Any>) -> Map<String, Any> = parentReference with:
  namespace: gateway.namespace

fn withGatewayParentReferences(resource: Map<String, Any>) -> Map<String, Any> = resource with:
  spec:
    parentRefs: lists.map(resource.spec.parentRefs, fn(parentReference) => gatewayParentReference(parentReference))

fn trafficResource(resource: Map<String, Any>) -> Map<String, Any> =
  if resource.kind == "HTTPRoute":
    withGatewayParentReferences(resource)
  else:
    resource

let traffic =
  for resource in manifest.load("./_configs/traffic.yaml"):
    trafficResource(resource)
let scaling = manifest.load("./_configs/scaling.yaml")
let databaseCA = manifest.load("./_configs/database-ca.yaml")

fn withApiEndpoint(environment: Map<String, Any>, namespace: String) -> Map<String, Any> = environment with:
  value: "http://walnuk-backend." + namespace + ".svc.cluster.local:8080"

fn namespaceEnvironment(environment: Map<String, Any>, namespace: String) -> Map<String, Any> =
  if environment.name == "API_ENDPOINT":
    withApiEndpoint(environment, namespace)
  else:
    environment

fn withContainerEnv(container: Map<String, Any>, namespace: String) -> Map<String, Any> = container with:
  env: lists.map(container.env, fn(environment) => namespaceEnvironment(environment, namespace))

fn namespaceContainer(container: Map<String, Any>, namespace: String) -> Map<String, Any> =
  if container.name == "next":
    withContainerEnv(container, namespace)
  else:
    container

fn withNamespace(resource: Map<String, Any>, namespace: String) -> Map<String, Any> = resource with:
  metadata:
    namespace: namespace

fn withFrontendNamespace(resource: Map<String, Any>, namespace: String) -> Map<String, Any> = resource with:
  metadata:
    namespace: namespace
  spec:
    template:
      spec:
        containers: lists.map(resource.spec.template.spec.containers, fn(container) => namespaceContainer(container, namespace))

fn namespaceResource(resource: Map<String, Any>, namespace: String) -> Map<String, Any> =
  if resource.kind == "Deployment" and resource.metadata.name == "walnuk-frontend":
    withFrontendNamespace(resource, namespace)
  else:
    withNamespace(resource, namespace)

fn namespaceResources(resources: List<Map<String, Any>>, namespace: String) -> List<Map<String, Any>> =
  for resource in resources:
    namespaceResource(resource, namespace)

export fn resources(namespace: String) -> List<Map<String, Any>> =
  [
    ...namespaceResources(workloads, namespace),
    ...externalSecrets.resources(namespace),
    ...namespaceResources(traffic, namespace),
    ...namespaceResources(scaling, namespace),
    ...namespaceResources(databaseCA, namespace),
  ]
