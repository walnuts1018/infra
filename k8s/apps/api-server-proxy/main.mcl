import "../../cluster.mcl" as clusterConfig
import "../envoy-gateway-class/gateway.mcl" as gateway
export type ApiServerProxy =
  name: String
  hostname: String
  gatewayName: String
  backendService: String
  backendPort: Int
  backendHostname: String
  caConfigMap: String

param cluster: clusterConfig.Cluster
param namespace: String

let app: ApiServerProxy =
  name: "api-server-service-proxy"
  hostname: "kurumi.local.walnuts.dev"
  gatewayName: "envoy-gateway"
  backendService: "kubernetes"
  backendPort: 443
  backendHostname: "kubernetes.default.svc.cluster.local"
  caConfigMap: "kube-root-ca.crt"

let backendTLSPolicy = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "BackendTLSPolicy"
  metadata:
    name: app.name
    namespace: namespace
  spec:
    targetRefs:
      -
        group: ""
        kind: "Service"
        name: app.backendService
    validation:
      caCertificateRefs:
        -
          group: ""
          kind: "ConfigMap"
          name: app.caConfigMap
      hostname: app.backendHostname

let httpRoute = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "HTTPRoute"
  metadata:
    name: app.name
    namespace: namespace
  spec:
    parentRefs:
      -
        name: app.gatewayName
        namespace: gateway.namespace
    hostnames:
      - app.hostname
    rules:
      -
        backendRefs:
          -
            kind: "Service"
            name: app.backendService
            port: app.backendPort
            weight: 1
        matches:
          -
            path:
              type: "PathPrefix"
              value: "/"

emit backendTLSPolicy
emit httpRoute
