import "std:list" as lists
import "./features.mcl" as appFeatures

fn peerConfig(name: String, spec: Map<String, Any>) -> Map<String, Any> = node:
  apiVersion: "cilium.io/v2alpha1"
  kind: "CiliumBGPPeerConfig"
  metadata:
    name: name
  spec: spec

fn clusterConfig(name: String, nodeSelector: Map<String, Any>, bgpInstance: Map<String, Any>) -> Map<String, Any> = node:
  apiVersion: "cilium.io/v2alpha1"
  kind: "CiliumBGPClusterConfig"
  metadata:
    name: name
  spec:
    nodeSelector: nodeSelector
    bgpInstances:
      - bgpInstance

fn controlPlaneResources(features: List<appFeatures.Feature>) -> List<Map<String, Any>> =
  if appFeatures.enabled(features, "controlPlanePeer"):
    - peerConfig(
      appFeatures.controlPlanePeer.bgp.peerConfigName,
      appFeatures.controlPlanePeer.bgp.peerConfigSpec,
      )
    - clusterConfig(
      appFeatures.controlPlanePeer.bgp.instanceName,
      appFeatures.controlPlanePeer.bgp.nodeSelector,
      appFeatures.controlPlanePeer.bgp.bgpInstance,
      )
  else:
    []

fn serverVlanResources(features: List<appFeatures.Feature>) -> List<Map<String, Any>> =
  if appFeatures.enabled(features, "serverVlanPeer"):
    - peerConfig(
      appFeatures.serverVlanPeer.bgp.peerConfigName,
      appFeatures.serverVlanPeer.bgp.peerConfigSpec,
      )
    - clusterConfig(
      appFeatures.serverVlanPeer.bgp.instanceName,
      appFeatures.serverVlanPeer.bgp.nodeSelector,
      appFeatures.serverVlanPeer.bgp.bgpInstance,
      )
  else:
    []

export fn resources(features: List<appFeatures.Feature>) -> List<Map<String, Any>> =
  lists.concat(controlPlaneResources(features), serverVlanResources(features))
