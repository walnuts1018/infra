import "std:list" as lists
import "./features.mcl" as appFeatures

fn resource(name: String, start: String, stop: String) -> Map<String, Any> = node:
  apiVersion: "cilium.io/v2"
  kind: "CiliumLoadBalancerIPPool"
  metadata:
    name: name
  spec:
    blocks:
      - start: start
        stop: stop

fn controlPlanePool(features: List<appFeatures.Feature>) -> List<Map<String, Any>> =
  if appFeatures.enabled(features, "controlPlanePeer"):
    - resource(
      appFeatures.controlPlanePeer.addressPool.name,
      appFeatures.controlPlanePeer.addressPool.start,
      appFeatures.controlPlanePeer.addressPool.stop,
      )
  else:
    []

fn serverVlanPool(features: List<appFeatures.Feature>) -> List<Map<String, Any>> =
  if appFeatures.enabled(features, "serverVlanPeer"):
    - resource(
      appFeatures.serverVlanPeer.addressPool.name,
      appFeatures.serverVlanPeer.addressPool.start,
      appFeatures.serverVlanPeer.addressPool.stop,
      )
  else:
    []

export fn resources(features: List<appFeatures.Feature>) -> List<Map<String, Any>> =
  lists.concat(controlPlanePool(features), serverVlanPool(features))
