{
  name: "cilium-ipaddress",
  namespace: "cilium-system",
  clusters: {
    kurumi: {
      jsonnet: {
        extVars: [
          {
            name: "cluster",
            value: "kurumi",
          },
        ],
      },
    },
    biscuit: {
      jsonnet: {
        extVars: [
          {
            name: "cluster",
            value: "biscuit",
          },
        ],
        tlas: [
          {
            name: "start",
            value: "192.168.16.0",
          },
          {
            name: "stop",
            value: "192.168.16.255",
          },
        ],
      },
    },
  },
}
