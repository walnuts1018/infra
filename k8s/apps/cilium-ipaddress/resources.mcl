import "std:list" as lists
import "./advertisement.mcl" as appAdvertisement
import "./bgp.mcl" as appBgp
import "./ip-pool.mcl" as appIpPool

let advertisementResources =
  - appAdvertisement.advertisement

export let resources = lists.concat(
  advertisementResources,
  lists.concat(appBgp.resources, appIpPool.resources),
)
