import "./external-secrets.mcl" as externalSecrets
import "./workloads.mcl" as workloads
import "./datastores.mcl" as datastores
import "./http-route.mcl" as route
import "./security-policy.mcl" as policy
import "../../cluster.mcl" as clusterConfig
param cluster: clusterConfig.Cluster
param namespace: String

emit workloads.configMap(namespace)
emit externalSecrets.credentials(namespace)
emit externalSecrets.snmp(namespace)
emit datastores.keeperCluster(namespace)
emit datastores.clickHouseCluster(namespace)
emit datastores.kafka(namespace)
emit datastores.kafkaNodePool(namespace)
emit datastores.kafkaTopic(namespace)
emit datastores.valkeyCluster(namespace)
emit route.httpRoute(namespace)
emit policy.resource(namespace)
emit workloads.consoleDeployment(namespace)
emit workloads.inletDeployment(namespace)
emit workloads.outletDeployment(namespace)
emit workloads.orchestratorDeployment(namespace)
emit workloads.consoleService(namespace)
emit workloads.inletService(namespace)
emit workloads.outletService(namespace)
emit workloads.orchestratorService(namespace)
emit each workloads.componentServiceMonitors(namespace)
