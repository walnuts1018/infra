import "./external-secrets.mcl" as externalSecrets
let namespace = "akvorado"
let syncOptions = "SkipDryRunOnMissingResource=true"

export let httpRoute = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "HTTPRoute"
  metadata:
    name: "akvorado"
    namespace: namespace
    annotations:
      "argocd.argoproj.io/sync-options": syncOptions
  spec:
    parentRefs:
      - name: "envoy-gateway"
        namespace: "envoy-gateway-system"
    hostnames:
      - "akvorado.walnuts.dev"
    rules:
      -
        backendRefs:
          -
            kind: "Service"
            name: "akvorado-console"
            port: 8080
            weight: 1
