import "../envoy-gateway-class/gateway.mcl" as gateway
let syncOptions = "SkipDryRunOnMissingResource=true"

export fn httpRoute(namespace: String) -> Map<String, Any> = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "HTTPRoute"
  metadata:
    name: "akvorado"
    namespace: namespace
    annotations:
      "argocd.argoproj.io/sync-options": syncOptions
  spec:
    parentRefs:
      - name: "envoy-gateway"
        namespace: gateway.namespace
    hostnames:
      - "akvorado.walnuts.dev"
    rules:
      -
        backendRefs:
          -
            kind: "Service"
            name: "akvorado-console"
            port: 8080
            weight: 1
