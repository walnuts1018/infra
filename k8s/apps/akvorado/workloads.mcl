import "std:list" as lists
import "std:crypto" as crypto
import "./external-secrets.mcl" as externalSecrets
import text "./_configs/akvorado.yaml" as akvoradoConfigText
import text "./_configs/inlet.yaml" as inletConfigText
import text "./_configs/outlet.yaml" as outletConfigText
import text "./_configs/console.yaml" as consoleConfigText

let appName = "akvorado"
let appLabels =
  app: appName
  "app.kubernetes.io/name": appName
let emptyVolumes: List<Map<String, Any>> = []

fn componentLabels(component: String) -> Map<String, String> =
  app: appName
  "app.kubernetes.io/name": appName
  "app.kubernetes.io/component": component

fn deployment(namespace: String, name: String, component: String, podSpec: Map<String, Any>) -> Map<String, Any> = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    name: name
    namespace: namespace
    labels: appLabels
  spec:
    replicas: 1
    selector:
      matchLabels:
        "app.kubernetes.io/name": appName
        "app.kubernetes.io/component": component
    template:
      metadata:
        labels: componentLabels(component)
      spec: podSpec

fn service(namespace: String, name: String, component: String, ports: List<Map<String, Any>>) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    name: name
    namespace: namespace
    labels: componentLabels(component)
  spec:
    selector:
      "app.kubernetes.io/name": appName
      "app.kubernetes.io/component": component
    ports: ports

type MonitoredComponent =
  name: String
  component: String
  namespace: String

fn serviceMonitor(target: MonitoredComponent) -> Map<String, Any> = node:
  apiVersion: "monitoring.coreos.com/v1"
  kind: "ServiceMonitor"
  metadata:
    name: target.name
    namespace: target.namespace
    labels: componentLabels(target.component)
  spec:
    namespaceSelector:
      matchNames:
        - target.namespace
    selector:
      matchLabels:
        "app.kubernetes.io/name": appName
        "app.kubernetes.io/component": target.component
    endpoints:
      - port: "http"
        path: "/api/v0/metrics"

fn appContainer(name: String, args: List<String>, ports: List<Map<String, Any>>, resources: Map<String, Any>, mounts: List<Map<String, Any>> = []) -> Map<String, Any> =
  name: name
  image: "quay.io/akvorado/akvorado:2.4.1"
  args: args
  ports: ports
  volumeMounts: mounts
  resources: resources
  livenessProbe:
    httpGet:
      path: "/api/v0/healthcheck"
      port: 8080
    initialDelaySeconds: 30
    periodSeconds: 30
  readinessProbe:
    httpGet:
      path: "/api/v0/healthcheck"
      port: 8080
    initialDelaySeconds: 10
    periodSeconds: 10

let consoleContainerPorts =
  - name: "http"
    containerPort: 8080
    protocol: "TCP"
let inletContainerPorts =
  - name: "http"
    containerPort: 8080
    protocol: "TCP"
  - name: "netflow"
    containerPort: 2055
    protocol: "UDP"
  - name: "sflow"
    containerPort: 6343
    hostPort: 6343
    protocol: "UDP"
let httpContainerPorts =
  - name: "http"
    containerPort: 8080
    protocol: "TCP"
let consoleResources =
  requests:
    cpu: "2m"
    memory: "15Mi"
  limits:
    cpu: "500m"
    memory: "512Mi"
let inletResources =
  requests:
    cpu: "2m"
    memory: "14Mi"
  limits:
    cpu: "2"
    memory: "1Gi"
let outletResources =
  requests:
    cpu: "10m"
    memory: "32Mi"
  limits:
    memory: "256Mi"
let orchestratorResources =
  requests:
    cpu: "2m"
    memory: "11Mi"
  limits:
    cpu: "500m"
    memory: "256Mi"
let consoleArgs =
  - "console"
  - "http://akvorado-orchestrator:8080"
let inletArgs =
  - "inlet"
  - "http://akvorado-orchestrator:8080"
let outletArgs =
  - "outlet"
  - "--debug"
  - "http://akvorado-orchestrator:8080"
let orchestratorArgs =
  - "orchestrator"
  - "/etc/akvorado/akvorado.yaml"
let consoleContainer = appContainer(
  name = "console",
  args = consoleArgs,
  ports = consoleContainerPorts,
  resources = consoleResources,
)
let consolePodSpec =
  containers:
    - consoleContainer
  volumes: emptyVolumes
let inletContainer = appContainer(
  name = "inlet",
  args = inletArgs,
  ports = inletContainerPorts,
  resources = inletResources,
)
let inletPodSpec =
  containers:
    - inletContainer
  volumes: emptyVolumes
  nodeSelector:
    "kubernetes.io/hostname": "cake"
let outletContainer = appContainer(
  name = "outlet",
  args = outletArgs,
  ports = httpContainerPorts,
  resources = outletResources,
)
let outletPodSpec =
  containers:
    - outletContainer
  volumes: emptyVolumes
let orchestratorMounts =
  - name: "config"
    mountPath: "/etc/akvorado/akvorado.yaml"
    subPath: "akvorado.yaml"
    readOnly: true
  - name: "config"
    mountPath: "/etc/akvorado/inlet.yaml"
    subPath: "inlet.yaml"
    readOnly: true
  - name: "config"
    mountPath: "/etc/akvorado/outlet.yaml"
    subPath: "outlet.yaml"
    readOnly: true
  - name: "config"
    mountPath: "/etc/akvorado/console.yaml"
    subPath: "console.yaml"
    readOnly: true
  - name: "snmp-config"
    mountPath: "/etc/akvorado/snmp.yaml"
    subPath: "snmp.yaml"
    readOnly: true
let configMapData =
  "akvorado.yaml": akvoradoConfigText
  "inlet.yaml": inletConfigText
  "outlet.yaml": outletConfigText
  "console.yaml": consoleConfigText
let configMapName = "akvorado-config-" + crypto.sha256(configMapData, 6)
let orchestratorVolumes =
  - name: "config"
    configMap:
      name: configMapName
  - name: "snmp-config"
    secret:
      secretName: externalSecrets.snmpName
let orchestratorContainer = appContainer(
  name = "orchestrator",
  args = orchestratorArgs,
  ports = httpContainerPorts,
  resources = orchestratorResources,
  mounts = orchestratorMounts,
)
let orchestratorPodSpec =
  containers:
    - orchestratorContainer
  volumes: orchestratorVolumes

export fn configMap(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "ConfigMap"
  immutable: true
  metadata:
    name: configMapName
    namespace: namespace
    labels:
      app: "akvorado-config"
      "app.kubernetes.io/name": "akvorado-config"
  data: configMapData


let httpServicePorts =
  - name: "http"
    port: 8080
    targetPort: 8080
    protocol: "TCP"
let inletServicePorts =
  - name: "http"
    port: 8080
    targetPort: 8080
    protocol: "TCP"
  - name: "netflow"
    port: 2055
    targetPort: 2055
    protocol: "UDP"
  - name: "sflow"
    port: 6343
    targetPort: 6343
    protocol: "UDP"
export fn consoleDeployment(namespace: String) -> Map<String, Any> = deployment(namespace, "akvorado-console", "console", consolePodSpec)
export fn inletDeployment(namespace: String) -> Map<String, Any> = deployment(namespace, "akvorado-inlet", "inlet", inletPodSpec)
export fn outletDeployment(namespace: String) -> Map<String, Any> = deployment(namespace, "akvorado-outlet", "outlet", outletPodSpec)
export fn orchestratorDeployment(namespace: String) -> Map<String, Any> = deployment(namespace, "akvorado-orchestrator", "orchestrator", orchestratorPodSpec)
export fn consoleService(namespace: String) -> Map<String, Any> = service(namespace, "akvorado-console", "console", httpServicePorts)
export fn inletService(namespace: String) -> Map<String, Any> = service(namespace, "akvorado-inlet", "inlet", inletServicePorts)
export fn outletService(namespace: String) -> Map<String, Any> = service(namespace, "akvorado-outlet", "outlet", httpServicePorts)
export fn orchestratorService(namespace: String) -> Map<String, Any> = service(namespace, "akvorado-orchestrator", "orchestrator", httpServicePorts)
fn monitoredComponents(namespace: String) -> List<MonitoredComponent> =
  - name: "akvorado-console"
    component: "console"
    namespace: namespace
  - name: "akvorado-inlet"
    component: "inlet"
    namespace: namespace
  - name: "akvorado-outlet"
    component: "outlet"
    namespace: namespace
  - name: "akvorado-orchestrator"
    component: "orchestrator"
    namespace: namespace

export fn componentServiceMonitors(namespace: String) -> List<Map<String, Any>> =
  lists.map(monitoredComponents(namespace), serviceMonitor)
