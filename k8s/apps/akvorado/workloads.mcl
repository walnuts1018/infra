import "std:list" as lists
import "./external-secrets.mcl" as externalSecrets
import text "./_configs/akvorado.yaml" as akvoradoConfigText
import text "./_configs/inlet.yaml" as inletConfigText
import text "./_configs/outlet.yaml" as outletConfigText
import text "./_configs/console.yaml" as consoleConfigText

let namespace = "akvorado"
let appName = "akvorado"
let appLabels =
  app: appName
  "app.kubernetes.io/name": appName
let emptyMounts: List<Map<String, Any>> = []
let emptyVolumes: List<Map<String, Any>> = []

fn componentLabels(component: String) -> Map<String, String> = node:
  app: appName
  "app.kubernetes.io/name": appName
  "app.kubernetes.io/component": component

fn deployment(name: String, component: String, podSpec: Map<String, Any>) -> Map<String, Any> = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    name: name
    namespace: namespace
    labels: appLabels
  spec:
    replicas: 1
    selector:
      matchLabels:
        "app.kubernetes.io/name": appName
        "app.kubernetes.io/component": component
    template:
      metadata:
        labels: componentLabels(component)
      spec: podSpec

fn service(name: String, component: String, ports: List<Map<String, Any>>) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    name: name
    namespace: namespace
    labels: componentLabels(component)
  spec:
    selector:
      "app.kubernetes.io/name": appName
      "app.kubernetes.io/component": component
    ports: ports

type MonitoredComponent =
  name: String
  component: String

fn serviceMonitor(target: MonitoredComponent) -> Map<String, Any> = node:
  apiVersion: "monitoring.coreos.com/v1"
  kind: "ServiceMonitor"
  metadata:
    name: target.name
    namespace: namespace
    labels: componentLabels(target.component)
  spec:
    namespaceSelector:
      matchNames:
        - namespace
    selector:
      matchLabels:
        "app.kubernetes.io/name": appName
        "app.kubernetes.io/component": target.component
    endpoints:
      - port: "http"
        path: "/api/v0/metrics"

fn appContainer(name: String, args: List<String>, ports: List<Map<String, Any>>, mounts: List<Map<String, Any>>, resources: Map<String, Any>) -> Map<String, Any> = node:
  name: name
  image: "quay.io/akvorado/akvorado:2.4.1"
  args: args
  ports: ports
  volumeMounts: mounts
  resources: resources
  livenessProbe:
    httpGet:
      path: "/api/v0/healthcheck"
      port: 8080
    initialDelaySeconds: 30
    periodSeconds: 30
  readinessProbe:
    httpGet:
      path: "/api/v0/healthcheck"
      port: 8080
    initialDelaySeconds: 10
    periodSeconds: 10

let consoleContainerPorts =
  - name: "http"
    containerPort: 8080
    protocol: "TCP"
let inletContainerPorts =
  - name: "http"
    containerPort: 8080
    protocol: "TCP"
  - name: "netflow"
    containerPort: 2055
    protocol: "UDP"
  - name: "sflow"
    containerPort: 6343
    hostPort: 6343
    protocol: "UDP"
let httpContainerPorts =
  - name: "http"
    containerPort: 8080
    protocol: "TCP"
let consoleResources =
  requests:
    cpu: "2m"
    memory: "15Mi"
  limits:
    cpu: "500m"
    memory: "512Mi"
let inletResources =
  requests:
    cpu: "2m"
    memory: "14Mi"
  limits:
    cpu: "2"
    memory: "1Gi"
let outletResources =
  requests:
    cpu: "10m"
    memory: "32Mi"
  limits:
    memory: "256Mi"
let orchestratorResources =
  requests:
    cpu: "2m"
    memory: "11Mi"
  limits:
    cpu: "500m"
    memory: "256Mi"
let consoleArgs =
  - "console"
  - "http://akvorado-orchestrator:8080"
let inletArgs =
  - "inlet"
  - "http://akvorado-orchestrator:8080"
let outletArgs =
  - "outlet"
  - "--debug"
  - "http://akvorado-orchestrator:8080"
let orchestratorArgs =
  - "orchestrator"
  - "/etc/akvorado/akvorado.yaml"
let consoleContainer = appContainer(
  "console",
  consoleArgs,
  consoleContainerPorts,
  emptyMounts,
  consoleResources,
  )
let consolePodSpec =
  containers:
    - consoleContainer
  volumes: emptyVolumes
let inletContainer = appContainer(
  "inlet",
  inletArgs,
  inletContainerPorts,
  emptyMounts,
  inletResources,
  )
let inletPodSpec =
  containers:
    - inletContainer
  volumes: emptyVolumes
  nodeSelector:
    "kubernetes.io/hostname": "cake"
let outletContainer = appContainer(
  "outlet",
  outletArgs,
  httpContainerPorts,
  emptyMounts,
  outletResources,
  )
let outletPodSpec =
  containers:
    - outletContainer
  volumes: emptyVolumes
let orchestratorMounts =
  - name: "config"
    mountPath: "/etc/akvorado/akvorado.yaml"
    subPath: "akvorado.yaml"
    readOnly: true
  - name: "config"
    mountPath: "/etc/akvorado/inlet.yaml"
    subPath: "inlet.yaml"
    readOnly: true
  - name: "config"
    mountPath: "/etc/akvorado/outlet.yaml"
    subPath: "outlet.yaml"
    readOnly: true
  - name: "config"
    mountPath: "/etc/akvorado/console.yaml"
    subPath: "console.yaml"
    readOnly: true
  - name: "snmp-config"
    mountPath: "/etc/akvorado/snmp.yaml"
    subPath: "snmp.yaml"
    readOnly: true
let orchestratorVolumes =
  - name: "config"
    configMap:
      name: "akvorado-config-8a4b55"
  - name: "snmp-config"
    secret:
      secretName: externalSecrets.snmpName
let orchestratorContainer = appContainer(
  "orchestrator",
  orchestratorArgs,
  httpContainerPorts,
  orchestratorMounts,
  orchestratorResources,
  )
let orchestratorPodSpec =
  containers:
    - orchestratorContainer
  volumes: orchestratorVolumes

let configMapData =
  "akvorado.yaml": akvoradoConfigText
  "inlet.yaml": inletConfigText
  "outlet.yaml": outletConfigText
  "console.yaml": consoleConfigText

export let configMap = node:
  apiVersion: "v1"
  kind: "ConfigMap"
  immutable: true
  metadata:
    name: "akvorado-config-8a4b55"
    namespace: namespace
    labels:
      app: "akvorado-config"
      "app.kubernetes.io/name": "akvorado-config"
  data: configMapData


let componentNames =
  - name: "akvorado-console"
    component: "console"
  - name: "akvorado-inlet"
    component: "inlet"
  - name: "akvorado-outlet"
    component: "outlet"
  - name: "akvorado-orchestrator"
    component: "orchestrator"
let httpServicePorts =
  - name: "http"
    port: 8080
    targetPort: 8080
    protocol: "TCP"
let inletServicePorts =
  - name: "http"
    port: 8080
    targetPort: 8080
    protocol: "TCP"
  - name: "netflow"
    port: 2055
    targetPort: 2055
    protocol: "UDP"
  - name: "sflow"
    port: 6343
    targetPort: 6343
    protocol: "UDP"
export let consoleDeployment = deployment("akvorado-console", "console", consolePodSpec)
export let inletDeployment = deployment("akvorado-inlet", "inlet", inletPodSpec)
export let outletDeployment = deployment("akvorado-outlet", "outlet", outletPodSpec)
export let orchestratorDeployment = deployment("akvorado-orchestrator", "orchestrator", orchestratorPodSpec)
export let consoleService = service("akvorado-console", "console", httpServicePorts)
export let inletService = service("akvorado-inlet", "inlet", inletServicePorts)
export let outletService = service("akvorado-outlet", "outlet", httpServicePorts)
export let orchestratorService = service("akvorado-orchestrator", "orchestrator", httpServicePorts)
export let componentServiceMonitors = lists.map(componentNames, serviceMonitor)
