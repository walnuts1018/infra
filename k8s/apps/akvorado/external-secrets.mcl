import "std:hash" as hashes
import text "./_configs/snmp.yaml" as snmpTemplate

let credentialData =
  - secretKey: "client-id"
    remoteRef:
      key: "terraform-external-secrets"
      property: "akvorado-client-id"
  - secretKey: "client-secret"
    remoteRef:
      key: "terraform-external-secrets"
      property: "akvorado-client-secret"
let snmpData =
  - secretKey: "snmp_community"
    remoteRef:
      key: "snmp"
      property: "community"
let snmpTemplateData =
  "snmp.yaml": snmpTemplate
let snmpSecretHashInput = node:
  data: snmpData
  templateData: snmpTemplateData

export let credentialName = "akvorado-secret-" + hashes.fnv1a64(credentialData)
export let snmpName = "akvorado-snmp-" + hashes.fnv1a64(snmpSecretHashInput)

export let credentials = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: credentialName
  spec:
    secretStoreRef:
      kind: "ClusterSecretStore"
      name: "onepassword"
    refreshInterval: "1m"
    target:
      name: credentialName
      template:
        engineVersion: "v2"
        type: "Opaque"
    data: credentialData

export let snmp = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: snmpName
    namespace: "akvorado"
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: snmpName
      template:
        engineVersion: "v2"
        type: "Opaque"
        data: snmpTemplateData
    data: snmpData
