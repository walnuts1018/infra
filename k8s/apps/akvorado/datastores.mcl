let syncOptions = "SkipDryRunOnMissingResource=true"

let avoidSlowNodeAffinity =
  nodeAffinity:
    requiredDuringSchedulingIgnoredDuringExecution:
      nodeSelectorTerms:
        -
          matchExpressions:
            - key: "storage.walnuts.dev/slow"
              operator: "DoesNotExist"

export fn keeperCluster(namespace: String) -> Map<String, Any> = node:
  apiVersion: "clickhouse.com/v1alpha1"
  kind: "KeeperCluster"
  metadata:
    name: "akvorado-keeper"
    namespace: namespace
    annotations:
      "argocd.argoproj.io/sync-options": syncOptions
    labels:
      app: "akvorado-keeper"
      "app.kubernetes.io/name": "akvorado-keeper"
  spec:
    replicas: 1
    containerTemplate:
      resources:
        requests:
          cpu: "15m"
          memory: "116Mi"
    dataVolumeClaimSpec:
      accessModes:
        - "ReadWriteOnce"
      resources:
        requests:
          storage: "5Gi"
    podTemplate:
      affinity: avoidSlowNodeAffinity

export fn clickHouseCluster(namespace: String) -> Map<String, Any> = node:
  apiVersion: "clickhouse.com/v1alpha1"
  kind: "ClickHouseCluster"
  metadata:
    name: "akvorado-clickhouse"
    namespace: namespace
    annotations:
      "argocd.argoproj.io/sync-options": syncOptions
    labels:
      app: "akvorado-clickhouse"
      "app.kubernetes.io/name": "akvorado-clickhouse"
  spec:
    keeperClusterRef:
      name: "akvorado-keeper"
    replicas: 1
    dataVolumeClaimSpec:
      accessModes:
        - "ReadWriteOnce"
      resources:
        requests:
          storage: "32Gi"
    podTemplate:
      affinity: avoidSlowNodeAffinity
    containerTemplate:
      resources:
        requests:
          cpu: "90m"
          memory: "650Mi"
        limits:
          memory: "4Gi"

export fn kafka(namespace: String) -> Map<String, Any> = node:
  apiVersion: "kafka.strimzi.io/v1"
  kind: "Kafka"
  metadata:
    name: "akvorado-kafka"
    namespace: namespace
    annotations:
      "argocd.argoproj.io/sync-options": syncOptions
      "strimzi.io/node-pools": "enabled"
    labels:
      app: "akvorado-kafka"
      "app.kubernetes.io/name": "akvorado-kafka"
  spec:
    kafka:
      version: "4.3.0"
      listeners:
        - name: "plain"
          port: 9092
          type: "internal"
          tls: false
      config:
        "offsets.topic.replication.factor": 1
        "transaction.state.log.replication.factor": 1
        "transaction.state.log.min.isr": 1
        "default.replication.factor": 1
        "min.insync.replicas": 1
    entityOperator:
      topicOperator:
        resources:
          requests:
            cpu: "4m"
            memory: "200Mi"
          limits:
            cpu: "500m"
            memory: "1Gi"
      userOperator:
        resources:
          requests:
            cpu: "5m"
            memory: "200Mi"
          limits:
            cpu: "500m"
            memory: "1Gi"

export fn kafkaNodePool(namespace: String) -> Map<String, Any> = node:
  apiVersion: "kafka.strimzi.io/v1"
  kind: "KafkaNodePool"
  metadata:
    name: "akvorado-kafka-pool"
    namespace: namespace
    labels:
      app: "akvorado-kafka-pool"
      "app.kubernetes.io/name": "akvorado-kafka-pool"
      "strimzi.io/cluster": "akvorado-kafka"
    annotations:
      "argocd.argoproj.io/sync-options": syncOptions
  spec:
    replicas: 1
    roles:
      - "broker"
      - "controller"
    storage:
      type: "persistent-claim"
      size: "10Gi"
      deleteClaim: false
    resources:
      requests:
        cpu: "17m"
        memory: "1.5Gi"
      limits:
        memory: "2Gi"
    template:
      pod:
        affinity: avoidSlowNodeAffinity

export fn kafkaTopic(namespace: String) -> Map<String, Any> = node:
  apiVersion: "kafka.strimzi.io/v1"
  kind: "KafkaTopic"
  metadata:
    name: "flows-v5"
    namespace: namespace
    annotations:
      "argocd.argoproj.io/sync-options": syncOptions
    labels:
      app: "akvorado-kafka-topic"
      "app.kubernetes.io/name": "akvorado-kafka-topic"
      "strimzi.io/cluster": "akvorado-kafka"
  spec:
    partitions: 2
    replicas: 1
    config:
      "retention.ms": 604800000
      "segment.bytes": 1073741824

export fn valkeyCluster(namespace: String) -> Map<String, Any> = node:
  apiVersion: "valkey.io/v1alpha1"
  kind: "ValkeyCluster"
  metadata:
    name: "akvorado-valkey"
    namespace: namespace
    annotations:
      "argocd.argoproj.io/sync-options": syncOptions
    labels:
      app: "akvorado-valkey"
      "app.kubernetes.io/name": "akvorado-valkey"
  spec:
    shards: 1
    replicas: 1
    resources:
      requests:
        cpu: "6m"
        memory: "13Mi"
      limits:
        cpu: "500m"
        memory: "256Mi"
