import "./external-secrets.mcl" as externalSecrets

export fn resource(namespace: String) -> Map<String, Any> = node:
  apiVersion: "gateway.envoyproxy.io/v1alpha1"
  kind: "SecurityPolicy"
  metadata:
    name: "akvorado"
    namespace: namespace
  spec:
    targetRefs:
      - group: "gateway.networking.k8s.io"
        kind: "HTTPRoute"
        name: "akvorado"
    oidc:
      provider:
        issuer: "https://auth.walnuts.dev"
      clientIDRef:
        name: externalSecrets.credentialName
      clientSecret:
        name: externalSecrets.credentialName
      scopes:
        - "openid"
        - "email"
        - "profile"
        - "offline_access"
        - "urn:zitadel:iam:org:projects:roles"
      forwardAccessToken: true
      logoutPath: "/oauth2/logout"
    jwt:
      providers:
        - name: "zitadel"
          issuer: "https://auth.walnuts.dev"
          remoteJWKS:
            uri: "https://auth.walnuts.dev/oauth/v2/keys"
    authorization:
      defaultAction: "Deny"
      rules:
        - action: "Allow"
          principal:
            jwt:
              provider: "zitadel"
              claims:
                - name: "my:zitadel:grants"
                  valueType: "StringArray"
                  values:
                    - "385243484086337737:akvorado-admin"
