import "std:context" as context
import "std:helm" as helm
import "std:list" as lists
import "./chart.mcl" as appChart
import "./controller-configmap.mcl" as controllerConfigMap
import "./hooks.mcl" as appHooks
import "./profiles.mcl" as appProfiles

let apiVersions: List<String> = []
let values: Map<String, Any> = appProfiles.valuesByProfile[context.parameter("profile")]
let options =
  releaseName: appChart.releaseName
  namespace: appChart.namespace
  version: appChart.chartVersion
  kubeVersion: appChart.kubeVersion
  apiVersions: apiVersions
  values: values
let chartResources = helm.render(appChart.chartArchive, options)
let resourcesWithoutControllerConfig = lists.filter(
  chartResources,
  fn(resource) => resource.kind != "ConfigMap" or resource.metadata.name != "cert-manager",
)
let configResources =
  - controllerConfigMap.resource
let extraResources = lists.concat(appHooks.resources, configResources)
let resources = lists.concat(resourcesWithoutControllerConfig, extraResources)

emit each resources
