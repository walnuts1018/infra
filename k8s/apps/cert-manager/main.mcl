import "std:helm" as helm
import "std:core" as core
import "std:list" as lists
import "./chart.mcl" as appChart
import "./controller-configmap.mcl" as controllerConfigMap
import "./features.mcl" as appFeatures
import "../../cluster.mcl" as clusterConfig

type Feature = "monitoring"

param cluster: clusterConfig.Cluster
param namespace: String
param features: List<Feature> = []

let apiVersions: List<String> = []
let monitoringEnabled = lists.contains(features, "monitoring")
let values: Map<String, Any> =
  if monitoringEnabled:
    appFeatures.valuesByFeature.monitoring
  else:
    appFeatures.valuesByFeature.standard
let options =
  releaseName: appChart.releaseName
  namespace: namespace
  version: appChart.chartVersion
  kubeVersion: cluster.kubernetesVersion
  apiVersions: apiVersions
  values: values
let chartResources: List<Map<String, Any>> =
  helm.render(appChart.chartArchive, options)
let controllerConfigMapIdentity =
  apiVersion: "v1"
  kind: "ConfigMap"
  name: "cert-manager"
let controllerConfigMaps = lists.filter(
  chartResources,
  fn(resource) =>
    resource.apiVersion == controllerConfigMapIdentity.apiVersion and
    resource.kind == controllerConfigMapIdentity.kind and
    resource.metadata.name == controllerConfigMapIdentity.name,
)
rule hasOneControllerConfigMap(resources: List<Map<String, Any>>):
  require core.len(resources) == 1 message "cert-manager Helm chart must render exactly one controller ConfigMap"
let resourcesWithoutControllerConfig = lists.filter(
  chartResources,
  fn(resource) =>
    resource.apiVersion != controllerConfigMapIdentity.apiVersion or
    resource.kind != controllerConfigMapIdentity.kind or
    resource.metadata.name != controllerConfigMapIdentity.name,
)
let configResource = controllerConfigMap.resource(namespace)
let configResources =
  - configResource
let resources = lists.concat(resourcesWithoutControllerConfig, configResources)

emit each resources
validate controllerConfigMaps using hasOneControllerConfigMap
