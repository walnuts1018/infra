import "std:helm" as helm
import "std:list" as lists
import "./chart.mcl" as appChart
import "./controller-configmap.mcl" as controllerConfigMap
import "./hooks.mcl" as appHooks
import "./features.mcl" as appFeatures

type Feature = "monitoring"

param features: List<Feature> = []

let apiVersions: List<String> = []
let monitoringEnabled = lists.contains(features, "monitoring")
let values: Map<String, Any> =
  if monitoringEnabled:
    appFeatures.valuesByFeature.monitoring
  else:
    appFeatures.valuesByFeature.standard
let options =
  releaseName: appChart.releaseName
  namespace: appChart.namespace
  version: appChart.chartVersion
  kubeVersion: appChart.kubeVersion
  apiVersions: apiVersions
  values: values
let chartResources = helm.render(appChart.chartArchive, options)
let controllerConfigMapIdentity =
  apiVersion: "v1"
  kind: "ConfigMap"
  namespace: appChart.namespace
  name: "cert-manager"
let chartControllerConfigMap = lists.exactlyOne(
  chartResources,
  fn(resource) =>
    resource.apiVersion == controllerConfigMapIdentity.apiVersion and
    resource.kind == controllerConfigMapIdentity.kind and
    resource.metadata.namespace == controllerConfigMapIdentity.namespace and
    resource.metadata.name == controllerConfigMapIdentity.name,
)
let resourcesWithoutControllerConfig = lists.filter(
  chartResources,
  fn(resource) =>
    resource.apiVersion != chartControllerConfigMap.apiVersion or
    resource.kind != chartControllerConfigMap.kind or
    resource.metadata.namespace != chartControllerConfigMap.metadata.namespace or
    resource.metadata.name != chartControllerConfigMap.metadata.name,
)
let configResources =
  - controllerConfigMap.resource
let extraResources = lists.concat(appHooks.resources, configResources)
let resources = lists.concat(resourcesWithoutControllerConfig, extraResources)

emit each resources
