import "./chart.mcl" as appChart
import text "./_configs/controller-config.yaml" as controllerConfigText

let labels =
  app: "cert-manager"
  "app.kubernetes.io/name": "cert-manager"
  "app.kubernetes.io/instance": "cert-manager"
  "app.kubernetes.io/component": "controller"
  "app.kubernetes.io/version": appChart.chartVersion
  "app.kubernetes.io/managed-by": "Helm"
  "helm.sh/chart": "cert-manager-" + appChart.chartVersion

export fn resource(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "ConfigMap"
  metadata:
    name: "cert-manager"
    namespace: namespace
    labels: labels
  data:
    "config.yaml": controllerConfigText
