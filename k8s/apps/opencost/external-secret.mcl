import "std:hash" as hashes

let data =
  - secretKey: "client-id"
    remoteRef:
      key: "terraform-external-secrets"
      property: "opencost-client-id"
  - secretKey: "client-secret"
    remoteRef:
      key: "terraform-external-secrets"
      property: "opencost-client-secret"

let name = "opencost-secret-" + hashes.fnv1a64(data)

export let resource = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: name
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: name
      template:
        engineVersion: "v2"
        type: "Opaque"
    data: data
