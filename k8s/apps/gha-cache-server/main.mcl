import "std:helm" as helm
import "./chart.mcl" as appChart
import "./values.mcl" as appValues
import "./external-secret.mcl" as externalSecret
import "./http-route.mcl" as httpRoute
import "./scaled-object.mcl" as scaledObject
import "./service-monitor.mcl" as serviceMonitor
import "../../cluster.mcl" as clusterConfig
param cluster: clusterConfig.Cluster
param namespace: String

let apiVersions: List<String> = []
let options =
  releaseName: "gha-cache-server"
  namespace: namespace
  version: appChart.chartVersion
  kubeVersion: cluster.kubernetesVersion
  apiVersions: apiVersions
  values: appValues.baseValues
let resources = helm.render(appChart.chartArchive, options)

emit each resources
emit externalSecret.resource(namespace)
emit httpRoute.resource(namespace)
emit scaledObject.resource(namespace)
emit serviceMonitor.resource(namespace)
