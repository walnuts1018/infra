import "../envoy-gateway-class/gateway.mcl" as gateway

export fn resource(namespace: String) -> Map<String, Any> = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "HTTPRoute"
  metadata:
    name: "gha-cache-server"
    namespace: namespace
  spec:
    parentRefs:
      - name: "envoy-gateway"
        namespace: gateway.namespace
    hostnames:
      - "gha-cache-server.local.walnuts.dev"
    rules:
      -
        matches:
          -
            path:
              type: "PathPrefix"
              value: "/"
        timeouts:
          request: "0s"
          backendRequest: "0s"
        backendRefs:
          -
            kind: "Service"
            name: "gha-cache-server-github-actions-cache-server"
            port: 3000
