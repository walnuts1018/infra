import "std:kustomize" as kustomize
import "std:list" as lists
import "../../cluster.mcl" as clusterConfig
param cluster: clusterConfig.Cluster
param namespace: String

let crds = kustomize.build(
  "git+https://github.com/kubernetes-csi/external-snapshotter",
  "6b2feaaf7fc3d6d0fe21029d1032ea0eee2081e9",
  "client/config/crd",
)
let controller = kustomize.build(
  "git+https://github.com/kubernetes-csi/external-snapshotter",
  "6b2feaaf7fc3d6d0fe21029d1032ea0eee2081e9",
  "deploy/kubernetes/snapshot-controller",
)

fn withNamespace(resource: Map<String, Any>) -> Map<String, Any> = resource with:
  metadata:
    namespace: namespace

fn withSubjectNamespace(subject: Map<String, Any>) -> Map<String, Any> = subject with:
  namespace: namespace

fn serviceAccountSubject(subject: Map<String, Any>) -> Map<String, Any> =
  if subject.kind == "ServiceAccount":
    withSubjectNamespace(subject)
  else:
    subject

fn withServiceAccountSubjectNamespaces(resource: Map<String, Any>) -> Map<String, Any> = resource with:
  subjects: lists.map(resource.subjects, serviceAccountSubject)

fn clusterRoleBindingResource(resource: Map<String, Any>) -> Map<String, Any> =
  if resource.kind == "ClusterRoleBinding":
    withServiceAccountSubjectNamespaces(resource)
  else:
    resource

fn controllerResource(resource: Map<String, Any>) -> Map<String, Any> =
  if resource.kind == "Deployment" or resource.kind == "ServiceAccount":
    withNamespace(resource)
  else:
    clusterRoleBindingResource(resource)

let controllerInNamespace = lists.map(controller, controllerResource)

emit each crds
emit each controllerInNamespace
