export type Database =
  name: String
  resourceName: String
  userName: String
  passwordSecretName: String
  secretSourceKey: String
  secretSourceProperty: String
  extensions?: List<Map<String, String>>

export let databases =
  - name: "picca"
    resourceName: "picca"
    userName: "picca"
    passwordSecretName: "picca-db-password"
    secretSourceKey: "postgres_passwords"
    secretSourceProperty: "picca"
    extensions:
      - name: "postgis"
  - name: "picca_dev"
    resourceName: "picca-dev"
    userName: "picca_dev"
    passwordSecretName: "picca-dev-db-password"
    secretSourceKey: "postgres_passwords"
