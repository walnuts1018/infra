import "std:helm" as helm
import "./chart.mcl" as appChart
import "../../cluster.mcl" as clusterConfig

param enableServiceMonitor: Bool = false
param cluster: clusterConfig.Cluster
param namespace: String

let commonValues: Map<String, Any> =
  replicaCount: 1
  resources:
    requests:
      cpu: "10m"
      memory: "64Mi"
    limits:
      cpu: "500m"
      memory: "128Mi"
  topologySpreadConstraints:
    - maxSkew: 1
      topologyKey: "kubernetes.io/hostname"
      whenUnsatisfiable: "ScheduleAnyway"
      labelSelector:
        matchLabels:
          "app.kubernetes.io/name": "valkey-operator"
  metrics:
    enabled: true
let values: Map<String, Any> =
  if enableServiceMonitor:
    commonValues with:
      metrics:
        serviceMonitor:
          enabled: true
  else:
    commonValues
let renderOptions =
  releaseName: "valkey-operator"
  namespace: namespace
  version: appChart.chartVersion
  kubeVersion: cluster.kubernetesVersion
  apiVersions: []
  values: values
let rendered = helm.render(appChart.chartArchive, renderOptions)

emit each rendered
