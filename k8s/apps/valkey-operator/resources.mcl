import "std:helm" as helm
import "./chart.mcl" as appChart
import "../../cluster.mcl" as clusterConfig
type HelmOptions =
  releaseName: String
  namespace: String
  version: String
  kubeVersion: String
  apiVersions: List<String>
  values: Map<String, Any>

let apiVersions: List<String> = []
fn baseOptions(cluster: clusterConfig.Cluster) -> HelmOptions =
  releaseName: "valkey-operator"
  version: appChart.chartVersion
  kubeVersion: cluster.kubernetesVersion
  apiVersions: apiVersions

fn options(cluster: clusterConfig.Cluster, namespace: String, values: Map<String, Any>) -> HelmOptions = baseOptions(cluster) with:
  namespace: namespace
  values: values

export fn render(cluster: clusterConfig.Cluster, namespace: String, values: Map<String, Any>) -> List<Map<String, Any>> = helm.render(appChart.chartArchive, options(cluster, namespace, values))
