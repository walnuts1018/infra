import "std:hash" as hashes
import "./config.mcl" as app

let data =
  - secretKey: "client-id"
    remoteRef:
      key: "terraform-external-secrets"
      property: "hubble-client-id"
  - secretKey: "client-secret"
    remoteRef:
      key: "terraform-external-secrets"
      property: "hubble-client-secret"

export let name = app.name + "-secret-" + hashes.fnv1a64(data)

export fn resource(namespace: String) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: name
    namespace: namespace
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: name
      template:
        engineVersion: "v2"
        type: "Opaque"
    data: data
