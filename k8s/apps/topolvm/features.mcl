import "std:list" as lists
import "./values.mcl" as appValues
import "./config.mcl" as config

fn hasFeature(features: List<config.Feature>, name: config.Feature) -> Bool =
  lists.contains(features, name)

let ssdDeviceClassItems: List<Map<String, Any>> =
  -
    name: "ssd"
    "volume-group": "ssd"
    "spare-gb": 5
    default: false
    "lvcreate-options":
      - "--alloc=normal"
let ssdStorageClassItems: List<Map<String, Any>> =
  -
    name: "topolvm-ssd"
    storageClass:
      fsType: "xfs"
      reclaimPolicy: "Retain"
      isDefaultClass: false
      volumeBindingMode: "WaitForFirstConsumer"
      allowVolumeExpansion: true
      additionalParameters:
        "topolvm.io/device-class": "ssd"
      mountOptions:
        - "noatime"
let hddStorageClassItems: List<Map<String, Any>> =
  -
    name: "topolvm-hdd"
    storageClass:
      fsType: "xfs"
      reclaimPolicy: "Retain"
      isDefaultClass: false
      volumeBindingMode: "WaitForFirstConsumer"
      allowVolumeExpansion: true
      additionalParameters:
        "topolvm.io/device-class": "hdd"
      mountOptions:
        - "noatime"

fn hddDeviceClasses(features: List<config.Feature>, settings: config.Settings) -> List<Map<String, Any>> =
  if hasFeature(features, "hdd"):
    -
      name: "hdd"
      "volume-group": "hdd"
      "spare-gb": 10
      default: settings.hddIsDefault
      "lvcreate-options":
        - "--alloc=normal"
  else:
    []

fn ssdDeviceClasses(features: List<config.Feature>) -> List<Map<String, Any>> =
  if hasFeature(features, "ssd"):
    ssdDeviceClassItems
  else:
    []

fn deviceClasses(features: List<config.Feature>, settings: config.Settings) -> List<Map<String, Any>> =
  lists.concat(ssdDeviceClasses(features), hddDeviceClasses(features, settings))

fn ssdStorageClasses(features: List<config.Feature>) -> List<Map<String, Any>> =
  if hasFeature(features, "ssd"):
    ssdStorageClassItems
  else:
    []

fn hddStorageClasses(features: List<config.Feature>) -> List<Map<String, Any>> =
  if hasFeature(features, "hdd"):
    hddStorageClassItems
  else:
    []

fn storageClasses(features: List<config.Feature>) -> List<Map<String, Any>> =
  lists.concat(ssdStorageClasses(features), hddStorageClasses(features))

export fn values(features: List<config.Feature>, settings: config.Settings) -> Map<String, Any> = appValues.commonValues with:
  lvmd:
    nodeSelector: settings.lvmdNodeSelector
    deviceClasses: deviceClasses(features, settings)
    prometheus:
      podMonitor:
        enabled: hasFeature(features, "monitoring")
  controller:
    prometheus:
      podMonitor:
        enabled: hasFeature(features, "monitoring")
  node:
    nodeSelector: settings.nodeSelector
    prometheus:
      podMonitor:
        enabled: hasFeature(features, "monitoring")
  storageClasses: storageClasses(features)
