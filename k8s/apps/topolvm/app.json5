{
  name: "topolvm",
  namespace: "topolvm-system",
  additionalSources: {
    helm: {
      repoURL: "https://topolvm.github.io/topolvm",
      chart: "topolvm",
      targetRevision: "17.2.0",
      valueFiles: [
        "values.yaml",
      ],
    },
  },
  clusters: {
    kurumi: {
      additionalSources: {
        helm: {
          additionalValueFiles: [
            "values.kurumi.yaml",
          ],
        },
      },
    },
    biscuit: {
      additionalSources: {
        helm: {
          additionalValueFiles: [
            "values.biscuit.yaml",
          ],
        },
      },
    },
  },
}
