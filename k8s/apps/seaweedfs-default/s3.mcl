      policyDocument: "{\n    \"Statement\": [\n        {\n            \"Action\": [\n                \"s3:Get*\",\n                \"s3:Put*\",\n                \"s3:Delete*\",\n                \"s3:AbortMultipartUpload\",\n                \"s3:List*\",\n                \"s3:*Tagging\"\n            ],\n            \"Effect\": \"Allow\",\n            \"Resource\": [\n                \"arn:aws:s3:::oekaki-dengon-game\",\n                \"arn:aws:s3:::oekaki-dengon-game/*\"\n            ]\n        }\n    ],\n    \"Version\": \"2012-10-17\"\n}"
      reclaimPolicy: "Retain"
      seaweedRef:
        name: "seaweedfs-default"
  -
    apiVersion: "seaweed.seaweedfs.com/v1"
    kind: "S3Policy"
    metadata:
      name: "stalwart-access-key"
      namespace: "seaweedfs"
    spec:
      name: "stalwart-access-key"
      policyDocument: "{\n    \"Statement\": [\n        {\n            \"Action\": [\n                \"s3:Get*\",\n                \"s3:Put*\",\n                \"s3:Delete*\",\n                \"s3:AbortMultipartUpload\",\n                \"s3:List*\",\n                \"s3:*Tagging\"\n            ],\n            \"Effect\": \"Allow\",\n            \"Resource\": [\n                \"arn:aws:s3:::stalwart\",\n                \"arn:aws:s3:::stalwart/*\"\n            ]\n        }\n    ],\n    \"Version\": \"2012-10-17\"\n}"
      reclaimPolicy: "Retain"
      seaweedRef:
        name: "seaweedfs-default"
