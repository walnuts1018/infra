export let policies =
  -
    apiVersion: "seaweed.seaweedfs.com/v1"
    kind: "S3Policy"
    metadata:
      name: "mac-hatena-access-key"
      namespace: "seaweedfs"
    spec:
      name: "mac-hatena-access-key"
      policyDocument: "{\n    \"Statement\": [\n        {\n            \"Action\": [\n                \"s3:*\"\n            ],\n            \"Effect\": \"Allow\",\n            \"Resource\": [\n                \"*\"\n            ]\n        }\n    ],\n    \"Version\": \"2012-10-17\"\n}"
      reclaimPolicy: "Retain"
      seaweedRef:
        name: "seaweedfs-default"
  -
    apiVersion: "seaweed.seaweedfs.com/v1"
    kind: "S3Policy"
    metadata:
      name: "maps-read-access-key"
      namespace: "seaweedfs"
    spec:
      name: "maps-read-access-key"
      policyDocument: "{\n    \"Statement\": [\n        {\n            \"Action\": [\n                \"s3:Get*\"\n            ],\n            \"Effect\": \"Allow\",\n            \"Resource\": [\n                \"arn:aws:s3:::maps\",\n                \"arn:aws:s3:::maps/*\"\n            ]\n        }\n    ],\n    \"Version\": \"2012-10-17\"\n}"
      reclaimPolicy: "Retain"
      seaweedRef:
        name: "seaweedfs-default"
  -
    apiVersion: "seaweed.seaweedfs.com/v1"
    kind: "S3Policy"
    metadata:
      name: "misskey-access-key"
      namespace: "seaweedfs"
    spec:
      name: "misskey-access-key"
      policyDocument: "{\n    \"Statement\": [\n        {\n            \"Action\": [\n                \"s3:Get*\",\n                \"s3:Put*\",\n                \"s3:Delete*\",\n                \"s3:AbortMultipartUpload\",\n                \"s3:List*\",\n                \"s3:*Tagging\"\n            ],\n            \"Effect\": \"Allow\",\n            \"Resource\": [\n                \"arn:aws:s3:::misskey\",\n                \"arn:aws:s3:::misskey/*\"\n            ]\n        }\n    ],\n    \"Version\": \"2012-10-17\"\n}"
      reclaimPolicy: "Retain"
      seaweedRef:
        name: "seaweedfs-default"
  -
    apiVersion: "seaweed.seaweedfs.com/v1"
    kind: "S3Policy"
    metadata:
      name: "oekaki-dengon-game-access-key"
      namespace: "seaweedfs"
