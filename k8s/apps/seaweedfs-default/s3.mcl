import "std:list" as lists

type BucketConfig =
  name: String
  diskType: "hdd" | "ssd"
  replication: "000" | "001"

let bucketConfigs: List<BucketConfig> =
  - name: "picca"
    diskType: "ssd"
    replication: "001"
  - name: "picca-dev"
    diskType: "ssd"
    replication: "001"
  - name: "cloudnative-pg-backup"
    diskType: "ssd"
    replication: "001"
  - name: "cortex-blocks"
    diskType: "ssd"
    replication: "001"
  - name: "cortex-ruler"
    diskType: "ssd"
    replication: "001"
  - name: "cortex-alertmanager"
    diskType: "ssd"
    replication: "001"
  - name: "gha-cache"
    diskType: "ssd"
    replication: "000"
  - name: "ipu"
    diskType: "ssd"
    replication: "001"
  - name: "loki-admin"
    diskType: "ssd"
    replication: "001"
  - name: "loki-chunks"
    diskType: "hdd"
    replication: "000"
  - name: "loki-ruler"
    diskType: "ssd"
    replication: "001"
  - name: "maps"
    diskType: "ssd"
    replication: "001"
  - name: "misskey"
    diskType: "ssd"
    replication: "001"
  - name: "netbox-media"
    diskType: "ssd"
    replication: "001"
  - name: "netbox-scripts"
    diskType: "ssd"
    replication: "001"
  - name: "oekaki-dengon-game"
    diskType: "ssd"
    replication: "001"
  - name: "pyroscope"
    diskType: "hdd"
    replication: "000"
  - name: "stalwart"
    diskType: "ssd"
    replication: "001"
  - name: "tempo"
    diskType: "hdd"
    replication: "000"
  - name: "visual-regression-tracker"
    diskType: "ssd"
    replication: "000"

fn bucket(config: BucketConfig) -> Map<String, Any> = node:
  apiVersion: "seaweed.seaweedfs.com/v1"
  kind: "Bucket"
  metadata:
    name: config.name
    namespace: "seaweedfs"
  spec:
    adoptExisting: true
    clusterRef:
      name: "seaweedfs-default"
    objectLock: false
    placement:
      diskType: config.diskType
      replication: config.replication
    reclaimPolicy: "Retain"
    versioning: "Off"

export let buckets = lists.map(bucketConfigs, fn(config) => bucket(config))

export let identities =
  -
    apiVersion: "seaweed.seaweedfs.com/v1"
    kind: "S3Identity"
    metadata:
      name: "mac-hatena"
      namespace: "seaweedfs"
    spec:
      name: "mac_hatena"
      reclaimPolicy: "Retain"
      seaweedRef:
        name: "seaweedfs-default"
  -
    apiVersion: "seaweed.seaweedfs.com/v1"
    kind: "S3Identity"
    metadata:
      name: "maps-read"
      namespace: "seaweedfs"
    spec:
      name: "maps_read"
      reclaimPolicy: "Retain"
      seaweedRef:
        name: "seaweedfs-default"
  -
    apiVersion: "seaweed.seaweedfs.com/v1"
    kind: "S3Identity"
