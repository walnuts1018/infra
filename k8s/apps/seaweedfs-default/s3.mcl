import "std:json" as json
import "std:list" as lists

type BucketConfig =
  name: String
  diskType: "hdd" | "ssd"
  replication: "000" | "001"

let bucketConfigs: List<BucketConfig> =
  - name: "picca"
    diskType: "ssd"
    replication: "001"
  - name: "picca-dev"
    diskType: "ssd"
    replication: "001"
  - name: "cloudnative-pg-backup"
    diskType: "ssd"
    replication: "001"
  - name: "cortex-blocks"
    diskType: "ssd"
    replication: "001"
  - name: "cortex-ruler"
    diskType: "ssd"
    replication: "001"
  - name: "cortex-alertmanager"
    diskType: "ssd"
    replication: "001"
  - name: "gha-cache"
    diskType: "ssd"
    replication: "000"
  - name: "ipu"
    diskType: "ssd"
    replication: "001"
  - name: "loki-admin"
    diskType: "ssd"
    replication: "001"
  - name: "loki-chunks"
    diskType: "hdd"
    replication: "000"
  - name: "loki-ruler"
    diskType: "ssd"
    replication: "001"
  - name: "maps"
    diskType: "ssd"
    replication: "001"
  - name: "misskey"
    diskType: "ssd"
    replication: "001"
  - name: "netbox-media"
    diskType: "ssd"
    replication: "001"
  - name: "netbox-scripts"
    diskType: "ssd"
    replication: "001"
  - name: "oekaki-dengon-game"
    diskType: "ssd"
    replication: "001"
  - name: "pyroscope"
    diskType: "hdd"
    replication: "000"
  - name: "stalwart"
    diskType: "ssd"
    replication: "001"
  - name: "tempo"
    diskType: "hdd"
    replication: "000"
  - name: "visual-regression-tracker"
    diskType: "ssd"
    replication: "000"

fn bucket(namespace: String, config: BucketConfig) -> Map<String, Any> = node:
  apiVersion: "seaweed.seaweedfs.com/v1"
  kind: "Bucket"
  metadata:
    name: config.name
    namespace: namespace
  spec:
    adoptExisting: true
    clusterRef:
      name: "seaweedfs-default"
    objectLock: false
    placement:
      diskType: config.diskType
      replication: config.replication
    reclaimPolicy: "Retain"
    versioning: "Off"

export fn buckets(namespace: String) -> List<Map<String, Any>> = lists.map(bucketConfigs, fn(config) => bucket(namespace, config))

type S3ClientConfig =
  name: String
  identityName: String
  actions: List<String>
  resources: List<String>
  secretName: String
  secretNamespace: String
  accessKeyField: String
  secretKeyField: String

let readWriteActions =
  - "s3:Get*"
  - "s3:Put*"
  - "s3:Delete*"
  - "s3:AbortMultipartUpload"
  - "s3:List*"
  - "s3:*Tagging"

fn bucketResources(bucketName: String) -> List<String> =
  - "arn:aws:s3:::" + bucketName
  - "arn:aws:s3:::" + bucketName + "/*"

fn policyValue(actions: List<String>, resources: List<String>) -> Map<String, Any> =
  "Statement":
    - Action: actions
      Effect: "Allow"
      Resource: resources
  "Version": "2012-10-17"

let s3ClientConfigs: List<S3ClientConfig> =
  - name: "mac-hatena"
    identityName: "mac_hatena"
    actions: ["s3:*"]
    resources: ["*"]
    secretName: "seaweedfs-default-mac-hatena-credentials"
    secretNamespace: "seaweedfs"
    accessKeyField: "accesskey"
    secretKeyField: "secretkey"
  - name: "maps-read"
    identityName: "maps_read"
    actions: ["s3:Get*"]
    resources: ["arn:aws:s3:::maps", "arn:aws:s3:::maps/*"]
    secretName: "maps-s3-credentials"
    secretNamespace: "maps"
    accessKeyField: "AWS_ACCESS_KEY_ID"
    secretKeyField: "AWS_SECRET_ACCESS_KEY"
  - name: "misskey"
    identityName: "misskey"
    actions: readWriteActions
    resources: bucketResources("misskey")
    secretName: "seaweedfs-default-misskey-credentials"
    secretNamespace: "seaweedfs"
    accessKeyField: "accesskey"
    secretKeyField: "secretkey"
  - name: "oekaki-dengon-game"
    identityName: "oekaki_dengon_game"
    actions: readWriteActions
    resources: bucketResources("oekaki-dengon-game")
    secretName: "oekaki-dengon-game-s3-credentials"
    secretNamespace: "oekaki-dengon-game"
    accessKeyField: "minio-access-key"
    secretKeyField: "minio-secret-key"
  - name: "stalwart"
    identityName: "stalwart"
    actions: readWriteActions
    resources: bucketResources("stalwart")
    secretName: "stalwart-s3-credentials"
    secretNamespace: "stalwart"
    accessKeyField: "s3_access_key"
    secretKeyField: "s3_secret_access_key"
  - name: "visual-regression-tracker"
    identityName: "visual_regression_tracker"
    actions: readWriteActions
    resources: bucketResources("visual-regression-tracker")
    secretName: "visual-regression-tracker-s3-credentials"
    secretNamespace: "visual-regression-tracker"
    accessKeyField: "AWS_ACCESS_KEY_ID"
    secretKeyField: "AWS_SECRET_ACCESS_KEY"

fn identity(namespace: String, config: S3ClientConfig) -> Map<String, Any> = node:
  apiVersion: "seaweed.seaweedfs.com/v1"
  kind: "S3Identity"
  metadata:
    name: config.name
    namespace: namespace
  spec:
    name: config.identityName
    reclaimPolicy: "Retain"
    seaweedRef:
      name: "seaweedfs-default"

fn policy(namespace: String, config: S3ClientConfig) -> Map<String, Any> = node:
  apiVersion: "seaweed.seaweedfs.com/v1"
  kind: "S3Policy"
  metadata:
    name: config.name + "-access-key"
    namespace: namespace
  spec:
    name: config.name + "-access-key"
    policyDocument: json.encode(policyValue(config.actions, config.resources))
    reclaimPolicy: "Retain"
    seaweedRef:
      name: "seaweedfs-default"

fn binding(namespace: String, config: S3ClientConfig) -> Map<String, Any> = node:
  apiVersion: "seaweed.seaweedfs.com/v1"
  kind: "S3PolicyBinding"
  metadata:
    name: config.name
    namespace: namespace
  spec:
    policyRef:
      name: config.name + "-access-key"
    reclaimPolicy: "Retain"
    seaweedRef:
      name: "seaweedfs-default"
    subjects:
      - kind: "S3Identity"
        name: config.name

fn credentialsResource(namespace: String, config: S3ClientConfig) -> Map<String, Any> = node:
  apiVersion: "seaweed.seaweedfs.com/v1"
  kind: "S3Credentials"
  metadata:
    name: config.name
    namespace: namespace
  spec:
    identityRef:
      name: config.name
    reclaimPolicy: "Retain"
    seaweedRef:
      name: "seaweedfs-default"
    secretRef:
      accessKeyField: config.accessKeyField
      name: config.secretName
      namespace: config.secretNamespace
      secretKeyField: config.secretKeyField

fn clientResources(namespace: String, config: S3ClientConfig) -> List<Map<String, Any>> =
  [
    identity(namespace, config),
    policy(namespace, config),
    binding(namespace, config),
    credentialsResource(namespace, config),
  ]

fn clients(namespace: String) -> List<Map<String, Any>> =
  lists.flatMap(s3ClientConfigs, fn(config) => clientResources(namespace, config))

export fn resources(namespace: String) -> List<Map<String, Any>> =
  [
    ...buckets(namespace),
    ...clients(namespace),
  ]
