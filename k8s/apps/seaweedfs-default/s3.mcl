        accessKeyField: "s3_access_key"
        name: "stalwart-s3-credentials"
        namespace: "stalwart"
        secretKeyField: "s3_secret_access_key"
  -
    apiVersion: "seaweed.seaweedfs.com/v1"
    kind: "S3Credentials"
    metadata:
      name: "visual-regression-tracker"
      namespace: "seaweedfs"
    spec:
      identityRef:
        name: "visual-regression-tracker"
      reclaimPolicy: "Retain"
      seaweedRef:
        name: "seaweedfs-default"
      secretRef:
        accessKeyField: "AWS_ACCESS_KEY_ID"
        name: "visual-regression-tracker-s3-credentials"
        namespace: "visual-regression-tracker"
        secretKeyField: "AWS_SECRET_ACCESS_KEY"
