export let credentials =
  -
    apiVersion: "seaweed.seaweedfs.com/v1"
    kind: "S3Credentials"
    metadata:
      name: "mac-hatena"
      namespace: "seaweedfs"
    spec:
      identityRef:
        name: "mac-hatena"
      reclaimPolicy: "Retain"
      seaweedRef:
        name: "seaweedfs-default"
      secretRef:
        accessKeyField: "accesskey"
        name: "seaweedfs-default-mac-hatena-credentials"
        namespace: "seaweedfs"
        secretKeyField: "secretkey"
  -
    apiVersion: "seaweed.seaweedfs.com/v1"
    kind: "S3Credentials"
    metadata:
      name: "maps-read"
      namespace: "seaweedfs"
    spec:
      identityRef:
        name: "maps-read"
      reclaimPolicy: "Retain"
      seaweedRef:
        name: "seaweedfs-default"
      secretRef:
        accessKeyField: "AWS_ACCESS_KEY_ID"
        name: "maps-s3-credentials"
        namespace: "maps"
        secretKeyField: "AWS_SECRET_ACCESS_KEY"
  -
