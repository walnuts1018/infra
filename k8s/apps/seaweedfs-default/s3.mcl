    metadata:
      name: "stalwart"
      namespace: "seaweedfs"
    spec:
      name: "stalwart"
      reclaimPolicy: "Retain"
      seaweedRef:
        name: "seaweedfs-default"
  -
    apiVersion: "seaweed.seaweedfs.com/v1"
    kind: "S3Identity"
    metadata:
      name: "visual-regression-tracker"
      namespace: "seaweedfs"
    spec:
