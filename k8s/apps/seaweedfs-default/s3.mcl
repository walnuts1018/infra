export let bindings =
  -
    apiVersion: "seaweed.seaweedfs.com/v1"
    kind: "S3PolicyBinding"
    metadata:
      name: "mac-hatena"
      namespace: "seaweedfs"
    spec:
      policyRef:
        name: "mac-hatena-access-key"
      reclaimPolicy: "Retain"
      seaweedRef:
        name: "seaweedfs-default"
      subjects:
        -
          kind: "S3Identity"
          name: "mac-hatena"
  -
    apiVersion: "seaweed.seaweedfs.com/v1"
    kind: "S3PolicyBinding"
    metadata:
