import "../envoy-gateway-class/gateway.mcl" as gateway

export fn resources(namespace: String) -> List<Map<String, Any>> =
  -
    apiVersion: "gateway.networking.k8s.io/v1"
    kind: "HTTPRoute"
    metadata:
      name: "seaweedfs-default"
      namespace: namespace
    spec:
      hostnames:
        - "seaweedfs.walnuts.dev"
      parentRefs:
        -
          name: "envoy-gateway"
          namespace: gateway.namespace
      rules:
        -
          backendRefs:
            -
              kind: "Service"
              name: "seaweedfs-default-filer"
              port: 8333
              weight: 1
          matches:
            -
              path:
                type: "PathPrefix"
                value: "/"
          timeouts:
            request: "1h"
  -
    apiVersion: "gateway.networking.k8s.io/v1"
    kind: "HTTPRoute"
    metadata:
      name: "seaweedfs-default-local"
      namespace: namespace
    spec:
      hostnames:
        - "seaweedfs.local.walnuts.dev"
      parentRefs:
        -
          name: "envoy-gateway"
          namespace: gateway.namespace
      rules:
        -
          backendRefs:
            -
              kind: "Service"
              name: "seaweedfs-default-filer"
              port: 8333
              weight: 1
          matches:
            -
              path:
                type: "PathPrefix"
                value: "/"
          timeouts:
            request: "1h"
  -
    apiVersion: "gateway.networking.k8s.io/v1"
    kind: "HTTPRoute"
    metadata:
      name: "seaweedfs-default-minio"
      namespace: namespace
    spec:
      hostnames:
        - "minio.walnuts.dev"
      parentRefs:
        -
          name: "envoy-gateway"
          namespace: gateway.namespace
      rules:
        -
          filters:
            -
              requestRedirect:
                hostname: "seaweedfs.walnuts.dev"
                scheme: "https"
                statusCode: 301
              type: "RequestRedirect"
          matches:
            -
              path:
                type: "PathPrefix"
                value: "/"
