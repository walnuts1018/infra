import text "./_configs/filer.toml" as filerConfig
import text "./_configs/iam.json" as iamConfig
import "std:hash" as hash

let filerConfigData =
  -
    remoteRef:
      key: "seaweedfs"
      property: "sts_signing_key"
    secretKey: "sts_signing_key"
let filerConfigTemplateData =
  "filer.toml": filerConfig
  "iam.json": iamConfig
let filerConfigHashInput =
  data: filerConfigData
  templateData: filerConfigTemplateData
export let filerConfigName = "seaweedfs-default-filer-config-" + hash.fnv1a64(filerConfigHashInput)

export let resources =
  -
    apiVersion: "external-secrets.io/v1"
    kind: "ExternalSecret"
    metadata:
      name: filerConfigName
      namespace: "seaweedfs"
    spec:
      data: filerConfigData
      refreshInterval: "1m"
      secretStoreRef:
        kind: "ClusterSecretStore"
        name: "onepassword"
      target:
        name: filerConfigName
        template:
          data: filerConfigTemplateData
          engineVersion: "v2"
          type: "Opaque"
  -
    apiVersion: "external-secrets.io/v1"
    kind: "ExternalSecret"
    metadata:
      name: "seaweedfs-default-mac-hatena-credentials"
      namespace: "seaweedfs"
    spec:
      data:
        -
          remoteRef:
            key: "seaweedfs"
            property: "mac_hatena_accesskey"
          secretKey: "accesskey"
        -
          remoteRef:
            key: "seaweedfs"
            property: "mac_hatena_secretkey"
          secretKey: "secretkey"
      refreshInterval: "1m"
      secretStoreRef:
        kind: "ClusterSecretStore"
        name: "onepassword"
      target:
        creationPolicy: "Orphan"
        name: "seaweedfs-default-mac-hatena-credentials"
        template:
          data:
            accesskey: "{{ .accesskey }}"
            secretkey: "{{ .secretkey }}"
          engineVersion: "v2"
          type: "Opaque"
  -
    apiVersion: "external-secrets.io/v1"
    kind: "ExternalSecret"
    metadata:
      name: "seaweedfs-default-misskey-credentials"
      namespace: "seaweedfs"
    spec:
      data:
        -
          remoteRef:
            key: "seaweedfs"
            property: "misskey_accesskey"
          secretKey: "accesskey"
        -
          remoteRef:
            key: "seaweedfs"
            property: "misskey_secretkey"
          secretKey: "secretkey"
      refreshInterval: "1m"
      secretStoreRef:
        kind: "ClusterSecretStore"
        name: "onepassword"
      target:
        creationPolicy: "Orphan"
        name: "seaweedfs-default-misskey-credentials"
        template:
          data:
            accesskey: "{{ .accesskey }}"
            secretkey: "{{ .secretkey }}"
          engineVersion: "v2"
          type: "Opaque"
