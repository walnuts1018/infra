      {
        "name": "agr-app-service-read",
        "statements": [
          {
            "effect": "Allow",
            "actions": [
              "s3:ListBucket"
            ],
            "resources": [
              "arn:aws:s3:::agr-ai"
            ],
            "condition": {
              "StringLike": {
                "s3:prefix": [
                  "worker-runs/models/*"
                ]
              }
            }
          },
          {
            "effect": "Allow",
            "actions": [
              "s3:GetObject"
            ],
            "resources": [
              "arn:aws:s3:::agr-ai/worker-runs/models/releases/*",
              "arn:aws:s3:::agr-ai/worker-runs/models/active.json"
            ]
          }
        ]
      },
      {
        "name": "agr-planner",
        "statements": [
          {
            "effect": "Allow",
            "actions": [
              "s3:ListBucket"
            ],
            "resources": [
              "arn:aws:s3:::agr-ai"
            ],
            "condition": {
              "StringLike": {
                "s3:prefix": [
                  "worker-runs/models/*",
                  "worker-runs/generations/*"
                ]
              }
            }
          },
          {
            "effect": "Allow",
            "actions": [
              "s3:GetObject"
            ],
            "resources": [
              "arn:aws:s3:::agr-ai/worker-runs/models/*",
              "arn:aws:s3:::agr-ai/worker-runs/generations/*/plan.json"
            ]
          },
          {
            "effect": "Allow",
            "actions": [
              "s3:PutObject",
              "s3:AbortMultipartUpload"
            ],
            "resources": [
              "arn:aws:s3:::agr-ai/worker-runs/generations/*/plan.json",
              "arn:aws:s3:::agr-ai/worker-runs/semantics/*",
              "arn:aws:s3:::agr-ai/worker-runs/operations/*",
              "arn:aws:s3:::agr-ai/worker-runs/generations/*/attempts/*/attempt.json",
              "arn:aws:s3:::agr-ai/worker-runs/generations/*/attempts/*/stage-metrics/*"
            ]
          }
        ]
      },
