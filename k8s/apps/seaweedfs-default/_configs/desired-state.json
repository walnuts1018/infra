{
  "bucketDefaults": {
    "adoptExisting": true,
    "objectLock": false,
    "reclaimPolicy": "Retain",
    "versioning": "Off"
  },
  "buckets": [
    {
      "name": "picca",
      "publicRead": [],
      "cors": [
        {
          "allowedOrigins": ["https://picca.walnuts.dev"],
          "allowedMethods": ["GET", "PUT", "HEAD"],
          "allowedHeaders": ["Content-Type"],
          "exposeHeaders": ["ETag"],
          "maxAgeSeconds": 3600
        }
      ]
    },
    {
      "name": "picca-dev",
      "publicRead": [],
      "cors": [
        {
          "allowedOrigins": ["https://picca-dev.walnuts.dev"],
          "allowedMethods": ["GET", "PUT", "HEAD"],
          "allowedHeaders": ["Content-Type"],
          "exposeHeaders": ["ETag"],
          "maxAgeSeconds": 3600
        }
      ]
    },
    {
      "name": "cloudnative-pg-backup",
      "publicRead": []
    },
    {
      "name": "gha-cache",
      "publicRead": []
    },
    {
      "name": "ipu",
      "publicRead": []
    },
    {
      "name": "loki-admin",
      "publicRead": []
    },
    {
      "name": "loki-chunks",
      "publicRead": []
    },
    {
      "name": "loki-ruler",
      "publicRead": []
    },
    {
      "name": "maps",
      "publicRead": []
    },
    {
      "name": "misskey",
      "publicRead": [
        "files/*"
      ]
    },
    {
      "name": "netbox-media",
      "publicRead": []
    },
    {
      "name": "netbox-scripts",
      "publicRead": []
    },
    {
      "name": "oekaki-dengon-game",
      "publicRead": [
        "*"
      ]
    },
    {
      "name": "picca-ai-prototype",
      "publicRead": []
    },
    {
      "name": "pyroscope",
      "publicRead": []
    },
    {
      "name": "stalwart",
      "publicRead": []
    },
    {
      "name": "tempo",
      "publicRead": []
    },
    {
      "name": "visual-regression-tracker",
      "publicRead": []
    }
  ],
  "accessKeyIdentities": [
    {
      "name": "mac_hatena",
      "accessKeyProperty": "mac_hatena_accesskey",
      "secretKeyProperty": "mac_hatena_secretkey",
      "permissions": [
        {
          "effect": "Allow",
          "actions": [
            "Admin"
          ],
          "resources": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "maps_read",
      "secretTarget": {
        "namespace": "maps",
        "secretName": "maps-s3-credentials",
        "accessKeyField": "AWS_ACCESS_KEY_ID",
        "secretKeyField": "AWS_SECRET_ACCESS_KEY"
      },
      "permissions": [
        {
          "effect": "Allow",
          "actions": [
            "Read"
          ],
          "buckets": [
            "maps"
          ]
        }
      ]
    },
    {
      "name": "misskey",
      "accessKeyProperty": "misskey_accesskey",
      "secretKeyProperty": "misskey_secretkey",
      "permissions": [
        {
          "effect": "Allow",
          "actions": [
            "Read",
            "Write",
            "List",
            "Tagging"
          ],
          "buckets": [
            "misskey"
          ]
        }
      ]
    },
    {
      "name": "oekaki_dengon_game",
      "secretTarget": {
        "namespace": "oekaki-dengon-game",
        "secretName": "oekaki-dengon-game-s3-credentials",
        "accessKeyField": "minio-access-key",
        "secretKeyField": "minio-secret-key"
      },
      "permissions": [
        {
          "effect": "Allow",
          "actions": [
            "Read",
            "Write",
            "List",
            "Tagging"
          ],
          "buckets": [
            "oekaki-dengon-game"
          ]
        }
      ]
    },
    {
      "name": "stalwart",
      "secretTarget": {
        "namespace": "stalwart",
        "secretName": "stalwart-s3-credentials",
        "accessKeyField": "s3_access_key",
        "secretKeyField": "s3_secret_access_key"
      },
      "permissions": [
        {
          "effect": "Allow",
          "actions": [
            "Read",
            "Write",
            "List",
            "Tagging"
          ],
          "buckets": [
            "stalwart"
          ]
        }
      ]
    },
    {
      "name": "visual_regression_tracker",
      "secretTarget": {
        "namespace": "visual-regression-tracker",
        "secretName": "visual-regression-tracker-s3-credentials",
        "accessKeyField": "AWS_ACCESS_KEY_ID",
        "secretKeyField": "AWS_SECRET_ACCESS_KEY"
      },
      "permissions": [
        {
          "effect": "Allow",
          "actions": [
            "Read",
            "Write",
            "List",
            "Tagging"
          ],
          "buckets": [
            "visual-regression-tracker"
          ]
        }
      ]
    }
  ],
  "sts": {
    "tokenDuration": "1h",
    "maxSessionLength": "12h",
    "issuer": "seaweedfs-sts",
    "signingKeyProperty": "sts_signing_key",
    "providers": [
      {
        "name": "k8s",
        "type": "oidc",
        "issuer": "https://192.168.0.17:16443",
        "clientId": "sts.seaweedfs.com",
        "jwksUri": "https://kubernetes.default.svc/openid/v1/jwks",
        "tlsCaCert": "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt",
        "defaultRole": "S3DenyAllRole",
        "mappings": [
          {
            "claim": "sub",
            "value": "system:serviceaccount:loki:loki",
            "role": "loki"
          },
          {
            "claim": "sub",
            "value": "system:serviceaccount:ipu:ipu",
            "role": "ipu"
          },
          {
            "claim": "sub",
            "value": "system:serviceaccount:picca:picca",
            "role": "picca"
          },
          {
            "claim": "sub",
            "value": "system:serviceaccount:picca-dev:picca-dev",
            "role": "picca-dev"
          },
          {
            "claim": "sub",
            "value": "system:serviceaccount:maps:maps-updater",
            "role": "maps"
          },
          {
            "claim": "sub",
            "value": "system:serviceaccount:picca-ai-prototype:picca-ai-prototype-gateway",
            "role": "picca-ai-prototype-gateway"
          },
          {
            "claim": "sub",
            "value": "system:serviceaccount:picca-ai-prototype:picca-ai-prototype-debug-web",
            "role": "picca-ai-prototype-debug-web"
          },
          {
            "claim": "sub",
            "value": "system:serviceaccount:misskey:misskey-postgresql",
            "role": "cloudnative-pg-backup"
          },
          {
            "claim": "sub",
            "value": "system:serviceaccount:databases:postgresql-default",
            "role": "cloudnative-pg-backup"
          },
          {
            "claim": "sub",
            "value": "system:serviceaccount:tempo:tempo",
            "role": "tempo"
          },
          {
            "claim": "sub",
            "value": "system:serviceaccount:pyroscope:pyroscope",
            "role": "pyroscope"
          },
          {
            "claim": "sub",
            "value": "system:serviceaccount:netbox:netbox",
            "role": "netbox"
          },
          {
            "claim": "sub",
            "value": "system:serviceaccount:stalwart:stalwart",
            "role": "stalwart"
          },
          {
            "claim": "sub",
            "value": "system:serviceaccount:arc-systems:gha-cache-server",
            "role": "gha-cache-server"
          }
        ]
      },
      {
        "name": "terraform_cloud",
        "type": "oidc",
        "issuer": "https://app.terraform.io",
        "clientId": "aws.workload.identity",
        "jwksUri": "https://app.terraform.io/.well-known/jwks",
        "defaultRole": "S3DenyAllRole",
        "mappings": [
          {
            "claim": "aud",
            "value": "aws.workload.identity",
            "role": "TerraformCloud"
          }
        ]
      }
    ],
    "policies": [
      {
        "name": "DenyAllPolicy",
        "statements": [
          {
            "effect": "Deny",
            "actions": [
              "s3:*"
            ],
            "resources": [
              "*"
            ]
          }
        ]
      },
      {
        "name": "AdministratorAccess",
        "statements": [
          {
            "effect": "Allow",
            "actions": [
              "s3:*"
            ],
            "resources": [
              "*"
            ]
          }
        ]
      },
      {
        "name": "cloudnative-pg-backup",
        "statements": [
          {
            "effect": "Allow",
            "actions": [
              "s3:*"
            ],
            "buckets": [
              "cloudnative-pg-backup"
            ]
          }
        ]
      },
      {
        "name": "picca",
        "statements": [
          {
            "effect": "Allow",
            "actions": [
              "s3:Get*",
              "s3:Put*",
              "s3:Delete*",
              "s3:List*",
              "s3:*Tagging",
              "s3:AbortMultipartUpload"
            ],
            "buckets": [
              "picca"
            ]
          }
        ]
      },
      {
        "name": "picca-dev",
        "statements": [
          {
            "effect": "Allow",
            "actions": [
              "s3:Get*",
              "s3:Put*",
              "s3:Delete*",
              "s3:List*",
              "s3:*Tagging",
              "s3:AbortMultipartUpload"
            ],
            "buckets": [
              "picca-dev"
            ]
          }
        ]
      },
      {
        "name": "ipu",
        "statements": [
          {
            "effect": "Allow",
            "actions": [
              "s3:Get*",
              "s3:List*"
            ],
            "buckets": [
              "ipu"
            ]
          }
        ]
      },
      {
        "name": "maps",
        "statements": [
          {
            "effect": "Allow",
            "actions": [
              "s3:Get*",
              "s3:Put*",
              "s3:Delete*",
              "s3:List*",
              "s3:*Tagging",
              "s3:AbortMultipartUpload"
            ],
            "buckets": [
              "maps"
            ]
          }
        ]
      },
      {
        "name": "loki",
        "statements": [
          {
            "effect": "Allow",
            "actions": [
              "s3:*"
            ],
            "buckets": [
              "loki-admin",
              "loki-chunks",
              "loki-ruler"
            ]
          }
        ]
      },
      {
        "name": "netbox",
        "statements": [
          {
            "effect": "Allow",
            "actions": [
              "s3:*"
            ],
            "buckets": [
              "netbox-media",
              "netbox-scripts"
            ]
          }
        ]
      },
      {
        "name": "picca-ai-prototype-debug-web",
        "statements": [
          {
            "effect": "Allow",
            "actions": [
              "s3:ListBucket"
            ],
            "resources": [
              "picca-ai-prototype"
            ]
          },
          {
            "effect": "Allow",
            "actions": [
              "s3:GetObject",
              "s3:PutObject"
            ],
            "resources": [
              "picca-ai-prototype",
              "picca-ai-prototype/*"
            ]
          }
        ]
      },
      {
        "name": "picca-ai-prototype-gateway",
        "statements": [
          {
            "effect": "Allow",
            "actions": [
              "s3:ListBucket"
            ],
            "resources": [
              "picca-ai-prototype"
            ]
          },
          {
            "effect": "Allow",
            "actions": [
              "s3:GetObject"
            ],
            "resources": [
              "picca-ai-prototype",
              "picca-ai-prototype/*"
            ]
          }
        ]
      },
      {
        "name": "pyroscope",
        "statements": [
          {
            "effect": "Allow",
            "actions": [
              "s3:*"
            ],
            "buckets": [
              "pyroscope"
            ]
          }
        ]
      },
      {
        "name": "stalwart",
        "statements": [
          {
            "effect": "Allow",
            "actions": [
              "s3:*"
            ],
            "buckets": [
              "stalwart"
            ]
          }
        ]
      },
      {
        "name": "tempo",
        "statements": [
          {
            "effect": "Allow",
            "actions": [
              "s3:*"
            ],
            "buckets": [
              "tempo"
            ]
          }
        ]
      },
      {
        "name": "gha-cache-server",
        "statements": [
          {
            "effect": "Allow",
            "actions": [
              "s3:*"
            ],
            "buckets": [
              "gha-cache"
            ]
          }
        ]
      }
    ],
    "roles": [
      {
        "name": "S3DenyAllRole",
        "policies": [
          "DenyAllPolicy"
        ]
      },
      {
        "name": "TerraformCloud",
        "policies": [
          "AdministratorAccess"
        ],
        "provider": "terraform_cloud",
        "subjectPatterns": [
          "organization:walnuts-dev:project:*:workspace:*:run_phase:*"
        ]
      },
      {
        "name": "loki",
        "policies": [
          "loki"
        ],
        "provider": "k8s"
      },
      {
        "name": "ipu",
        "policies": [
          "ipu"
        ],
        "provider": "k8s"
      },
      {
        "name": "picca",
        "policies": [
          "picca"
        ],
        "provider": "k8s"
      },
      {
        "name": "picca-dev",
        "policies": [
          "picca-dev"
        ],
        "provider": "k8s"
      },
      {
        "name": "maps",
        "policies": [
          "maps"
        ],
        "provider": "k8s"
      },
      {
        "name": "cloudnative-pg-backup",
        "policies": [
          "cloudnative-pg-backup"
        ],
        "provider": "k8s"
      },
      {
        "name": "picca-ai-prototype-gateway",
        "policies": [
          "picca-ai-prototype-gateway"
        ],
        "provider": "k8s"
      },
      {
        "name": "picca-ai-prototype-debug-web",
        "policies": [
          "picca-ai-prototype-debug-web"
        ],
        "provider": "k8s"
      },
      {
        "name": "tempo",
        "policies": [
          "tempo"
        ],
        "provider": "k8s"
      },
      {
        "name": "pyroscope",
        "policies": [
          "pyroscope"
        ],
        "provider": "k8s"
      },
      {
        "name": "netbox",
        "policies": [
          "netbox"
        ],
        "provider": "k8s"
      },
      {
        "name": "stalwart",
        "policies": [
          "stalwart"
        ],
        "provider": "k8s"
      },
      {
        "name": "gha-cache-server",
        "policies": [
          "gha-cache-server"
        ],
        "provider": "k8s"
      }
    ]
  }
}
