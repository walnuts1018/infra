import "../envoy-gateway-class/gateway.mcl" as gateway

let routeRules =
  -
    backendRefs:
      -
        kind: "Service"
        name: "seaweedfs-default-filer"
        port: 8333

export fn resource(namespace: String) -> Map<String, Any> = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "HTTPRoute"
  metadata:
    labels:
      app: "seaweedfs-default-s3"
      "app.kubernetes.io/name": "seaweedfs-default-s3"
    name: "seaweedfs-default-s3"
    namespace: namespace
  spec:
    hostnames:
      - "visual-regression-tracker.seaweedfs.local.walnuts.dev"
      - "picca.seaweedfs.walnuts.dev"
      - "picca-dev.seaweedfs.walnuts.dev"
    parentRefs:
      -
        name: "envoy-gateway"
        namespace: gateway.namespace
    rules: routeRules
