import "./core.mcl" as core
import "./volume.mcl" as volume
import "./routes.mcl" as routes
import "./s3-route.mcl" as s3Route
import "./s3.mcl" as s3
import "./external-secrets.mcl" as externalSecrets
import "../../cluster.mcl" as clusterConfig
param cluster: clusterConfig.Cluster
param namespace: String

emit each core.resources(namespace)
emit each volume.resources(namespace)
emit each routes.resources(namespace)
emit s3Route.resource(namespace)
emit each s3.buckets(namespace)
emit each s3.identities(namespace)
emit each s3.policies(namespace)
emit each s3.bindings(namespace)
emit each s3.credentials(namespace)
emit each externalSecrets.resources(namespace)
