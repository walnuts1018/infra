import "std:manifest" as manifest
import "std:list" as lists
import "../envoy-gateway-class/gateway.mcl" as gateway
let egressBundle = manifest.load("./_configs/networkpolicy-egress.yaml")
let ingressBundle = manifest.load("./_configs/networkpolicy-ingress.yaml")
let oidcBundle = manifest.load("./_configs/ciliumnetworkpolicy-oidc.yaml")

export let egress = egressBundle[0]
let ingressResource: Map<String, Any> = ingressBundle[0]
let ingressPeers = ingressResource.spec.ingress[0].from
let ingressRuleBase: Map<String, Any> = ingressResource.spec.ingress[0]
let gatewayPeerBase: Map<String, Any> = ingressPeers[1]
let gatewayPeer = gatewayPeerBase with:
  namespaceSelector:
    matchLabels:
      "kubernetes.io/metadata.name": gateway.namespace
let ingressRule = ingressRuleBase with:
  from: lists.replaceAt(ingressPeers, 1, gatewayPeer)
export let ingress = ingressResource with:
  spec:
    ingress: lists.replaceAt(ingressResource.spec.ingress, 0, ingressRule)
export let oidc = oidcBundle[0]
