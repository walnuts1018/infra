import "./external-secret.mcl" as externalSecret
import "./network-policies.mcl" as networkPolicies
import "./route.mcl" as route
import "./service.mcl" as service
import "./workload.mcl" as workload
import "../../cluster.mcl" as clusterConfig
import "./config.mcl" as appConfig
param cluster: clusterConfig.Cluster
param namespace: String
param settings: appConfig.Settings

let resources =
  - workload.serviceAccount(namespace)
  - externalSecret.resource(namespace)
  - service.resource(namespace)
  - workload.deployment(namespace, settings)
  - route.resource(namespace)
  - networkPolicies.egress
  - networkPolicies.ingress
  - networkPolicies.oidc

emit each resources
