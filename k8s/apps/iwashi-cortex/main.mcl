import "std:helm" as helm
import "std:list" as lists
import "./chart.mcl" as appChart
import "./network-policies.mcl" as networkPolicies
import "./profiles.mcl" as appProfiles
import "../../cluster.mcl" as clusterConfig
param cluster: clusterConfig.Cluster

let profileName = "metricsStorage"
let values: Map<String, Any> = appProfiles.valuesByProfile[profileName]
let apiVersions: List<String> = []
let options =
  releaseName: "iwashi-cortex"
  namespace: appChart.namespace
  version: appChart.chartVersion
  kubeVersion: cluster.kubernetesVersion
  apiVersions: apiVersions
  values: values
let chartResources = helm.render(appChart.chartArchive, options)

emit each lists.concat(chartResources, networkPolicies.resources)
