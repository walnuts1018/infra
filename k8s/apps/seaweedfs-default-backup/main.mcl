import "./resources.mcl" as appResources
import "./config.mcl" as appConfig
import "../../cluster.mcl" as clusterConfig
param cluster: clusterConfig.Cluster
param namespace: String
param settings: appConfig.Settings

emit appResources.awsConfigMap(namespace)
emit appResources.rcloneConfigMap(namespace)
emit appResources.scriptConfigMap(namespace)
emit appResources.externalSecret(namespace)
emit appResources.serviceAccount(namespace)
emit appResources.cronJob(namespace, settings)
