import "./config.mcl" as appConfig
import "../../cluster.mcl" as clusterConfig
param cluster: clusterConfig.Cluster
param namespace: String
param settings: appConfig.Settings

let resource = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ClusterSecretStore"
  metadata:
    name: "onepassword"
  spec:
    provider:
      onepassword:
        connectHost: "http://onepassword-connect.onepassword.svc.cluster.local:8080"
        vaults: settings.vaults
        auth:
          secretRef:
            connectTokenSecretRef:
              namespace: "onepassword"
              name: "onepassword-token"
              key: "token"

emit resource
