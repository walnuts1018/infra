import "std:manifest" as manifest
import "std:list" as lists

let clusterRoleBinding = manifest.loadOne("./_configs/cluster-role-binding.yaml")
let clusterRole = manifest.loadOne("./_configs/cluster-role.yaml")
let atomicCollector = manifest.loadOne("./_configs/collectors__atomic.yaml")
let daemonsetCollector = manifest.loadOne("./_configs/collectors__daemonset.yaml")
let defaultCollector = manifest.loadOne("./_configs/collectors__default.yaml")
let prometheusCollector = manifest.loadOne("./_configs/collectors__prometheus.yaml")
let vyosCollector = manifest.loadOne("./_configs/collectors__vyos.yaml")
let vyosService = manifest.loadOne("./_configs/collectors__vyos_service.yaml")
let externalSecret = manifest.loadOne("./_configs/external-secret.yaml")
let serviceAccount = manifest.loadOne("./_configs/sa.yaml")

let collectors =
  - atomicCollector
  - daemonsetCollector
  - defaultCollector
  - prometheusCollector
  - vyosCollector

let fixedResources =
  - clusterRoleBinding
  - clusterRole
  - externalSecret
  - serviceAccount

let serviceResources =
  - vyosService

let resourcesWithClusterObjects = lists.concat(
  lists.concat(fixedResources, collectors),
  serviceResources,
)

fn withNamespace(namespace: String, resource: Map<String, Any>) -> Map<String, Any> = resource with:
  metadata:
    namespace: namespace

fn withSubjectNamespace(namespace: String, subject: Map<String, Any>) -> Map<String, Any> = subject with:
  namespace: namespace

fn withSubjects(namespace: String, resource: Map<String, Any>) -> Map<String, Any> = resource with:
  subjects: lists.map(resource.subjects, fn(subject) => withSubjectNamespace(namespace, subject))

fn applyNamespacedResource(namespace: String, resource: Map<String, Any>) -> Map<String, Any> =
  if resource.kind == "ClusterRoleBinding":
    withSubjects(namespace, resource)
  else:
    withNamespace(namespace, resource)

fn applyNamespace(namespace: String, resource: Map<String, Any>) -> Map<String, Any> =
  if resource.kind == "ClusterRole":
    resource
  else:
    applyNamespacedResource(namespace, resource)

export fn resources(namespace: String) -> List<Map<String, Any>> =
  lists.map(resourcesWithClusterObjects, fn(resource) => applyNamespace(namespace, resource))
