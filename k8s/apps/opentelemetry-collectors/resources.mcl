import "std:manifest" as manifest
import "std:list" as lists

let clusterRoleBinding = manifest.loadOne("./_configs/cluster-role-binding.yaml")
let clusterRole = manifest.loadOne("./_configs/cluster-role.yaml")
let atomicCollector = manifest.loadOne("./_configs/collectors__atomic.yaml")
let daemonsetCollector = manifest.loadOne("./_configs/collectors__daemonset.yaml")
let defaultCollector = manifest.loadOne("./_configs/collectors__default.yaml")
let prometheusCollector = manifest.loadOne("./_configs/collectors__prometheus.yaml")
let vyosCollector = manifest.loadOne("./_configs/collectors__vyos.yaml")
let vyosService = manifest.loadOne("./_configs/collectors__vyos_service.yaml")
let externalSecret = manifest.loadOne("./_configs/external-secret.yaml")
let serviceAccount = manifest.loadOne("./_configs/sa.yaml")

let collectors =
  - atomicCollector
  - daemonsetCollector
  - defaultCollector
  - prometheusCollector
  - vyosCollector

let baseResources =
  - clusterRoleBinding
  - clusterRole
  - externalSecret
  - serviceAccount

let serviceResources =
  - vyosService

export let resources = lists.concat(
  lists.concat(baseResources, collectors),
  serviceResources,
)
