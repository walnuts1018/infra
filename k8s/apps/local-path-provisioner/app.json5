{
  name: "local-path-storage",
  namespace: "local-path-storage",
  additionalSources: {
    kustomize: [
      {
        repoURL: "https://github.com/rancher/local-path-provisioner",
        path: "deploy",
        targetRevision: "v0.0.32",
        patches: [
          {
            patch: "$patch: delete\napiVersion: v1\nkind: Namespace\nmetadata:\n  name: local-path-storage",
          },
          {
            target: {
              group: "apps",
              version: "v1",
              kind: "Deployment",
              name: "local-path-provisioner",
            },
            patch: "- op: add\n  path: /spec/template/spec/affinity\n  value:\n    nodeAffinity:\n      requiredDuringSchedulingIgnoredDuringExecution:\n        nodeSelectorTerms:\n        - matchExpressions:\n          - key: storage.walnuts.dev/slow\n            operator: DoesNotExist\n",
          },
          {
            target: {
              version: "v1",
              kind: "ConfigMap",
              name: "local-path-config",
            },
            patch: "- op: replace\n  path: /data/config.json\n  value: |-\n    {\n      \"nodePathMap\": [\n        {\n          \"node\": \"DEFAULT_PATH_FOR_NON_LISTED_NODES\",\n          \"paths\": [\"/opt/local-path-provisioner\"]\n        },\n        {\n          \"node\": \"rusk\",\n          \"paths\": []\n        }\n      ]\n    }\n",
          },
          {
            target: {
              group: "storage.k8s.io",
              version: "v1",
              kind: "StorageClass",
              name: "local-path",
            },
            patch: "- op: add\n  path: /allowedTopologies\n  value:\n  - matchLabelExpressions:\n    - key: storage.walnuts.dev/fast\n      values:\n      - \"true\"\n",
          },
        ],
      },
    ],
  },
  clusters: {
    kurumi: {},
  },
}
