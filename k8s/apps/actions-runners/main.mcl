import "./applications.mcl" as runnerApplications
import "./resources.mcl" as resources
import "../../cluster.mcl" as clusterConfig
param cluster: clusterConfig.Cluster
param namespace: String

let appResources = resources.resources(namespace)
emit appResources.runnerHooksConfigMap
emit appResources.githubAppSecret
emit appResources.networkPolicy
emit appResources.podMonitor
emit each runnerApplications.applications(namespace)
