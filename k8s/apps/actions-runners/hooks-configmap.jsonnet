{
  "apiVersion": "v1",
  "kind": "ConfigMap",
  "metadata": {
    "name": "runner-hooks",
    "namespace": "arc-runners"
  },
  "data": {
    "job-started.sh": "#!/usr/bin/env bash\nSTART_TIME=$(date +%s)\nCPU_USAGE=0\nif [ -f /sys/fs/cgroup/cpu.stat ]; then\n  CPU_USAGE=$(grep \"usage_usec\" /sys/fs/cgroup/cpu.stat | awk \"{print \\$2}\")\nfi\necho \"START_TIME=${START_TIME}\" > /tmp/job-metrics.env\necho \"START_CPU_USAGE=${CPU_USAGE}\" >> /tmp/job-metrics.env\nexit 0\n",
    "job-completed.sh": "#!/usr/bin/env bash\n(\n  END_TIME=$(date +%s)\n  START_TIME=\"${END_TIME}\"\n  START_CPU_USAGE=0\n\n  if [ -f /tmp/job-metrics.env ]; then\n    source /tmp/job-metrics.env\n  fi\n\n  DURATION=$((END_TIME - START_TIME))\n  if [ \"${DURATION}\" -le 0 ]; then\n    DURATION=1\n  fi\n\n  PEAK_MEM=0\n  if [ -f /sys/fs/cgroup/memory.peak ]; then\n    PEAK_MEM=$(cat /sys/fs/cgroup/memory.peak 2>/dev/null || echo 0)\n  elif [ -f /sys/fs/cgroup/memory.current ]; then\n    PEAK_MEM=$(cat /sys/fs/cgroup/memory.current 2>/dev/null || echo 0)\n  fi\n\n  AVG_CPU=\"0.0\"\n  if [ -f /sys/fs/cgroup/cpu.stat ]; then\n    END_CPU_USAGE=$(grep \"usage_usec\" /sys/fs/cgroup/cpu.stat | awk \"{print \\$2}\")\n    if [ -n \"${END_CPU_USAGE}\" ] && [ \"${END_CPU_USAGE}\" -gt \"${START_CPU_USAGE}\" ]; then\n      CPU_DELTA_USEC=$((END_CPU_USAGE - START_CPU_USAGE))\n      AVG_CPU=$(awk \"BEGIN {printf \\\"%.4f\\\", ${CPU_DELTA_USEC} / (${DURATION} * 1000000)}\")\n    fi\n  fi\n\n  JOB_NAME=\"${GITHUB_JOB:-unknown}\"\n  WORKFLOW_NAME=\"${GITHUB_WORKFLOW:-unknown}\"\n  REPO_NAME=\"${GITHUB_REPOSITORY:-unknown}\"\n  REPO_SHORT=\"${REPO_NAME##*/}\"\n\n  NOW_NS=$(date +%s%N 2>/dev/null || echo \"$(( $(date +%s) * 1000000000 ))\")\n\n  PAYLOAD=$(cat <<EOF\n{\n  \"resourceMetrics\": [{\n    \"resource\": {\n      \"attributes\": [\n        {\"key\": \"service.name\", \"value\": {\"stringValue\": \"actions-runner\"}},\n        {\"key\": \"k8s.namespace.name\", \"value\": {\"stringValue\": \"arc-runners\"}}\n      ]\n    },\n    \"scopeMetrics\": [{\n      \"scope\": {\"name\": \"github.actions.runner\"},\n      \"metrics\": [\n        {\n          \"name\": \"gha_job_resource_peak_memory_bytes\",\n          \"gauge\": {\n            \"dataPoints\": [{\n              \"asInt\": ${PEAK_MEM},\n              \"timeUnixNano\": \"${NOW_NS}\",\n              \"attributes\": [\n                {\"key\": \"job_name\", \"value\": {\"stringValue\": \"${JOB_NAME}\"}},\n                {\"key\": \"job_workflow_name\", \"value\": {\"stringValue\": \"${WORKFLOW_NAME}\"}},\n                {\"key\": \"repository\", \"value\": {\"stringValue\": \"${REPO_SHORT}\"}}\n              ]\n            }]\n          }\n        },\n        {\n          \"name\": \"gha_job_resource_avg_cpu_cores\",\n          \"gauge\": {\n            \"dataPoints\": [{\n              \"asDouble\": ${AVG_CPU},\n              \"timeUnixNano\": \"${NOW_NS}\",\n              \"attributes\": [\n                {\"key\": \"job_name\", \"value\": {\"stringValue\": \"${JOB_NAME}\"}},\n                {\"key\": \"job_workflow_name\", \"value\": {\"stringValue\": \"${WORKFLOW_NAME}\"}},\n                {\"key\": \"repository\", \"value\": {\"stringValue\": \"${REPO_SHORT}\"}}\n              ]\n            }]\n          }\n        },\n        {\n          \"name\": \"gha_job_resource_duration_seconds\",\n          \"gauge\": {\n            \"dataPoints\": [{\n              \"asInt\": ${DURATION},\n              \"timeUnixNano\": \"${NOW_NS}\",\n              \"attributes\": [\n                {\"key\": \"job_name\", \"value\": {\"stringValue\": \"${JOB_NAME}\"}},\n                {\"key\": \"job_workflow_name\", \"value\": {\"stringValue\": \"${WORKFLOW_NAME}\"}},\n                {\"key\": \"repository\", \"value\": {\"stringValue\": \"${REPO_SHORT}\"}}\n              ]\n            }]\n          }\n        }\n      ]\n    }]\n  }]\n}\nEOF\n)\n\n  curl -s -m 5 -X POST     \"http://default-collector.opentelemetry-collector.svc.cluster.local:4318/v1/metrics\"     -H \"Content-Type: application/json\"     -d \"${PAYLOAD}\" >/dev/null 2>&1 || true\n) || true\nexit 0\n"
  }
}
