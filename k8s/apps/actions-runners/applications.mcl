import "std:list" as lists
import "./values.mcl" as runnerConfig

let runners = runnerConfig.runners

fn runnerApplication(namespace: String, runner: runnerConfig.Runner) -> Map<String, Any> = node:
  apiVersion: "argoproj.io/v1alpha1"
  kind: "Application"
  metadata:
    name: "arc-picca-" + runner.name + "-helm"
    namespace: "argocd"
    finalizers:
      - "resources-finalizer.argocd.argoproj.io"
  spec:
    destination:
      namespace: namespace
      server: "https://kubernetes.default.svc"
    project: "default"
    source:
      chart: "gha-runner-scale-set"
      repoURL: "ghcr.io/actions/actions-runner-controller-charts"
      targetRevision: "0.14.2"
      helm:
        releaseName: "arc-picca-" + runner.name
        valuesObject: runnerConfig.runnerValues(runner)
    syncPolicy:
      automated:
        prune: true
        selfHeal: true
      syncOptions:
        - "ServerSideApply=true"
        - "FailOnSharedResource=true"

export fn applications(namespace: String) -> List<Map<String, Any>> =
  - runnerApplication(namespace, runners[0])
  - runnerApplication(namespace, runners[1])
  - runnerApplication(namespace, runners[2])
  - runnerApplication(namespace, runners[3])
  - runnerApplication(namespace, runners[4])
