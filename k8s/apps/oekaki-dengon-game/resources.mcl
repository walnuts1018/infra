import "std:manifest" as manifest
import "std:list" as lists
import text "./_configs/robots.txt" as robotsText

let backDeployment = manifest.loadOne("./_configs/back__deployment.yaml")
let backHpa = manifest.loadOne("./_configs/back__hpa.yaml")
let backNetworkPolicy = manifest.loadOne("./_configs/back__networkpolicy.yaml")
let backService = manifest.loadOne("./_configs/back__service.yaml")
let backVpa = manifest.loadOne("./_configs/back__vpa.yaml")
let externalSecret = manifest.loadOne("./_configs/external-secret.yaml")
let frontDeployment = manifest.loadOne("./_configs/front__deployment.yaml")
let frontHpa = manifest.loadOne("./_configs/front__hpa.yaml")
let frontNetworkPolicy = manifest.loadOne("./_configs/front__networkpolicy.yaml")
let frontService = manifest.loadOne("./_configs/front__service.yaml")
let frontVpa = manifest.loadOne("./_configs/front__vpa.yaml")
let oauth2ProxyExternalSecret = manifest.loadOne("./_configs/oauth2-proxy__external-secret.yaml")
let oauth2ProxyHttpRoutePublic = manifest.loadOne("./_configs/oauth2-proxy__httproute-public.yaml")
let oauth2ProxyHttpRoute = manifest.loadOne("./_configs/oauth2-proxy__httproute.yaml")
let oauth2ProxySecurityPolicy = manifest.loadOne("./_configs/oauth2-proxy__securitypolicy.yaml")
let s3CredentialsSecret = manifest.loadOne("./_configs/s3-credentials-secret.yaml")
let s3ReferenceGrant = manifest.loadOne("./_configs/s3-reference-grant.yaml")
let oauth2ProxyConfigMap = node:
  apiVersion: "v1"
  kind: "ConfigMap"
  immutable: true
  metadata:
    name: "oekaki-dengon-game-oauth2-proxy-6181a5"
    labels:
      app: "oekaki-dengon-game"
      "app.kubernetes.io/name": "oekaki-dengon-game"
  data:
    "robots.txt": robotsText

let baseResources =
  - externalSecret
  - oauth2ProxyExternalSecret
  - s3CredentialsSecret
  - s3ReferenceGrant
  - oauth2ProxyConfigMap
  - backDeployment
  - backService
  - backHpa
  - backVpa
  - backNetworkPolicy
  - frontDeployment
  - frontService
  - frontHpa
  - frontVpa
  - frontNetworkPolicy
  - oauth2ProxyHttpRoute
  - oauth2ProxyHttpRoutePublic
  - oauth2ProxySecurityPolicy

fn withEnvironmentValue(environment: Map<String, Any>, value: String) -> Map<String, Any> = environment with:
  value: value

fn frontEnvironment(namespace: String, environment: Map<String, Any>) -> Map<String, Any> =
  if environment.name == "API_URL":
    withEnvironmentValue(environment, "http://oekaki-dengon-game-back." + namespace + ".svc.cluster.local:8080/api")
  else:
    environment

fn frontContainerWithEnvironment(container: Map<String, Any>, environment: List<Map<String, Any>>) -> Map<String, Any> = container with:
  env: environment

fn frontContainer(namespace: String, container: Map<String, Any>) -> Map<String, Any> =
  if container.name == "oekaki-dengon-game-front":
    frontContainerWithEnvironment(container, lists.map(container.env, fn(environment) => frontEnvironment(namespace, environment)))
  else:
    container

fn frontDeployment(namespace: String, resource: Map<String, Any>) -> Map<String, Any> = resource with:
  metadata:
    namespace: namespace
  spec:
    template:
      spec:
        containers: lists.map(resource.spec.template.spec.containers, fn(container) => frontContainer(namespace, container))

fn withNamespace(namespace: String, resource: Map<String, Any>) -> Map<String, Any> = resource with:
  metadata:
    namespace: namespace

fn namespaceResource(namespace: String, resource: Map<String, Any>) -> Map<String, Any> =
  if resource.kind == "Deployment" and resource.metadata.name == "oekaki-dengon-game-front":
    frontDeployment(namespace, resource)
  else:
    withNamespace(namespace, resource)

export fn resources(namespace: String) -> List<Map<String, Any>> =
  lists.map(baseResources, fn(resource) => namespaceResource(namespace, resource))
