import "../envoy-gateway-class/gateway.mcl" as gateway
import "./app.mcl" as app

export fn resource(namespace: String) -> Map<String, Any> = node:
  apiVersion: "gateway.networking.k8s.io/v1"
  kind: "HTTPRoute"
  metadata:
    name: app.name
    namespace: namespace
    annotations:
      "external-dns-cloudflare.alpha.kubernetes.io/cloudflare-proxied": "true"
  spec:
    parentRefs:
      - name: "envoy-gateway"
        namespace: gateway.namespace
        sectionName: "https"
    hostnames:
      - "maps.walnuts.dev"
    rules:
      -
        backendRefs:
          - kind: "Service"
            name: "maps-versatiles-server"
            port: 80
            weight: 1
