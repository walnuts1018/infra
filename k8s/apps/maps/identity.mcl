import "./app.mcl" as app

export fn versatilesServiceAccount(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "ServiceAccount"
  metadata:
    name: app.name + "-versatiles-server"
    namespace: namespace
  automountServiceAccountToken: false

export fn updaterServiceAccount(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "ServiceAccount"
  metadata:
    name: app.name + "-updater"
    namespace: namespace

export fn s3CredentialsSecret(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Secret"
  metadata:
    name: "maps-s3-credentials"
    namespace: namespace

export fn s3ReferenceGrant(namespace: String) -> Map<String, Any> = node:
  apiVersion: "seaweed.seaweedfs.com/v1"
  kind: "ResourceReferenceGrant"
  metadata:
    name: "seaweedfs-s3-credentials"
    namespace: namespace
  spec:
    from:
      - group: "seaweed.seaweedfs.com"
        kind: "S3Credentials"
        namespace: "seaweedfs"
    to:
      - group: ""
        kind: "Secret"
