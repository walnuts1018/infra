import "./app.mcl" as app

let labels = app.labels("versatiles-server")

export fn resource(namespace: String) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    name: "maps-versatiles-server"
    namespace: namespace
    labels: labels
  spec:
    selector: labels
    ports:
      - name: "http"
        port: 80
        targetPort: 8080
    type: "ClusterIP"
