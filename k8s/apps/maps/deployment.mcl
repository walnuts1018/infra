import "./app.mcl" as app
import "./configmaps.mcl" as appConfigMaps

let s3CredentialsSecret = "maps-s3-credentials"
let labels = app.labels("versatiles-server")

export fn resource(namespace: String) -> Map<String, Any> = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    name: "maps-versatiles-server"
    namespace: namespace
    labels: labels
  spec:
    replicas: 1
    selector:
      matchLabels: labels
    strategy:
      type: "RollingUpdate"
      rollingUpdate:
        maxUnavailable: 0
        maxSurge: 1
    template:
      metadata:
        labels: labels
      spec:
        serviceAccountName: "maps-versatiles-server"
        automountServiceAccountToken: false
        securityContext:
          runAsNonRoot: true
          runAsUser: 65532
          runAsGroup: 65532
        topologySpreadConstraints:
          - maxSkew: 1
            topologyKey: "kubernetes.io/hostname"
            whenUnsatisfiable: "ScheduleAnyway"
            labelSelector:
              matchLabels: labels
        initContainers:
          - name: "envoy-s3-proxy"
            image: "docker.io/envoyproxy/envoy:distroless-v1.39.0"
            imagePullPolicy: "IfNotPresent"
            restartPolicy: "Always"
            command:
              - "envoy"
            args:
              - "-c"
              - "/etc/envoy/envoy.yaml"
            envFrom:
              - secretRef:
                  name: s3CredentialsSecret
            securityContext: app.versatilesContainerSecurityContext
            readinessProbe:
              httpGet:
                path: "/ready"
                port: 9901
              periodSeconds: 5
              failureThreshold: 6
            resources:
              requests:
                cpu: "30m"
                memory: "48Mi"
              limits:
                memory: "256Mi"
            volumeMounts:
              - name: "envoy-config"
                mountPath: "/etc/envoy"
                readOnly: true
        containers:
          - name: "versatiles"
            image: "docker.io/versatiles/versatiles:v4.13.0"
            imagePullPolicy: "IfNotPresent"
            args:
              - "serve"
              - "--config"
              - "/config/config.yaml"
            securityContext: app.versatilesContainerSecurityContext
            ports:
              - name: "http"
                containerPort: 8080
            startupProbe:
              httpGet:
                path: "/status"
                port: 8080
              periodSeconds: 2
              failureThreshold: 30
            readinessProbe:
              httpGet:
                path: "/status"
                port: 8080
              periodSeconds: 10
              failureThreshold: 3
            livenessProbe:
              httpGet:
                path: "/status"
                port: 8080
              periodSeconds: 10
              failureThreshold: 3
            resources:
              requests:
                cpu: "50m"
                memory: "128Mi"
              limits:
                cpu: "1"
                memory: "768Mi"
            volumeMounts:
              - name: "config"
                mountPath: "/config"
                readOnly: true
        volumes:
          - name: "config"
            configMap:
              name: appConfigMaps.versatilesName
          - name: "envoy-config"
            configMap:
              name: appConfigMaps.envoyName
