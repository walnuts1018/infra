export type ChartReference =
  repoURL: String
  chart: String
  targetRevision: String

# renovate: datasource=helm depName=reloader registryUrl=https://stakater.github.io/stakater-charts
export let chartVersion = "2.2.17"
export let chart: ChartReference =
  repoURL: "https://stakater.github.io/stakater-charts"
  chart: "reloader"
  targetRevision: chartVersion
export let chartArchive = chart.repoURL + "/" + chart.chart + "-" + chart.targetRevision + ".tgz"
export let apiVersions: List<String> =
  - "rbac.authorization.k8s.io/v1"
