import "./config.mcl" as appConfig

let appName = "visual-regression-tracker"
fn labels(name: String) -> Map<String, String> =
  app: name
  "app.kubernetes.io/name": name
fn databaseURL(settings: appConfig.Settings) -> String = "postgresql://visual_regression_tracker:{{ .postgres_password }}@" + settings.databaseHost + ":5432/visual_regression_tracker?connection_limit=10"

fn externalSecret(namespace: String, settings: appConfig.Settings) -> Map<String, Any> = node:
  apiVersion: "external-secrets.io/v1"
  kind: "ExternalSecret"
  metadata:
    name: appName
    namespace: namespace
  spec:
    secretStoreRef:
      name: "onepassword"
      kind: "ClusterSecretStore"
    refreshInterval: "1m"
    target:
      name: appName
      template:
        engineVersion: "v2"
        type: "Opaque"
        data:
          jwt_secret: "{{ .jwt_secret }}"
          DATABASE_URL: databaseURL(settings)
          DEFAULT_USER_PASSWORD: "{{ .admin_password }}"
          DEFAULT_USER_API_KEY: "{{ .admin_api_key }}"
    data:
      - secretKey: "jwt_secret"
        remoteRef:
          key: "terraform-external-secrets"
          property: "visual-regression-tracker-jwt-secret"
      - secretKey: "postgres_password"
        remoteRef:
          key: "postgres_passwords"
          property: "visual_regression_tracker"
      - secretKey: "admin_password"
        remoteRef:
          key: "terraform-external-secrets"
          property: "visual-regression-tracker-admin-password"
      - secretKey: "admin_api_key"
        remoteRef:
          key: "terraform-external-secrets"
          property: "visual-regression-tracker-admin-api-key"

fn s3CredentialsSecret(namespace: String, settings: appConfig.Settings) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Secret"
  metadata:
    name: "visual-regression-tracker-s3-credentials"
    namespace: namespace

fn s3ReferenceGrant(namespace: String, settings: appConfig.Settings) -> Map<String, Any> = node:
  apiVersion: "seaweed.seaweedfs.com/v1"
  kind: "ResourceReferenceGrant"
  metadata:
    name: "seaweedfs-s3-credentials"
    namespace: namespace
  spec:
    from:
      - group: "seaweed.seaweedfs.com"
        kind: "S3Credentials"
        namespace: "seaweedfs"
    to:
      - group: ""
        kind: "Secret"

fn apiDeployment(namespace: String, settings: appConfig.Settings) -> Map<String, Any> = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    name: appName + "-api"
    namespace: namespace
    labels: labels(appName + "-api")
  spec:
    replicas: 1
    selector:
      matchLabels: labels(appName + "-api")
    template:
      metadata:
        labels: labels(appName + "-api")
      spec:
        containers:
          - name: "api"
            image: "docker.io/visualregressiontracker/api:5.6.3"
            imagePullPolicy: "IfNotPresent"
            ports:
              - name: "http"
                containerPort: 3000
            env:
              - name: "APP_FRONTEND_URL"
                value: settings.publicURL
              - name: "AUTO_APPROVE_BASED_ON_HISTORY"
                value: "true"
              - name: "BODY_PARSER_JSON_LIMIT"
                value: "5mb"
              - name: "JWT_LIFE_TIME"
                value: "1d"
              - name: "DATABASE_URL"
                valueFrom:
                  secretKeyRef:
                    name: "visual-regression-tracker"
                    key: "DATABASE_URL"
              - name: "JWT_SECRET"
                valueFrom:
                  secretKeyRef:
                    name: "visual-regression-tracker"
                    key: "jwt_secret"
              - name: "STATIC_SERVICE"
                value: "s3"
              - name: "AWS_S3_BUCKET_NAME"
                value: settings.s3Bucket
              - name: "AWS_REGION"
                value: "us-east-1"
              - name: "AWS_ENDPOINT_URL_S3"
                value: settings.s3Endpoint
              - name: "AWS_ACCESS_KEY_ID"
                valueFrom:
                  secretKeyRef:
                    name: "visual-regression-tracker-s3-credentials"
                    key: "AWS_ACCESS_KEY_ID"
              - name: "AWS_SECRET_ACCESS_KEY"
                valueFrom:
                  secretKeyRef:
                    name: "visual-regression-tracker-s3-credentials"
                    key: "AWS_SECRET_ACCESS_KEY"
            livenessProbe:
              tcpSocket:
                port: 3000
              initialDelaySeconds: 5
              periodSeconds: 10
            readinessProbe:
              tcpSocket:
                port: 3000
              initialDelaySeconds: 5
              periodSeconds: 10
            resources:
              requests:
                cpu: "10m"
                memory: "128Mi"
              limits:
                cpu: "1000m"
                memory: "512Mi"
            securityContext:
              readOnlyRootFilesystem: false
              seccompProfile:
                type: "RuntimeDefault"
              capabilities:
                add:
                  - "NET_BIND_SERVICE"
                drop:
                  - "all"

fn apiService(namespace: String, settings: appConfig.Settings) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    name: appName + "-api"
    namespace: namespace
    labels: labels(appName + "-api")
  spec:
    ports:
      - name: "http"
        port: 3000
        targetPort: 3000
    selector: labels(appName + "-api")
    type: "ClusterIP"

fn uiDeployment(namespace: String, settings: appConfig.Settings) -> Map<String, Any> = node:
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    name: appName + "-ui"
    namespace: namespace
    labels: labels(appName + "-ui")
  spec:
    replicas: 1
    selector:
      matchLabels: labels(appName + "-ui")
    template:
      metadata:
        labels: labels(appName + "-ui")
      spec:
        containers:
          - name: "ui"
            image: "docker.io/visualregressiontracker/ui:5.5.2"
            imagePullPolicy: "IfNotPresent"
            ports:
              - name: "http"
                containerPort: 8080
            env:
              - name: "REACT_APP_API_URL"
                value: settings.publicURL + "/api"
            livenessProbe:
              tcpSocket:
                port: 8080
              initialDelaySeconds: 5
              periodSeconds: 10
            readinessProbe:
              tcpSocket:
                port: 8080
              initialDelaySeconds: 5
              periodSeconds: 10
            resources:
              requests:
                cpu: "10m"
                memory: "32Mi"
              limits:
                cpu: "200m"
                memory: "128Mi"
            securityContext:
              readOnlyRootFilesystem: false
              seccompProfile:
                type: "RuntimeDefault"
              capabilities:
                add:
                  - "NET_BIND_SERVICE"
                  - "CHOWN"
                  - "SETUID"
                  - "SETGID"
                drop:
                  - "all"

fn uiService(namespace: String, settings: appConfig.Settings) -> Map<String, Any> = node:
  apiVersion: "v1"
  kind: "Service"
  metadata:
    name: appName + "-ui"
    namespace: namespace
    labels: labels(appName + "-ui")
  spec:
    ports:
      - name: "http"
        port: 8080
        targetPort: 8080
    selector: labels(appName + "-ui")
    type: "ClusterIP"

fn migrationJob(namespace: String, settings: appConfig.Settings) -> Map<String, Any> = node:
  apiVersion: "batch/v1"
  kind: "Job"
  metadata:
    name: "visual-regression-tracker-migration-1197c5f7e1"
    namespace: namespace
    labels: labels("visual-regression-tracker-migration")
  spec:
    template:
      metadata:
        labels: labels("visual-regression-tracker-migration")
      spec:
        restartPolicy: "Never"
        containers:
          - name: "migration"
            image: "docker.io/visualregressiontracker/migration:5.4.0"
            imagePullPolicy: "IfNotPresent"
            env:
              - name: "DATABASE_URL"
                valueFrom:
                  secretKeyRef:
                    name: "visual-regression-tracker"
                    key: "DATABASE_URL"
              - name: "DEFAULT_USER_EMAIL"
                value: "admin@vrt.local.walnuts.dev"
              - name: "DEFAULT_USER_PASSWORD"
                valueFrom:
                  secretKeyRef:
                    name: "visual-regression-tracker"
                    key: "DEFAULT_USER_PASSWORD"
              - name: "DEFAULT_USER_API_KEY"
                valueFrom:
                  secretKeyRef:
                    name: "visual-regression-tracker"
                    key: "DEFAULT_USER_API_KEY"
            securityContext:
              readOnlyRootFilesystem: false
              seccompProfile:
                type: "RuntimeDefault"
              capabilities:
                add:
                  - "NET_BIND_SERVICE"
                drop:
                  - "all"


export fn resources(namespace: String, settings: appConfig.Settings) -> List<Map<String, Any>> =
  - externalSecret(namespace, settings)
  - s3CredentialsSecret(namespace, settings)
  - s3ReferenceGrant(namespace, settings)
  - apiDeployment(namespace, settings)
  - apiService(namespace, settings)
  - uiDeployment(namespace, settings)
  - uiService(namespace, settings)
  - migrationJob(namespace, settings)
